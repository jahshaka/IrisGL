+static void limitErrorByEdges(const clodConfig& config, const clodMesh& mesh, const std::vector<unsigned int>& indices, float* error)
+{
+	if (config.simplify_error_edge_limit > 0)
+	{
+		float max_edge_sq = 0;
+
+		for (size_t i = 0; i < indices.size(); i += 3)
+		{
+			unsigned int a = indices[i + 0], b = indices[i + 1], c = indices[i + 2];
+			assert(a < mesh.vertex_count && b < mesh.vertex_count && c < mesh.vertex_count);
