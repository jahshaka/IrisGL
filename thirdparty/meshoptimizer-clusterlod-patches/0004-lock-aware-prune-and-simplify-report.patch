+
+	// how the group's (last) simplification went: CLOD_SIMPLIFY_* bits; how many of the group's locked positions (the level's
+	// boundary, terminal and input locks, by welded position) the result no longer uses; and how many vertices of components the
+	// prune removed the verify hook asked to lock (a pruned piece the caller would not accept)
+	unsigned int simplify_flags;
+	unsigned int locked_dropped;
+	unsigned int pruned_relocked;
