-static std::vector<unsigned int> simplify(const clodConfig& config, const clodMesh& mesh, const std::vector<unsigned int>& indices, const std::vector<unsigned char>& locks, size_t target_count, float* error)
+static void pruneUnlocked(const clodMesh& mesh, const std::vector<unsigned int>& indices, const std::vector<unsigned char>& locks, const std::vector<unsigned int>& remap, size_t target_count, std::vector<unsigned int>& lod, float* error, std::vector<unsigned int>& pruned)
+{
+	// the group's positions, numbered locally
+	std::vector<unsigned int> pos(indices.size());
+	for (size_t i = 0; i < indices.size(); ++i)
+		pos[i] = remap[indices[i]];
+	std::sort(pos.begin(), pos.end());
+	pos.erase(std::unique(pos.begin(), pos.end()), pos.end());
+
+	struct Local
+	{
+		const std::vector<unsigned int>& pos;
+		unsigned int operator()(unsigned int r) const { return unsigned(std::lower_bound(pos.begin(), pos.end(), r) - pos.begin()); }
+	} local = {pos};
+
+	// components of the group's input, by position
+	std::vector<unsigned int> parent(pos.size());
+	for (size_t i = 0; i < parent.size(); ++i)
+		parent[i] = unsigned(i);
+
+	struct Find
+	{
+		std::vector<unsigned int>& parent;
+		unsigned int operator()(unsigned int x) const
+		{
+			while (parent[x] != x)
+				x = parent[x] = parent[parent[x]];
+			return x;
+		}
+	} find = {parent};
+
+	for (size_t i = 0; i < indices.size(); i += 3)
+	{
+		unsigned int a = find(local(remap[indices[i + 0]]));
+		for (int k = 1; k < 3; ++k)
+		{
+			unsigned int b = find(local(remap[indices[i + k]]));
+			if (a != b)
+				parent[a < b ? b : a] = a < b ? a : b, a = a < b ? a : b;
+		}
+	}
+
+	// per component: locked, cost (the largest component_extent, else the box diagonal), output triangles
+	size_t count = pos.size();
+	std::vector<unsigned char> locked(count, 0);
+	std::vector<float> cost(count, 0.f);
+	std::vector<float> box(count * 6);
+	for (size_t c = 0; c < count; ++c)
+		for (int k = 0; k < 3; ++k)
+			box[c * 6 + k] = FLT_MAX, box[c * 6 + 3 + k] = -FLT_MAX;
+
+	size_t positions_stride = mesh.vertex_positions_stride / sizeof(float);
+
+	for (size_t i = 0; i < indices.size(); ++i)
+	{
+		unsigned int v = indices[i];
+		unsigned int c = find(local(remap[v]));
+
+		if (locks[v] & meshopt_SimplifyVertex_Lock)
+			locked[c] = 1;
+
+		if (mesh.component_extent)
+			cost[c] = std::max(cost[c], mesh.component_extent[v]);
+
+		for (int k = 0; k < 3; ++k)
+		{
+			float x = mesh.vertex_positions[v * positions_stride + k];
+			box[c * 6 + k] = std::min(box[c * 6 + k], x);
+			box[c * 6 + 3 + k] = std::max(box[c * 6 + 3 + k], x);
+		}
+	}
+
+	if (!mesh.component_extent)
+		for (size_t c = 0; c < count; ++c)
+		{
+			float dx = box[c * 6 + 3] - box[c * 6 + 0], dy = box[c * 6 + 4] - box[c * 6 + 1], dz = box[c * 6 + 5] - box[c * 6 + 2];
+			cost[c] = sqrtf(dx * dx + dy * dy + dz * dz);
+		}
+
+	std::vector<unsigned int> outputTris(count, 0);
+	for (size_t i = 0; i < lod.size(); i += 3)
+		outputTris[find(local(remap[lod[i]]))]++;
+
+	// smallest first; ties by component number (deterministic)
+	std::vector<unsigned int> order;
+	for (size_t c = 0; c < count; ++c)
+		if (!locked[c] && outputTris[c] && parent[c] == c)
+			order.push_back(unsigned(c));
+
+	std::sort(order.begin(), order.end(), [&](unsigned int a, unsigned int b) { return cost[a] < cost[b] || (cost[a] == cost[b] && a < b); });
+
+	std::vector<unsigned char> removed(count, 0);
+	size_t remaining = lod.size();
+	for (size_t k = 0; k < order.size() && remaining > target_count; ++k)
+	{
+		unsigned int c = order[k];
+		removed[c] = 1;
+		remaining -= outputTris[c] * 3;
+		*error = std::max(*error, cost[c]);
+	}
+
+	if (remaining == lod.size())
+		return;
+
+	size_t write = 0;
+	for (size_t i = 0; i < lod.size(); i += 3)
+		if (!removed[find(local(remap[lod[i]]))])
+		{
+			lod[write + 0] = lod[i + 0], lod[write + 1] = lod[i + 1], lod[write + 2] = lod[i + 2];
+			write += 3;
+		}
+	lod.resize(write);
+
+	for (size_t i = 0; i < indices.size(); ++i)
+		if (removed[find(local(remap[indices[i]]))])
+			pruned.push_back(indices[i]);
+	std::sort(pruned.begin(), pruned.end());
+	pruned.erase(std::unique(pruned.begin(), pruned.end()), pruned.end());
+}
+
+static std::vector<unsigned int> simplify(const clodConfig& config, const clodMesh& mesh, const std::vector<unsigned int>& indices, const std::vector<unsigned char>& locks, const std::vector<unsigned int>& remap, size_t target_count, float* error, unsigned int* flags, std::vector<unsigned int>& pruned)
 {
+	*flags = 0;
+	pruned.clear();
+
 	if (target_count > indices.size())
 		return indices;
 
@@ -490,10 +637,19 @@
 		    mesh.vertex_attributes, mesh.vertex_attributes_stride, mesh.attribute_weights, mesh.attribute_count,
 		    &locks[0], target_count, FLT_MAX, options | meshopt_SimplifyPermissive, error));
 
+	// the collapses could not reach the target: remove whole unlocked components, smallest first
+	if (lod.size() > target_count && config.simplify_prune_unlocked)
+	{
+		pruneUnlocked(mesh, indices, locks, remap, target_count, lod, error, pruned);
+		if (!pruned.empty())
+			*flags |= CLOD_SIMPLIFY_PRUNED;
+	}
+
 	// while it's possible to call simplifySloppy directly, it doesn't support sparsity or absolute error, so we need to do some extra work
