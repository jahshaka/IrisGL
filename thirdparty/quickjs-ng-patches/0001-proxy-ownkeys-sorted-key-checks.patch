-/* return the index of the property or -1 if not found */
-static int find_prop_key(const JSPropertyEnum *tab, int n, JSAtom atom)
+/* JAHSHAKA 0001 (irisgl/thirdparty/quickjs-ng-patches): a Proxy's ownKeys list is checked through a SORTED COPY of its
+   (atom, index) pairs - a heapsort, n log n in the WORST case whatever atoms the script chose (no hash a script can
+   crowd), no recursion - the list itself never reordered: the trap's order is the result's. The quadratic scans it
+   replaces cost ~2.3e-10 s x n^2 in C where no interrupt reaches. */
+typedef struct JahKeyPair {
+    uint32_t atom;
+    uint32_t index;
+} JahKeyPair;
+
+static int jah_key_less(const JahKeyPair *a, const JahKeyPair *b)
+{
+    return a->atom < b->atom || (a->atom == b->atom && a->index < b->index);
+}
+
+static void jah_key_sift(JahKeyPair *p, size_t root, size_t n)
 {
-    int i;
-    for(i = 0; i < n; i++) {
-        if (tab[i].atom == atom)
-            return i;
+    for (;;) {
+        size_t child = 2 * root + 1;
+        JahKeyPair t;
+        if (child >= n)
+            return;
+        if (child + 1 < n && jah_key_less(&p[child], &p[child + 1]))
+            child++;
+        if (!jah_key_less(&p[root], &p[child]))
+            return;
+        t = p[root];
+        p[root] = p[child];
+        p[child] = t;
+        root = child;
     }
-    return -1;
+}
+
+/* the pairs of tab[0..len) sorted by (atom, index); NULL on an allocation refused (the exception thrown) */
+static JahKeyPair *jah_key_sorted(JSContext *ctx, const JSPropertyEnum *tab, uint32_t len)
+{
+    JahKeyPair *p, t;
+    size_t i, n = len;
+    p = js_malloc(ctx, (n ? n : 1) * sizeof(p[0]));
+    if (!p)
+        return NULL;
+    for (i = 0; i < n; i++) {
+        p[i].atom = tab[i].atom;
+        p[i].index = (uint32_t)i;
+    }
+    for (i = n / 2; i-- > 0;)
+        jah_key_sift(p, i, n);
+    for (i = n; i-- > 1;) {
+        t = p[0];
+        p[0] = p[i];
+        p[i] = t;
+        jah_key_sift(p, 0, i);
+    }
+    return p;
+}
+
+/* the index of `atom` in the list, or -1: a binary search of the sorted pairs */
+static int jah_key_find(const JahKeyPair *p, uint32_t len, JSAtom atom)
+{
+    size_t lo = 0, hi = len;
+    while (lo < hi) {
+        size_t mid = lo + (hi - lo) / 2;
+        if (p[mid].atom < atom)
+            lo = mid + 1;
+        else
+            hi = mid;
+    }
+    return lo < len && p[lo].atom == atom ? (int)p[lo].index : -1;
 }
 
