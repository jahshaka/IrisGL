--- a/Components/Hlms/Pbs/include/Vct/OgreVctVoxelizer.h
+++ b/Components/Hlms/Pbs/include/Vct/OgreVctVoxelizer.h
@@ -60,18 +60,45 @@
         UavBufferPacked   *vertexBuffer;
         UavBufferPacked   *indexBuffer;
         bool               needsTexPool;
+        /// WHAT THIS BUCKET IS, said without a pointer: the compute job's VARIANT
+        /// (the VoxelizerJobSetting bits — it also decides the vertex and index
+        /// buffers) and the material's POOL and SLOT. See operator< below.
+        uint32             variant;
+        uint32             materialBucketIdx;
+        uint32             materialSlotIdx;
 
+        /// ORDERED BY WHAT A BUCKET IS, NEVER BY WHERE IT LIVES.
+        ///
+        /// This ordering is the ORDER THE DISPATCHES RUN IN (VctVoxelizer::build
+        /// iterates mBuckets), and the voxelisation shader's per-voxel merge is not
+        /// fully order-independent: the double-sided flag it writes is the last
+        /// dispatch's answer for every voxel it touches. Comparing POINTERS therefore
+        /// made the voxel contents depend on the order the allocator happened to hand
+        /// out buffers — the same scene, voxelised in two processes, is not the same
+        /// picture, and no re-solve can correct it because the VOXELS differ.
+        ///
+        /// The three integer keys name the bucket completely: `variant` carries the
+        /// job and, with it, which vertex/index buffers the bucket uses (compressed
+        /// vertex format, 32-bit indices) and whether a texture pool is needed; the
+        /// material's pool + slot name the material. The pointer comparisons remain
+        /// underneath as a total-order tie-break that nothing reaches.
         bool operator<( const VoxelizerBucket &other ) const
         {
+            if( this->variant != other.variant )
+                return this->variant < other.variant;
+            if( this->materialBucketIdx != other.materialBucketIdx )
+                return this->materialBucketIdx < other.materialBucketIdx;
+            if( this->materialSlotIdx != other.materialSlotIdx )
+                return this->materialSlotIdx < other.materialSlotIdx;
+            if( this->needsTexPool != other.needsTexPool )
+                return this->needsTexPool < other.needsTexPool;
             if( this->job != other.job )
                 return this->job < other.job;
             if( this->materialBuffer != other.materialBuffer )
                 return this->materialBuffer < other.materialBuffer;
             if( this->vertexBuffer != other.vertexBuffer )
                 return this->vertexBuffer < other.vertexBuffer;
-            if( this->indexBuffer != other.indexBuffer )
-                return this->indexBuffer < other.indexBuffer;
-            return this->needsTexPool < other.needsTexPool;
+            return this->indexBuffer < other.indexBuffer;
         }
     };
 
