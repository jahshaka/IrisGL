+        // JAHSHAKA PATCH 0028 — A MATERIAL WITH NO SPECULAR RESPONSE SAMPLES NO
+        // REFLECTION PROBE.
+        //
+        // Owner, 2026-09-13: "[reflection probes] should only affect reflective
+        // objects in a scene." Upstream has no material-side gate at all: once
+        // the pass sets parallax_correct_cubemaps, EVERY datablock gets
+        // use_envprobe_map and every lit pixel of every object runs the
+        // per-pixel probe loop, however matte it is.
+        //
+        // The gate is the material's OWN reflectance, not a roughness guess
+        // (roughness blurs a reflection, it never removes one). The PBS
+        // specular term ends as
+        //     Rs = envColourS * pixelData.specular * (F0*envBRDF.x + envBRDF.y)
+        // with pixelData.specular = material.kS (200.BRDFs_piece_ps.any /
+        // Main/800.PixelShader_piece_ps.any:307), so a datablock whose SPECULAR
+        // COLOUR is black multiplies every environment term by zero: skipping
+        // the lookup is arithmetically identical, not an approximation. The
+        // second half of the pair — F0 — is required as well, so that the gate
+        // only fires where the AUTHOR has said "not reflective" with both of
+        // the controls that spell it (F0 alone leaves the Schlick rim and the
+        // envBRDF bias; kS alone is the one that zeroes the product).
+        //
+        // Kept out of the gate, deliberately:
+        //   * clear coat — its own environment term is NOT multiplied by kS, so
+        //     a zero-kS clear-coated material still reflects;
+        //   * cubemaps_as_diffuse_gi — there a probe also carries DIFFUSE light,
+        //     which kS does not scale. Off in Jahshaka (envFeatures 0), checked
+        //     anyway so the patch is honest upstream.
+        // Physically lit surfaces keep their ~4% sheen: a default metallic
+        // dielectric has kS = 1 and never qualifies.
+        {
+            const Vector3 kS = datablock->getSpecular();
+            const Real kEps = Real( 1e-4 );
+            bool bZeroSpecular = kS.x <= kEps && kS.y <= kEps && kS.z <= kEps;
+            if( bZeroSpecular )
+            {
+                // ...and F0: authored directly in the Fresnel workflows, and
+                // driven by metalness in the metallic one (where the shader's
+                // dielectric floor of 0.04 is not reachable from any setter, so
+                // "no authored F0" is metalness 0).
+                if( metallicWorkflow )
+                    bZeroSpecular = datablock->getMetalness() <= kEps;
+                else
+                {
+                    const Vector3 f0 = datablock->getFresnel();
+                    bZeroSpecular = f0.x <= kEps && f0.y <= kEps && f0.z <= kEps;
+                }
+            }
+            if( bZeroSpecular && datablock->mClearCoat == 0.0f )
+                setProperty( kNoTid, PbsProperty::ZeroSpecularResponse, 1 );
+        }
+
         setProperty( kNoTid, PbsProperty::FresnelScalar,
                      datablock->hasSeparateFresnel() || metallicWorkflow );
         setProperty( kNoTid, PbsProperty::FresnelWorkflow, fresnelWorkflow );
