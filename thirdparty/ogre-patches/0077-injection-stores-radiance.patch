-			outSpecular += float4( irrLight.colour.xyz * blendWeight * 0.31831f, blend );
+			// JAHSHAKA PATCH 0077: THE FUDGE IS GONE, AT ITS CAUSE.
+			// Upstream's comment here read "0.31831 = 1 / PI, but I'm not sure why
+			// is it even needed. It's clearly overbrightened when it's not there".
+			// It was needed because the light injection stored PI times the
+			// surface's outgoing radiance (LightInjection_piece_cs.any: the direct
+			// term had no 1/PI), so every cone result -- diffuse and specular
+			// alike -- came back PI times too bright. The diffuse composite above
+			// never carried the correction and was therefore PI times too bright
+			// for as long as this line hid the same error on the specular one.
+			// With the injection fixed the voxel holds radiance, a specular cone
+			// returns radiance, and the pre-integrated BRDF downstream wants
+			// exactly that: no factor.
+			outSpecular += float4( irrLight.colour.xyz * blendWeight, blend );
 
 			@property( jah_sky_env_probe )
 				// JAHSHAKA PATCH 0048: WHAT THE CONE COULD NOT ANSWER FOR.
@@ -704,24 +714,28 @@
 				// cubemap in the direction the surface reflects, for pixels no
 				// probe box covers. To replace it, it must know precisely what
 				// was added and at what weight, per cascade and with the same
-				// blendWeight and 1/pi that scaled it -- so both are exported
+				// blendWeight that scaled it -- so both are exported
 				// rather than reconstructed, and the cone's own HIT colour is
 				// never touched.
-				// THE COLOUR REMOVED CARRIES THE 1/PI; THE WEIGHT ADDED DOES NOT,
-				// and that asymmetry is the whole of the units question. What
-				// was ADDED here is the flat ambient scaled by the cone's own
-				// composite, 1/pi included, so removing it exactly means
-				// removing exactly that. What is ADDED BACK downstream is a
-				// cubemap sample, and every other cubemap sample in this shader
-				// (CubemapGlobal, the probe loop) is taken in radiance units
-				// with no 1/pi at all -- the two conventions differ by pi in
-				// this pin, which upstream's own comment three lines above
-				// records as unexplained. So the sky's weight is the ESCAPE
-				// FRACTION itself: at a full escape the pixel sees exactly the
-				// sky it would see with no voxel volume at all, which is the
-				// calibrated answer (scripting.e2e.default_ground's 5/255
-				// grazing margin, measured back to 5 with this).
-				jahEscapeColour += jahAmbientTerm * specAlpha * blendWeight * 0.31831f;
+				// (JAHSHAKA PATCH 0077: the 1/pi this comment argued about is
+				// gone from both sides -- see below.)
+				// THE REMOVAL IS EXACTLY WHAT WAS ADDED, WHICHEVER UNITS THAT IS
+				// IN -- that is the whole of the units question, and it is why
+				// this term is EXPORTED rather than reconstructed here. What was
+				// added above is the flat ambient scaled by the cone's own
+				// escape composite and by blendWeight, so this is that same
+				// product, and the swap downstream is exact.
+				// JAHSHAKA PATCH 0077 removed the 1/pi that used to appear in
+				// BOTH lines (upstream's eye-tuned cancellation of the
+				// injection's missing 1/pi, fixed at the cause in
+				// LightInjection_piece_cs.any). The two conventions the older
+				// comment here described as "differing by pi in this pin" now
+				// agree: the voxel volume, the cubemaps and the flat ambient are
+				// all radiance. The sky's WEIGHT is still the escape fraction
+				// itself -- at a full escape the pixel sees exactly the sky it
+				// would see with no voxel volume at all, which is the calibrated
+				// answer (scripting.e2e.default_ground's grazing margin).
+				jahEscapeColour += jahAmbientTerm * specAlpha * blendWeight;
 				jahEscapeWeight += specAlpha * blendWeight;
 				jahConeWeight   += blendWeight;
 			@end
