+            const VertexFormatEntry::MaterialRqId &material = entry.materials[i];
             WarmUpRenderable *renderable =
                 new WarmUpRenderable( Ogre::Id::generateNewId<Ogre::MovableObject>(),
                                       &sceneManager->_getEntityMemoryManager( Ogre::SCENE_STATIC ),
@@ -433,10 +480,29 @@ void VertexFormatWarmUpStorage::createWarmUp( SceneManager *sceneManager )
             if( bHasSkeleton )
                 renderable->setupSkeleton( mSkeleton, &mBlendIndexToBoneIndexMap );
             entry.renderables.push_back( renderable );
-            renderable->setDatablock( material.name );
+            renderable->setDatablock( datablock );
             rootNode->attachObject( renderable );
+            ++numSpawned;
         }
     }
+
+    // Nothing was spawned at all: the dummy skeleton this call may have created
+    // has no user and destroyWarmUp() -- which finds its SceneManager through a
+    // spawned renderable -- would not be able to reach one to free it with.
+    if( numSpawned == 0u )
+        destroySkeleton( sceneManager );
+
+    if( numMissingMaterials > 0u )
+    {
+        // ONE line, at the ordinary level, saying what happened and why it can
+        // happen at all -- instead of one CRITICAL line per missing material
+        // from deep inside HlmsManager, which says nothing about warm-ups.
+        LogManager::getSingleton().logMessage(
+            "VertexFormatWarmUpStorage: " + StringConverter::toString( numMissingMaterials ) +
+            " of " + StringConverter::toString( numMaterials ) +
+            " recorded material(s) do not exist in this process and were skipped. A warm-up set "
+            "records a material by NAME, so names that are not stable across runs warm nothing." );
+    }
 }
