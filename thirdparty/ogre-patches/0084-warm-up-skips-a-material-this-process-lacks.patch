-        for( const VertexFormatEntry::MaterialRqId &material : entry.materials )
+        for( size_t i = 0u; i < entry.materials.size(); ++i )
         {
+            HlmsDatablock *datablock = entryDatablocks[i];
+            if( !datablock )
