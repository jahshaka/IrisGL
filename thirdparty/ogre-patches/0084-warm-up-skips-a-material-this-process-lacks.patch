+    // DEFAULT datablock for a name it cannot find -- so a recorded entry whose
+    // material is absent used to spawn a renderable wearing the default
+    // datablock and compile ITS permutation, which is not the permutation the
+    // recording was made for and which no draw in the session will use. The
+    // storage then reported those compiles as a successful warm-up.
+    //
+    // Measured on a host whose datablock names are per-process (Jahshaka,
+    // 2026-09-21): seven "Can't find HLMS datablock material" CRITICAL lines
+    // and eight shaders compiled on every warm launch, none of them ever bound.
+    //
+    // The whole ENTRY is tested before its dummy buffers are built, because an
+    // entry that spawns no renderable would otherwise leak its VAO and vertex
+    // buffers: destroyWarmUp() reaches them through `entry.renderables.back()`.
+    HlmsManager *hlmsManager = Root::getSingleton().getHlmsManager();
+    FastArray<HlmsDatablock *> entryDatablocks;
+    size_t numMissingMaterials = 0u;
+    size_t numMaterials = 0u;
+    size_t numSpawned = 0u;
+
     SceneNode *rootNode = sceneManager->getRootSceneNode( SCENE_STATIC );
     for( VertexFormatEntry &entry : mEntries )
     {
+        numMaterials += entry.materials.size();
+
+        entryDatablocks.clear();
+        entryDatablocks.reserve( entry.materials.size() );
+        for( const VertexFormatEntry::MaterialRqId &material : entry.materials )
+        {
+            HlmsDatablock *datablock = hlmsManager->getDatablockNoDefault( material.name );
+            if( !datablock )
+                ++numMissingMaterials;
+            entryDatablocks.push_back( datablock );
+        }
+
+        bool bHasAnyMaterial = false;
+        for( HlmsDatablock *datablock : entryDatablocks )
+            bHasAnyMaterial |= datablock != 0;
+        if( !bHasAnyMaterial )
+            continue;  // Nothing to apply the vertex format to.
+
         // Generate dummy buffers full of 0. We hold data for 3 vertices
         // to avoid tripping any potential HW bug. Index buffers are not needed.
         vertexBuffers.clear();
@@ -424,8 +467,12 @@ void VertexFormatWarmUpStorage::createWarmUp( SceneManager *sceneManager )
         const bool bHasSkeleton = entry.vertexFormats.hasSkeleton;
 
