 				//TODO: SSR pass should be able to combine global & local cubemap.
 				float4 ssrReflection = OGRE_Load2D( ssrTexture, iFragCoord, 0 ).xyzw;
-				@property( use_envprobe_map )
-					pixelData.envColourS = lerp( pixelData.envColourS.xyz, ssrReflection.xyz, ssrReflection.w );
-				@else
-					pixelData.envColourS += ssrReflection.xyz * ssrReflection.w;
-				@end
+				/// JAHSHAKA PATCH 0036: a screen-space reflection REPLACES the
+				/// environment term it supersedes, always -- it never adds to it.
+				/// The two are estimates of ONE integral (the radiance arriving
+				/// along the specular lobe) and ssrReflection.w is how much of
+				/// that integral the screen could answer for; the rest stays with
+				/// the probe. Upstream's second branch added another copy of the
+				/// lobe wherever an environment source exists that does not raise
+				/// use_envprobe_map, and there is one: applyVoxelConeTracing adds
+				/// its cone-traced SPECULAR to envColourS above this line without
+				/// raising the property (the irradiance field and the irradiance
+				/// volumes write envColourD only, so they are not in this).
+				/// Where envColourS really is zero
+				/// the two spellings are the same arithmetic, which is why this
+				/// moves no frame that has a sky or a probe. Patch header: why.
+				pixelData.envColourS = lerp( pixelData.envColourS.xyz, ssrReflection.xyz, ssrReflection.w );
