new file mode 100644
index 0000000..37c2904
--- /dev/null
+++ b/Samples/Media/VCT/VoxelMerge_piece_cs.any
@@ -0,0 +1,167 @@
+// Jahshaka patch 0065 — THE ORDER-INDEPENDENT VOXEL MERGE (Voxelizer_piece_cs).
+//
+// WHY IT EXISTS. `VctVoxelizer::build()` issues one compute dispatch per bucket
+// per octant, and upstream merged each dispatch's triangles into the RGBA8 voxel
+// textures as a RUNNING MEAN (`mixAverage3/4`): load the mean written so far,
+// weight it by the count, add this dispatch's, store the new mean back — 8-bit,
+// once per dispatch. An average of the same numbers taken in a different order
+// is the same value only up to that quantisation, so WHICH INSTANCES LANDED IN
+// WHICH DISPATCH decided the picture, by a few 8-bit steps per voxel and by
+// ~6/255 on screen after the bounce. That is why patch 0062 had to give every
+// MATERIAL its own bucket (one dispatch per material makes the partition a
+// property of the scene rather than of the attach order) — and why the outermost
+// cascade of a scene whose 8,001 primitives each own a material cost 321 ms
+// instead of 86: a dispatch is sized by the whole octant however few instances
+// it holds.
+//
+// THE FIX IS TO STOP MERGING MEANS. Every contribution is snapped to a fixed
+// point grid and added into a per-voxel INTEGER SUM; the mean is computed ONCE,
+// by the resolve pass, after every dispatch has run. Integer addition is exact
+// and associative, so the voxels do not depend on the partition at all, and a
+// bucket can go back to being a material POOL.
+//
+// THE GRID. 12 fractional bits (1/4096 = 2.4e-4) — 6 % of one step of the 8-bit
+// texture the mean is finally written to, so the snap is invisible — and one
+// contribution is clamped to [0, 16] first, which bounds a sum of 65,535
+// contributions (the widest the voxeliser's own triangle counter allows) at
+// 2.1e9: half a uint32, with the other half as headroom.
+
+@piece( DeclVoxelMerge )
+
+#define VOXEL_MERGE_SCALE 4096.0f
+#define VOXEL_MERGE_CLAMP 16.0f
+
+	/// ONE VOXEL'S SIXTEEN ACCUMULATOR TEXELS ARE ADJACENT IN Z, four per
+	/// quantity: albedo sum at z*16+0..3, RAW normal sum at +4..7 (two's
+	/// complement), emissive sum at +8..11, FOLDED normal sum at +12..15.
+	/// Interleaved rather than stacked planes so the shader needs no knowledge of
+	/// the volume's depth (a voxelisation dispatch covers one OCTANT and does not
+	/// know it), and so a voxel's sixteen texels share a cache line's worth of
+	/// the 3D swizzle.
+	///
+	/// R32_UINT AND NOT RGBA32_UINT, WHICH WOULD BE A QUARTER OF THE TEXELS:
+	/// `clearVoxels` clears this texture every build through
+	/// `ComputeTools::clearUavUint`, and clearing a PFG_RGBA32_UINT 3D uav that
+	/// way HANGS THIS DRIVER — VK_ERROR_DEVICE_LOST with `NVRM: Xid 109 CTX
+	/// SWITCH TIMEOUT`, 8 runs out of 8 on `samples.cleanstart.Showroom{,_2}`
+	/// (NVIDIA 595.84) and 0 out of 4 with that one call removed, everything else
+	/// identical. R32_UINT clears without complaint. Recorded as an upstream /
+	/// driver finding; the cost is the scattered access this layout implies.
+	INLINE uint3 voxelMergeUvw( uint3 voxelCel, uint chan )
+	{
+		return uint3( voxelCel.x, voxelCel.y, voxelCel.z * 16u + chan );
+	}
+
+	/// THE TWO NORMAL SUMS, AND WHY THERE ARE TWO.
+	///
+	/// Upstream decided "this voxel holds surfaces facing opposite ways" WHILE
+	/// summing: it compared each triangle's normal against the sum SO FAR, and if
+	/// the angle exceeded 120 degrees it set the double-sided flag and dropped
+	/// that triangle from the sum. That is first-one-wins — the answer depends on
+	/// which triangle the thread reached first, which is the instance order in
+	/// the dispatch, which is the attach order. It is the LAST order dependence
+	/// in the voxelisation once the merge itself is exact, and it is worth 6/255
+	/// on gi.cascade_determinism's room.
+	///
+	/// So the decision moves to the resolve pass, where it is made from two sums
+	/// that do not care about order: the RAW sum of every normal, and the sum of
+	/// every normal FOLDED into one half-space. `voxelMergeCanonical` folds by
+	/// the sign of the normal's largest component, which is arbitrary but has the
+	/// one property the test needs — ANTIPODAL NORMALS ALWAYS FOLD TOGETHER, since
+	/// sign(-n) = -sign(n). Two surfaces facing opposite ways therefore cancel in
+	/// the raw sum and reinforce in the folded one.
+	///
+	/// AND THE TWO SUMS GIVE BACK THE TWO GROUPS. Folded = U - F and raw = U + F,
+	/// where U is the sum of the normals the fold left alone and F the sum, in
+	/// their ORIGINAL directions, of the ones it turned round — so
+	/// U = (raw + folded)/2 and F = (raw - folded)/2, both exact. The voxel's
+	/// normal is the LARGER of the two, which is the majority group's mean, which
+	/// is what the pin stored (it dropped the opposing triangles from the sum and
+	/// divided by the whole count); the double-sided flag is "the other group is
+	/// not empty", which is what the pin's exclusion meant. No threshold, no
+	/// epsilon: both tests are integer comparisons of the two sums.
+	///
+	/// The one place this is NOT the pin's answer: upstream dropped a triangle at
+	/// more than 120 degrees from the RUNNING sum, while the fold separates at 90,
+	/// so a voxel whose normals span 90 to 120 degrees is two groups here and one
+	/// there. Measured on gi.field_follows' sub-voxel walls that is worth under
+	/// 3 % of the far bounce — the price of not asking the question one triangle
+	/// at a time, and of the answer no longer depending on which triangle a thread
+	/// reached first.
+	INLINE float3 voxelMergeCanonical( float3 n )
+	{
+		float3 a = abs( n );
+		float s = (a.x >= a.y && a.x >= a.z) ? n.x : ((a.y >= a.z) ? n.y : n.z);
+		return s < 0.0f ? -n : n;
+	}
+
+	/// A contribution in [0, VOXEL_MERGE_CLAMP], on the grid, rounded to nearest.
+	INLINE uint4 voxelMergeQuantize4( float4 v )
+	{
+		return uint4( clamp( v, 0.0f, VOXEL_MERGE_CLAMP ) * VOXEL_MERGE_SCALE + 0.5f );
+	}
+	INLINE uint3 voxelMergeQuantize3( float3 v )
+	{
+		return uint3( clamp( v, 0.0f, VOXEL_MERGE_CLAMP ) * VOXEL_MERGE_SCALE + 0.5f );
+	}
+	/// A unit vector's component, on the same grid, as two's complement. `floor`
+	/// and not a cast: a cast truncates towards zero and would round -0.5 the
+	/// wrong way.
+	INLINE int3 voxelMergeQuantizeSigned3( float3 v )
+	{
+		return int3( floor( clamp( v, -1.0f, 1.0f ) * VOXEL_MERGE_SCALE + 0.5f ) );
+	}
+
+
+	/// THE MEAN, FROM THE SUMS. Every dispatch that adds anything to a voxel
+	/// writes this afterwards, from the TOTAL the accumulator then holds — so
+	/// whichever dispatch happens to be last leaves the complete answer, and an
+	/// earlier one's partial answer is always overwritten by it. That is why the
+	/// resolve rides the voxelisation instead of being a pass of its own: the
+	/// value written does not depend on WHO writes it, only on the sums, and the
+	/// sums are exact.
+	INLINE float4 voxelMergeAlbedo( uint4 sumAlbedo, float invAccum )
+	{
+		return float4( sumAlbedo ) * invAccum;
+	}
+	INLINE float4 voxelMergeNormal( uint4 sumNormal, uint4 sumFolded, float invAccum )
+	{
+		// THE TWO GROUPS, RECOVERED. Write the folded sum as U - F and the raw one
+		// as U + F, where U is the sum of the normals the fold left alone and F
+		// the sum, IN THEIR ORIGINAL DIRECTIONS, of the ones it turned round: then
+		// U = (raw + folded)/2 and F = (raw - folded)/2, both exact. The voxel's
+		// normal is the LARGER of the two — the majority group's mean, which is
+		// what the pin stored after it dropped the opposing triangles and divided
+		// by the whole count — and it is double-sided when the OTHER group is not
+		// empty, which is what the pin's exclusion meant.
+		//
+		// Taking the larger and not U is load-bearing: a voxel whose normals ALL
+		// lie in the half-space the fold turns round (a wall facing -X, say) has
+		// U = 0, and storing that would leave it black. Measured: it costs
+		// gi.leak_room four assertions.
+		//
+		// Both emptiness tests are on the INTEGER sums, so they are exact and a
+		// minority of one triangle in sixty thousand still counts.
+		int3 iRaw	= int3( sumNormal.xyz );
+		int3 iFolded	= int3( sumFolded.xyz );
+		int3 iU		= iRaw + iFolded;
+		int3 iF		= iRaw - iFolded;
+		bool emptyU	= ( iU.x == 0 ) && ( iU.y == 0 ) && ( iU.z == 0 );
+		bool emptyF	= ( iF.x == 0 ) && ( iF.y == 0 ) && ( iF.z == 0 );
+		bool doubleSided = !emptyU && !emptyF;
+
+		float3 nU = float3( iU ) * ( 0.5f * invAccum );
+		float3 nF = float3( iF ) * ( 0.5f * invAccum );
+		float3 normalOut = dot( nU, nU ) >= dot( nF, nF ) ? nU : nF;
+
+		// Stored unnormalized and biased, exactly as before, so the injection's
+		// `xyz * 2 - 1` keeps meaning what it meant; .a is the double-sided flag
+		// it reads to pick abs(NdotL) over saturate(NdotL).
+		return float4( normalOut * 0.5f + 0.5f, doubleSided ? 1.0f : 0.0f );
+	}
+	INLINE float4 voxelMergeEmissive( uint4 sumEmissive, float invAccum )
+	{
+		return float4( float3( sumEmissive.xyz ) * invAccum, 0.0f );
+	}
+
+@end
