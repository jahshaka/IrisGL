         pimpl->mProgressHandler->UpdateFileRead( fileSize, fileSize );
 
+        // A PROGRESS HANDLER THAT ANSWERS false CANCELS THE IMPORT (the contract
+        // ProgressHandler::Update documents): checked once the format's read is
+        // done, before any post-processing. The partial scene is freed.
+        bool cancelled = false;
+        if (pimpl->mScene && !pimpl->mProgressHandler->Update(-1.f)) {
+            delete pimpl->mScene;
+            pimpl->mScene = nullptr;
+            pimpl->mErrorString = "import cancelled by the progress handler (after the read)";
+            ASSIMP_LOG_WARN(pimpl->mErrorString);
+            cancelled = true;
+        }
+
         if (profiler) {
             profiler->EndRegion("import");
         }
