#include "/media/matias/Datos/SyntaxHighlightingMisc.h"

// GATHER-0 — THE SCREEN-PROBE GATHER'S PIXEL SIDE (phase 0, 2026-09-21).
//
// ONE TEXEL FETCH, at the diffuse-GI slot of the PBS pixel shader. The compute
// pair in irisgl/engine/src/rayquery/ has already written this pixel's block
// probe into `jahProbeIrradiance`; what arrives here is the MEAN RADIANCE over
// the cosine-weighted hemisphere, which is exactly what `envColourD` is (the
// BRDF multiplies it by kD and by pi, 200.BRDFs_piece_ps.any:305). So the
// whole pixel side is an add, and the weight is the probe's own coverage: 1
// where a probe answered, 0 where none did — and where none did the pixel
// keeps whatever the irradiance field or the cones already gave it, which is
// the fallback rule of the spec's section 2 item 8 in its simplest form.
//
// WHY THIS PIECE IS `applyIrradianceVolumes`. It is upstream's own insertion
// point immediately after the environment cubemaps and before the ambient
// composite — inside the lighting body, after `envColourD` is zeroed, where
// every other diffuse-GI source adds itself — and it is EMPTY in this engine,
// because nothing here ever binds an Ogre IrradianceVolume (the piece is
// defined only under the `irradiance_volumes` property, which is never set).
// Taking it costs no patch. It is also a SPIKE'S shape and not a shipping one:
// phase 2 puts the read where the spec says, behind the cage-guard hook of
// patch 0085, and this piece goes away with the rest of the spike.
//
// THE GUARD IS FOUR TERMS AND EVERY ONE OF THEM EARNS ITS PLACE: the pass
// property (set by FogHlmsListener::preparePassHash only while a scene has
// the spike armed), not a prepass (the lighting body does not exist there and
// the register is not claimed), not a shadow caster (same), and not an Ogre
// irradiance volume (a second definition of one piece is a parse error, and
// this file must not be the one that finds out).

@property( jah_probe_gather && !hlms_prepass && !hlms_shadowcaster && !irradiance_volumes )
@piece( applyIrradianceVolumes )
	float4 jahProbeGathered = OGRE_Load2D( jahProbeIrradiance, iFragCoord, 0 ).xyzw;
	pixelData.envColourD += midf3_c( jahProbeGathered.xyz ) * midf_c( jahProbeGathered.w );
@end
@end
