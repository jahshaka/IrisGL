#include "/media/matias/Datos/SyntaxHighlightingMisc.h"

// GATHER-0 — THE SCREEN-PROBE GATHER'S PIXEL SIDE (phase 0, 2026-09-21).
//
// ONE TEXEL FETCH, at the diffuse-GI slot of the PBS pixel shader. The compute
// pair in irisgl/engine/src/rayquery/ has already written this pixel's block
// probe into `jahProbeIrradiance`; what arrives here is the MEAN RADIANCE over
// the cosine-weighted hemisphere, which is exactly what `envColourD` is (the
// BRDF multiplies it by kD and by pi, 200.BRDFs_piece_ps.any:305). So the
// whole pixel side is an add, and the weight is the texel's own coverage - 1
// at every pixel since PHOTON-7 7-2: the integrate composes the irradiance
// field (and the field's own environment fallback) where no probe answered,
// after its temporal mean, so the texture IS the pixel's diffuse GI.
//
// WHY THIS PIECE IS `applyIrradianceVolumes`. It is upstream's own insertion
// point immediately after the environment cubemaps and before the ambient
// composite — inside the lighting body, after `envColourD` is zeroed, where
// every other diffuse-GI source adds itself — and it is EMPTY in this engine,
// because nothing here ever binds an Ogre IrradianceVolume (the piece is
// defined only under the `irradiance_volumes` property, which is never set).
// Taking it costs no patch. The read itself is final since phase 2
// (PHOTON-GATHER-1b): the integrate writes E/pi at the pixel's normal, and the
// pass that reads it binds no world cache (PHOTON-7 7-5): no cone, no field
// cage. A blended fragment never reads it: the chain draws the blended queues in
// their own pass after the opaque one ("Jahshaka blended", OgreChain.cpp), with
// the world caches the refractives pass reads.
//
// THE GUARD IS SIX TERMS AND EVERY ONE OF THEM EARNS ITS PLACE, two of them
// because a missing one does not draw the wrong picture, it LOSES THE FRAME
// (fix round, D2):
//
//   jah_probe_gather      the pass property, set by
//                         FogHlmsListener::preparePassHash only while a scene
//                         has the spike armed and only for the pass the
//                         gather was recorded in front of.
//   hlms_screen_pos_int   IS THE ONE THAT DECIDES WHETHER `iFragCoord` EXISTS.
//                         The pin sets it for a PrePassUse pass and for a
//                         refractions pass and for nothing else
//                         (OgreHlms.cpp), so a probe capture, a planar arm or
//                         a plain forward pass that somehow reached this
//                         property would fail to COMPILE on an undeclared
//                         identifier and take its frame with it.
//   needs_env_brdf        ...and this one decides whether `envColourD`
//                         exists at all: upstream declares and zeroes it
//                         under that property alone
//                         (800.PixelShader_piece_ps.any).
//   !hlms_prepass         the lighting body does not exist there and the
//                         texture register is not claimed.
//   !hlms_shadowcaster    same.
//   !irradiance_volumes   a second definition of one piece is a parse error,
//                         and this file must not be the one that finds out.
//
// THE ACCOUNTING RULE (PHOTON-GATHER-1d; PHOTON-7 7-2 and 7-5). A pixel gets
// exactly ONE diffuse-GI term, the gather's, here: its texel holds the probes'
// answer, or the irradiance field's where no probe answered (composed in the
// integrate), and the pass binds neither the cones nor the field, and compiles
// upstream's ambient out (below).

@property( jah_probe_gather && hlms_screen_pos_int && needs_env_brdf && !hlms_prepass && !hlms_shadowcaster && !irradiance_volumes )
@piece( applyIrradianceVolumes )
	float4 jahProbeGathered = OGRE_LoadScreen2D( jahProbeIrradiance, iFragCoord, 0 ).xyzw;
	pixelData.envColourD += midf3_c( jahProbeGathered.xyz ) * midf_c( jahProbeGathered.w );
	@property( jah_rough_spec )
		// THE ROUGH SPECULAR (PHOTON-7 stage 7, 7-3): the radiance along this pixel's GGX lobe read from the probes'
		// prefiltered maps, handed over to E/pi by the roughness (rq_probe_integrate.comp), at its GATE's share (w: 0
		// where the view's traced reflection owns the lobe). The pass binds no cone (7-5); the material's cube takes
		// the gate's complement below; the fork's SSR composite after both hands the reflection's confidence over.
		float4 jahRoughSpecTexel = OGRE_LoadScreen2D( jahRoughSpec, iFragCoord, 0 ).xyzw;
		pixelData.envColourS += midf3_c( jahRoughSpecTexel.xyz ) * midf_c( jahRoughSpecTexel.w );
	@end
@end
@end

// THE SKY ARRIVES ONCE (PHOTON-7 stage 7, 7-3). Where the probes' lobe is the environment term, their escaping rays
// already carried the sky into it (rq_probe_gather.comp reads the environment on a miss, occluded where the scene stops
// it), so HlmsPbs's CubemapGlobal - the material's cube sampled along the lobe with nothing in the way - lights only the
// gate's complement: the share the traced reflection owns, whose own warm-up hands over to the cube as before. Its hook
// (jahGlobalEnvVisibility, empty wherever no GI piece defines it; the cone's own definition needs the cone, which this
// pass does not bind) under the same six terms as the read above.
@property( jah_rough_spec && jah_probe_gather && hlms_screen_pos_int && needs_env_brdf && !hlms_prepass && !hlms_shadowcaster && !irradiance_volumes )
	@piece( jahGlobalEnvVisibility )* midf_c( 1.0f - jahRoughSpecTexel.w )@end
@end

// THE AMBIENT IS NOT A SECOND DIFFUSE (PHOTON-7 stage 7, 7-5; PREFLIGHT_7 E8). Upstream's ambient (DoAmbientLighting: the
// sky's SH at the normal, AmbientLighting_piece_ps.any) has ONE gate on a Photon pass - "outside every voxel volume",
// vctSpecular.w == 0 - and the bound cone closes it everywhere (computeVctProbe writes the coverage w = 1 with or without
// its specular). A pass that reads the gather binds no world cache (7-5: the gather is its diffuse, the integrate composes
// the field and the field's own environment fallback where no probe answered, 7-2), so the gate is gone with the cone and
// the SH would add the sky's irradiance, unoccluded, on top of the gather that already carries it (its rays escape to the
// sky). On a pass that reads the gather the piece is compiled out whole: one diffuse term a pixel.
@property( jah_probe_gather && hlms_screen_pos_int && needs_env_brdf && !hlms_prepass && !hlms_shadowcaster && !irradiance_volumes )
	@undefpiece( DoAmbientLighting )
@end

// F2's SECOND HALF (PHOTON-GATHER-1d): A BLENDED FRAGMENT IS NOT PART OF THE
// G-BUFFER. The depth/normal prepass draws the same render-queue range as the
// shading pass (OgreChain.cpp: the shading pass depth-tests read-only against
// what the prepass wrote), so a Fade/Glass renderable used to write ITS depth,
// normal and shadow into the prepass — blended over the opaque surface's — and
// the opaque surface behind it then failed its read-only depth test or read the
// blend: measured on gi.gather_glass's F2 arm, a Fade slab 7.6/255 dark after the
// listener's per-renderable withdrawal (31.9 before either half). The prepass
// holds OPAQUE surfaces only: a blended fragment writes nothing there. The
// discard is the LAST statement (the helper-lane rule: every load before it runs
// either way, and none of them reads a device address).
// NOT IN A CARD CAPTURE (PHOTON-GATHER-1d fix round): the capture's own piece
// (JahCardCapture_piece_ps.any) fills the same hook in a prepass, and two
// definitions of one piece are a compile error, a black frame. Cards hold
// opaque surfaces only (OgreScene's candidate walk drops a blended item), so
// the guard is never the one that decides; it keeps the pieces disjoint.
@property( hlms_prepass && hlms_alphablend && !hlms_shadowcaster && !jah_card_capture )
@piece( custom_ps_posExecution )
	discard;
@end
@end
