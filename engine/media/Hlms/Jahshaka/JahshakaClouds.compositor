// THE CLOUD FIELD BAKE (CLOUDS-2D-1; four passes since CLOUDS-2D-3 -- the
// shape and why, JahCloudBake_ps.glsl): run by hand on a change of the layer's
// coverage, density or weather map (OgreScene::bakeCloudField) -- never per
// frame. The footprint and its blur live on a 512^2 grid over the tile (125 m a
// texel, local to this node: a bake's workspace is created and removed around
// the one render); the field is 2048^2. The field's mip chain is generated by
// the host right after (the layer reads the field towards the horizon).
//
// external 0 = the field (R16F, RenderToTexture + AllowAutomipmaps)

compositor_node JahshakaCloudBakeNode
{
	in 0 cloudField

	texture cloudFootprint 512 512 PFG_R16_FLOAT
	texture cloudBlurX 512 512 PFG_R16_FLOAT
	texture cloudBlurred 512 512 PFG_R16_FLOAT

	target cloudFootprint
	{
		pass render_quad
		{
			load
			{
				all	dont_care
			}
			material Jahshaka/CloudShape
			profiling_id "Jahshaka cloud footprint"
		}
	}
	target cloudBlurX
	{
		pass render_quad
		{
			load
			{
				all	dont_care
			}
			material Jahshaka/CloudBlurH
			input 0 cloudFootprint
			profiling_id "Jahshaka cloud blur x"
		}
	}
	target cloudBlurred
	{
		pass render_quad
		{
			load
			{
				all	dont_care
			}
			material Jahshaka/CloudBlurV
			input 0 cloudBlurX
			profiling_id "Jahshaka cloud blur y"
		}
	}
	target cloudField
	{
		pass render_quad
		{
			load
			{
				all	dont_care
			}
			material Jahshaka/CloudBake
			input 0 cloudBlurred
			profiling_id "Jahshaka cloud field bake"
		}
	}
}

workspace JahshakaCloudBakeWorkspace
{
	connect_external 0 JahshakaCloudBakeNode 0
}
