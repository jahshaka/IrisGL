// Jahshaka linear distance fog — parity with the legacy IrisGL forward renderer
// (irisgl/assets/shaders/pbr_material.frag:397-401):
//     zDist      = length(v_worldPos - u_eyePos)
//     fogFactor  = clamp((zDist - start) / (end - start), 0, 1)
//     finalColor = mix(finalColor, fogColor, fogFactor)
//
// Attached per-datablock with setCustomPieceFile() by OgreEngine — every lit PBS
// material gets it; Unlit (gizmos, wires, billboards) and the low-level sky
// material do not, so they stay unfogged, exactly like legacy.
//
// The pass-buffer members below are inserted at the END of the PassData struct
// (500.Structs_piece_vs_piece_ps.any @insertpiece(custom_passBuffer)); the values
// are appended to the end of the pass buffer by FogHlmsListener in OgreEngine.cpp
// — the two layouts line up by construction. The listener ALWAYS appends the two
// float4s (even with fog off): the shader branches on jahFogColour.w, so toggling
// fog needs no shader recompile and no Hlms cache invalidation.
//
// Shadow-caster shaders share this insertion point but not the lit pass buffer,
// hence the guard.
@property( !hlms_shadowcaster )

@piece( custom_passBuffer )
	float4 jahFogColour;	// rgb = fog colour (linear), w = enabled (0.0 / 1.0)
	float4 jahFogParams;	// x = start, y = end, z = 1/(end-start), w unused
@end

@end

// The fog EXECUTION needs `outPs_colour0`, which is #defined to `outColour`
// (Hlms/Common/GLSL/CrossPlatformSettings_piece_all.glsl) — and `outColour` is
// only DECLARED when !hlms_render_depth_only && !hlms_shadowcaster &&
// !hlms_prepass (Hlms/Pbs/GLSL/PixelShader_ps.glsl:10-25). A depth/normal
// prepass shader (POST_CHAIN_SPEC.md §4.3 item 3 — the SSR shape) would
// therefore reference an undeclared output and throw out of renderOneFrame:
// JAH_TRY swallows it, and the frame goes black with one line in the log.
// Guarding here rather than later keeps the SSR phase from re-learning it.
@property( !hlms_shadowcaster && !hlms_prepass && !hlms_render_depth_only )

@piece( custom_ps_posExecution )
	if( passBuf.jahFogColour.w > 0.5 )
	{
		// inPs.pos is the view-space position: its length is the eye distance,
		// the same metric as legacy's length(v_worldPos - u_eyePos).
		float jahZDist     = length( inPs.pos.xyz );
		float jahFogFactor = clamp( ( jahZDist - passBuf.jahFogParams.x ) *
									passBuf.jahFogParams.z, 0.0, 1.0 );
		outPs_colour0.xyz = lerp( outPs_colour0.xyz,
								  midf3_c( passBuf.jahFogColour.xyz ),
								  midf_c( jahFogFactor ) );
	}
@end

@end

// Jahshaka UV tiling — the document's PbrMaterial::textureScale. HlmsPbs has no
// UV transform for its base maps (detail maps alone get offset/scale), so this
// redefines Ogre's official UV-modifier macros (UvModifierMacros_piece_ps.any,
// inserted at the top of every Pbs pixel shader) to multiply each base-map
// lookup by the per-datablock user value that OgreScene::applyPbr writes with
// setUserValue(0, ...). userValue lives in the material buffer: scale edits are
// const-buffer updates, never shader rebuilds. Deliberately OUTSIDE the
// !hlms_shadowcaster guard above: alpha-tested (Cutout) caster shaders sample
// the diffuse map through UV_DIFFUSE with `material` in scope too, and must see
// the same tiling as the colour pass or shadows detach from the silhouette.
// UV_SPECULAR covers the metalness map (metallic workflow rides the specular
// texture slot). No AO macro exists — HlmsPbs has no AO input (see Types.h).
@piece( custom_ps_uv_modifier_macros )
	#undef UV_DIFFUSE
	#undef UV_NORMAL
	#undef UV_SPECULAR
	#undef UV_ROUGHNESS
	#undef UV_EMISSIVE
	#define UV_DIFFUSE(x) ((x) * material.userValue[0].xy)
	#define UV_NORMAL(x) ((x) * material.userValue[0].xy)
	#define UV_SPECULAR(x) ((x) * material.userValue[0].xy)
	#define UV_ROUGHNESS(x) ((x) * material.userValue[0].xy)
	#define UV_EMISSIVE(x) ((x) * material.userValue[0].xy)
@end
