#include "/media/matias/Datos/SyntaxHighlightingMisc.h"

// THE NO-RAY ROUTE'S SPECULAR, FROM THE SCREEN (PHOTON-7 stage 7, 7-6; L4 on every chain; the roughness split since
// stage 10-3).
//
// On a chain that does not gather (no ray device, the project's ray row off, a Live or undeclared offscreen view) the
// opaque passes bind no voxel volume: the screen integrate (Jahshaka/ScreenIntegrate, JahScreenIntegrate_cs.glsl)
// gathered each pixel's light from the prepass and wrote the SAME screen products a gathering chain reads - the diffuse
// into jahProbeIrradiance (read by JahProbeGather_piece_ps.any's diffuse read, as on a gathering chain) and the
// SPECULAR into jahRoughSpec (rgb: the lobe's light from what stopped it - the K(alpha) rays' hits, the field along R for
// the widest lobes; w: the lobe's open share, the rays' escapes) beside jahConeHit (the rays' mean hit distance along
// the reflection, metres). This file rebuilds from them, in the pixel, the three things the voxel route hands the rest of
// the shader on the voxel route (PhotonVct_piece_ps.any's computeVctProbe):
//   vctSpecular   the stopped share's light plus the environment's open share at the surface's own roughness (zero for a
//                 material whose own cube lights the unoccluded share, CubemapGlobal - the voxel route's rule), and the
//                 coverage 1 (the voxel route's blend is one everywhere);
//   vctRoughOcclusion  the lobe's stopped share, 1 - w at every lobe - the cube's visibility hook below;
//   vctSpecPosVS  the rays' hit, back along the pixel's reflection - the parallax-corrected probes' hybrid weight
//                 (the fork's forwardPlusDoCubemaps, under the pass property jah_screen_cone, runs UNCHANGED).
// The pass property jah_screen_cone is set by the Hlms listener with the screen products' registration (OgreFog.cpp);
// the guard is the gather read's six terms (JahProbeGather_piece_ps.any says why each).
// No at-sign in any comment of this file (the Hlms parser reads them).

@property( jah_screen_cone && jah_rough_spec && jah_cone_hit && jah_probe_gather && hlms_screen_pos_int && needs_env_brdf && !hlms_prepass && !hlms_shadowcaster && !irradiance_volumes )

// The hybrid's weight before the declarations (a pure function, where the voxel route's DeclVctFuncs puts it); the
// environment's binding AFTER them (it reads the pass's jahEnvCube), where the voxel route's DeclVctTextures puts it.
@piece( DeclVctFuncs )
	@insertpiece( JahPccVctBlendFunc )
@end
@piece( DeclVctTextures )
	@insertpiece( JahPhotonEnvBinding )
@end

@piece( applyVoxelConeTracing )
	float4 jahConeTexel = OGRE_LoadScreen2D( jahRoughSpec, iFragCoord, 0 ).xyzw;
	@property( use_parallax_correct_cubemaps )
		// the rays' hit, back along this pixel's reflection (view space, metres)
		float3 vctSpecPosVS = inPs.pos + float3( pixelData.reflDir ) * OGRE_LoadScreen2D( jahConeHit, iFragCoord, 0 ).x;
	@end
	// THE FOOTPRINT'S ROUGHNESS (PHOTON-7 stage 7's read, F4): the fork's geometric specular anti-aliasing widens a
	// normal-mapped surface's alpha (pixelData.roughness) and the G-buffer carries the widened one - the integrate
	// decides its lobe from it, so this read decides from the same value, never the material's unwidened one
	@property( perceptual_roughness )
		const float jahFootprintRoughness = sqrt( float( pixelData.roughness ) );
	@else
		const float jahFootprintRoughness = float( pixelData.roughness );
	@end
	// THE LOBE'S STOPPED SHARE, AT EVERY LOBE (stage 10-3's split): what the rays met (or the field answered) is not
	// open to the global cube - the cube lights only the share no geometry stopped. The rough-lobe-only rule let the
	// captured sky's cube light a narrow lobe through a wall (the sealed box's cube case: 199 % of the roof's light).
	const float vctRoughOcclusion = 1.0f - jahConeTexel.w;
	@property( use_envprobe_map && !use_parallax_correct_cubemaps )
		const float3 jahEnvS = float3( 0.0f, 0.0f, 0.0f );
	@else
		// the escape's share: the prefiltered lobe along its dominant direction, weighted by the share the voxels did
		// not stop (the voxel route's jahEnvS exactly)
		const float3 jahEnvS = jahEnvLobe( jahViewToWorldDir( jahEnvDominantDir(
											   float3( pixelData.normal ), float3( pixelData.reflDir ),
											   jahFootprintRoughness * jahFootprintRoughness ) ),
										   jahFootprintRoughness ) * jahConeTexel.w;
	@end
	float4 vctSpecular = float4( jahConeTexel.xyz + jahEnvS, 1.0f );
	pixelData.envColourS.xyz += midf3_c( vctSpecular.xyz );
@end

// THE CUBE LIGHTS ONLY WHAT THE ROUGH LOBE LET THROUGH (the voxel route's hook, PhotonVct_piece_ps.any)
@piece( jahGlobalEnvVisibility )* midf_c( 1.0f - vctRoughOcclusion )@end

@end
