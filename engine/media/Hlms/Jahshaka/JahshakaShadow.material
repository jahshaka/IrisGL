// The per-map shadow-atlas clear quads (SPECS/SHADOW_TOOLING_SPEC.md §4.3).
// Two variants of one shader: the render system decides which one the shadow
// node's clear passes name (OgreShadow.cpp, shadowClearMaterialName()).
//
// GLSL + Vulkan only, like Jahshaka/Ssr* beside this file: those are the two
// syntaxes this engine ever builds (macOS runs Vulkan through MoltenVK, not
// the Metal render system).

fragment_program Jahshaka/ShadowMapClear_ps_GLSL glsl
{
	source JahShadowClear_ps.glsl
}
fragment_program Jahshaka/ShadowMapClear_ps_VK glslvk
{
	source JahShadowClear_ps.glsl
}
fragment_program Jahshaka/ShadowMapClear_ps unified
{
	delegate Jahshaka/ShadowMapClear_ps_GLSL
	delegate Jahshaka/ShadowMapClear_ps_VK
}

fragment_program Jahshaka/ShadowMapClearRev_ps_GLSL glsl : Jahshaka/ShadowMapClear_ps_GLSL
{
	preprocessor_defines REVERSE_DEPTH=1
}
fragment_program Jahshaka/ShadowMapClearRev_ps_VK glslvk : Jahshaka/ShadowMapClear_ps_VK
{
	preprocessor_defines REVERSE_DEPTH=1
}
fragment_program Jahshaka/ShadowMapClearRev_ps unified
{
	delegate Jahshaka/ShadowMapClearRev_ps_GLSL
	delegate Jahshaka/ShadowMapClearRev_ps_VK
}

// Depth writes on, depth test always passing, no colour output at all: the
// shadow atlas is a depth-only target (PFG_D32_FLOAT with an explicit RTV), so
// a pass that wrote colour would not match the render pass. This is exactly the
// shape of Ogre/DPSM/CubeToDpsm, which writes this same atlas.
material Jahshaka/ShadowMapClear
{
	technique
	{
		pass
		{
			depth_check on
			depth_write on
			depth_func always_pass
			cull_hardware none

			vertex_program_ref Ogre/Compositor/Quad_vs
			{
			}

			fragment_program_ref Jahshaka/ShadowMapClear_ps
			{
			}
		}
	}
}

material Jahshaka/ShadowMapClearRev
{
	technique
	{
		pass
		{
			depth_check on
			depth_write on
			depth_func always_pass
			cull_hardware none

			vertex_program_ref Ogre/Compositor/Quad_vs
			{
			}

			fragment_program_ref Jahshaka/ShadowMapClearRev_ps
			{
			}
		}
	}
}

// THE KEPT DEPTH'S SEED (PHOTON-7 stage 10-3, R0; OgreChain.cpp addAtomDecodePass): the far depth written by ONE draw in
// a target's first frame, so a depth the next pass loads read-only has been written by a draw (a new D32 written only by
// a render-pass clear and then loaded read-only reset the 3D engine on driver 595.x). The clear's own value, and only
// where the depth still holds it (depth_func equal: a texel the classify pass drew keeps its depth); no colour.
material Jahshaka/DepthSeed
{
	technique
	{
		pass
		{
			depth_check on
			depth_write on
			depth_func equal
			cull_hardware none
			colour_write off

			vertex_program_ref Ogre/Compositor/Quad_vs
			{
			}

			fragment_program_ref Jahshaka/ShadowMapClear_ps
			{
			}
		}
	}
}

material Jahshaka/DepthSeedRev
{
	technique
	{
		pass
		{
			depth_check on
			depth_write on
			depth_func equal
			cull_hardware none
			colour_write off

			vertex_program_ref Ogre/Compositor/Quad_vs
			{
			}

			fragment_program_ref Jahshaka/ShadowMapClearRev_ps
			{
			}
		}
	}
}

// THE TRANSMITTANCE LAYER's PER-MAP CLEAR (PHOTON-7 10-4 R8): atlasT's map rectangle to 1, colour only - the depth atlas
// is bound read-only beside it (OgreShadow.cpp's atlasTRtv).
fragment_program Jahshaka/ShadowTransmitClear_ps_GLSL glsl
{
	source JahShadowTransmitClear_ps.glsl
}
fragment_program Jahshaka/ShadowTransmitClear_ps_VK glslvk
{
	source JahShadowTransmitClear_ps.glsl
}
fragment_program Jahshaka/ShadowTransmitClear_ps unified
{
	delegate Jahshaka/ShadowTransmitClear_ps_GLSL
	delegate Jahshaka/ShadowTransmitClear_ps_VK
}
material Jahshaka/ShadowTransmitClear
{
	technique
	{
		pass
		{
			depth_check off
			depth_write off
			cull_hardware none

			vertex_program_ref Ogre/Compositor/Quad_vs
			{
			}

			fragment_program_ref Jahshaka/ShadowTransmitClear_ps
			{
			}
		}
	}
}
