// THE LEVEL RULE'S SCALE, ONE DEFINITION for every compute job that picks a mesh
// level on the device (the GPU cull, the voxel gather). Its C++ twin is
// jahshaka::engine::worldMaxAxisScale in Types.h, and engine.lod_rule_parity holds
// the two together.
//
// THE LONGEST COLUMN, NOT THE LONGEST ROW. The GPU scene stores the world transform
// as a ROW-MAJOR 3x4, M = T R S, whose COLUMN j is R times the j-th axis times s_j:
// its length is exactly s_j, the scale along the mesh's own axis j. A ROW mixes the
// three scales through the rotation, and under rotation times non-uniform scale its
// length is smaller than the largest s_j - the level rule then divides by too small a
// scale and picks a coarser level than the tolerance permits.
@piece( JahLevelRuleScale )
	float jahWorldMaxAxisScale( vec4 r0, vec4 r1, vec4 r2 )
	{
		return max( max( length( vec3( r0.x, r1.x, r2.x ) ),
						 length( vec3( r0.y, r1.y, r2.y ) ) ),
					length( vec3( r0.z, r1.z, r2.z ) ) );
	}
@end

// THE QUALITY CURRENCY, GLSL half — ONE DEFINITION for every compute job that
// spends it (the GPU cull, the voxel gather, and the cluster cut's piece
// JahClusterCut.glsl). Its C++ twin is sampleFootprintPerspective + allowedWorldError
// in Types.h; engine.lod_rule_parity holds the two together.
//
// One sample's world footprint at `d` metres of a perspective view...
@piece( JahLevelRuleCurrency )
	float jahSampleFootprint( float d, float projScaleY, float viewportHeight )
	{
		if( projScaleY <= 0.0 || viewportHeight <= 0.0 )
			return 0.0;
		return d * 2.0 / ( projScaleY * viewportHeight );
	}

	// ...and what a consumer may afford of it, in the units the BAKED bounds are
	// measured in (the mesh's own, hence the divide by the instance's scale).
	float jahAllowedWorldError( float tolerance, float footprint, float meshToWorldScale )
	{
		if( tolerance <= 0.0 || footprint <= 0.0 || meshToWorldScale <= 0.0 )
			return 0.0;
		return tolerance * footprint / meshToWorldScale;
	}
@end
