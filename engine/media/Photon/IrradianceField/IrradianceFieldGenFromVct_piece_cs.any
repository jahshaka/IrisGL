
//#include "SyntaxHighlightingMisc.h"

@piece( HeaderCS )
	CONST_BUFFER_STRUCT_BEGIN( IrradianceFieldGenParams, 0 )
	{
		// Jahshaka (PHOTON-FIELD-ROTATE-1): one float4 of scalars (groups per
		// dispatch row, the environment's bin cone, the work's first position, a pad),
		// then the probe counts (w unused).
		uint probesPerRow;
		float coneAngleTan;
		uint numProcessedProbes;
		uint padding0;

		uint4 numProbes;

		// Jahshaka (PHOTON-WRITER-1): the work's boxes and the window's offset
		// (IrradianceField::scrollWindow; jah_field_window.glsl says what they mean).
		uint4 boxLo[3];
		uint4 boxSize[3];
		uint4 windowOffset;

		float4x4 irrProbeToVctTransform;

		// Jahshaka (PHOTON-READER-1): the cascade chain, as VctLighting's one
		// definition writes it (getCascadeChainParams) - sized by
		// IrradianceField::kMaxChainCascades = 8.
		float4 vctInvResMaxLod[8];
		float4 vctFromPrev[14];

		// Jahshaka (PHOTON-ENV-1): THE ONE ENVIRONMENT an escaping probe ray sees,
		// as radiance, the store's own units (PHOTON-7 stage 1): rgb = the
		// environment light's gain on the cube,
		// w = the cube's mip count; and its nine-band SH, world axes.
		float4 envGainMips;
		float4 envSh[9];

		// Jahshaka (PHOTON-FIELD-ROTATE-1): the world lattice coordinate of the
		// window's first probe (xyz, two's complement; w unused), and the history rule: x = the
		// mode (IrradianceField::IntegrationMode, as the job properties ifd_mode_fresh / _change / _refine / _invalidate), y = the target sample
		// count, z = the samples a change keeps, w = 1 to rotate the rays
		// (IrradianceField::update).
		uint4 latticeOrigin;
		uint4 sweep;
		// Jahshaka (PHOTON-VOXEL-4, FIELD-DIR-1): a world direction to cascade 0's
		// normalised space, per axis (all ones in a cube: no transform); w (PHOTON-7 stage
		// 10, 10-1) the probe rays' last world shell, cascade 0's normalised units.
		float4 worldToVolumeDir;
		// Jahshaka (ENGINE-UPGRADE-2B stage 4): THE PER-PROBE VARIANCE STOP - x = the
		// precision e (a probe stops once t SE <= e times its mean on every texel, t the 95 %
		// Student quantile at n - 1 degrees: jahIfdStudentT), y = the
		// fewest samples a stop may follow (0: the stop is off), z = the mean at or below
		// which a texel has read no light (it never stops its probe), w unused.
		float4 varianceStop;
	}
	CONST_BUFFER_STRUCT_END( p );

	// Jahshaka (PHOTON-WRITER-1): the field's window, one definition for this job,
	// its sibling and the pixel's reader (the build wraps jah_field_window.glsl).
	@insertpiece( JahFieldWindow )


	struct Probe
	{
		float3 center;
	};

	// THE PROBE RAY IS THE WORLD CACHES' OCCUPANCY RAY (PHOTON-7 stage 10, 10-1;
	// jah_voxel_ray.glsl, the piece JahVoxelRay named in this job's piece list) over
	// the WHOLE chain on the world shells - the cards' and the bounce's one ray. (It
	// was the pixel's aperture-0 cone march, PHOTON-READER-1, and before that a third
	// march of cascade 0 alone.) A probe is a point in free space: no surface, no own
	// cell, its start one cell of cascade 0 along the ray.
	#define JAH_VOX_MAX_CASCADES @value( hlms_num_vct_cascades )
	#define JAH_VOX_COUNT @value( hlms_num_vct_cascades )
	#define JAH_VOX_SAMPLE_ISO( c, u, l ) OGRE_SampleLevel( vctProbes[c], probeSampler, u, l )
	// Jahshaka (PHOTON-VOXEL-3): the PER-AXIS COVERAGE, VctLighting's last light-volume
	// entry - the march's mip-0 read takes the opacity along its ray from it.
	#define JAH_VOX_SAMPLE_COVP( c, u, l ) OGRE_SampleLevel( vctProbeCovP[c], probeSampler, u, l )
	#define JAH_VOX_SAMPLE_COVN( c, u, l ) OGRE_SampleLevel( vctProbeCovN[c], probeSampler, u, l )
	// Jahshaka (PHOTON-VOXEL-4): the SURFACE POSITION, the list's last entry - the gate.
	#define JAH_VOX_SAMPLE_POSP( c, u, l ) OGRE_SampleLevel( vctProbePosP[c], probeSampler, u, l )
	#define JAH_VOX_SAMPLE_POSN( c, u, l ) OGRE_SampleLevel( vctProbePosN[c], probeSampler, u, l )
	#define JAH_VOX_SAMPLE_X( c, u, l ) OGRE_SampleLevel( vctProbeX[c], probeSampler, u, l )
	#define JAH_VOX_SAMPLE_Y( c, u, l ) OGRE_SampleLevel( vctProbeY[c], probeSampler, u, l )
	#define JAH_VOX_SAMPLE_Z( c, u, l ) OGRE_SampleLevel( vctProbeZ[c], probeSampler, u, l )
	// Jahshaka (PHOTON-VOXEL-5): level 0 read per side (jah_voxel_sample.glsl).
	#define JAH_VOX_PER_SIDE 1
	#define JAH_VOX_SAMPLE_BACK( c, u, l ) OGRE_SampleLevel( vctProbeBack[c], probeSampler, u, l )
	#define JAH_VOX_SAMPLE_NRM( c, u, l ) OGRE_SampleLevel( vctProbeNrm[c], probeSampler, u, l )
	#define JAH_VOX_INVRES( c ) p.vctInvResMaxLod[c].xyz
	#define JAH_VOX_MAXLOD( c ) p.vctInvResMaxLod[c].w
	#define JAH_VOX_FROM_PREV_SCALE( c ) p.vctFromPrev[( (c) - 1 ) * 2]
	#define JAH_VOX_FROM_PREV_OFFSET( c ) p.vctFromPrev[( (c) - 1 ) * 2 + 1]
	@insertpiece( JahVoxelSample )
	@insertpiece( JahVoxelMarch )
	@insertpiece( JahVoxelRay )

	// THE ONE ENVIRONMENT (Jahshaka, PHOTON-ENV-1; jah_environment.glsl, wrapped
	// into the piece JahEnvironment): the cube at the unit after every volume
	// (IrradianceField::bindChainToGenerationJob, job property jah_env), sampled
	// with the volumes' sampler.
	@property( jah_env )
		#define JAH_ENV_CUBE_ON true
		#define JAH_ENV_SAMPLE( d, l ) OGRE_SampleLevel( envCube, probeSampler, d, l ).xyz
	@else
		#define JAH_ENV_CUBE_ON false
		#define JAH_ENV_SAMPLE( d, l ) float3( 0, 0, 0 )
	@end
	#define JAH_ENV_MIPS p.envGainMips.w
	#define JAH_ENV_GAIN p.envGainMips.xyz
	#define JAH_ENV_SH_C0 p.envSh[0].xyz
	#define JAH_ENV_SH_C1 p.envSh[1].xyz
	#define JAH_ENV_SH_C2 p.envSh[2].xyz
	#define JAH_ENV_SH_C3 p.envSh[3].xyz
	#define JAH_ENV_SH_C4 p.envSh[4].xyz
	#define JAH_ENV_SH_C5 p.envSh[5].xyz
	#define JAH_ENV_SH_C6 p.envSh[6].xyz
	#define JAH_ENV_SH_C7 p.envSh[7].xyz
	#define JAH_ENV_SH_C8 p.envSh[8].xyz
	@insertpiece( JahEnvironment )

	#define ProbeIndex uint

	// THE OCTAHEDRAL DIRECTION OF A TEXEL'S CENTRE (Jahshaka, PHOTON-FIELD-ROTATE-1):
	// Ogre's own decode (Math::octahedronMappingDecode) at the point the pixel's reader
	// addresses - texel xy of a tile of res texels is read at ( xy + 0.5 ) / res
	// (IrradianceField_piece_ps.any, getIrradianceFieldXY). Upstream's integration
	// taps took the texel CORNER ( xy / res ), half a texel away from both the rays
	// and the reader.
	INLINE float3 jahIfdTexelDir( uint2 xy, float res )
	{
		float2 f = ( float2( xy ) + 0.5 ) * ( 2.0 / res ) - 1.0;
		float3 n = float3( f.x, f.y, 1.0 - abs( f.x ) - abs( f.y ) );
		float t = saturate( -n.z );
		n.x += n.x >= 0.0 ? -t : t;
		n.y += n.y >= 0.0 ? -t : t;
		return normalize( n );
	}

	// PCG hash (Jarzynski and Olano 2020, "Hash Functions for GPU Rendering").
	INLINE uint jahIfdPcg( uint v )
	{
		uint state = v * 747796405u + 2891336453u;
		uint word = ( ( state >> ( ( state >> 28u ) + 4u ) ) ^ state ) * 277803737u;
		return ( word >> 22u ) ^ word;
	}

	// THE PROBE'S RAY ROTATION FOR ITS SAMPLE m: a uniformly random rotation
	// (Shoemake's quaternion from three uniforms) hashed from the probe's WORLD
	// lattice coordinate and m, so a probe at one lattice point integrates the same
	// K rotations whatever happened before - a converged field is a deterministic
	// function of the world. Rows of the rotation matrix.
	INLINE void jahIfdRotation( uint3 lattice, uint m, out float3 r0, out float3 r1, out float3 r2 )
	{
		uint h = jahIfdPcg( lattice.x ^ jahIfdPcg( lattice.y ^ jahIfdPcg( lattice.z ^ jahIfdPcg( m ) ) ) );
		float u1 = float( jahIfdPcg( h ) ) * ( 1.0 / 4294967296.0 );
		float u2 = float( jahIfdPcg( h + 1u ) ) * ( 1.0 / 4294967296.0 );
		float u3 = float( jahIfdPcg( h + 2u ) ) * ( 1.0 / 4294967296.0 );
		float s1 = sqrt( 1.0 - u1 );
		float s2 = sqrt( u1 );
		float w = s2 * cos( 6.283185307 * u3 );
		float x = s1 * sin( 6.283185307 * u2 );
		float y = s1 * cos( 6.283185307 * u2 );
		float z = s2 * sin( 6.283185307 * u3 );
		r0 = float3( 1.0 - 2.0 * ( y * y + z * z ), 2.0 * ( x * y - w * z ), 2.0 * ( x * z + w * y ) );
		r1 = float3( 2.0 * ( x * y + w * z ), 1.0 - 2.0 * ( x * x + z * z ), 2.0 * ( y * z - w * x ) );
		r2 = float3( 2.0 * ( x * z - w * y ), 2.0 * ( y * z + w * x ), 1.0 - 2.0 * ( x * x + y * y ) );
	}

	// The first interior texel of probe probeIdx's tile in an atlas of fullWidth
	// texels whose tiles are res + 2 wide (upstream's layout, one texel of border).
	INLINE uint2 jahIfdTileOrigin( uint probeIdx, uint res, uint fullWidth )
	{
		uint bordered = res + 2u;
		return uint2( ( probeIdx * bordered ) % fullWidth,
					  ( ( probeIdx * bordered ) / fullWidth ) * bordered ) + uint2( 1u, 1u );
	}

	// THE VARIANCE STATE (Jahshaka, ENGINE-UPGRADE-2B stage 4; PhotonIrradianceField's
	// mVarianceBuffer): four counters (the stops made, the stops cleared, the integrations
	// made, a pad), then one stopped flag per probe slot, then one running second moment
	// (M2, the luminance's sum of squared deviations from the running mean - Welford) per
	// interior texel of the irradiance tile, then from word numProbes.w (a 256-byte boundary) THE
	// MARKS (PHOTON-7 stage 5, 5-4): four words a slot - its SENSITIVITY (codes of its darkest
	// irradiance texel per unit of radiance its rays read, float bits; 0 = none), the would-move
	// accumulated since its last restart (fixed point), the rounding's fraction and listed - the
	// cards' accumulation's state with the probe as the receiver (JahCardIndirect_cs.glsl, which
	// adds into it; this job writes the sensitivity and a restart clears the rest).
	#define JAH_IFD_STOPS 0u
	#define JAH_IFD_UNSTOPS 1u
	#define JAH_IFD_INTEGRATIONS 2u
	#define JAH_IFD_FLAG( probe ) ( 4u + ( probe ) )
	#define JAH_IFD_M2( probe, t ) ( 4u + p.numProbes.x * p.numProbes.y * p.numProbes.z + \
		( probe ) * @value( irrad_resolution )u * @value( irrad_resolution )u + ( t ) )
	#define JAH_IFD_MARK( probe ) ( p.numProbes.w + 4u * ( probe ) )

	// THE INTERVAL'S WIDTH FROM AN ESTIMATED DEVIATION (Student's t): the standard error a
	// stop reads is itself estimated from the probe's n samples, so the two-sided 95 % interval
	// of the mean is t( 0.975, n - 1 ) standard errors wide, not two - at n = 4 the deviation
	// estimate of three degrees of freedom reads under half the truth one time in seven. Two
	// from 30 degrees on (the derivation's own two sigma).
	INLINE float jahIfdStudentT( float n )
	{
		const float t[29] = float[29]( 12.706, 4.303, 3.182, 2.776, 2.571, 2.447, 2.365, 2.306, 2.262,
									   2.228, 2.201, 2.179, 2.160, 2.145, 2.131, 2.120, 2.110, 2.101,
									   2.093, 2.086, 2.080, 2.074, 2.069, 2.064, 2.060, 2.056, 2.052,
									   2.048, 2.045 );
		int dof = int( n ) - 1;
		return dof >= 1 && dof <= 29 ? t[dof - 1] : 2.0;
	}

	// A probe's estimate is about to be replaced (a fresh, change or invalidating pass): its
	// stop no longer holds.
	INLINE void jahIfdClearStop( uint probeIdx )
	{
		if( ifdVariance[JAH_IFD_FLAG( probeIdx )] != 0u )
		{
			ifdVariance[JAH_IFD_FLAG( probeIdx )] = 0u;
			atomicAdd( ifdVariance[JAH_IFD_UNSTOPS], 1u );
		}
	}
@end

//in uvec3 gl_NumWorkGroups;
//in uvec3 gl_WorkGroupID;
//in uvec3 gl_LocalInvocationID;
//in uvec3 gl_GlobalInvocationID;
//in uint  gl_LocalInvocationIndex;


@piece( BodyCS )
	// ONE WORK GROUP PER PROBE (Jahshaka, PHOTON-FIELD-ROTATE-1; DDGI's estimator,
	// Majercik et al. 2019). The group's position in the WORK (the boxes of
	// JahFieldWindow) names the probe's slot; a group past the work's end exits
	// before any barrier (the condition is the same for every thread of it).
	uint listPos = gl_WorkGroupID.x + gl_WorkGroupID.y * p.probesPerRow + p.numProcessedProbes;
	if( listPos >= p.windowOffset.w )
		return;
	uint3 slot3;
	if( p.boxSize[0].w != 0u )
	{
		// THE WORK IS A LIST (PHOTON-7 stage 5, 5-4): position p is slot ifdWork[p]
		const uint idx = ifdWork[listPos];
		slot3 = uint3( idx % p.numProbes.x, ( idx / p.numProbes.x ) % p.numProbes.y,
					   idx / ( p.numProbes.x * p.numProbes.y ) );
	}
	else
		slot3 = jahFieldWorkSlot( listPos, p.boxLo[0], p.boxLo[1], p.boxLo[2],
								  p.boxSize[0], p.boxSize[1], p.boxSize[2], p.numProbes.xyz );
	ProbeIndex probeIdx = jahFieldSlotIndex( slot3, p.numProbes.xyz );
	uint2 irradTile = jahIfdTileOrigin( probeIdx, @value( irrad_resolution )u, @value( irrad_full_width )u );
	uint2 depthTile = jahIfdTileOrigin( probeIdx, @value( depth_resolution )u, @value( depth_full_width )u );
	uint lid = gl_LocalInvocationIndex;

	// THE INVALIDATION (a re-placement): no rays - the probe's irradiance
	// tile to value 0 and sample count 0, so the pixel's reader gives it no weight
	// until an integration reaches it. The same for every thread of the group.
	if( p.sweep.x == @value( ifd_mode_invalidate )u )
	{
		if( lid == 0u )
		{
			jahIfdClearStop( probeIdx );
			// no estimate: nothing to accumulate a move against (sensitivity 0) and nothing listed
			for( uint k = 0u; k < 4u; ++k )
				ifdVariance[JAH_IFD_MARK( probeIdx ) + k] = 0u;
		}
		for( uint t = lid; t < @value( irrad_resolution )u * @value( irrad_resolution )u;
			 t += @value( threads_per_group_x )u )
		{
			uint2 xy = uint2( t % @value( irrad_resolution )u, t / @value( irrad_resolution )u );
			OGRE_imageWrite2D4( irradianceField, irradTile + xy, float4( 0, 0, 0, 0 ) );
		}
		return;
	}

	// THE PROBE'S HISTORY: how many integrations its value is the mean of, stored in
	// the irradiance atlas's alpha (every texel of the tile, the border mirror
	// included - the pixel's reader reads it as the probe's validity). A FRESH
	// integration keeps nothing, a CHANGE keeps at most sweep.z samples' weight, a
	// REFINEMENT skips a probe that already holds sweep.y samples - or that STOPPED (the
	// variance stop, below: its estimate met the precision before the target). A fresh or a
	// change integration REPLACES the estimate (PHOTON-7 stage 5, 5-4: a restart) - its stop
	// cleared, and the move accumulated against the old one with it (the marks' words 1-3).
	if( lid == 0u )
	{
		float held = OGRE_imageLoad2D( irradianceField, irradTile ).w;
		float kept = p.sweep.x == @value( ifd_mode_fresh )u
						 ? 0.0
						 : ( p.sweep.x == @value( ifd_mode_change )u ? min( held, float( p.sweep.z ) ) : held );
		bool refine = p.sweep.x == @value( ifd_mode_refine )u;
		bool stopped = ifdVariance[JAH_IFD_FLAG( probeIdx )] != 0u;
		float skip = ( refine && ( held >= float( p.sweep.y ) || stopped ) ) ? 1.0 : 0.0;
		if( !refine )
		{
			jahIfdClearStop( probeIdx );
			for( uint k = 1u; k < 4u; ++k )
				ifdVariance[JAH_IFD_MARK( probeIdx ) + k] = 0u;
		}
		g_probeHistory = float4( kept, skip, held, 0.0 );
		g_probeUnconverged = 0u;
		g_probeMinBits = 0x7F7FFFFFu;   // the largest finite float: no texel yet
	}
	__sharedOnlyBarrier;
	float4 history = g_probeHistory;
	if( history.y != 0.0 )
		return;

	uint3 probeLocal = jahFieldLocal( slot3, p.windowOffset.xyz, p.numProbes.xyz );
	float3 probeCenter = float3( probeLocal );
	float3 posLS = mul( float4( probeCenter, 1.0f ), p.irrProbeToVctTransform ).xyz;

	// This sample's rotation: the probe's world lattice point and its sample index
	// (history.x, the samples the blend keeps, IS this sample's index).
	float3 rot0 = float3( 1, 0, 0 );
	float3 rot1 = float3( 0, 1, 0 );
	float3 rot2 = float3( 0, 0, 1 );
	if( p.sweep.w != 0u )
		jahIfdRotation( p.latticeOrigin.xyz + probeLocal, uint( history.x ), rot0, rot1, rot2 );

	// EVERY RAY OF THE PROBE: the spherical-Fibonacci set (IrradianceField::fillDirections)
	// under this sample's random rotation - so the set's gaps land somewhere new every
	// sample and the mean over a probe's samples converges on the irradiance, where a
	// fixed set converged on its own aliasing.
	for( uint r = lid; r < @value( num_rays_per_probe )u; r += @value( threads_per_group_x )u )
	{
		float3 setDir = bufferFetch( directionsBuffer, int( r ) ).xyz;
		float3 dir = normalize( float3( dot( rot0, setDir ), dot( rot1, setDir ), dot( rot2, setDir ) ) );
		// THE RAY IN THE VOLUME'S SPACE (PHOTON-VOXEL-4, FIELD-DIR-1): `dir` is a WORLD
		// direction; the march walks cascade 0's normalised space, where it is the world
		// direction over the box's size. This job used to pass the world direction as the
		// normalised one - right in a cube only: in gi.ddgi_ambient's 18 x 9 x 18 m box a
		// 45-degree ray marched at 26.6 degrees and its depth was integrated as 45. A cube
		// (every cascade of the chain) takes the world direction's own bits.
		float3 dirLS = dir;
		if( any( notEqual( p.worldToVolumeDir.xyz, float3( 1.0, 1.0, 1.0 ) ) ) )
			dirLS = normalize( dir * p.worldToVolumeDir.xyz );

		// THE START BIAS (0070's rule, the ray's own direction as the bias direction).
		// A probe sits at a lattice point, and one standing in or beside a surface's
		// own cell would otherwise meet that cell's opacity on its first sample. The
		// ray leaves by one cell of cascade 0 along itself, componentwise (in the volume's
		// space: dirLS), and the plane march reads on from there - the pixel cone's
		// geometry (surface, one cell along the normal). Measured at 0 / 1 / 2 extra
		// cells (PHOTON-READER-1): gi.ddgi_ambient's floor 0.914 / 0.915 / 0.915 of its
		// truth, the sealed room 1 / 1 / 3 codes, gi.leak_room's thin walls within
		// 0.004 of each other at 0 and 1 - nothing overrules the pixel's geometry.
		float3 startBias = dirLS * JAH_VOX_INVRES( 0 );
		// THE PROBE'S RAY IS THE CACHES' OCCUPANCY RAY (PHOTON-7 stage 10, 10-1; L9: jah_voxel_ray.glsl): a cell
		// holding any geometry stops it from every direction, its hit reads the side facing the ray, and the sky
		// enters only at an EARNED MISS - the ray left the last cascade (its world shell, worldToVolumeDir.w, or its
		// box in the band) - over the ray's own BIN (the cone of solid angle 4 pi / N, coneAngleTan); an EXHAUSTED
		// ray is no sample (its direction zeroed: the texels' cosine weights skip it). It was the aperture-0 plane
		// march with the sky on its escape, one minus min( 1, opacity / 0.95 ) - a composite of coverage, which a wall
		// covering part of a cell's face let the rest through (10-0's P3: the field's probe rays carried the sealed
		// room's last 1.76 % of sky). A probe is a point in free space: no surface, no own cell.
		const JahVoxelRayResult ray = jahVoxelRay( posLS + startBias, dirLS, float3( 0, 0, 0 ), float3( 0, 0, 0 ), 0.0,
												   int4( 0, 0, 0, 0 ), 0.0, p.worldToVolumeDir.w, true );
		// (a ray no cascade held - OUTSIDE - is no sample here: a probe beyond the chain is not the chain's to answer)
		const bool sampled = ray.exitReason == kJahRayHit || ray.exitReason == kJahRayEscaped;
		// (through the panes it crossed - their own light is in ray.radiance: PHOTON-7 10-4 R7)
		const float3 sky = ray.exitReason == kJahRayEscaped ? ray.throughput * jahEnvCone( dir, p.coneAngleTan ) : float3( 0, 0, 0 );
		// THE DEPTH STAYS CASCADE-0-LOCAL AND IS MEASURED FROM THE PROBE: the march's
		// age converted back into cascade 0's normalised units, plus the start bias's
		// own length - and BOUNDED at cascade 0's diagonal, 1.414, the old march's own
		// exit. A miss has no distance; the moments feed the Chebyshev visibility
		// test, and an unbounded miss distance blows up the variance of every texel
		// that mixes hits and misses (DDGI bounds a miss the same way).
		// NO NON-FINITE SAMPLE ENTERS THE MEAN (F5; the tree's NaN rule - the test is
		// on the BITS, a self-compare folds to true on this compiler): a NaN or Inf
		// radiance would poison the probe's running mean until the next change, so it
		// counts as black (the environment's inputs are refused at the host too).
		float3 rayColour = ray.radiance + sky;
		uint3 rayBits = floatBitsToUint( rayColour ) & uint3( 0x7FFFFFFFu, 0x7FFFFFFFu, 0x7FFFFFFFu );
		if( rayBits.x >= 0x7F800000u || rayBits.y >= 0x7F800000u || rayBits.z >= 0x7F800000u )
			rayColour = float3( 0, 0, 0 );
		// (a hit's distance is where it entered the cell it hit; a miss reads the bound)
		const float rayDepthC0 = ray.exitReason == kJahRayHit ? ray.tC0 + length( startBias ) : 1.414213562;
		g_rayColourDepth[r] = float4( rayColour,
									  min( rayDepthC0, 1.414213562 ) * dot( abs( dirLS ), float3( p.numProbes.xyz ) ) );
		g_rayDir[r] = float4( sampled ? dir : float3( 0, 0, 0 ), 0.0 );
	}
	__sharedOnlyBarrier;

	// THE PROBE'S MEAN: this integration enters with weight 1 / ( kept + 1 ), so after
	// m integrations with no restart the value is the plain mean of m independent
	// estimates. A fresh probe (kept 0) takes this integration whole - a select, not
	// a mix, so whatever the atlas held before (recycled VRAM included) never
	// reaches the answer.
	float blend = 1.0 / ( history.x + 1.0 );
	float heldAfter = history.x + 1.0;

	// THE DEPTH MOMENTS: each texel is the cosine-weighted mean of every ray's
	// distance and squared distance about the texel's own direction - upstream's
	// kernel (its integration taps were the same clamped cosine over texels),
	// estimated over rays uniform in solid angle instead of over texels that are not.
	for( uint t = lid; t < @value( depth_resolution )u * @value( depth_resolution )u;
		 t += @value( threads_per_group_x )u )
	{
		uint2 xy = uint2( t % @value( depth_resolution )u, t / @value( depth_resolution )u );
		float3 texelDir = jahIfdTexelDir( xy, float( @value( depth_resolution ) ) );
		float3 acc = float3( 0, 0, 0 );
		for( uint r = 0u; r < @value( num_rays_per_probe )u; ++r )
		{
			float w = max( 0.0, dot( texelDir, g_rayDir[r].xyz ) );
			float d = g_rayColourDepth[r].w;
			acc += w * float3( d, d * d, 1.0 );
		}
		float2 sampled = acc.z > 0.0 ? acc.xy / acc.z : float2( 0, 0 );
		uint2 at = depthTile + xy;
		float2 value = sampled;
		if( blend < 1.0 )
			value = lerp( OGRE_imageLoad2D( irradianceFieldDepth, at ).xy, sampled, blend );
		OGRE_imageWrite2D4( irradianceFieldDepth, at, float4( value, 0.0, 0.0 ) );
	}

	// THE IRRADIANCE: each texel is the cosine-weighted mean radiance about its own
	// direction (E / pi, in cascade 0's stored units), and alpha carries the count.
	// THE SECOND MOMENT beside the mean (Welford, on the luminance): the sample's deviation
	// from the held mean times its deviation from the new one. A change that keeps fewer
	// samples than the probe held keeps its variance estimate, the moment scaled to the
	// samples kept; a sample that replaces the estimate (blend 1) starts it at 0. THE STOP
	// TEST, per texel: with n samples the estimate's standard error is sqrt( M2 / ( n - 1 ) / n ),
	// and a texel is at the precision when its 95 % interval (jahIfdStudentT standard errors)
	// sits inside e of its mean (a texel that has read no light never does); the probe stops
	// when every texel is.
	const float3 kLum = float3( 0.2126, 0.7152, 0.0722 );
	for( uint t = lid; t < @value( irrad_resolution )u * @value( irrad_resolution )u;
		 t += @value( threads_per_group_x )u )
	{
		uint2 xy = uint2( t % @value( irrad_resolution )u, t / @value( irrad_resolution )u );
		float3 texelDir = jahIfdTexelDir( xy, float( @value( irrad_resolution ) ) );
		float4 acc = float4( 0, 0, 0, 0 );
		for( uint r = 0u; r < @value( num_rays_per_probe )u; ++r )
		{
			float w = max( 0.0, dot( texelDir, g_rayDir[r].xyz ) );
			acc += w * float4( g_rayColourDepth[r].xyz, 1.0 );
		}
		float3 sampled = acc.w > 0.0 ? acc.xyz / acc.w : float3( 0, 0, 0 );
		uint2 at = irradTile + xy;
		float3 value = sampled;
		float sampleL = dot( sampled, kLum );
		float meanL = sampleL;
		float m2 = 0.0;
		if( blend < 1.0 )
		{
			float3 heldValue = OGRE_imageLoad2D( irradianceField, at ).xyz;
			value = lerp( heldValue, sampled, blend );
			float heldL = dot( heldValue, kLum );
			float heldM2 = uintBitsToFloat( ifdVariance[JAH_IFD_M2( probeIdx, t )] );
			float keptM2 = history.z > 1.0 ? heldM2 * max( history.x - 1.0, 0.0 ) / ( history.z - 1.0 ) : 0.0;
			float d = sampleL - heldL;
			meanL = heldL + d * blend;
			m2 = keptM2 + d * ( sampleL - meanL );
		}
		ifdVariance[JAH_IFD_M2( probeIdx, t )] = floatBitsToUint( m2 );
		if( p.varianceStop.y != 0.0 )
		{
			// A TEXEL THAT HAS READ NO LIGHT BOUNDS NOTHING: a source its rays have not met yet - the
			// rare-and-bright integrand, a small emitter (gi.field_variance_stop_sliver: stopped at n = 4
			// on four dark samples, those texels read 100 % off the oracle) - reads exactly that way, so
			// such a texel keeps its probe refining to the target.
			bool atPrecision = heldAfter >= p.varianceStop.y && meanL > p.varianceStop.z &&
							   jahIfdStudentT( heldAfter ) * sqrt( max( m2, 0.0 ) / ( ( heldAfter - 1.0 ) * heldAfter ) ) <=
								   p.varianceStop.x * meanL;
			if( !atPrecision )
				atomicOr( g_probeUnconverged, 1u );
		}
		OGRE_imageWrite2D4( irradianceField, at, float4( value, heldAfter ) );
		// (a non-negative float's bits order as the float does)
		atomicMin( g_probeMinBits, floatBitsToUint( max( max( max( value.x, value.y ), value.z ), 0.0 ) ) );
	}

	// THE PROBE'S STOP: every texel at the precision - the refinements skip it from now on
	// and the budget goes to the probes that are not. Counted, so the host knows when none
	// is left.
	__sharedOnlyBarrier;
	if( lid == 0u )
	{
		// THE PROBE'S SENSITIVITY (PHOTON-7 stage 5, 5-4): codes of its darkest irradiance texel per unit of radiance
		// its rays read - a code is 1 % of the texel over the store's floor (Types.h kGiBrickFloor, the cards' rule),
		// and a probe's texel is the cosine-weighted mean radiance, so a radiance change of x over a share w of its
		// sphere moves it by at most w x.
		const float code = 0.01 * max( uintBitsToFloat( g_probeMinBits ), 5.9604645e-6 );
		ifdVariance[JAH_IFD_MARK( probeIdx )] = g_probeMinBits == 0x7F7FFFFFu ? 0u : floatBitsToUint( 1.0 / code );
		atomicAdd( ifdVariance[JAH_IFD_INTEGRATIONS], 1u );
		if( p.varianceStop.y != 0.0 && g_probeUnconverged == 0u )
		{
			ifdVariance[JAH_IFD_FLAG( probeIdx )] = 1u;
			atomicAdd( ifdVariance[JAH_IFD_STOPS], 1u );
		}
	}
@end
