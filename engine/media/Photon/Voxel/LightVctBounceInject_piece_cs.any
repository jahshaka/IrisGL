
#include "/media/matias/Datos/SyntaxHighlightingMisc.h"

@piece( HeaderCS )
	// THE BOUNCE'S CONE MARCH IS JAHSHAKA'S ONE VOXEL RADIANCE READER
	// (PHOTON-READER-1). This job used to carry its own copy of the pixel
	// shader's march - the age carry, but no escape estimate, no one-cell bias at
	// a cascade hop, its own start bias and mip rule - so the bounce a cascade
	// injected and the bounce the pixel read were two integrals of one volume.
	// It now calls the march the pixel shader, the irradiance field's generation
	// job and (for the read) the ray hit share: jah_voxel_sample.glsl +
	// jah_voxel_march.glsl, wrapped by Jahshaka's build into the pieces
	// JahVoxelSample / JahVoxelMarch (this job's piece list names both files).
	// Every rule and its fork-change number is written there once; what is here
	// is the binding.
	//
	// The chain's parameters are VctLighting::getCascadeChainParams' arrays (the one
	// definition the pixel pass buffer and the field's generation job read too).
	#define JAH_VOX_MAX_CASCADES @value( hlms_num_vct_cascades )
	#define JAH_VOX_COUNT @value( hlms_num_vct_cascades )
	#define JAH_VOX_SAMPLE_ISO( c, u, l ) OGRE_SampleLevel( vctProbes[c], vctProbeSampler, u, l )
	// PHOTON-7 stage 7: the BACK side (the store holds the two sides) and stage 10's NORMAL: a ray's hit reads the side
	// facing it (jah_voxel_ray.glsl). The mean-of-sides read this job took (a live leak carrier: half of a sunlit outer
	// face lit the inside) is DELETED with the cones.
	#define JAH_VOX_PER_SIDE 1
	#define JAH_VOX_SAMPLE_BACK( c, u, l ) OGRE_SampleLevel( vctProbeBack[c], vctProbeSampler, u, l )
	#define JAH_VOX_SAMPLE_NRM( c, u, l ) OGRE_SampleLevel( vctProbeNrm[c], vctProbeSampler, u, l )
	// Jahshaka (PHOTON-VOXEL-3): the PER-AXIS COVERAGE, VctLighting's last light-volume
	// entry - the march's mip-0 read takes the opacity along its ray from it.
	#define JAH_VOX_SAMPLE_COVP( c, u, l ) OGRE_SampleLevel( vctProbeCovP[c], vctProbeSampler, u, l )
	#define JAH_VOX_SAMPLE_COVN( c, u, l ) OGRE_SampleLevel( vctProbeCovN[c], vctProbeSampler, u, l )
	// Jahshaka (PHOTON-VOXEL-4): the SURFACE POSITION, the list's last entry - the gate.
	#define JAH_VOX_SAMPLE_POSP( c, u, l ) OGRE_SampleLevel( vctProbePosP[c], vctProbeSampler, u, l )
	#define JAH_VOX_SAMPLE_POSN( c, u, l ) OGRE_SampleLevel( vctProbePosN[c], vctProbeSampler, u, l )
	#define JAH_VOX_SAMPLE_X( c, u, l ) OGRE_SampleLevel( vctProbeX[c], vctProbeSampler, u, l )
	#define JAH_VOX_SAMPLE_Y( c, u, l ) OGRE_SampleLevel( vctProbeY[c], vctProbeSampler, u, l )
	#define JAH_VOX_SAMPLE_Z( c, u, l ) OGRE_SampleLevel( vctProbeZ[c], vctProbeSampler, u, l )
	#define JAH_VOX_INVRES( c ) p_vctInvResMaxLod[c].xyz
	#define JAH_VOX_MAXLOD( c ) p_vctInvResMaxLod[c].w
	@property( hlms_num_vct_cascades > 1 )
		#define JAH_VOX_FROM_PREV_SCALE( c ) p_vctFromPreviousProbeToNext[(c) - 1][0]
		#define JAH_VOX_FROM_PREV_OFFSET( c ) p_vctFromPreviousProbeToNext[(c) - 1][1]
	@end
	@insertpiece( JahVoxelSample )
	@insertpiece( JahVoxelMarch )
	@insertpiece( JahVoxelRay )

	// THE ONE ENVIRONMENT (Jahshaka, PHOTON-ENV-1; jah_environment.glsl, wrapped
	// into the piece JahEnvironment): what an escaping cone sees. The sky enters the
	// store HERE and only here, as the light the escaping cones bring to the voxel they
	// leave - IN THE ESCAPE OF EVERY PASS (PHOTON-7 stage 4: the separate sky pass is deleted; the feedback's
	// passes converge the sky's light with every other bounce), always on the lamps' direct volume, so a pixel's own
	// escape (the sky it sees) and a hit on the store (the surface's sky-lit radiance) never count it twice. The gain
	// and the SH arrive as radiance, the store's own units (PHOTON-7 stage 1), like the cone's own colour.
	@property( jah_env )
		#define JAH_ENV_CUBE_ON true
		#define JAH_ENV_SAMPLE( d, l ) OGRE_SampleLevel( envCube, vctProbeSampler, d, l ).xyz
	@else
		#define JAH_ENV_CUBE_ON false
		#define JAH_ENV_SAMPLE( d, l ) float3( 0, 0, 0 )
	@end
	#define JAH_ENV_MIPS p_envMips.w
	#define JAH_ENV_SH_C0 p_envSh[0].xyz
	#define JAH_ENV_SH_C1 p_envSh[1].xyz
	#define JAH_ENV_SH_C2 p_envSh[2].xyz
	#define JAH_ENV_SH_C3 p_envSh[3].xyz
	#define JAH_ENV_SH_C4 p_envSh[4].xyz
	#define JAH_ENV_SH_C5 p_envSh[5].xyz
	#define JAH_ENV_SH_C6 p_envSh[6].xyz
	#define JAH_ENV_SH_C7 p_envSh[7].xyz
	#define JAH_ENV_SH_C8 p_envSh[8].xyz
	@insertpiece( JahEnvironment )
	// Jahshaka (PHOTON-WRITER-1): the diffuse lobe's albedo (jah_diffuse_albedo.glsl).
	@insertpiece( JahDiffuseAlbedo )
	// Jahshaka (METAL-BOUNCE-1): THE METAL'S LOBE INTEGRALS - PhotonSpecularAlbedo.h's table, two floats
	// an entry and four to a float4 (slot 0, the job's one constant buffer: PhotonVoxelLighting::setupBounceTextures binds it).
	@property( syntax != metal )
		CONST_BUFFER( JahSpecularAlbedoBuf, 0 )
		{
			float4 jahSpecularAlbedoTable[528];
		};
	@end
	#define JAH_SPEC_ALBEDO( k ) jahSpecularAlbedoTable[( k ) >> 2][( k ) & 3]
	@insertpiece( JahSpecularAlbedo )

	// THE CONE FRAME AND THE START BIAS (Jahshaka, PHOTON-CARDS-2; jah_voxel_cones.glsl, the piece JahVoxelCones): the
	// frame is built from the WORLD normal, and a world direction reaches the volume's normalised space through the
	// box's size (the cell size over the inverse resolution).
	#define JAH_CONES_TO_LS( d ) normalize( ( d ) * ( p_invVoxelResolution / p_voxelCellSize ) )
	#define JAH_CONES_TO_WORLD( d ) ( d )
	@insertpiece( JahVoxelCones )

	/// THE BOUNCE GATHERED AT ONE SIDE OF A VOXEL, BY RAYS (PHOTON-7 stage 10, 10-1; L9: no light passes a wall) - the
	/// card relight's estimator, ONE TEXT of it (jah_voxel_cones.glsl's jahRayDiffuse): the cosine-weighted mean
	/// radiance over the side's hemisphere as the mean of N fixed cosine-distributed occupancy rays
	/// (jah_voxel_ray.glsl), N = p_rayCounts.x. A HIT reads the side of the voxel facing the ray; an ESCAPE (out of the
	/// last cascade: its world shell p_rayParams.w, or its box in the band) the sky over the ray's bin; an EXHAUSTED ray
	/// is no sample. THE SIDE STARTS FROM ITS OWN SURFACE (the preflight's M4: the voxel's centre put a thin wall's two
	/// sides' starts at one point, and a side's rays left from inside the wall): along the axis the side's normal is
	/// dominant on, where the voxel's faces looking that way lie (the surface position of that half), the cell's
	/// centre across it - then the finest cell off along the normal; the surface's tangent plane and the voxel's own
	/// cell are the ray's (jah_voxel_ray.glsl).
	/// `cellLS` the voxel's centre (this cascade's normalised space), `nWorld` the side's unit world normal. The result
	/// is radiance, the store's units.
	INLINE float3 jahBounceRays( float3 cellLS, int3 cell, float3 nWorld )
	{
		const float3 normalLS = jahConeBiasDir( nWorld * ( p_invVoxelResolution / p_voxelCellSize ) );
		const float3 an = abs( normalLS );
		const int a = an.x >= an.y ? ( an.x >= an.z ? 0 : 2 ) : ( an.y >= an.z ? 1 : 2 );
		float3 surfaceLS = cellLS;
		{
			const bool plus = normalLS[a] > 0.0;
			const float o = ( plus ? OGRE_Load3D( vctProbeCovP[0], cell, 0 ) : OGRE_Load3D( vctProbeCovN[0], cell, 0 ) )[a];
			const float pO = ( plus ? OGRE_Load3D( vctProbePosP[0], cell, 0 ) : OGRE_Load3D( vctProbePosN[0], cell, 0 ) )[a];
			if( o > 0.0 )
				surfaceLS[a] = ( float( cell[a] ) + saturate( pO / o ) ) * p_invVoxelResolution[a];
		}
		// THE START: the finest cascade's cell off the surface (p_rayCounts.y, this cascade's units) - never this cascade's
		// own cell, which would jump a slab thinner than it (the roof's top 0.4 m above a contact face in a 0.47 m cell:
		// gi.sealed_sky)
		const float eps = p_rayCounts.y;
		return jahRayDiffuse( surfaceLS, normalLS, jahConeBasisWorld( nWorld ), int( p_rayCounts.x ), eps,
							  int4( cell, 1 ), p_rayCounts.z, p_rayParams.w, p_rayCounts.w > 0.5 );
	}

	@insertpiece( DeclSRgbFuncs )
	// JAHSHAKA fork ae2ed529f+155a56bf8 (was 0080): THE STORE'S ENCODING FOLLOWS ITS FORMAT.
	// `uav0_orig_pf_srgb` is the property HlmsComputeJob derives from the pixel
	// format of the texture actually bound, so this one branch covers both
	// stores: an 8-bit UNORM_SRGB volume is written through the sRGB encode --
	// which is the dark-end precision an 8-bit store lives on -- and a float one
	// is written LINEAR. A format with no fixed range has no transfer function to
	// apply, and encoding into one would throw away the headroom it is there for
	// (the encode saturates nothing, but toSRGB of a value above 1 is above 1 and
	// the UNORM write clamps it -- which is the clip this patch removes).
	// THE fp16 STORE ROUNDS FIRST (REDS-1 item 5): an rgba16f store truncates on NVIDIA 595.x (jah_half_round.glsl)
	@insertpiece( JahHalfRound )
	@property( uav0_orig_pf_srgb )
		#define jahStoreLight( x ) toSRGB( x )
	@else
		#define jahStoreLight( x ) jahRoundHalf( x )
	@end
	// VOXEL-R13 stage 1: THE HALF STORE (written in place, read-write) and its direct terms (read), per axis
	@insertpiece( JahVoxelHalves )
	INLINE float4 jahHalfLightLoad( int a, int3 t )
	{
		return a == 0 ? imageLoad( halfLightX, t ) : ( a == 1 ? imageLoad( halfLightY, t ) : imageLoad( halfLightZ, t ) );
	}
	/// (the store rounds the half float to nearest itself - REDS-1's rule: callers pass the f32)
	INLINE void jahHalfLightStore( int a, int3 t, float4 v )
	{
		if( a == 0 )
			imageStore( halfLightX, t, jahStoreLight( v ) );
		else if( a == 1 )
			imageStore( halfLightY, t, jahStoreLight( v ) );
		else
			imageStore( halfLightZ, t, jahStoreLight( v ) );
	}
	INLINE float4 jahHalfDirectLoad( int a, int3 t )
	{
		return a == 0 ? OGRE_Load3D( halfDirectX, t, 0 )
					  : ( a == 1 ? OGRE_Load3D( halfDirectY, t, 0 ) : OGRE_Load3D( halfDirectZ, t, 0 ) );
	}
@end

//in uvec3 gl_NumWorkGroups;
//in uvec3 gl_WorkGroupID;
//in uvec3 gl_LocalInvocationID;
//in uvec3 gl_GlobalInvocationID;
//in uint  gl_LocalInvocationIndex;

@piece( BodyCS )
	// THE PASS'S CELL (PHOTON-7 stage 4): an ACTIVE brick's (the feedback's list, 8 groups of 4^3 a brick: group y the
	// brick, x its octant).
	const uint jahPacked = jahFbList[gl_WorkGroupID.y];
	const uint3 jahBrick = uint3( jahPacked & 1023u, ( jahPacked >> 10u ) & 1023u, jahPacked >> 20u );
	const uint jahSub = gl_WorkGroupID.x;
	const uint3 jahCell = jahBrick * 8u + uint3( jahSub & 1u, ( jahSub >> 1u ) & 1u, jahSub >> 2u ) * 4u +
						  gl_LocalInvocationID.xyz;
	float3 voxelUvwPos = p_invVoxelResolution * (float3( jahCell ) + 0.5f);

	float4 albedoVal = OGRE_Load3D( voxelAlbedoTex, jahCell, 0 );
	float4 normalVal = OGRE_Load3D( voxelNormalTex, jahCell, 0 );
	// JAHSHAKA fork ae2ed529f+155a56bf8 (was 0076): JACOBI, NOT ACCUMULATION.
	//
	// What this pass writes is  new = direct + rho * G( total )  -- the fixed point
	// of the radiance in the volume, iterated once. The base term is therefore the
	// DIRECT injection, read from its own volume; the GATHER below still reads the
	// running total (`vctProbes`), which is what makes the second pass see the first
	// bounce and the chain see the cascades outside it.
	//
	// What stood here was `OGRE_Load3D( vctProbes[0], ... )`: the running TOTAL as
	// the base, so the pass computed  new = total + rho * G( total )  and the series
	// was S_n = (1 + rho*G)^n * D -- binomial. It never contracts; every pass
	// re-amplifies the first bounce's energy, which is why upstream needed a 1/pi
	// dampening (and a commented-out per-pass one, and "more bounces for coarser
	// cascades") to keep the picture from running away. With this line the series
	// contracts by rho * f per pass on its own, and the dampening is 1.
	//
	// The alpha channel is the voxel's COVERAGE, identical in both volumes (the
	// injection writes albedoVal.w to each), so reading it here keeps it exactly as
	// the accumulating form did.
	float4 currentLight = OGRE_Load3D( directVoxel, jahCell, 0 );
	float4 backLight = OGRE_Load3D( directBackVoxel, jahCell, 0 );
	// what this voxel re-emits of what it gathers (0 where nothing is): the feedback's sensitivity, below
	float3 jahReemit = float3( 0, 0, 0 );

	// VOXEL-R13 stage 1: THE HALVES ARE THE FIXED POINT (jah_voxel_halves.glsl) - each half of the voxel is its own
	// surface, L_q = D_q + rho G_q, G_q gathered FROM ITS OWN FACES along ITS OWN NORMAL (the ray tier: rq_voxel_sides.comp
	// over the same list); stored in place, (radiance x k, k) - no gather of this pass reads a half (the ray tier's ran
	// before it; the voxel rays read the two sides and the directional chain). The two sides are DERIVED from the stored
	// halves (this stage only; jahHalfSideWeight), so they move only when a half moves.
	const int jahHalfW = imageSize( halfLightX ).x >> 1;
	const float3 jahCovP = OGRE_Load3D( vctProbeCovP[0], jahCell, 0 ).xyz;
	const float3 jahCovN = OGRE_Load3D( vctProbeCovN[0], jahCell, 0 ).xyz;
	// each half's target, (radiance x k, k): its direct term, and below what it re-emits of its own gather
	float4 jahHalfTarget[6];
	for( int q = 0; q < 6; ++q )
		jahHalfTarget[q] = jahHalfDirectLoad( q % 3, jahHalfTexel( int3( jahCell ), q / 3, jahHalfW ) );
	const bool twoSided = normalVal.a > 0.0f;
	normalVal.xyz = normalize( normalVal.xyz * 2.0f - 1.0f );

	if( anyInvocationARB( albedoVal.a > 0 ) )
	{
		float3 gatheredHalf[6];
	@property( jah_vct_tlas )
		// AT THE RAY TIER each half's gather is the TLAS's (rq_voxel_sides.comp): its slot's voxel, its half
		{
			const uint3 jahIn = jahCell - jahBrick * 8u;
			const uint jahBase = ( gl_WorkGroupID.y * 512u + jahIn.x + 8u * jahIn.y + 64u * jahIn.z ) * 12u;
			for( int q = 0; q < 6; ++q )
			{
				const float2 jahRg = unpackHalf2x16( jahSideGather[jahBase + 2u * uint( q )] );
				const float2 jahB = unpackHalf2x16( jahSideGather[jahBase + 2u * uint( q ) + 1u] );
				gatheredHalf[q] = float3( jahRg.x, jahRg.y, jahB.x );
			}
		}
	@else
		// THE NO-RAY TIER (VOXEL-R13 stage 3 moves it to the halves): the voxel rays gather the two sides as before - a
		// two-sided voxel both hemispheres, a one-sided voxel its front - and each half takes the gather of the side its
		// faces belong to (jahHalfSideWeight)
		// ONE call site in a loop over the sides, not two: the gather is the whole ray set, inlined per call (a second
		// call doubled the job's compile time).
		float3 gathered[2];
		gathered[0] = float3( 0, 0, 0 );
		gathered[1] = float3( 0, 0, 0 );
		for( int side = 0; side < ( twoSided ? 2 : 1 ); ++side )
			gathered[side] = jahBounceRays( voxelUvwPos, int3( jahCell ), side == 0 ? normalVal.xyz : -normalVal.xyz );
		for( int q = 0; q < 6; ++q )
			gatheredHalf[q] = jahHalfSideWeight( normalVal.xyz, twoSided, q / 3, q % 3, 0 ) * gathered[0] +
							  jahHalfSideWeight( normalVal.xyz, twoSided, q / 3, q % 3, 1 ) * gathered[1];
	@end
		// THE BOUNCE RE-EMITS WHAT THE SURFACE RENDERS (PHOTON-WRITER-1): a voxel lit
		// by the diffuse gather of its surroundings reflects the normalised Disney
		// lobe's HEMISPHERICAL albedo of it (jahDiffuseAlbedoHemi, the lobe's
		// directional albedo averaged over a uniform incoming hemisphere), at the
		// voxel's own roughness (the emissive volume's alpha).
		const float voxelRoughness =
			OGRE_Load3D( voxelEmissiveTex, jahCell, 0 ).w;
		// (per unit of the surfaces' radiance: a half's store is premultiplied by its own coverage k below; the voxel's
		// opacity c multiplies the sensitivity's re-emission, jahReemit, as the store did)
		float3 reemit = albedoVal.xyz * p_iterationDampening * jahDiffuseAlbedoHemi( voxelRoughness );
		// ...AND THE SPECULAR LOBE (METAL-BOUNCE-1, ENGINE-POLISH-PHOTON-1 stage 2): of what it gathers,
		// a surface of F0 and Fresnel-90 weight w - a metal's F0 = b kS, a dielectric's 0.04 kS, w = kS -
		// re-emits its lobe's HEMISPHERICAL albedo F0 A-bar( r ) + w B-bar( r ) (JahSpecularAlbedo): a
		// white rough metal ~ its reflectance, a dielectric its 4 % layer's share, where the diffuse-only
		// store had both re-emit 0.
		// (The volume holds F0 relative to the dielectric's, Voxelizer_piece_cs.any: F0 kS = 0.04 w + 0.96 rgb.)
		const float4 metalVal = OGRE_Load3D( voxelMetalTex, jahCell, 0 );
		if( metalVal.w > 0.0f )
		{
			float sa, sb;
			jahSpecularAlbedoHemi( voxelRoughness, sa, sb );
			const float3 specF0 = metalVal.www * 0.04f + metalVal.xyz * 0.96f;
			reemit += ( specF0 * sa + metalVal.w * sb ) * p_iterationDampening;
		}
		// each half its own fixed point (a half without coverage holds nothing)
		for( int q = 0; q < 6; ++q )
		{
			const float k = min( q < 3 ? jahCovP[q % 3] : jahCovN[q % 3], 1.0f );
			if( k > 0.0f )
				jahHalfTarget[q].xyz += reemit * gatheredHalf[q] * k;
		}
		jahReemit = reemit * albedoVal.w;
	}

	// THE STORE MOVES IN WHOLE STEPS (PHOTON-7 stage 4's fix, measured in stage 5): a channel is written only where the
	// pass's f32 result is AT LEAST ONE STEP of the half-float store from what the store holds (the step at the larger of
	// the two magnitudes: 2^-10 of the value, a tenth of a code); nearer, the stored value stays. Why: an iteration whose
	// contraction r exceeds 1/2 rounds into a one-step orbit around its fixed point (r x a step rounds to a step) - the
	// orbit's f32 move is (1 + r) d with d at most half a step, under one step, so it is held and dies at the first
	// resume (a resumed brick's target moves r x a step) - where every flip was a move the stopped bricks' resume summed
	// over every touching brick at weight 1, and they resumed each other for ever (a sealed room after a teleport: 92
	// bricks of cascade 0 active 1500 frames on). A change of any speed is kept: the target is recomputed from the world
	// every pass, so a slow change writes once it reaches a step (its lag at most a step; gi.bounce_series' slow fade).
	// The price: the feedback rests within step / (1 - r) of the fixed point instead of step / (2 (1 - r)). EVERY HALF
	// HELD AGAINST ITS OWN STORED VALUE (VOXEL-R13 stage 1: the halves are the store's state; the sides are derived).
	// THE ROUNDING ORBIT (PHOTON-7 stage 10, the lead's ruling on the TLAS route): round-to-nearest cannot bring a
	// contraction r closer to its fixed point than 0.5 / (1 - r) store steps, and it can leave it ORBITING there - the
	// Jacobi of two surfaces that read each other has an eigenvalue -r beside +r, a period-2 mode the rounding keeps at
	// up to that amplitude (measured on the TLAS route: 1-412 steps at the subnormal floor, period 2, gi.card_residency
	// (7)). r here is the brick's MEASURED contraction (its word 2 once bit 11 is set - the pass never writes it then,
	// so every group of the brick reads one value), never above this voxel's OPERATOR BOUND (what it re-emits of what it
	// gathers: no bounce here gains more - inside an orbit the measured ratio reads ~1, which no contraction is); the
	// operator bound alone before a measurement. Two rules take it: THE WRITE HOLD (a), and THE SCHEDULER's no-move (ii)
	// below.
	// THE ROUNDING IS THE STORE'S OWN, MADE SO (REDS-1 item 5): the rules above assume a ROUND-TO-NEAREST store, and an
	// rgba16f store TRUNCATES on NVIDIA 595.x (measured: every value half a step low); every write of this light store
	// goes through jahStoreLight's jahRoundHalf (jah_half_round.glsl), so the 0.5 / (1 - r) bound holds as written.
	const uint jahIdxR = jahBrick.x + p_brickMark.y * ( jahBrick.y + p_brickMark.z * jahBrick.z );
	const float jahOperator = min( max( max( jahReemit.x, jahReemit.y ), jahReemit.z ), 0.999 );
	const float jahRho = ( jahFbState[10u * jahIdxR] & 2048u ) != 0u
							 ? min( clamp( uintBitsToFloat( jahFbState[10u * jahIdxR + 2u] ), 0.0, 0.999 ), jahOperator )
							 : jahOperator;
	const float jahOrbitSteps = 0.5 / ( 1.0 - jahRho );
	const float3 jahFloor = float3( 6.1035156e-5, 6.1035156e-5, 6.1035156e-5 );   // the half float's smallest normal
	// THE HALVES: held (a), written in place, read back (the store's own rounding), their move under (ii)'s no-move rule
	float4 jahHalfStored[6];
	float jahHalfMoved = 0.0;
	float3 jahHalfAbs = float3( 0.0, 0.0, 0.0 );
	for( int q = 0; q < 6; ++q )
	{
		const int3 t = jahHalfTexel( int3( jahCell ), q / 3, jahHalfW );
		const float4 stored = jahHalfLightLoad( q % 3, t );
		float4 target = jahHalfTarget[q];
		const float3 step = exp2( floor( log2( max( max( abs( target.xyz ), abs( stored.xyz ) ), jahFloor ) ) ) - 10.0 );
		// (a) THE WRITE HOLD: max( 1, 0.5 / (1 - r) ) steps, CAPPED at 0.8 of a code at the value's own level (a code: 1 %
		// of the value over the store's floor kGiBrickFloor) - never over a code anywhere; at the floor, where a code IS
		// one step, the hold stays the one step and the scheduler's rule (ii) takes the orbit
		const float3 code = 0.01 * max( max( abs( target.xyz ), abs( stored.xyz ) ), float3( 5.9604645e-6 ) );
		const float3 hold = step * max( float3( 1.0 ), min( float3( jahOrbitSteps ), 0.8 * code / step ) );
		for( int k = 0; k < 3; ++k )
		{
			if( abs( target[k] - stored[k] ) < hold[k] )
				target[k] = stored[k];
		}
		jahHalfLightStore( q % 3, t, target );
		const float4 now = jahHalfLightLoad( q % 3, t );
		jahHalfStored[q] = now;
		// (ii) THE SCHEDULER's NO-MOVE, per half (below, the rule's text): within 0.5 / (1 - r) steps no move
		float3 moved = now.xyz;
		const float3 stepN = exp2( floor( log2( max( max( abs( now.xyz ), abs( stored.xyz ) ), jahFloor ) ) ) - 10.0 );
		for( int k = 0; k < 3; ++k )
		{
			if( abs( moved[k] - stored[k] ) <= jahOrbitSteps * stepN[k] )
				moved[k] = stored[k];
		}
		const float invK = now.w > 0.0 ? 1.0 / now.w : 0.0;
		jahHalfMoved = max( jahHalfMoved, jahBrickChange( stored.xyz * invK, moved * invK ) );
		jahHalfAbs = max( jahHalfAbs, abs( moved - stored.xyz ) * invK );
	}
	// THE TWO SIDES FROM THE STORED HALVES (VOXEL-R13 stage 1 only: the level-0 readers read them until stage 2) - each the
	// coverage-weighted mean of its halves' radiance, times the voxel's opacity c, as the store held it
	{
		float3 f = float3( 0.0, 0.0, 0.0 ), b = float3( 0.0, 0.0, 0.0 );
		float wf = 0.0, wb = 0.0;
		for( int q = 0; q < 6; ++q )
		{
			const float sf = jahHalfSideWeight( normalVal.xyz, twoSided, q / 3, q % 3, 0 );
			const float sb = jahHalfSideWeight( normalVal.xyz, twoSided, q / 3, q % 3, 1 );
			f += sf * jahHalfStored[q].xyz;
			wf += sf * jahHalfStored[q].w;
			b += sb * jahHalfStored[q].xyz;
			wb += sb * jahHalfStored[q].w;
		}
		const float c = albedoVal.w;
		currentLight = float4( ( wf > 0.0 ? f / wf : float3( 0.0, 0.0, 0.0 ) ) * c, currentLight.w );
		backLight = float4( twoSided && wb > 0.0 ? ( b / wb ) * c : float3( 0.0, 0.0, 0.0 ), backLight.w );
	}
	float3 jahBackOld = OGRE_Load3D( vctProbeBack[0], jahCell, 0 ).xyz;   // the back as the store held it (THE PASS'S MOVE)
	wshort3 voxelCelUvw = wshort3( jahCell );
	OGRE_imageWrite3D4( lightVoxel, voxelCelUvw, jahStoreLight( currentLight ) );  // JAHSHAKA fork ae2ed529f+155a56bf8 (was 0080)
	// the back into the chain's compact scratch at this brick's list slot (the declaration says why)
	const int2 jahScratchAt = int2( int( ( jahCell.x & 7u ) + 8u * ( jahCell.y & 7u ) + 64u * ( jahCell.z & 7u ) ),
									int( gl_WorkGroupID.y ) );
	imageStore( backScratch, jahScratchAt, jahRoundHalf( float4( backLight.xyz, currentLight.w ) ) );
	// THE PASS'S MOVE (PHOTON-7 stage 3's word 1, stage 4's feedback): the total it gathered from (the current one, a
	// linear read) against what the STORE now holds - read back by this invocation (program order: the store's own
	// rounding, never a conversion of ours), so a voxel at the float store's fixed point moves by exactly 0. Per
	// brick the most relative move (the mask, codes), the most absolute move and the sensitivity - the re-emission over
	// the voxel's own code, per channel (the state) - each the group's most, then one atomic per group. Every invocation
	// of a group is in one brick and reaches the barriers (the list's bricks are whole).
	const float3 jahOld = OGRE_Load3D( vctProbes[0], jahCell, 0 ).xyz;
	const float3 jahNewStored = imageLoad( lightVoxel, int3( jahCell ) ).xyz;
	// ...and the back, read back from the scratch in program order (the store's own rounding): the series and the stop
	// take EITHER side's move (PHOTON-7 stage 7: both sides are stored and read; a brick stopped on its front alone
	// would rest with its back still moving)
	const float3 jahBackNewStored = imageLoad( backScratch, jahScratchAt ).xyz;
	// (ii) THE SCHEDULER's NO-MOVE (the lead's ruling): a channel's move within max( the hold, 0.5 / (1 - r) ) steps at
	// its own level is NO MOVE for the stop, the resume and every accumulation that reads the moves - the store may hold
	// it (it is written), but nothing is told: the brick stops, its move resumes nobody, and with nothing recomputing it
	// an orbit ends. This is the store's ACHIEVABLE QUANTUM under the iteration (round-to-nearest cannot do better), not
	// a loosened bar: about 1.5e-7 radiance at the floor at r 0.8 (2.5 steps of 2^-24); in the normal range 0.5 / (1 - r)
	// steps of 2^-10 of the value. The rows' floor comparisons take their tolerance from it.
	float3 jahNew = jahNewStored;
	float3 jahBackNew = jahBackNewStored;
	{
		const float3 jahFloorS = float3( 6.1035156e-5, 6.1035156e-5, 6.1035156e-5 );
		const float3 jahStepN = exp2( floor( log2( max( max( abs( jahNew ), abs( jahOld ) ), jahFloorS ) ) ) - 10.0 );
		const float3 jahStepNB =
			exp2( floor( log2( max( max( abs( jahBackNew ), abs( jahBackOld ) ), jahFloorS ) ) ) - 10.0 );
		for( int k = 0; k < 3; ++k )
		{
			if( abs( jahNew[k] - jahOld[k] ) <= jahOrbitSteps * jahStepN[k] )
				jahNew[k] = jahOld[k];
			if( abs( jahBackNew[k] - jahBackOld[k] ) <= jahOrbitSteps * jahStepNB[k] )
				jahBackNew[k] = jahBackOld[k];
		}
	}
	const float jahMoved = max( max( jahBrickChange( jahOld, jahNew ), jahBrickChange( jahBackOld, jahBackNew ) ),
								jahHalfMoved );
	// THE ABSOLUTE MOVE'S REFERENCE (PHOTON-7 stage 5, 5-4): what a reader read at this world point before. A CLEARED
	// voxel (its brick's bit 10 - the shift brought it in, a whole injection wrote it - and its total still its direct
	// term alone, bit for bit: no pass has reached it) was read from the next cascade out, so its first pass's move is
	// against that cascade's total there (the outermost's against nothing: no reader read radiance there); the series
	// (the mask's relative move, the stop) keeps the store's own move. The cards' and the field's accumulation read it.
	float3 jahRef = jahOld;
	float3 jahRefBack = jahBackOld;
	{
		const uint jahIdx0 = jahBrick.x + p_brickMark.y * ( jahBrick.y + p_brickMark.z * jahBrick.z );
		const float3 jahStoredDirect = OGRE_Load3D( directVoxel, jahCell, 0 ).xyz;
		if( ( jahFbState[10u * jahIdx0] & 1024u ) != 0u &&
			all( equal( floatBitsToUint( jahOld ), floatBitsToUint( jahStoredDirect ) ) ) )
		{
			jahRef = float3( 0.0, 0.0, 0.0 );
			jahRefBack = float3( 0.0, 0.0, 0.0 );
			@property( hlms_num_vct_cascades > 1 )
				const float3 jahUvw1 = voxelUvwPos * JAH_VOX_FROM_PREV_SCALE( 1 ).xyz + JAH_VOX_FROM_PREV_OFFSET( 1 ).xyz;
				if( all( greaterThanEqual( jahUvw1, float3( 0.0, 0.0, 0.0 ) ) ) &&
					all( lessThanEqual( jahUvw1, float3( 1.0, 1.0, 1.0 ) ) ) )
				{
					jahRef = OGRE_SampleLevel( vctProbes[1], vctProbeSampler, jahUvw1, 0.0 ).xyz;
					jahRefBack = OGRE_SampleLevel( vctProbeBack[1], vctProbeSampler, jahUvw1, 0.0 ).xyz;
				}
			@end
		}
	}
	// THE ABSOLUTE MOVE IS EITHER SIDE'S (PHOTON-7 stage 7): a reader reads the side its travel meets, so what a reader
	// read moved by the larger of the two sides' moves - the front (the target, read back) and the back (the scratch,
	// read back above). Measured on the front alone, a wall voxel whose canonical normal looks out of a room moved its
	// BACK under a lamp step inside and nothing was reported.
	// (VOXEL-R13: and every half's own move - the directional chain the coarser readers read is composited from them)
	const float3 jahAbs3 = max( max( abs( jahNew - jahRef ), abs( jahBackNew - jahRefBack ) ), jahHalfAbs );
	float jahAbs = max( max( jahAbs3.x, jahAbs3.y ), jahAbs3.z );
	if( ( floatBitsToUint( jahAbs ) & 0x7F800000u ) == 0x7F800000u )
		jahAbs = 1.0e30;
	const float3 jahCode = 0.01 * max( abs( jahNew ), float3( 5.9604645e-6, 5.9604645e-6, 5.9604645e-6 ) );
	const float3 jahSens3 = jahReemit / jahCode;
	float jahSens = max( max( jahSens3.x, jahSens3.y ), jahSens3.z );
	if( !( jahSens < 1.0e30 ) )
		jahSens = jahReemit.x + jahReemit.y + jahReemit.z > 0.0 ? 1.0e30 : 0.0;
	// THE OPERATOR'S BOUND (PHOTON-7 stage 5's read A2): the most this voxel re-emits of what it gathers, any channel - a
	// bounce's gain here never exceeds it, so the brick's most bounds its contraction: the prior r of a brick whose r was
	// never measured (PhotonBrickFeedback_cs.glsl's word 2, bit 11 of word 0 unset).
	const float jahPrior = min( max( max( jahReemit.x, jahReemit.y ), jahReemit.z ), 0.999 );
	if( gl_LocalInvocationIndex == 0u )
	{
		jahBrickShared = 0u;
		jahAbsShared = 0u;
		jahSensShared = 0u;
		jahPriorShared = 0u;
		jahFluxShared = 0u;
	}
	memoryBarrierShared();
	barrier();
	if( jahMoved > 0.0f )
		atomicMax( jahBrickShared, floatBitsToUint( jahMoved ) );
	if( jahAbs > 0.0f )
	{
		atomicMax( jahAbsShared, floatBitsToUint( jahAbs ) );
		// THE MOVED FLUX (PhotonBrickFeedback_cs.glsl's word 8): this voxel's move in its fixed point - 1/64 of radiance,
		// rounded UP (a bound); a move past the half store's largest finite value - a non-finite one, or a finite f32 move
		// over 65504 (taken before the half store) - sets bit 31: no flux bound for the brick this frame (conservative)
		if( jahAbs <= 65504.0f )
			atomicAdd( jahFluxShared, uint( ceil( jahAbs * 64.0f ) ) );
		else
			atomicOr( jahFluxShared, 0x80000000u );
	}
	if( jahSens > 0.0f )
		atomicMax( jahSensShared, floatBitsToUint( jahSens ) );
	if( jahPrior > 0.0f )
		atomicMax( jahPriorShared, floatBitsToUint( jahPrior ) );
	memoryBarrierShared();
	barrier();
	if( gl_LocalInvocationIndex == 0u )
	{
		const uint jahIdx = jahBrick.x + p_brickMark.y * ( jahBrick.y + p_brickMark.z * jahBrick.z );
		if( jahBrickShared != 0u )
			atomicMax( jahBrickMask[2u * jahIdx + 1u], jahBrickShared );
		if( jahAbsShared != 0u )
			atomicMax( jahFbState[10u * jahIdx + 4u], jahAbsShared );
		// (the group's flux: its finite part an add - a brick's whole pass sums under 2^31, so never into bit 31 - and
		// the non-finite mark an or: integer atomics, the sum independent of their order)
		if( ( jahFluxShared & 0x7FFFFFFFu ) != 0u )
			atomicAdd( jahFbState[10u * jahIdx + 8u], jahFluxShared & 0x7FFFFFFFu );
		if( ( jahFluxShared & 0x80000000u ) != 0u )
			atomicOr( jahFbState[10u * jahIdx + 8u], 0x80000000u );
		if( jahSensShared != 0u )
			atomicMax( jahFbState[10u * jahIdx + 5u], jahSensShared );
		if( jahPriorShared != 0u && ( jahFbState[10u * jahIdx] & 2048u ) == 0u )
			atomicMax( jahFbState[10u * jahIdx + 2u], jahPriorShared );
	}
@end
