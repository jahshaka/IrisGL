//#include "SyntaxHighlightingMisc.h"

//in uvec3 gl_NumWorkGroups;
//in uvec3 gl_WorkGroupID;
//in uvec3 gl_LocalInvocationID;
//in uvec3 gl_GlobalInvocationID;
//in uint  gl_LocalInvocationIndex;

@piece( HeaderCS )
	@insertpiece( JahDirectionalComposite )

	@insertpiece( DeclSRgbFuncs )
	// JAHSHAKA fork ae2ed529f+155a56bf8 (was 0080): THE STORE'S ENCODING FOLLOWS ITS FORMAT (the directional volumes are
	// float: written linear).
	// THE fp16 STORE ROUNDS FIRST (REDS-1 item 5): an rgba16f store truncates on NVIDIA 595.x (jah_half_round.glsl)
	@insertpiece( JahHalfRound )
	@property( uav0_orig_pf_srgb )
		#define jahStoreLight( x ) toSRGB( x )
	@else
		#define jahStoreLight( x ) jahRoundHalf( x )
	@end
	// VOXEL-R13: the half store's texel
	@insertpiece( JahVoxelHalves )
@end

@piece( BodyCS )
	// Jahshaka (PHOTON-VOXEL-5): STEP 0 IS THE BOUNCE'S PART OF THE DIRECTIONAL LEVEL 0. The light
	// injection composites the directional level 0 itself, from each voxel's light PER HALF-AXIS
	// (LightInjection_piece_cs.any, the fused step 0); with a bounce it writes the DIRECT part of
	// it into its own volumes (`dirDirect0..2`) and this pass, after every bounce, adds the
	// bounce's: per child and half THAT HALF'S OWN bounce - its stored light minus its stored direct term (VOXEL-R13
	// stage 1: the level-0 half store, each half its own fixed point; the side a half took by the sign of the voxel's one
	// normal is deleted) - composited with the same pairs and the same coverages. The composite is linear in the colours
	// for given coverages, so the sum is the composite of the sums; the opacity is the coverages' composite, as the
	// injection's.
	JAH_DIR_OFFSETS;
	JAH_DIR_FRONT;
	JAH_DIR_BACK;

	// THE PASS'S TEXEL (PHOTON-7 stage 2): a region pass starts at p_regionOrigin (a whole pass at 0). PHOTON-7 stage 4:
	// under the feedback's brick list, one group a listed brick - its texels of this level (a texel covers
	// 2^p_regionOrigin.w cells; a texel wider than a brick is written by each brick under it, the same value).
	@property( jah_brick_list )
		const uint jahFbPacked = jahFbList[gl_WorkGroupID.y];
		const uint3 jahFbBrick = uint3( jahFbPacked & 1023u, ( jahFbPacked >> 10u ) & 1023u, jahFbPacked >> 20u );
		const uint jahFbSide = max( 8u >> p_regionOrigin.w, 1u );
		if( any( greaterThanEqual( gl_LocalInvocationID.xyz, uint3( jahFbSide, jahFbSide, jahFbSide ) ) ) )
			return;
		const uint3 jahTexel = ( ( jahFbBrick * 8u ) >> p_regionOrigin.w ) + gl_LocalInvocationID.xyz;
	@else
		const uint3 jahTexel = gl_GlobalInvocationID.xyz + p_regionOrigin.xyz;
	@end
	int3 iSourceUvw = int3( jahTexel << 1u );

	// (the half store's halves are (radiance x k, k) - each child's bounce part per half is the stored light minus the
	// stored direct term, already premultiplied by the half's own coverage, as the composite's pair wants it)
	const int jahHalfW = 2 * p_higherMipHalfWidth;
	float3 coveragesP[8];
	float3 coveragesN[8];
	for( int n = 0; n < 8; ++n )
	{
		const int3 uvw = iSourceUvw + jahDirOffsets[n];
		coveragesP[n] = OGRE_Load3D( inCoveragePTex, uvw, 0 ).xyz;
		coveragesN[n] = OGRE_Load3D( inCoverageNTex, uvw, 0 ).xyz;
	}

	wshort3 outIUvw;
	for( int dir = 0; dir < 6; ++dir )
	{
		const int axis = dir >> 1;
		// the -a texel (even) is read travelling +a: the faces looking -a; the +a one the +a faces
		const bool plusHalf = ( dir & 1 ) != 0;
		float4 accumVal = float4( 0, 0, 0, 0 );
		for( int p = 0; p < 4; ++p )
		{
			float4 pair[2];
			for( int e = 0; e < 2; ++e )
			{
				const int n = e == 0 ? jahDirFront[dir * 4 + p] : jahDirBack[dir * 4 + p];
				const float k = min( plusHalf ? coveragesP[n][axis] : coveragesN[n][axis], 1.0f );
				const int3 t = jahHalfTexel( iSourceUvw + jahDirOffsets[n], plusHalf ? 0 : 1, axis, jahHalfW );
				const float3 b = max( OGRE_Load3D( inHalfLight, t, 0 ).xyz - OGRE_Load3D( inHalfDirect, t, 0 ).xyz,
									  float3( 0, 0, 0 ) );
				pair[e] = k > 0.0f ? float4( b, k ) : float4( 0, 0, 0, 0 );
			}
			accumVal += compositeAlongAxis( pair[0], pair[1] );
		}
		accumVal *= 0.25f;

		outIUvw.xyz = wshort3( jahTexel );
		if( plusHalf )
			outIUvw.x += p_higherMipHalfWidth;
		// the direct part the injection composited (8-bit sRGB, read linear)
		const float3 direct = axis == 0 ? OGRE_Load3D( inDirectDir0, outIUvw, 0 ).xyz
							: ( axis == 1 ? OGRE_Load3D( inDirectDir1, outIUvw, 0 ).xyz
										  : OGRE_Load3D( inDirectDir2, outIUvw, 0 ).xyz );
		accumVal.xyz += direct;
		if( axis == 0 )
			OGRE_imageWrite3D4( outLightHigherMip0, outIUvw, jahStoreLight( accumVal ) );
		else if( axis == 1 )
			OGRE_imageWrite3D4( outLightHigherMip1, outIUvw, jahStoreLight( accumVal ) );
		else
			OGRE_imageWrite3D4( outLightHigherMip2, outIUvw, jahStoreLight( accumVal ) );
	}
@end
