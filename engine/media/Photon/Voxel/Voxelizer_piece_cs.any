// Heavily modified version based on voxelization shader written by mattatz
//	https://github.com/mattatz/unity-voxel
// Original work Copyright (c) 2018 mattatz under MIT license.
//
// mattatz's work is a full voxelization algorithm.
// We only need to voxelize the shell (aka the contour),
// not to fill the entire voxel.
//
// Adapted for Ogre and for use for Voxel Cone Tracing by
// Matias N. Goldberg Copyright (c) 2019

@piece( PreBindingsHeaderCS )
	// Jahshaka (ATOM P4): the `Vertex` struct is GONE. There is no private vertex
	// buffer to describe - the shader reads the raster's own through the device
	// addresses in a geometry row - Jahshaka's JahGeomRows piece (the one decode,
	// irisgl/engine/src/rayquery/include/jah_geom_rows.glsl, which the ray jobs'
	// hit normal reads too).
	@insertpiece( JahGeomRows )

	struct InstanceBuffer
	{
		float4 worldTransformRow0;
		float4 worldTransformRow1;
		float4 worldTransformRow2;
		float4 aabb0;
		float4 aabb1;
		uint4 meshData;
	};
@end

@piece( HeaderCS )
	@insertpiece( Common_Matrix_DeclLoadOgreFloat4x3 )

	struct Material
	{
		float4 bgDiffuse;
		// Jahshaka (METAL-BOUNCE-1, PHOTON-4): the colour the albedo map multiplies (the metallic workflow's
		// BASE colour, which the piece splits into the two lobes below; the specular workflows' diffuse) and
		// the transparency.
		float4 diffuse;
		// ...the emissive, and in the fourth lane the share of the mapped colour that is F0 (the metallic
		// workflow's metalness, 0 in the specular workflows)
		float3 emissive;
		float metalness;
		// the albedo map's pool slice in the low half, the emissive map's in the high half
		uint texSlices;
		// the mean of the datablock's kS: the specular lobe's scale (PhotonVoxelMaterial::writeRow)
		float specularWeight;
		// Jahshaka (PHOTON-WRITER-1): the datablock's perceptual roughness
		// (VctMaterial's row), merged per voxel into the emissive volume's alpha.
		float roughness;
		// Jahshaka (PHOTON-4): the UNTINTED F0 above the dielectric's - the specular workflows' Fresnel,
		// ( F0 - 0.04 ) / 0.96 per channel, 10:10:10 UNORM in bits 2-31 (0 in the metallic workflow)
		uint f0Packed;
	};

	@property( syntax != metal )
		CONST_BUFFER( MaterialBuf, 0 )
		{
			Material materials[1024];
		};
	@end

	struct Plane
	{
		float3 normal;
		float distance;
	};

	struct Aabb
	{
		float3 center;
		float3 halfSize;
	};

	struct Triangle
	{
		float3 v[3];
		float3 n[3];
		float2 uv[3];
	};

	// Jahshaka (ATOM P4): WHICH GEOMETRY, AND WHICH SLICE OF IT. `vertexBufferStart`
	// is gone - the row's vertex address already points at this submesh's own buffer.
	// `geomRow` names a (mesh, LOD LEVEL, submesh), so two instances of one mesh can
	// be voxelized at two different levels in the same dispatch (AT-A10).
	struct Mesh
	{
		uint geomRow;
		uint firstIndex;
		uint numIndices;
		// Jahshaka (FAR-SUN-1): 1 = the instance CASTS A SHADOW (the shadow maps' caster set,
		// GpuScene.h kGpuCaster, written by JahVoxelGather_cs.glsl); 0 = its surfaces bounce
		// light but occlude no light's march (the light injection's caster share).
		uint caster;
		// Jahshaka (PHOTON-5 stage 2): 1 = the instance's colour pass draws BOTH faces
		// (GpuScene.h kGpuTwoSided, its macroblock's CULL_NONE): a single-winding sheet
		// covers both halves of its voxels, as the rays and the raster see it.
		uint twoSided;
	};

	struct Instance
	{
		ogre_float4x3 worldTransform;
		//uint meshIdx;
		uint materialIdx;
		Aabb bounds;

		Mesh mesh;
	};

	INLINE Instance getInstance( uint instanceIdx PARAMS_ARG_DECL )
	{
		Instance retVal;

		retVal.worldTransform = makeOgreFloat4x3( instanceBuffer[instanceIdx].worldTransformRow0,
												  instanceBuffer[instanceIdx].worldTransformRow1,
												  instanceBuffer[instanceIdx].worldTransformRow2 );

		retVal.bounds.center	= instanceBuffer[instanceIdx].aabb0.xyz;
		retVal.bounds.halfSize	= instanceBuffer[instanceIdx].aabb1.xyz;

		//retVal.meshIdx		= floatBitsToUint( instanceBuffer[instanceIdx].aabb0.w );
		retVal.materialIdx	= floatBitsToUint( instanceBuffer[instanceIdx].aabb1.w );

		retVal.mesh.geomRow				= instanceBuffer[instanceIdx].meshData.x;
		retVal.mesh.firstIndex			= instanceBuffer[instanceIdx].meshData.y;
		retVal.mesh.numIndices			= instanceBuffer[instanceIdx].meshData.z;
		// meshData.w is a FLAGS lane (PHOTON-5): bit 0 the caster, bit 1 two-sided.
		retVal.mesh.caster				= instanceBuffer[instanceIdx].meshData.w & 1u;
		retVal.mesh.twoSided			= ( instanceBuffer[instanceIdx].meshData.w >> 1u ) & 1u;

		return retVal;
	}

	INLINE Triangle getTriangle( uint triIdx, Mesh mesh PARAMS_ARG_DECL )
	{
		Triangle retVal;

		GeometryRow row = geometryTable[mesh.geomRow];

		for( uint i=0u; i<3u; ++i )
		{
			uint idx = geomIndex( row, mesh.firstIndex + triIdx * 3u + i );
			retVal.v[i]		= geomPosition( row, idx );
			retVal.n[i]		= geomNormal( row, idx );
			retVal.uv[i]	= geomUv( row, idx );
		}

		return retVal;
	}

	INLINE bool intersects( Aabb a, Aabb b )
	{
		float3 absDistance = abs( a.center - b.center );
		float3 sumHalfSizes = a.halfSize + b.halfSize;

		// ( abs( center.x - center2.x ) <= halfSize.x + halfSize2.x &&
		//   abs( center.y - center2.y ) <= halfSize.y + halfSize2.y &&
		//   abs( center.z - center2.z ) <= halfSize.z + halfSize2.z )
		return	absDistance.x <= sumHalfSizes.x &&
				absDistance.y <= sumHalfSizes.y &&
				absDistance.z <= sumHalfSizes.z;
	}

	INLINE bool intersects_tri_aabb_onto_axis( float3 v0, float3 v1, float3 v2, float3 halfSize, float3 axis )
	{
		// project all 3 vertices of the triangle onto the axis
		float p0 = dot( v0, axis );
		float p1 = dot( v1, axis );
		float p2 = dot( v2, axis );

		// project the Aabb onto the axis
		float r = halfSize.x * abs( axis.x ) + halfSize.y * abs( axis.y ) + halfSize.z * abs( axis.z );
		float minP = min(p0, min(p1, p2));
		float maxP = max(p0, max(p1, p2));
		return !((maxP < -r) || (r < minP));
	}

	INLINE bool intersects_plane_aabb( Plane pl, Aabb aabb )
	{
		float r =	aabb.halfSize.x * abs( pl.normal.x ) +
					aabb.halfSize.y * abs( pl.normal.y ) +
					aabb.halfSize.z * abs( pl.normal.z );
		float s = dot( pl.normal, aabb.center ) - pl.distance;
		return abs(s) <= r;
	}

	INLINE bool intersects_tri_aabb( Triangle tri, Aabb aabb )
	{
		// Make the triangle local space to Aabb
		float3 v0 = tri.v[0] - aabb.center;
		float3 v1 = tri.v[1] - aabb.center;
		float3 v2 = tri.v[2] - aabb.center;

		// Test x axis
		if( max3( v0.x, v1.x, v2.x ) < -aabb.halfSize.x || min3( v0.x, v1.x, v2.x ) > aabb.halfSize.x )
			return false;

		// Test y axis
		if( max3( v0.y, v1.y, v2.y ) < -aabb.halfSize.y || min3( v0.y, v1.y, v2.y ) > aabb.halfSize.y )
			return false;

		// Test z axis
		if( max3( v0.z, v1.z, v2.z ) < -aabb.halfSize.z || min3( v0.z, v1.z, v2.z ) > aabb.halfSize.z )
			return false;

		// compute the edge vectors of the triangle
		// get the lines between the points as vectors
		float3 f0 = v1 - v0;
		float3 f1 = v2 - v1;
		float3 f2 = v0 - v2;

		// cross products of triangle edges & aabb edges
		// AABB normals are the x( 1, 0, 0 ), y( 0, 1, 0 ), z( 0, 0, 1 ) axis.
		// so we can get the cross products between triangle edge vectors
		// and AABB normals without calculation
		float3 a00 = float3( 0, -f0.z, f0.y ); // cross product of X and f0
		float3 a01 = float3( 0, -f1.z, f1.y ); // X and f1
		float3 a02 = float3( 0, -f2.z, f2.y ); // X and f2
		float3 a10 = float3( f0.z, 0, -f0.x ); // Y and f0
		float3 a11 = float3( f1.z, 0, -f1.x ); // Y and f1
		float3 a12 = float3( f2.z, 0, -f2.x ); // Y and f2
		float3 a20 = float3( -f0.y, f0.x, 0 ); // Z and f0
		float3 a21 = float3( -f1.y, f1.x, 0 ); // Z and f1
		float3 a22 = float3( -f2.y, f2.x, 0); // Z and f2

		// Test 9 axes
		if ( !intersects_tri_aabb_onto_axis( v0, v1, v2, aabb.halfSize, a00 ) )
			return false;
		if ( !intersects_tri_aabb_onto_axis( v0, v1, v2, aabb.halfSize, a01 ) )
			return false;
		if ( !intersects_tri_aabb_onto_axis( v0, v1, v2, aabb.halfSize, a02 ) )
			return false;
		if ( !intersects_tri_aabb_onto_axis( v0, v1, v2, aabb.halfSize, a10 ) )
			return false;
		if ( !intersects_tri_aabb_onto_axis( v0, v1, v2, aabb.halfSize, a11 ) )
			return false;
		if ( !intersects_tri_aabb_onto_axis( v0, v1, v2, aabb.halfSize, a12 ) )
			return false;
		if ( !intersects_tri_aabb_onto_axis( v0, v1, v2, aabb.halfSize, a20 ) )
			return false;
		if ( !intersects_tri_aabb_onto_axis( v0, v1, v2, aabb.halfSize, a21 ) )
			return false;
		if ( !intersects_tri_aabb_onto_axis( v0, v1, v2, aabb.halfSize, a22 ) )
			return false;


		// Test triangle normal
		Plane pl;
		pl.normal	= normalize( cross( f1, f0 ) );
		pl.distance	= dot( pl.normal, tri.v[0] );
		return intersects_plane_aabb( pl, aabb );
	}

	// https://gamedev.stackexchange.com/questions/23743/
	// whats-the-most-efficient-way-to-find-barycentric-coordinates
	INLINE float3 tri_barycentric( float3 p, Triangle tri )
	{
		float3 v0 = tri.v[1] - tri.v[0];
		float3 v1 = tri.v[2] - tri.v[0];
		float3 v2 = p - tri.v[0];

		float d00 = dot( v0, v0 );
		float d01 = dot( v0, v1 );
		float d11 = dot( v1, v1 );
		float d20 = dot( v2, v0 );
		float d21 = dot( v2, v1 );
		float denom = 1.0 / (d00 * d11 - d01 * d01);

		float3 uvw;
		uvw.y = (d11 * d20 - d01 * d21) * denom;
		uvw.z = (d00 * d21 - d01 * d20) * denom;
		uvw.x = 1.0f - uvw.y - uvw.z;

		return uvw;
	}

	INLINE float3 tri_barycentric_normal( float3 p, Triangle tri )
	{
		float3 uvw = tri_barycentric( p, tri );
		return tri.n[0] * uvw.x + tri.n[1] * uvw.y + tri.n[2] * uvw.z;
	}

	INLINE float2 tri_barycentric_uv( float3 p, Triangle tri )
	{
		float3 uvw = tri_barycentric( p, tri );
		return tri.uv[0] * uvw.x + tri.uv[1] * uvw.y + tri.uv[2] * uvw.z;
	}

	// Jahshaka (PHOTON-VOXEL-3): THE SIGNED DISTANCE OF p TO ONE OF THE VOXEL'S SIX
	// FACES, positive inside. Faces 0/2/4 are the LOW x/y/z faces, 1/3/5 the high ones.
	INLINE float voxelFaceSide( float3 p, uint face, float3 lo, float3 hi )
	{
		uint axis = face >> 1u;
		return ( face & 1u ) == 0u ? ( p[axis] - lo[axis] ) : ( hi[axis] - p[axis] );
	}

	// Jahshaka (PHOTON-VOXEL-3): THE AREA OF THE TRIANGLE INSIDE THE VOXEL, and the
	// centroid of that piece. The triangle is clipped against the voxel's six faces
	// (Sutherland-Hodgman; a triangle clipped by six planes has at most nine corners)
	// and the convex piece left is summed as a fan.
	//
	// THE VOXEL IS HALF-OPEN, [lo, hi): a point ON a low face belongs to this voxel and
	// a point ON a high face to the next one. So the voxels PARTITION a surface - a wall
	// lying exactly on a voxel boundary is counted in ONE layer, not in both (the
	// conservative box test the caller runs first takes both; this is what decides).
	// The side tests are world-space differences against lo and hi, and the caller
	// builds both from the same expression of the voxel index (origin + cell x i), so
	// the two neighbours of a boundary test it against the same float and agree about
	// which of them owns a point on it - exactly within an octant; across two octants'
	// dispatches the origins are the host's, and they agree whenever the cell and the
	// region are dyadic (every cascade this engine builds).
	INLINE float voxelClippedArea( Triangle tri, float3 lo, float3 hi, float3 voxelCentre,
								   OGRE_OUT_REF( float3, pieceCentre ) )
	{
		float3 polyA[9];
		float3 polyB[9];
		polyA[0] = tri.v[0];
		polyA[1] = tri.v[1];
		polyA[2] = tri.v[2];
		uint numA = 3u;

		for( uint face=0u; face<6u && numA >= 3u; ++face )
		{
			bool strict = ( face & 1u ) != 0u;
			uint numB = 0u;
			for( uint i=0u; i<numA; ++i )
			{
				float3 pa = polyA[i];
				float3 pb = polyA[( i + 1u ) == numA ? 0u : ( i + 1u )];
				float sa = voxelFaceSide( pa, face, lo, hi );
				float sb = voxelFaceSide( pb, face, lo, hi );
				bool ina = strict ? ( sa > 0.0f ) : ( sa >= 0.0f );
				bool inb = strict ? ( sb > 0.0f ) : ( sb >= 0.0f );
				if( ina && numB < 9u )
				{
					polyB[numB] = pa;
					++numB;
				}
				if( ina != inb && numB < 9u )
				{
					polyB[numB] = pa + ( pb - pa ) * ( sa / ( sa - sb ) );
					++numB;
				}
			}
			for( uint i=0u; i<numB; ++i )
				polyA[i] = polyB[i];
			numA = numB;
		}

		float area = 0.0f;
		float3 weighted = float3( 0.0f, 0.0f, 0.0f );
		if( numA >= 3u )
		{
			// Relative to the voxel's centre: the fan's cross products stay small.
			float3 p0 = polyA[0] - voxelCentre;
			for( uint i=1u; i + 1u<numA; ++i )
			{
				float3 p1 = polyA[i] - voxelCentre;
				float3 p2 = polyA[i + 1u] - voxelCentre;
				float a = length( cross( p1 - p0, p2 - p0 ) );
				area += a;
				weighted += a * ( p0 + p1 + p2 );
			}
		}
		pieceCentre = area > 0.0f ? voxelCentre + weighted / ( 3.0f * area ) : voxelCentre;
		return 0.5f * area;
	}
@end

//in uvec3 gl_NumWorkGroups;
//in uvec3 gl_WorkGroupID;
//in uvec3 gl_LocalInvocationID;
//in uvec3 gl_GlobalInvocationID;
//in uint  gl_LocalInvocationIndex;

@piece( VoxelPieceContribution )
	// Jahshaka (ENGINE-UPGRADE-U5 stage 2): ONE TRIANGLE'S CONTRIBUTION TO ONE VOXEL - the clip, the
	// texture reads at the piece's centroid and the integer sums on VoxelMerge's grid, into the c*
	// locals (zero where the triangle misses the voxel), the arithmetic the voxel-per-lane partition ran,
	// unchanged: the sums are exact integers, whoever adds them.
	// In: tri (world space), material, instance, voxelAabb, voxelLo, voxelHi, invFaceArea, invAxisFaceArea.
	uint  cWeight = 0u;
	uint3 cAlbedo = uint3( 0u, 0u, 0u );
	uint4 cMetal = uint4( 0u, 0u, 0u, 0u );
	uint3 cEmissive = uint3( 0u, 0u, 0u );
	uint  cRoughness = 0u;
	int3  cNormalRaw = int3( 0, 0, 0 );
	int3  cNormalFolded = int3( 0, 0, 0 );
	uint3 cAxisP = uint3( 0u, 0u, 0u );
	uint3 cAxisN = uint3( 0u, 0u, 0u );
	uint3 cCasterP = uint3( 0u, 0u, 0u );
	uint3 cCasterN = uint3( 0u, 0u, 0u );
	uint3 cEmitP = uint3( 0u, 0u, 0u );
	uint3 cEmitN = uint3( 0u, 0u, 0u );
	uint  cEmitWeight = 0u;
	uint3 cPosP = uint3( 0u, 0u, 0u );
	uint3 cPosN = uint3( 0u, 0u, 0u );
	{
			float3 pieceCentroid = voxelAabb.center;
			uint weight = 0u;
			float pieceArea = 0.0f;
			if( intersects_tri_aabb( tri, voxelAabb ) )
			{
				pieceArea = voxelClippedArea( tri, voxelLo, voxelHi,
											  voxelAabb.center, pieceCentroid );
				weight = voxelMergeWeight( pieceArea * invFaceArea );
			}
			if( weight > 0u )
			{
				// The piece's own centroid, not the voxel's centre: a
				// triangle that only clips a corner is read where it IS.
				@property( has_diffuse_tex || has_emissive_tex )
					float2 uv = tri_barycentric_uv( pieceCentroid, tri );
				@end

				float4 finalDiffuse		= material.diffuse.xyzw;
				float3 finalEmissive	= material.emissive.xyz;
			@property( has_diffuse_tex )
				finalDiffuse *= OGRE_SampleArray2DLevel( texturePool, poolSampler, uv,
														 material.texSlices & 0xFFFFu, 0 );
			@else
				finalDiffuse *= material.bgDiffuse.xyzw;
			@end

			@property( has_emissive_tex )
				finalEmissive *= OGRE_SampleArray2DLevel( texturePool, poolSampler, uv,
														  material.texSlices >> 16u, 0 ).xyz;
			@end

				// THE TWO LOBES (VOXEL-METAL-ALBEDO-1, METAL-BOUNCE-1, ENGINE-POLISH-PHOTON-1 stage 2, PHOTON-4):
				// of the mapped colour b at metalness m, HlmsPbs's diffuse lobe takes b (1 - m) - the albedo
				// volume - and its specular lobe kS ( F0 A + B ) with F0 = lerp( 0.04, b, m ) in the metallic
				// workflow (800.PixelShader), the datablock's Fresnel f in the specular workflows (m = 0
				// there, f untinted by the map): EVERY surface's, a dielectric's too. The specular volume
				// holds F0 kS = kS ( 0.04 + m max( b - 0.04, 0 ) + ( f - 0.04 ) ) and the Fresnel-90 weight
				// kS, which the injection and the bounce re-emit by the lobe's integral (JahSpecularAlbedo).
				// Both are area means like every material property here.
				// THE VOLUME HOLDS F0 RELATIVE TO THE DIELECTRIC'S: rgb = ( F0 kS - 0.04 kS ) / 0.96 =
				// kS m ( b - 0.04 ) / 0.96, alpha = kS, and every reader takes F0 kS = 0.04 alpha +
				// 0.96 rgb (linear, so the area means stay exact). A dielectric then stores rgb = 0 and
				// its 0.04 kS is exact, where a plain RGBA8 F0 would round 0.04 to 10 / 255 (-2 % of a
				// 4 % term); a white metal stores 1 exactly. Stated: a metal darker than 0.04 (b m below
				// 0.04 m) clamps at the dielectric's F0, an excess of under 0.04 kS.
				const float specW = material.specularWeight;
				const uint f0Word = material.f0Packed;
				const float3 f0Rel = float3( float( ( f0Word >> 2u ) & 1023u ), float( ( f0Word >> 12u ) & 1023u ),
											 float( f0Word >> 22u ) ) * ( 1.0f / 1023.0f );
				const float3 specRel = max( finalDiffuse.xyz - float3( 0.04f, 0.04f, 0.04f ),
											float3( 0.0f, 0.0f, 0.0f ) ) *
									   ( material.metalness * specW * ( 1.0f / 0.96f ) ) +
									   f0Rel * specW;
				cAlbedo		= voxelMergeWeigh3( voxelMergeQuantize3( finalDiffuse.xyz *
																	 ( 1.0f - material.metalness ) ),
												weight );
				cMetal		= voxelMergeWeigh4( voxelMergeQuantize4( float4( specRel, specW ) ),
												weight );
				cEmissive		= voxelMergeWeigh3( voxelMergeQuantize3( finalEmissive ),
													 weight );
				cRoughness	= voxelMergeWeigh3( voxelMergeQuantize3(
									   float3( material.roughness, 0.0f, 0.0f ) ),
									   weight ).x;

				float3 triNormal = tri_barycentric_normal( pieceCentroid, tri );
				triNormal = normalize( triNormal );

				// Jahshaka fork ad452604a+155a56bf8+0338ca7f2+c4c80b5f7 (was 0065): every normal goes into BOTH sums,
				// raw and folded, and nothing is dropped. The "these two
				// surfaces face opposite ways" decision upstream made
				// here, against the sum SO FAR, is made once at the end
				// of this shader from the two sums — see
				// `voxelMergeNormal` in VoxelMerge_piece_cs.any. (The old
				// code is worth remembering: `cosAngle <= -0.5` dropped
				// the triangle from the sum and set a double-sided flag,
				// so the FIRST triangle a thread happened to see decided
				// which way the voxel faced.)
				cNormalRaw	= voxelMergeWeighSigned3(
										voxelMergeQuantizeSigned3( triNormal ), weight );
				cNormalFolded	= voxelMergeWeighSigned3(
										voxelMergeQuantizeSigned3(
											voxelMergeCanonical( triNormal ) ), weight );

				cWeight = weight;

				// The triangle's GEOMETRIC normal: the projected area
				// of a flat piece is its area times |n . axis| exactly,
				// whatever the shading normals say.
				float3 geoN = cross( tri.v[1] - tri.v[0], tri.v[2] - tri.v[0] );
				float geoLen = length( geoN );
				geoN = geoLen > 0.0f ? geoN / geoLen : float3( 0.0f, 0.0f, 0.0f );
				// THE SIDE IT FACES IS THE AUTHORED ONE (PHOTON-VOXEL-4): the coverage
				// is split by the side a face looks to, and the winding's cross product
				// is only the facing up to the mesh's convention (a mirrored instance
				// flips it) - the interpolated shading normal says which way it looks.
				if( dot( geoN, triNormal ) < 0.0f )
					geoN = -geoN;
				const float3 axisScale = invAxisFaceArea * ( pieceArea * saturate( finalDiffuse.w ) );
				// A TWO-SIDED SHEET FACES BOTH WAYS (PHOTON-5 stage 2): its one winding covers
				// both halves, exactly what the same sheet authored as two opposed windings
				// writes - a ray meets the faces looking against it (jah_voxel_sample), so a
				// one-sided half left a leaf card transparent from its back. The caster
				// copies below follow the same halves.
				const float3 contribP = ( instance.mesh.twoSided != 0u ? abs( geoN )
										  : max( geoN, float3( 0.0f, 0.0f, 0.0f ) ) ) * axisScale;
				const float3 contribN = ( instance.mesh.twoSided != 0u ? abs( geoN )
										  : max( -geoN, float3( 0.0f, 0.0f, 0.0f ) ) ) * axisScale;
				cAxisP = voxelMergeAxisQuantize( contribP );
				cAxisN = voxelMergeAxisQuantize( contribN );
				if( instance.mesh.caster != 0u )
				{
					cCasterP = voxelMergeAxisQuantize( contribP );
					cCasterN = voxelMergeAxisQuantize( contribN );
				}
				// JUNCTION-NORMAL-1: an EMITTING piece's share of the coverage and of the weight
				// (VoxelMerge_piece_cs.any, THE EMISSIVE PER HALF-AXIS).
				if( any( greaterThan( cEmissive, uint3( 0u, 0u, 0u ) ) ) )
				{
					cEmitP = cAxisP;
					cEmitN = cAxisN;
					cEmitWeight = weight;
				}
				const float3 cellLocal =
					saturate( ( pieceCentroid - voxelLo ) / p_voxelCellSize );
				cPosP = voxelMergeAxisQuantize( contribP * cellLocal );
				cPosN = voxelMergeAxisQuantize( contribN * cellLocal );
				// THE OTHER WINDING'S SUMS (PHOTON-5 stage 2): a two-sided piece is written as the
				// two pieces the same sheet authored as two opposed windings writes, sum for sum -
				// the halves above already hold both, every weighted mean takes the piece twice and
				// the normal sums take the opposed normal as the second piece's, so the merge
				// recovers its two groups and the voxel is two-sided (the injection lights its back).
				if( instance.mesh.twoSided != 0u )
				{
					cWeight *= 2u;
					cAlbedo *= 2u;
					cMetal *= 2u;
					cEmissive *= 2u;
					cRoughness *= 2u;
					cEmitWeight *= 2u;
					cNormalRaw += voxelMergeWeighSigned3(
										voxelMergeQuantizeSigned3( -triNormal ), weight );
					cNormalFolded += voxelMergeWeighSigned3(
										voxelMergeQuantizeSigned3(
											voxelMergeCanonical( -triNormal ) ), weight );
				}
			}
	}
@end

@piece( BodyCS )
	// Jahshaka (ENGINE-UPGRADE-U5 stage 1): THE BOUNDS GUARD. A dispatch covers its octant in 4^3
	// groups rounded UP, so an octant whose size is not a multiple of four (a scroll's entering slab:
	// the step in cells) has lanes past its edge. They run the loop below like every other lane -
	// their triangles' clips reach in-octant voxels too - and write nothing: the voxel they would write belongs to the
	// copied part of the volume or lies outside it. Upstream's check_out_of_bounds, the same test.
	bool voxelInBounds = gl_GlobalInvocationID.x < p_voxelPixelsToWrite.x &&
							   gl_GlobalInvocationID.y < p_voxelPixelsToWrite.y &&
							   gl_GlobalInvocationID.z < p_voxelPixelsToWrite.z;

	Aabb voxelAabb;
	voxelAabb.center	= p_voxelOrigin + p_voxelCellSize * (float3( gl_GlobalInvocationID.xyz ) + 0.5f);
	voxelAabb.halfSize	= p_voxelCellSize * 0.5f;

	Aabb groupVoxelAabb;
	groupVoxelAabb.center	= p_voxelOrigin +
							  4.0f * p_voxelCellSize * (float3( gl_WorkGroupID.xyz ) + 0.5f);
	groupVoxelAabb.halfSize	= 4.0f * p_voxelCellSize * 0.5f;

	// Jahshaka (PHOTON-VOXEL-3): THE VOXEL'S AREA WEIGHT. What a triangle contributes
	// to the voxel's material MEANS is weighted by its area inside the voxel (over the
	// voxel's mean face area, only so the weight sits on VoxelMerge's grid - the means
	// divide it out). The sum of the weights replaces upstream's triangle count as the
	// divisor (VoxelMerge_piece_cs.any, THE DIVISOR IS THE AREA).
	float3 voxelLo = p_voxelOrigin + p_voxelCellSize * float3( gl_GlobalInvocationID.xyz );
	float3 voxelHi = p_voxelOrigin + p_voxelCellSize * float3( gl_GlobalInvocationID.xyz + 1u );
	float invFaceArea = 1.0f / pow( p_voxelCellSize.x * p_voxelCellSize.y * p_voxelCellSize.z,
									2.0f / 3.0f );
	// ...and each AXIS's coverage is over THAT axis's face: y z for x, z x for y, x y
	// for z. A scene-fitted volume's cells are not cubes (a 10 m room 5 m tall:
	// cells half as tall as wide), and one mean face area there left a floor-to-
	// ceiling wall 0.77 opaque along its own normal.
	float3 invAxisFaceArea = 1.0f / ( p_voxelCellSize.yzx * p_voxelCellSize.zxy );
	uint accumWeight = 0u;
	// Jahshaka (FAR-SUN-1): THE CASTERS' COVERAGE per half-axis, on the coverage's own grid - the
	// part of the voxel's coverage the light injection's march may count as an occluder
	// (VoxelMerge_piece_cs.any, THE CASTER SHARE).
	uint3 accCasterP = uint3( 0u, 0u, 0u );
	uint3 accCasterN = uint3( 0u, 0u, 0u );
	// Jahshaka (JUNCTION-NORMAL-1): THE EMITTERS' COVERAGE per half-axis and their weight.
	uint3 accEmitP = uint3( 0u, 0u, 0u );
	uint3 accEmitN = uint3( 0u, 0u, 0u );
	uint  accEmitWeight = 0u;
	// Jahshaka (PHOTON-VOXEL-3): THE VOXEL'S COVERAGE PER AXIS - the surface's
	// area inside the voxel PROJECTED onto each axis, over the voxel's face area,
	// times the material's opacity: sum of w * alpha * |n . axis| on
	// VoxelMerge's per-axis grid (voxelMergeAxisQuantize). This is what a ray
	// along that axis sees of the voxel: a thin wall on the xy plane covers its
	// voxels fully along z and not at all along x and y, which no single
	// per-voxel opacity can say (VoxelMerge_piece_cs.any, THE DIRECTIONAL
	// COVERAGE).
	// (PHOTON-VOXEL-4) SPLIT BY THE SIDE THE PIECE LOOKS TO: +a and -a (VoxelMerge_piece_cs.any).
	uint3 accAxisP = uint3( 0u, 0u, 0u );
	uint3 accAxisN = uint3( 0u, 0u, 0u );
	// Jahshaka (PHOTON-VOXEL-4): THE SURFACE POSITION - the same contributions, each times
	// the piece's centroid along its axis in the cell's own coordinate [0, 1]
	// (VoxelMerge_piece_cs.any, THE SURFACE POSITION).
	uint3 accPosP = uint3( 0u, 0u, 0u );
	uint3 accPosN = uint3( 0u, 0u, 0u );
	// Jahshaka fork ad452604a+155a56bf8+0338ca7f2+c4c80b5f7 (was 0065): the SUMS this dispatch adds to the voxel's running
	// integer total, on VoxelMerge's fixed-point grid. They are exact and they
	// are ALL of the state, so neither the split of the instances between
	// dispatches nor their order inside one decides anything
	// (VoxelMerge_piece_cs.any has the whole argument).
	uint3 accAlbedo			= uint3( 0u, 0u, 0u );
	uint4 accMetal			= uint4( 0u, 0u, 0u, 0u );	// METAL-BOUNCE-1: F0 rgb, the Fresnel-90 weight
	int3  accNormalRaw		= int3( 0, 0, 0 );
	int3  accNormalFolded	= int3( 0, 0, 0 );
	uint3 accEmissive		= uint3( 0u, 0u, 0u );
	uint  accRoughness		= 0u;	// PHOTON-WRITER-1: the fourteenth sum

	// THE RECORDS OF THIS (octant, bucket), as the host's gather wrote them on the
	// device: (start, count) into the instance buffer. Dynamically uniform - every
	// lane reads the same range.
	uint2 instanceRange = ranges[p_rangeIdx];
	// Jahshaka (ENGINE-UPGRADE-U5 stage 2): THE WORK PARTITION - A TRIANGLE PER LANE, THE SUMS IN
	// GROUPSHARED. The voxeliser used to give each of the group's 64 lanes ONE VOXEL and loop it over
	// every triangle of every batch the group vote let through: every triangle fetched, transformed and
	// clipped 64 times over, and T serial steps per lane - so a dispatch ran as long as its densest
	// group (measured on Bistro's walk: a scroll chunk of 380 ms, U5 stage 1). Now LANE t TAKES
	// TRIANGLE triIdxBase + t: it is fetched and transformed ONCE, and clipped only against the voxels
	// of the group its box reaches (most triangles touch 1-8 of the 64), each contribution added with
	// an atomic into that voxel's GROUPSHARED sums. The sums are EXACT INTEGERS on VoxelMerge's grid -
	// order-free, whoever adds them - and the arithmetic is the one piece both partitions insert
	// (VoxelPieceContribution), so the store is the old one bit for bit - proved on Bistro (cascades 2
	// and 0 built whole under the old piece and this one in the same binary: the nine-volume store
	// digests equal; cascade 2 567 -> 31 ms of GPU, cascade 0 65 -> 13) and by the six hashes.
	// (gi.scroll_slab's float-for-float equality is this partition against itself: it proves the
	// scroll, not the partition.)
	// The reference partition and its arm are deleted; the group vote too (decision 12.5). The
	// broadphase, the octants and the buckets are unchanged.
	@foreach( 43, k )
		g_voxelSums[@k * 64 + gl_LocalInvocationIndex] = 0u;
	@end
	__sharedOnlyBarrier;
	const float3 groupLo = p_voxelOrigin + 4.0f * p_voxelCellSize * float3( gl_WorkGroupID.xyz );
	for( uint i=instanceRange.x; i<instanceRange.x + instanceRange.y; ++i )
	{
		Instance instance = getInstance( i PARAMS_ARG );

		//Broadphase culling: the record against the group's box (every lane runs the same records).
		if( intersects( groupVoxelAabb, instance.bounds ) )
		{
			Material material = materials[instance.materialIdx];

			uint numTris = instance.mesh.numIndices / 3u;

			for( uint triIdxBase=0u; triIdxBase<numTris; triIdxBase += 64u )
			{
				// THE BATCH: lane t owns triangle triIdxBase + t, and the batch's tail ENDS it
				// (PHOTON-VOXEL-3): a lane past it owns no triangle. NO GROUP VOTE (decision 12.5): it
				// was the voxel-per-lane loop's batch filter - every lane now skips, by its own
				// triangle's box, exactly what the vote would have skipped, and the vote's emulation
				// cost seven barriers a batch.
				uint numInBatch = min( 64u, numTris - triIdxBase );
				if( gl_LocalInvocationIndex < numInBatch )
				{
					uint triIdx = triIdxBase + gl_LocalInvocationIndex;
					// FETCHED AND TRANSFORMED ONCE (decision 12.6): the box below is made from these
					// vertices - the arithmetic the deleted second-fetch box made, value for value.
					Triangle tri = getTriangle( triIdx, instance.mesh PARAMS_ARG );

					for( uint i=0; i<3u; ++i )
					{
						tri.v[i] = mul( float4( tri.v[i], 1.0f ), instance.worldTransform );
						tri.n[i] = mul( tri.n[i], toFloat3x3( instance.worldTransform ) );
					}
					const float3 triMin = min( min( tri.v[0], tri.v[1] ), tri.v[2] );
					const float3 triMax = max( max( tri.v[0], tri.v[1] ), tri.v[2] );
					Aabb triAabb;
					triAabb.center		= ( triMin + triMax ) * 0.5f;
					triAabb.halfSize	= ( triMax - triMin ) * 0.5f;

					// THE GROUP'S BOX CULLS A TRIANGLE ONLY WHERE NO CLIP COULD GIVE IT AREA. That is
					// the exactness of this partition, and it rests on the LATTICE: a cascade's origin
					// is an exact integer multiple of its cell and the cell a short dyadic rational, so
					// a voxel's corner origin + cell x id is exact and the group's box is exactly the
					// union of its 64 voxels - a triangle reaching a voxel with area reaches the box.
					// The host asserts the lattice where the placement is set (PhotonGi.cpp,
					// recentreCascade, under JAH_DEBUG): a non-dyadic origin is a bug, not a case.
					if( intersects( triAabb, groupVoxelAabb ) )
					{
						// THE VOXELS ITS BOX REACHES, widened by a thousandth of a cell each way: a
						// superset, so every voxel the clip gives an area is visited, each by the same
						// test as before. CLAMPED IN FLOAT, then converted (decision 12.8): a float
						// outside the int range is undefined in the conversion; a NaN goes to 0.
						float3 fLo = clamp( floor( ( triMin - groupLo ) / p_voxelCellSize - 1e-3f ),
											float3( 0.0f, 0.0f, 0.0f ), float3( 3.0f, 3.0f, 3.0f ) );
						float3 fHi = clamp( floor( ( triMax - groupLo ) / p_voxelCellSize + 1e-3f ),
											float3( 0.0f, 0.0f, 0.0f ), float3( 3.0f, 3.0f, 3.0f ) );
						// THE NaN TEST IS ON THE BITS (trap 5: x == x is no NaN test in our shaders).
						for( int a = 0; a < 3; ++a )
						{
							if( ( floatBitsToUint( fLo[a] ) & 0x7FFFFFFFu ) > 0x7F800000u ) fLo[a] = 0.0f;
							if( ( floatBitsToUint( fHi[a] ) & 0x7FFFFFFFu ) > 0x7F800000u ) fHi[a] = 0.0f;
						}
						const int3 vLo = int3( fLo );
						const int3 vHi = int3( fHi );
						for( int vz = vLo.z; vz <= vHi.z; ++vz )
						for( int vy = vLo.y; vy <= vHi.y; ++vy )
						for( int vx = vLo.x; vx <= vHi.x; ++vx )
						{
							// THE VOXEL'S OWN ARITHMETIC, as its lane computes it above.
							const uint3 vid = gl_WorkGroupID.xyz * 4u + uint3( vx, vy, vz );
							if( vid.x >= p_voxelPixelsToWrite.x || vid.y >= p_voxelPixelsToWrite.y ||
								vid.z >= p_voxelPixelsToWrite.z )
								continue;   // past the octant: written by nobody (the bounds guard)
							Aabb voxelAabb;
							voxelAabb.center	= p_voxelOrigin + p_voxelCellSize * (float3( vid ) + 0.5f);
							voxelAabb.halfSize	= p_voxelCellSize * 0.5f;
							float3 voxelLo = p_voxelOrigin + p_voxelCellSize * float3( vid );
							float3 voxelHi = p_voxelOrigin + p_voxelCellSize * float3( vid + 1u );

							@insertpiece( VoxelPieceContribution )

							if( cWeight > 0u )
							{
								const uint v = uint( vx + 4 * vy + 16 * vz );
								@foreach( 3, c )
									atomicAdd( g_voxelSums[( 0 + @c ) * 64 + v], cAlbedo[@c] );
									atomicAdd( g_voxelSums[( 33 + @c ) * 64 + v], cMetal[@c] );
								@end
								atomicAdd( g_voxelSums[3 * 64 + v], cMetal.w );
								@foreach( 3, c )
									atomicAdd( g_voxelSums[( 4 + @c ) * 64 + v], uint( cNormalRaw[@c] ) );
									atomicAdd( g_voxelSums[( 7 + @c ) * 64 + v], uint( cNormalFolded[@c] ) );
									atomicAdd( g_voxelSums[( 10 + @c ) * 64 + v], cEmissive[@c] );
									atomicAdd( g_voxelSums[( 15 + @c ) * 64 + v], cAxisP[@c] );
									atomicAdd( g_voxelSums[( 18 + @c ) * 64 + v], cAxisN[@c] );
									atomicAdd( g_voxelSums[( 21 + @c ) * 64 + v], cPosP[@c] );
									atomicAdd( g_voxelSums[( 24 + @c ) * 64 + v], cPosN[@c] );
									atomicAdd( g_voxelSums[( 27 + @c ) * 64 + v], cCasterP[@c] );
									atomicAdd( g_voxelSums[( 30 + @c ) * 64 + v], cCasterN[@c] );
									atomicAdd( g_voxelSums[( 36 + @c ) * 64 + v], cEmitP[@c] );
									atomicAdd( g_voxelSums[( 39 + @c ) * 64 + v], cEmitN[@c] );
								@end
								atomicAdd( g_voxelSums[42 * 64 + v], cEmitWeight );
								atomicAdd( g_voxelSums[13 * 64 + v], cRoughness );
								atomicAdd( g_voxelSums[14 * 64 + v], cWeight );
							}
						}
					}
				}
			}
		}
	}
	__sharedOnlyBarrier;
	// THIS LANE'S VOXEL'S SUMS, as its own loop used to leave them.
	{
		const uint v = gl_LocalInvocationIndex;
		@foreach( 3, c )
			accAlbedo[@c] = g_voxelSums[( 0 + @c ) * 64 + v];
			accMetal[@c] = g_voxelSums[( 33 + @c ) * 64 + v];
		@end
		accMetal.w = g_voxelSums[3 * 64 + v];
		@foreach( 3, c )
			accNormalRaw[@c]	= int( g_voxelSums[( 4 + @c ) * 64 + v] );
			accNormalFolded[@c]	= int( g_voxelSums[( 7 + @c ) * 64 + v] );
			accEmissive[@c]		= g_voxelSums[( 10 + @c ) * 64 + v];
			accAxisP[@c]		= g_voxelSums[( 15 + @c ) * 64 + v];
			accAxisN[@c]		= g_voxelSums[( 18 + @c ) * 64 + v];
			accPosP[@c]			= g_voxelSums[( 21 + @c ) * 64 + v];
			accPosN[@c]			= g_voxelSums[( 24 + @c ) * 64 + v];
			accCasterP[@c]		= g_voxelSums[( 27 + @c ) * 64 + v];
			accCasterN[@c]		= g_voxelSums[( 30 + @c ) * 64 + v];
			accEmitP[@c]		= g_voxelSums[( 36 + @c ) * 64 + v];
			accEmitN[@c]		= g_voxelSums[( 39 + @c ) * 64 + v];
		@end
		accEmitWeight	= g_voxelSums[42 * 64 + v];
		accRoughness	= g_voxelSums[13 * 64 + v];
		accumWeight		= g_voxelSums[14 * 64 + v];
	}

	// Jahshaka fork ad452604a+155a56bf8+0338ca7f2+c4c80b5f7 (was 0065) — ACCUMULATE, THEN RESOLVE, IN ONE DISPATCH.
	//
	// This dispatch adds ITS triangles to the voxel's exact integer sums and then
	// writes the mean of the TOTAL the accumulator now holds. Whichever dispatch
	// happens to be last at a voxel therefore leaves the complete answer, and an
	// earlier one's partial answer is always overwritten by it — so the picture
	// depends on the sums and not on who wrote them, which is the whole point.
	// It also stops visiting voxels it contributed nothing to (the merge this
	// replaces had `accumTris + origAccumTris > 0`, so a dispatch re-rounded
	// every voxel an earlier one had filled), which is most of them.
	//
	// `voxelAccumVal` was the pin's triangle counter and the divisor; it now holds
	// the voxel's COVERAGE on the merge's fixed-point grid (PHOTON-VOXEL-3), read and
	// written exactly where upstream read and wrote the count.
	// WHERE IT IS STORED (PHOTON-7 stage 2, p_voxelStoreBase): the cell itself for a whole build, the scroll scratch's
	// layout for a scroll's chunk - the merge's accumulator below keeps the volume's own cell (voxelCel).
	const int3 jahStoreCel = int3( gl_GlobalInvocationID.xyz + p_voxelPixelOrigin );
	const int3 jahStorePerm = p_voxelStoreBase.w == 1 ? jahStoreCel.yxz
												   : ( p_voxelStoreBase.w == 2 ? jahStoreCel.zxy : jahStoreCel );
	wshort3 voxelCelUvw = wshort3( jahStorePerm + p_voxelStoreBase.xyz );

	@property( syntax != hlsl || typed_uav_load )
		uint origAccumWeight = voxelInBounds ? OGRE_imageLoad3D( voxelAccumVal, voxelCelUvw ).x : 0u;
	@else
		uint origAccumWeightVal = OGRE_imageLoad3D( voxelAccumVal,
													wshort3( voxelCelUvw.x >> 1u, voxelCelUvw.yz ) ).x;
		uint origAccumWeight = (gl_LocalInvocationIndex & 0x1u) ? (origAccumWeightVal >> 16u) :
																  (origAccumWeightVal & 0xFFFFu);
	@end

	if( accumWeight > 0u && voxelInBounds )
	{
		uint3 voxelCel = uint3( gl_GlobalInvocationID.xyz ) + uint3( p_voxelPixelOrigin );

		// The scalar texels per voxel (VoxelMerge_piece_cs.any has the layout): the albedo rgb,
		// the metal's F0 rgb and Fresnel-90 weight (METAL-BOUNCE-1), the raw normal xyz, the
		// emissive rgb, the folded normal xyz, the roughness (PHOTON-WRITER-1), the coverage, the
		// position and the casters per half. Only what carries something.
		uint3 sumAlbedo		= uint3( 0u, 0u, 0u );
		uint4 sumMetal		= uint4( 0u, 0u, 0u, 0u );
		uint4 sumNormal		= uint4( 0u, 0u, 0u, 0u );
		uint4 sumEmissive	= uint4( 0u, 0u, 0u, 0u );
		uint4 sumFolded		= uint4( 0u, 0u, 0u, 0u );
		uint  sumRoughness	= OGRE_imageLoad3D( voxelMergeAccum, voxelMergeUvw( voxelCel, 13u ) ).x;
		// PHOTON-VOXEL-3/-4: the per-half-axis coverage sums (+14 the faces looking +a,
		// +15 looking -a) and their position-weighted twins (+16, +17), packed.
		uint  sumAxisP	= OGRE_imageLoad3D( voxelMergeAccum, voxelMergeUvw( voxelCel, 14u ) ).x;
		uint  sumAxisN	= OGRE_imageLoad3D( voxelMergeAccum, voxelMergeUvw( voxelCel, 15u ) ).x;
		uint  sumPosP	= OGRE_imageLoad3D( voxelMergeAccum, voxelMergeUvw( voxelCel, 16u ) ).x;
		uint  sumPosN	= OGRE_imageLoad3D( voxelMergeAccum, voxelMergeUvw( voxelCel, 17u ) ).x;
		// FAR-SUN-1: the casters' coverage (+18 looking +a, +19 looking -a), saturating like the others.
		uint  sumCasterP	= voxelMergeAxisAddSat( OGRE_imageLoad3D( voxelMergeAccum, voxelMergeUvw( voxelCel, 18u ) ).x,
												accCasterP );
		uint  sumCasterN	= voxelMergeAxisAddSat( OGRE_imageLoad3D( voxelMergeAccum, voxelMergeUvw( voxelCel, 19u ) ).x,
												accCasterN );
		// JUNCTION-NORMAL-1: the emitters' coverage (+23 looking +a, +24 -a) and weight (+25).
		uint  sumEmitP	= voxelMergeAxisAddSat( OGRE_imageLoad3D( voxelMergeAccum, voxelMergeUvw( voxelCel, 23u ) ).x,
											accEmitP );
		uint  sumEmitN	= voxelMergeAxisAddSat( OGRE_imageLoad3D( voxelMergeAccum, voxelMergeUvw( voxelCel, 24u ) ).x,
											accEmitN );
		uint  sumEmitWeight	= voxelMergeAddSat( OGRE_imageLoad3D( voxelMergeAccum, voxelMergeUvw( voxelCel, 25u ) ).x,
											accEmitWeight );
		@foreach( 3, c )
			sumAlbedo[@c]	= OGRE_imageLoad3D( voxelMergeAccum, voxelMergeUvw( voxelCel, @c ) ).x;
			sumMetal[@c]	= OGRE_imageLoad3D( voxelMergeAccum, voxelMergeUvw( voxelCel, 20u + @c ) ).x;
		@end
		sumMetal.w	= OGRE_imageLoad3D( voxelMergeAccum, voxelMergeUvw( voxelCel, 3u ) ).x;
		@foreach( 3, c )
			sumNormal[@c]	= OGRE_imageLoad3D( voxelMergeAccum, voxelMergeUvw( voxelCel, 4u + @c ) ).x;
			sumEmissive[@c]	= OGRE_imageLoad3D( voxelMergeAccum, voxelMergeUvw( voxelCel, 7u + @c ) ).x;
			sumFolded[@c]	= OGRE_imageLoad3D( voxelMergeAccum, voxelMergeUvw( voxelCel, 10u + @c ) ).x;
		@end

		// SATURATING on the two unsigned sums — a contribution is at most
		// 16 * 4096, sixty-five thousand of them fill a uint32, and nothing caps
		// the triangle count at sixty-five thousand on this backend. Saturating
		// addition is commutative and associative, so the merge stays exactly as
		// order-independent as it was (VoxelMerge_piece_cs.any, THE GRID).
		@foreach( 3, c )
			sumAlbedo[@c]	= voxelMergeAddSat( sumAlbedo[@c], accAlbedo[@c] );
		@end
		@foreach( 4, c )
			sumMetal[@c]	= voxelMergeAddSat( sumMetal[@c], accMetal[@c] );
		@end
		@foreach( 3, c )
			sumEmissive[@c]	= voxelMergeAddSat( sumEmissive[@c], accEmissive[@c] );
		@end
		sumRoughness	= voxelMergeAddSat( sumRoughness, accRoughness );
		voxelMergeAxisPosAddSat( sumAxisP, sumPosP, accAxisP, accPosP );
		voxelMergeAxisPosAddSat( sumAxisN, sumPosN, accAxisN, accPosN );
		// Two's complement: a signed sum kept in a uint wraps the same way in
		// every order, which is the whole point of doing this in integers — and a
		// unit vector's quantised component is 4,096, so half a million triangles
		// in one voxel would be needed to reach the wrap at all.
		sumNormal.xyz	= uint3( int3( sumNormal.xyz ) + accNormalRaw );
		sumFolded.xyz	= uint3( int3( sumFolded.xyz ) + accNormalFolded );

		@foreach( 3, c )
			OGRE_imageWrite3D1( voxelMergeAccum, voxelMergeUvw( voxelCel, @c ),
								uint4( sumAlbedo[@c], 0u, 0u, 0u ) );
			OGRE_imageWrite3D1( voxelMergeAccum, voxelMergeUvw( voxelCel, 20u + @c ),
								uint4( sumMetal[@c], 0u, 0u, 0u ) );
		@end
		OGRE_imageWrite3D1( voxelMergeAccum, voxelMergeUvw( voxelCel, 3u ), uint4( sumMetal.w, 0u, 0u, 0u ) );
		OGRE_imageWrite3D1( voxelMergeAccum, voxelMergeUvw( voxelCel, 13u ),
							uint4( sumRoughness, 0u, 0u, 0u ) );
		OGRE_imageWrite3D1( voxelMergeAccum, voxelMergeUvw( voxelCel, 14u ), uint4( sumAxisP, 0u, 0u, 0u ) );
		OGRE_imageWrite3D1( voxelMergeAccum, voxelMergeUvw( voxelCel, 15u ), uint4( sumAxisN, 0u, 0u, 0u ) );
		OGRE_imageWrite3D1( voxelMergeAccum, voxelMergeUvw( voxelCel, 16u ), uint4( sumPosP, 0u, 0u, 0u ) );
		OGRE_imageWrite3D1( voxelMergeAccum, voxelMergeUvw( voxelCel, 17u ), uint4( sumPosN, 0u, 0u, 0u ) );
		OGRE_imageWrite3D1( voxelMergeAccum, voxelMergeUvw( voxelCel, 18u ), uint4( sumCasterP, 0u, 0u, 0u ) );
		OGRE_imageWrite3D1( voxelMergeAccum, voxelMergeUvw( voxelCel, 19u ), uint4( sumCasterN, 0u, 0u, 0u ) );
		OGRE_imageWrite3D1( voxelMergeAccum, voxelMergeUvw( voxelCel, 23u ), uint4( sumEmitP, 0u, 0u, 0u ) );
		OGRE_imageWrite3D1( voxelMergeAccum, voxelMergeUvw( voxelCel, 24u ), uint4( sumEmitN, 0u, 0u, 0u ) );
		OGRE_imageWrite3D1( voxelMergeAccum, voxelMergeUvw( voxelCel, 25u ), uint4( sumEmitWeight, 0u, 0u, 0u ) );
		@foreach( 3, c )
			OGRE_imageWrite3D1( voxelMergeAccum, voxelMergeUvw( voxelCel, 4u + @c ),
								uint4( sumNormal[@c], 0u, 0u, 0u ) );
			OGRE_imageWrite3D1( voxelMergeAccum, voxelMergeUvw( voxelCel, 7u + @c ),
								uint4( sumEmissive[@c], 0u, 0u, 0u ) );
			OGRE_imageWrite3D1( voxelMergeAccum, voxelMergeUvw( voxelCel, 10u + @c ),
								uint4( sumFolded[@c], 0u, 0u, 0u ) );
		@end

		// The divisor of the MEANS, stored back into an R16_UINT: capped at its range
		// (16 full voxels of area on the 1/4096 grid - a divisor, so the cap only
		// rounds a mean that is already exact to the grid).
		uint totalWeight = min( accumWeight + origAccumWeight, 0xFFFFu );
		float3 voxelCoverageP	= voxelMergeAxisResolve( sumAxisP );
		float3 voxelCoverageN	= voxelMergeAxisResolve( sumAxisN );
		float3 voxelCoverage	= max( voxelCoverageP, voxelCoverageN );
		float4 voxelAlbedo		= voxelMergeAlbedo( sumAlbedo, totalWeight, voxelCoverage );
		float4 voxelNormal		= voxelMergeNormal( sumNormal, sumFolded, totalWeight );
		float4 voxelEmissive	= voxelMergeEmissive( sumEmissive, sumRoughness, totalWeight );
		float4 voxelMetal		= voxelMergeMetal( sumMetal, totalWeight );

		@property( syntax != hlsl || typed_uav_load )
			OGRE_imageWrite3D4( voxelAlbedoTex, voxelCelUvw, voxelAlbedo );
			OGRE_imageWrite3D4( voxelNormalTex, voxelCelUvw, voxelNormal );
			OGRE_imageWrite3D4( voxelEmissiveTex, voxelCelUvw, voxelEmissive );
			OGRE_imageWrite3D4( voxelMetalTex, voxelCelUvw, voxelMetal );
			OGRE_imageWrite3D1( voxelAccumVal, voxelCelUvw, uint4( totalWeight, 0u, 0u, 0u ) );
			OGRE_imageWrite3D4( voxelCoveragePTex, voxelCelUvw, float4( voxelCoverageP, 0.0f ) );
			OGRE_imageWrite3D4( voxelCoverageNTex, voxelCelUvw, float4( voxelCoverageN, 0.0f ) );
			// JUNCTION-NORMAL-1: the emissive factor per half-axis (VoxelMerge_piece_cs.any).
			OGRE_imageWrite3D4( voxelEmitPTex, voxelCelUvw,
								float4( voxelMergeEmitFactor( sumEmitP, sumAxisP, sumEmitWeight, totalWeight ), 0.0f ) );
			OGRE_imageWrite3D4( voxelEmitNTex, voxelCelUvw,
								float4( voxelMergeEmitFactor( sumEmitN, sumAxisN, sumEmitWeight, totalWeight ), 0.0f ) );
			// FAR-SUN-1: THE CASTER SHARE in both position halves' alpha (16 bits; otherwise
			// unused - VoxelMerge_piece_cs.any).
			const float casterShareP = voxelMergeCasterShare( sumCasterP, sumAxisP );
			const float casterShareN = voxelMergeCasterShare( sumCasterN, sumAxisN );
			// PHOTON-VOXEL-4: the surface position per half-axis, O-premultiplied, relative to the voxel's own cell
			// (PHOTON-7 stage 1: the same bits at every placement of the box).
			OGRE_imageWrite3D4( voxelPositionPTex, voxelCelUvw,
								float4( voxelMergePositionResolve( sumPosP, sumAxisP ), casterShareP ) );
			OGRE_imageWrite3D4( voxelPositionNTex, voxelCelUvw,
								float4( voxelMergePositionResolve( sumPosN, sumAxisN ), casterShareN ) );
		@else
			// JAHSHAKA fork ad452604a+155a56bf8 (was 0087): THE BRANCH THAT CANNOT FOLLOW THE FLOAT STORE.
			// This is D3D11 without typed UAV loads, where each texel is packed
			// into ONE 32-bit uint, and the emissive volume is now RGBA16_FLOAT
			// (64 bits per texel, OgreVctVoxelizer.cpp createVoxelTextures): a
			// half pair per channel needs two uints, so this path would need the
			// volume declared as a two-component uint image to carry it. It is
			// left packing UNORM8 deliberately -- this tree ships Vulkan only,
			// the GLSL and Metal paths take the branch above, and a silent
			// half-written texel would be worse than a documented ceiling. A
			// D3D11 port fixes this line together with the image declaration in
			// Voxelizer_cs.hlsl; the emissive clip at 1.0 is what it inherits
			// until then.
			OGRE_imageWrite3D4( voxelAlbedoTex, voxelCelUvw, packUnorm4x8( voxelAlbedo ) );
			OGRE_imageWrite3D4( voxelNormalTex, voxelCelUvw, packUnormRGB10A2( voxelNormal ) );
			OGRE_imageWrite3D4( voxelEmissiveTex, voxelCelUvw, packUnorm4x8( voxelEmissive ) );
			OGRE_imageWrite3D4( voxelMetalTex, voxelCelUvw, packUnorm4x8( voxelMetal ) );
		@end
	}

	@property( syntax == hlsl && !typed_uav_load )
		if( gl_LocalInvocationIndex & 0x1u )
			g_voxelAccumValue[gl_LocalInvocationIndex >> 1u] = 0;
		GroupMemoryBarrier();

		origAccumWeightVal = min( accumWeight + origAccumWeight, 0xFFFFu );
		origAccumWeightVal = (gl_LocalInvocationIndex & 0x1u) ? (origAccumWeightVal << 16u) :
																origAccumWeightVal;
		InterlockedOr( g_voxelAccumValue[gl_LocalInvocationIndex >> 1u], origAccumWeightVal );
		if( gl_LocalInvocationIndex & 0x1u )
		{
			OGRE_imageWrite3D1( voxelAccumVal, wshort3( voxelCelUvw.x >> 1u, voxelCelUvw.yz ),
								uint4( g_voxelAccumValue[gl_LocalInvocationIndex >> 1u], 0, 0, 0 ) );
		}
	@end
@end
