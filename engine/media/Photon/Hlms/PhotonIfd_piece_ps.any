// PHOTON (OWN-GI-1): the irradiance-field pieces of the PBS pixel shader, an owned copy of Ogre-Next's
// IrradianceField_piece_ps.any (as it stood on fork 24b2436c9). This library is registered AFTER Hlms/Pbs/Any, so the
// pieces upstream's file of the same name defines are taken away first and ours collected in their place: the PBS
// templates keep inserting them by their upstream names.
// THE CAGE IS ONE TEXT (PHOTON-7 stage 7, 7-2): jah_field_read.glsl, the piece JahFieldRead, read here and by the
// screen-probe gather's integrate (rq_probe_integrate.comp: the field is the fallback of the pixels no probe answers,
// composed into the gather's own texture after its temporal mean). This piece maps the pixel into grid space, asks the
// host's gate, adds the cage's answer, then hands its confidence to the host's two hooks (JahIfd_piece_ps.any).
@undefpiece( DeclIrradianceFieldTextures )
@undefpiece( DeclIrradianceFieldFuncs )
@undefpiece( applyIrradianceField )

#include "/media/matias/Datos/SyntaxHighlightingMisc.h"

@property( irradiance_field )

// clang-format off
@piece( DeclIrradianceFieldTextures )
	@property( syntax == glsl || syntax == glslvk )
		vulkan_layout( ogre_t@value(ifdColour) ) uniform texture2D ifdColour;
		vulkan_layout( ogre_t@value(ifdDepth) ) uniform texture2D ifdDepth;
		vulkan( layout( ogre_s@value(ifdColour) ) uniform sampler ifdSampler );
	@end
	@property( syntax == hlsl )
		Texture2D<float4> ifdColour		: register(t@value(ifdColour));
		Texture2D<float2> ifdDepth		: register(t@value(ifdDepth));
		SamplerState ifdSampler         : register(s@value(ifdColour));
	@end
	@property( syntax == metal )
		, texture2d<float> ifdColour	[[texture(@value(ifdColour))]]
		, texture2d<float> ifdDepth		[[texture(@value(ifdDepth))]]
		, sampler ifdSampler            [[sampler(@value(ifdColour))]]
	@end
	// Jahshaka (PHOTON-WRITER-1): the field's window - which atlas tile holds which probe - one definition shared with
	// the generation and integration jobs; and THE CAGE (PHOTON-7 stage 7, 7-2), one text with the gather's integrate,
	// its two atlas fetches bilinear at level 0. HERE, after the atlases are declared: the header's function pieces
	// (DeclIrradianceFieldFuncs) are inserted before every texture declaration of the pixel shader.
	@insertpiece( JahFieldWindow )
	#define JAH_FIELD_IRRAD( uv ) OGRE_SampleLevel( ifdColour, ifdSampler, uv, 0 )
	#define JAH_FIELD_DEPTH( uv ) OGRE_SampleLevel( ifdDepth, ifdSampler, uv, 0 ).xy
	@insertpiece( JahFieldRead )
@end
// clang-format on

{
@piece( DeclIrradianceFieldFuncs )
	INLINE float3 transformPos3( float3 position, float4 row0, float4 row1, float4 row2 )
	{
		float3 retVal;
		retVal.x = dot( row0.xyzw, float4( position, 1.0 ) );
		retVal.y = dot( row1.xyzw, float4( position, 1.0 ) );
		retVal.z = dot( row2.xyzw, float4( position, 1.0 ) );
		return retVal;
	}

	INLINE float3 transformDir3( float3 dir, float4 row0, float4 row1, float4 row2 )
	{
		float3 retVal;
		retVal.x = dot( row0.xyz, dir );
		retVal.y = dot( row1.xyz, dir );
		retVal.z = dot( row2.xyz, dir );
		return retVal;
	}
@end
}

{
@piece( applyIrradianceField )
	// the pixel in grid space [0; mNumProbes): its point, its normal, and the direction towards the eye (inPs.pos is a
	// VIEW-space position, the eye its origin: normalised in view space, rotated into grid space and NOT re-normalised -
	// the sample point's bias is in probe spacings, per axis)
	float3 ifdGridPos =
		transformPos3( inPs.pos.xyz, //
					   passBuf.irradianceField.viewToIrradianceFieldRow0,
					   passBuf.irradianceField.viewToIrradianceFieldRow1,
					   passBuf.irradianceField.viewToIrradianceFieldRow2 );
	float3 ifdSpaceNormal = normalize( transformDir3( pixelData.normal, //
									   passBuf.irradianceField.viewToIrradianceFieldRow0,
									   passBuf.irradianceField.viewToIrradianceFieldRow1,
									   passBuf.irradianceField.viewToIrradianceFieldRow2 ) );
	float3 ifdViewDirGrid = transformDir3( normalize( -inPs.pos.xyz ), //
										   passBuf.irradianceField.viewToIrradianceFieldRow0,
										   passBuf.irradianceField.viewToIrradianceFieldRow1,
										   passBuf.irradianceField.viewToIrradianceFieldRow2 );

	// A HOST PIECE MAY DECLINE THE WHOLE CAGE FOR THIS PIXEL (a pixel whose diffuse GI another estimator answered - the
	// screen-probe gather): no fetch is paid. Left at one, the cage runs.
	float ifdCageEnabled = 1.0;
	@insertpiece( custom_ps_ifdCageGate )

	// THE FIELD'S PROBE COUNTS AND ITS WINDOW (jahIfd: x the window's first slot packed x + 128 y + 16384 z, y and z
	// the counts upstream's render params do not carry - OgreScene::pushIfdState; absent counts reduce the cage to
	// upstream's behaviour)
	uint ifdWindowPacked = uint( passBuf.jahIfd.x + 0.5 );
	JahFieldAnswer ifdAnswer = jahFieldRead(
		ifdGridPos, ifdSpaceNormal, ifdViewDirGrid,
		float3( passBuf.irradianceField.numProbesAggregated.x, passBuf.jahIfd.y, passBuf.jahIfd.z ),
		uint3( ifdWindowPacked & 127u, ( ifdWindowPacked >> 7u ) & 127u, ( ifdWindowPacked >> 14u ) & 127u ),
		passBuf.irradianceField.numProbesAggregated.xy,
		float4( passBuf.irradianceField.depthBorderedRes, passBuf.irradianceField.depthFullWidth,
				passBuf.irradianceField.depthInvFullResolution ),
		float4( passBuf.irradianceField.irradBorderedRes, passBuf.irradianceField.irradFullWidth,
				passBuf.irradianceField.irradInvFullResolution ),
		ifdCageEnabled != 0.0 );
	pixelData.envColourD.xyz += ifdAnswer.irradiance;
	// HOW MUCH OF THE PIXEL THE FIELD ANSWERED, for the host's two hooks: what a declined cage owes (resolve), and the
	// fallback that takes the rest (post)
	float ifdConfidence = ifdAnswer.confidence;
	@insertpiece( custom_ps_ifdCageResolve )
	@insertpiece( custom_ps_ifdCagePost )
@end
}

@end
