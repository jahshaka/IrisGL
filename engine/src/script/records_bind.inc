// THE STRUCTURED BINDINGS OF THE RECORD GUARD (records.h, JAH_RECORD_COUNT) - GENERATED, never edited by hand: one
// overload a count, 1..128, each binding EXACTLY that many names (a record with another count does not compile), each
// answering the address of every field of `t` in declaration order - and bindTypes, the same binding answering a
// tuple of POINTERS TO EACH FIELD's TYPE (records.h carried<T>: the freeze's compile-only proof). bindFields' body
// is the output of (from this directory; bindTypes' of the second line, appended after it):
//   python3 -c "[print('template <class T> auto bindFields(const T &t, std::integral_constant<std::size_t, %d>)\n{\n    const auto &[%s] = t;\n    return std::array<const void *, %d>{{%s}};\n}' % (n, ', '.join('f%d' % i for i in range(n)), n, ', '.join('&f%d' % i for i in range(n)))) for n in range(1, 129)]" >> records_bind.inc
//   python3 -c "[print('template <class T> auto bindTypes(const T &t, std::integral_constant<std::size_t, %d>)\n{\n    const auto &[%s] = t;\n    return std::tuple<%s>{};\n}' % (n, ', '.join('f%d' % i for i in range(n)), ', '.join('std::remove_cv_t<std::remove_reference_t<decltype(f%d)>> *' % i for i in range(n)))) for n in range(1, 129)]" >> records_bind.inc
template <class T> auto bindFields(const T &t, std::integral_constant<std::size_t, 1>)
{
    const auto &[f0] = t;
    return std::array<const void *, 1>{{&f0}};
}
