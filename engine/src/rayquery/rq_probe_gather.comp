#version 460
// THE SCREEN-PROBE GATHER, JOB 2 OF 4: THE TRACE
// (GATHER-1a; SPECS/SCREEN_PROBE_GATHER_SPEC.md section 2 items 2-4; the reduce
// moved to the filter, PHOTON-GATHER-1b).
//
// ONE WORKGROUP PER PROBE, one THREAD per ray, one ray per texel of the
// probe's octahedral map. The workgroup is 8x8, so a probe traces at most 64
// rays; the map's resolution is the tier's (8 at High and Epic, 6 at Medium).
//
// THE PHYSICS, and the line that decides the units. A pixel's diffuse GI is
// E(n) = INTEGRAL L(w) max(0, n.w) dw. HlmsPbs consumes it as `envColourD`,
// which its BRDF multiplies by kD (= albedo/pi) and by pi
// (200.BRDFs_piece_ps.any:305) — so `envColourD` is E/pi. This job writes the
// RADIANCE half of that integral and nothing else: each ray's radiance and hit
// distance, into the probe's 8x8 block of the ATLAS. The next job
// (rq_probe_filter.comp) filters the map in probe space against its
// neighbours and projects it onto SH9 with the exact solid angle of each texel
// (jahOctSolidAngle, whose derivation is at its definition); the integrate
// evaluates that SH at every pixel's own normal.
//
// THE DIRECTIONS ARE JITTERED inside their texels (stratification: the rays
// cover the hemisphere once each rather than clustering, and the jitter is
// what keeps a small bright source from aliasing in and out as the probe
// moves); the filter assigns each texel's radiance to its texel, whose
// solid angle it weighs exactly.
//
// THE HIT'S RADIANCE, in Lumen's order (PHOTON-GATHER-1d, GA-1e): the hit
// instance's surface CARD wherever one describes the point (texel-exact and
// UNGATED: the fix round's decision, the header of jah_rq_hit_radiance.glsl
// says why), the cascade VOXEL otherwise, the
// SKY where the ray hit nothing -- `jahHitRadiance` (jah_rq_hit_radiance.glsl),
// the ONE function the reflection trace's hits read too, handed this ray's own
// footprint at the hit (t x sqrt(2/rays): one ray stands for one octahedral
// texel's solid angle). TWO QUERIES, ONE TLAS (ATOM-FARBLAS-1,
// A5b section 4): the ray first traces the NEAR copies (mask 0x0F) out to its
// near length -- the lit volume's inscribed radius, OgreScreenProbeGather.cpp's
// `reach`, inside which every hit is one the cascades can shade -- and a ray that
// ESCAPES it traces again, from that length to the far plane, against the FAR
// copies alone (mask 0x10: every object once more, over its mesh's coarsest
// level). The coarse level is the far field's geometry: beyond the near length a
// ray's footprint is wider than the chain's coarsest bound, and no read of the
// voxels at a missed ray's end point stands in for it (that read moved the
// picture AWAY from the long-ray reference and is gone, PHOTON-GAFAR-1). A ray
// that hits near pays one query; only an escaping ray pays the second. The far
// query is off when the far plane lies inside the near length (p.knobs3.w = 0).
// WHAT A FAR HIT IS WORTH: the cascades end at the near length, so a far hit is
// almost always outside every cascade — it is a RECORD for the visibility-
// buffer decode (PHOTON-HIT-SHADE-1, jah_rq_hit_record.glsl): its triangle is
// the mesh's COARSEST level (the record's far bit), shaded by HlmsAtom with the
// scene's own lighting text and written back into this ray's texel by
// rq_hit_composite.comp. So are a near hit on a MOVER or a RIGGED item (the
// caches cannot hold them) and a near hit neither its card nor a cascade
// answers. There is no black and no sky for a hit: the ray found geometry, and
// the geometry is shaded.
//
// THE STRATA ACROSS PROBES (GATHER-NOISE-1): a texel's ray is jittered inside one
// of 3 x 3 sub-cells, any 3 x 3 block of uniform probes holding each once, so the
// filter's average of one direction over its neighbours is stratified (-23 % of
// the moving floor's noise on Showroom 2 alone, at no cost). The hot spot a lamp
// throws on a ceiling is what a closed room's rays hit or miss: Showroom 2 with
// Light0 hidden is 12x quieter (spikes/gather-noise-1).
//
// DETERMINISM (spec section 5). Every stochastic input is an integer hash of
// (probe cell, ray, frame); each ray writes its own texel and nothing is summed
// here (the filter's reduction is a fixed-order shared-memory tree).
#extension GL_EXT_ray_query : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

layout( local_size_x = 8, local_size_y = 8, local_size_z = 1 ) in;

#define JAH_PROBE_PARAMS_BINDING 1
#include "jah_probe_params.glsl"
/// THE CELLS' REST (PHOTON-7 stage 8B, B1; jah_probe_rest.glsl): the clock (the frame's sample index and K), the cells'
/// state (a probe whose cell holds outside every active cell's ring is not traced) and their distance store (an active
/// cell's rays at rest write its bins' least and most hit distance: what the resume tests a held cell by).
#define JAH_REST_CLOCK_BINDING 38
#include "jah_probe_rest.glsl"
layout( std430, set = 0, binding = 39 ) readonly buffer JahCellState { uint jahCellState[]; };
layout( std430, set = 0, binding = 40 ) buffer JahCellStore { uint jahCellStore[]; };
/// THE DEMAND SPAN ON THE CLOCK (PHOTON-7 stage 10's per-reader snapshot, read on the device since 8B: the rest clock is
/// the GPU's): the view stamps the cards it reads at its rest indices [1, span] alone (p.knobs6.x = the span; 0 = no
/// span: always) - moving, K = 0, it always stamps.
/// (the probe's cell, set at main's head: its stamps' gate, jah_probe_rest.glsl jahCardStampsOf)
uint gCell = 0u;
#define JAH_CARD_STAMP_GATE jahCardStampsOf( gCell, p.knobs6.x )
#include "jah_ray_origin.glsl"

layout( set = 0, binding = 0 ) uniform accelerationStructureEXT tlas;
layout( std430, set = 0, binding = 2 ) readonly buffer Records { JahProbeRecord r[]; } records;
/// THE PROBE ATLAS: one 8x8 block per probe, rgb = the radiance arriving along
/// that texel's ray, re-weighted to the texel's centre (see `reweight`), a = how
/// far away it came from (-1 = the ray hit nothing, near or far: the sky).
layout( rgba16f, set = 0, binding = 3 ) uniform image2D probeAtlas;
layout( set = 0, binding = 4 ) uniform sampler3D voxelIso[kMaxCascades];
layout( set = 0, binding = 5 ) uniform sampler3D voxelX[kMaxCascades];
layout( set = 0, binding = 6 ) uniform sampler3D voxelY[kMaxCascades];
layout( set = 0, binding = 7 ) uniform sampler3D voxelZ[kMaxCascades];
layout( set = 0, binding = 8 ) uniform samplerCube skyCube;
// PHOTON-VOXEL-4 (RQ-COV-SLOT-1): every cascade's coverage and surface position per half,
// by name - after GA-1e's card read (9-12) and geometric normal (13, 14).
layout( set = 0, binding = 15 ) uniform sampler3D voxelCovP[kMaxCascades];
layout( set = 0, binding = 16 ) uniform sampler3D voxelCovN[kMaxCascades];
layout( set = 0, binding = 17 ) uniform sampler3D voxelPosP[kMaxCascades];
layout( set = 0, binding = 18 ) uniform sampler3D voxelPosN[kMaxCascades];
// PHOTON-VOXEL-5: level 0's back side and the voxeliser's normal (the side a hit meets).
layout( set = 0, binding = 23 ) uniform sampler3D voxelBack[kMaxCascades];
layout( set = 0, binding = 24 ) uniform sampler3D voxelNrm[kMaxCascades];
// MOVER-OCCLUSION-1: the lamps' direct term per cascade (its own chain), the share a
// hit keeps when a mover occludes the rest (jah_rq_hit.glsl).
layout( set = 0, binding = 32 ) uniform sampler3D voxelDirect[kMaxCascades];
#define JAH_VOX_SAMPLE_DIRECT( c, u, l ) textureLod( voxelDirect[c], u, l )
// ...and its BACK side (37, PHOTON-7 stage 7: the direct store holds the two sides; the hit's share reads their mean)
layout( set = 0, binding = 37 ) uniform sampler3D voxelDirectBack[kMaxCascades];
#define JAH_VOX_SAMPLE_DIRECT_BACK( c, u, l ) textureLod( voxelDirectBack[c], u, l )

#include "jah_rq_hit.glsl"

/// THE SURFACE CACHE THE HITS READ FIRST (GA-1e): the card table, the instance
/// table, the Depth and Radiance layers at bindings 9-12 — bound by the ray tier
/// exactly as it binds them for the reflection trace (or the stand-ins with zero
/// slots: every hit then reads the voxels).
#define JAH_CARD_BINDING_BASE 9
// ...and the view term's five after the job's last binding (PHOTON-CARDS-5).
#define JAH_CARD_VIEW_BINDING_BASE 25
#include "jah_rq_card_bindings.glsl"
// A READER (PHOTON-7 stage 5, 5-2): its hits stamp the cards they read and the faces that answered none - the
// cache's residency (jah_rq_card_bindings.glsl's demand layout); the gather is reader 1 of the counts.
#define JAH_CARD_DEMAND 1
#include "jah_rq_card.glsl"

/// THE HIT'S GEOMETRIC NORMAL (the card pick's facing): the per-slot row table
/// the tier writes with the TLAS (binding 13) and the GPU scene's geometry rows
/// (binding 14, three uvec4 lanes a row) — the reflection's bindings 19/20.
layout( std430, set = 0, binding = 13 ) readonly buffer JahGeomRowOfSlot { uint jahGeomRowOfSlot[]; };
layout( std430, set = 0, binding = 14 ) readonly buffer JahGeomRows { uvec4 jahGeomRows[]; };
#define JAH_GEOM_ROW_OF( slot ) jahGeomRowOfSlot[slot]
#define JAH_GEOM_LANE( row, k ) jahGeomRows[( row ) * 3u + ( k )]
#include "jah_rq_geom.glsl"


/// THE HIT RECORD (PHOTON-HIT-SHADE-1): the GPU scene's instance table (binding
/// 19), the compacted list's two images (20-21) and its buffer (22) — the
/// reflection's 25-28.
layout( std430, set = 0, binding = 19 ) readonly buffer JahHitInstances { uvec4 jahHitInstances[]; };
layout( rgba32ui, set = 0, binding = 20 ) uniform writeonly uimage2D jahHitIds;
layout( r32ui, set = 0, binding = 21 ) uniform writeonly uimage2D jahHitDest;
layout( std430, set = 0, binding = 22 ) buffer JahHitBuf { uint jahHitBuf[]; };
#define JAH_HIT_INSTANCE( s, k ) jahHitInstances[( s ) * 10u + ( k )]
#include "jah_rq_sun_ray.glsl"
#include "jah_rq_hit_record.glsl"
// THE HIT'S RADIANCE, after the alpha table (MOVER-OCCLUSION-1: the read traces the
// movers above the hit, cut-outs honoured).
// THE HIT'S OWN SURFACE (FAR-SUN-2, jah_rq_hit_direct.glsl): the hit table, the voxeliser's
// texture pool (binding 34) and the cloud layer's field (35).
layout( set = 0, binding = 35 ) uniform sampler2DArray jahHitPool;
layout( set = 0, binding = 36 ) uniform sampler2D jahHitCloud;
// A GATHER RAY READS A HIT'S SPECULAR LOBE BY ITS INTEGRAL (PHOTON-3, the lead's ruling: an irradiance estimator of
// a few stochastic rays cannot sample a polished hit's near-delta lobe; jah_rq_hit_direct.glsl's header).
#define JAH_HIT_LOBE_INTEGRAL
#include "jah_rq_hit_radiance.glsl"
#include "jah_rq_panes.glsl"
// THE CARD READ'S LOBE INTEGRALS (jah_rq_card.glsl, ENGINE-POLISH-PHOTON-1): the store's table, through the hit table.
void jahCardLobeHemi( float r, out float a, out float b )
{
	a = 0.0;
	b = 0.0;
	const uvec2 t = JAH_HIT_TABLE;
	if( ( t.x | t.y ) != 0u )
		jahSpecularAlbedoHemi( r, a, b );
}

/// THE GATHER-HITS INSTRUMENT (FAR-SUN-1): what answered every ray, as a readback and as a
/// picture - the gather's counterpart of the reflection trace's Hits view. Nothing in the frame
/// reads either binding; with both knobs off nothing is written.
///   31  one uvec4 per ray of every UNIFORM probe (probe x 64 + the ray's lane), written under
///       p.hits.x (the arm "gather.hitsReadback"): x = the source (bits 0-3: 1 the card, 2 the
///       voxels, 3 the sky, 4 a decode record, 5 a FAR decode record, 6 a dropped record) | the
///       answering cascade << 4 (the voxels) | the hit's sun visibility, unorm8 << 8 | the hit
///       normal's y, snorm8 << 16 | 1 << 24 (the probe traced this ray); y = the ray's
///       quadrature re-weight, half precision (the atlas texel over it is the radiance
///       returned) | the hit normal's x, snorm8 << 16 | its z, snorm8 << 24 (the whole normal:
///       a hit's truth is its own cosine to the sun, a chair's side as much as the street);
///       z = packHalf2x16( the hit's x, y ), w = packHalf2x16( the hit's z, the distance ).
///   32  the photon view's overlay (the GatherHits view, p.hits.y): every uniform probe's cell
///       painted ray by ray, one octahedral texel to one block of the cell, in its source's
///       colour (kGatherHitColour).
layout( std430, set = 0, binding = 33 ) writeonly buffer JahGatherRays { uvec4 jahGatherRays[]; };
layout( rgba16f, set = 0, binding = 34 ) uniform writeonly image2DArray photonOverlay;
const uint kGatherSrcCard = 1u, kGatherSrcVoxel = 2u, kGatherSrcSky = 3u, kGatherSrcDecode = 4u,
		   kGatherSrcDecodeFar = 5u, kGatherSrcDropped = 6u;
/// THE LEGEND: the card green; the voxels blue, darker at each coarser cascade; the sky cyan; a
/// decode record magenta, a FAR one orange; a dropped record red; a cell with no probe a veil.
vec4 kGatherHitColour( uint source, int cascade )
{
	if( source == kGatherSrcCard )
		return vec4( 0.1, 0.9, 0.2, 1.0 );
	if( source == kGatherSrcVoxel )
	{
		const float k = 1.0 - 0.25 * float( clamp( cascade, 0, 3 ) );
		return vec4( 0.15 * k, 0.35 * k, k, 1.0 );
	}
	if( source == kGatherSrcSky )
		return vec4( 0.2, 0.95, 1.0, 1.0 );
	if( source == kGatherSrcDecode )
		return vec4( 1.0, 0.2, 1.0, 1.0 );
	if( source == kGatherSrcDecodeFar )
		return vec4( 1.0, 0.6, 0.1, 1.0 );
	if( source == kGatherSrcDropped )
		return vec4( 1.0, 0.1, 0.05, 1.0 );
	return vec4( 0.0, 0.0, 0.0, 0.6 );
}
/// Paints ray `texel` of the uniform probe at `cell` (the list's cell: its eye by column).
void gatherHitPaint( ivec2 cell, ivec2 texel, int octRes, vec4 c )
{
	const int stride = max( int( p.hits.z ), 1 );
	const int eye = jahEyeOfCell( cell.x );
	const int cx = cell.x - eye * jahEyeGridW();
	const ivec2 full = ivec2( p.resolution.zw );
	// texel t covers [t stride / octRes, (t + 1) stride / octRes) of its cell: the map tiles the cell
	// exactly (a 6 x 6 map in 16 px), and a stride finer than the map paints some texels nowhere,
	// never into the neighbouring cell's pixels (a race between two probes' pictures).
	const int res = max( octRes, 1 );
	const ivec2 base = ivec2( cx, cell.y ) * stride;
	const ivec2 lo = base + ( texel * stride ) / res;
	const ivec2 hi = min( base + ( ( texel + 1 ) * stride ) / res, full );
	for( int y = lo.y; y < hi.y; ++y )
		for( int x = lo.x; x < hi.x; ++x )
			imageStore( photonOverlay, ivec3( x, y, eye ), c );
}

void main()
{
	const uint probe = gl_WorkGroupID.x;
	const uint lane = gl_LocalInvocationIndex;
	const int octRes = int( clamp( p.knobs2.w, 1.0, float( kOctResMax ) ) );
	const uint rays = uint( octRes * octRes );

	const vec4 posW = records.r[probe].posW;
	const vec4 normalW = records.r[probe].normalW;

	// THE PROBE'S CELL IS WHAT THE SAMPLE SEQUENCE IS KEYED ON, NEVER ITS LIST
	// SLOT, and this is the line that makes the adaptive pass deterministic. An
	// adaptive probe's slot is the atomic's choice and changes run to run; its
	// CELL is written into its record by the thread that appended it. A uniform
	// probe's index IS its cell. So the same scene at the same frame draws the
	// same picture whatever order the appends happened in — the property spec
	// section 5 item 2 asks for, made true here rather than hoped for.
	const int gridW = max( int( p.resolution.x ), 1 );
	const uint uniformProbes = uint( max( p.knobs3.x, 0.0 ) );
	const bool adaptive = probe >= uniformProbes;
	const uint cellIndex = adaptive ? uint( max( normalW.w - 1.0, 0.0 ) ) : probe;
	const ivec2 cell = ivec2( int( cellIndex ) % gridW, int( cellIndex ) / gridW );
	const uint frame = jahFrameIndexOf( cellIndex );
	gCell = cellIndex;
	// THE CELL'S REST (PHOTON-7 stage 8B, B1): a HELD cell outside every active cell's ring is not traced (nothing reads
	// its probes this frame: its own pixels write their history through) - its block reads "no answer", as a probe on
	// nothing; an ACTIVE cell keeps its rays' distances by world direction (since the camera stopped: rq_probe_resume.comp).
	const uint cellSt = jahCellState[kCellWords * cellIndex];
	const bool cellHeld = ( cellSt & kCellHeld ) != 0u;
	const bool traced = !cellHeld || jahCellState[kCellWords * cellIndex + 1u] != 0u;
	const bool onSurface = posW.w > 0.5 && traced;
	const bool keepsDistance = !cellHeld;
	// ...and the two probes of one cell are decorrelated by a constant, so the
	// second is not a second sample of the same 64 directions.
	const uint sequence = adaptive ? 4096u : 0u;

	// The atlas block, which exists whether or not the probe answered: a block
	// left holding an older frame's radiance would be read by phase 2's filter
	// as this frame's.
	const int atlasCols = max( int( p.knobs3.z ), 1 );
	const ivec2 block = ivec2( int( probe ) % atlasCols, int( probe ) / atlasCols ) * kOctResMax;
	// THE TEXEL IS THE OCTAHEDRAL COORDINATE, not the lane's position in an 8x8
	// block, and the two are the same thing only at octRes 8. At Medium
	// (octRes 6) a lane's direction is (lane % 6, lane / 6) while its store was
	// (lane % 8, lane / 8), so the map was written scrambled -- invisible at
	// phase 1, where nothing reads the atlas, and wrong the moment phase 2's
	// filter does (the lead's read). The block is 8x8 whatever the resolution;
	// the unused texels are cleared below by the same store.
	const ivec2 texel = ivec2( int( lane ) % octRes, int( lane ) / octRes );

	vec4 atlasTexel = vec4( 0.0, 0.0, 0.0, -1.0 );

	if( onSurface && lane < rays )
	{
		const vec3 n = normalW.xyz;
		vec3 T, B;
		jahTangentFrame( n, T, B );

		// ---- THE DIRECTION. One octahedral texel, jittered inside itself.
		// Stratification is the variance reduction that costs nothing: the 64
		// rays cover the hemisphere once each rather than clustering, and the
		// jitter inside the texel is what makes the estimate UNBIASED rather
		// than a fixed quadrature that would alias a small bright source in
		// and out as the probe moves.
		const ivec2 t = ivec2( int( lane ) % octRes, int( lane ) / octRes );
		vec2 j = p.knobs6.w > 0.5 ? vec2( 0.5 )
								  : jahSample2( jahLocalCell( cell ), sequence + lane + 1u, frame );
		// THE STRATA ACROSS NEIGHBOURING PROBES (GATHER-NOISE-1): this ray's
		// jitter is confined to sub-cell ((cell + o) mod N) of its texel, the
		// offset o drawn per TEXEL and per FRAME (never per probe), so every N x N
		// block of uniform cells holds each sub-cell exactly once — the filter's
		// and the bilinear's average of one direction over neighbouring probes is
		// a stratified estimate of the texel — and each probe's ray is uniform
		// over its texel across frames. Adaptive probes keep the plain jitter.
		const float strata = floor( max( p.young.z, 1.0 ) );
		if( strata > 1.5 && !adaptive && p.knobs6.w < 0.5 )
		{
			const vec2 o = floor( jahSample2( ivec2( 0 ), 8192u + lane, frame ) * strata );
			const vec2 s = mod( vec2( jahLocalCell( cell ) ) + o, vec2( strata ) );
			j = ( s + j ) / strata;
		}
		const vec2 uv = ( vec2( t ) + j ) / float( octRes );
		const vec3 octPoint = jahOctPoint( uv );
		const float invR = 1.0 / max( length( octPoint ), 1e-6 );
		const vec3 dLocal = octPoint * invR;
		const vec3 dir = normalize( T * dLocal.x + B * dLocal.y + n * dLocal.z );
		// THE TEXEL'S QUADRATURE WEIGHT, AT THE RAY AND AT THE CENTRE. The
		// filter and the SH integrate over texel CENTRES (a texel is one
		// direction to a neighbour and to the projection), while this ray stands
		// for a point jittered inside the texel — and with a sharp source that
		// covers part of a texel, where in the texel the rays hit correlates
		// with the cosine and the solid angle there: assigning the ray's
		// radiance to the centre's weight read a rectangular emitter 5-7 % off
		// at a grazing distance (gi.gather_reference, the lane's A/B). So the
		// atlas holds the radiance RE-WEIGHTED to the centre:
		//     L * ( cos dOmega at the ray ) / ( cos dOmega at the centre ),
		// whose centre quadrature is exactly this ray's jittered one (GATHER-1a's
		// unbiased estimator), and whose mean over the jitter is the texel's
		// cosine-weighted radiance per unit of the centre's weight.
		const vec3 centrePoint = jahOctPoint( ( vec2( t ) + 0.5 ) / float( octRes ) );
		const float centreCos = centrePoint.z / max( length( centrePoint ), 1e-6 );
		const float reweight = ( max( dLocal.z, 0.0 ) * jahOctSolidAngle( octPoint, float( octRes ) ) ) /
							   max( centreCos * jahOctSolidAngle( centrePoint, float( octRes ) ), 1e-9 );

		// THE ORIGIN LAW (PHOTON-7 stage 6, READ_A W2, READ_B F3 - the one law of every ray job, jah_ray_origin.glsl):
		// the probe sits on the DRAWN surface and its rays trace each mesh's level 0, so the ray starts off it along
		// the drawn surface's GEOMETRIC normal (geomW, found at the placement; the hemisphere stays the shaded one) by
		// the point's float bound plus the drawn surface's bound against level 0 (knobs2.y: Types.h
		// rayOriginDrawnFootprints) at the probe's Euclidean distance from the EYE that placed it (its cell names it,
		// PHOTON-GA-VR), tMin 0.
		const JahEye placedBy = jahEyeNow( jahEyeOfCell( cell.x ) );
		const float probeDist = jahViewDistanceOf( placedBy, posW.xyz );
		const float maxT = p.knobs.y;
		const float farT = p.knobs3.w;
		const vec4 geomW = records.r[probe].geomW;   // the geometric normal, and the point's own error (placement's)
		const vec3 origin = jahRayOrigin( posW.xyz, geomW.xyz, probeDist,
										  geomW.w + jahViewDrawnBound( p.knobs2.y, posW.xyz, placedBy.camPos,
																	   placedBy.rayDown, p.resolution.w,
																	   placedBy.perspective > 0.5 ) );
		// THE NEAR QUERY: the near copies (Types.h kRayMaskNearField).
		rayQueryEXT rq;
		rayQueryInitializeEXT( rq, tlas, jahAlphaRayFlags( gl_RayFlagsNoneEXT ), 0x0Fu, origin, 0.0, dir, maxT );
		JahPanes panes = jahPanesNone();
		JAH_RQ_PROCEED_PANES( rq, panes )
		bool hit = rayQueryGetIntersectionTypeEXT( rq, true ) ==
				   gl_RayQueryCommittedIntersectionTriangleEXT;
		float tHit = hit ? rayQueryGetIntersectionTEXT( rq, true ) : -1.0;
		// THE PANES IN FRONT (PHOTON-7 10-4 R7): the near query's, before its hit or its end; the far query's past it
		jahPanesInFront( panes, hit ? tHit : maxT );
		JahPanes panesFar = jahPanesNone();
		// A NEAR hit names its instance (the item slot the card tables are indexed
		// by) and its triangle's geometric normal (the card pick's facing); a far
		// hit names neither (the header: its triangle is the coarse level's).
		uint hitSlot = 0xFFFFFFFFu;
		uint hitPrim = 0u;
		vec2 hitBary = vec2( 0.0 );
		bool far = false;
		vec3 hitN = -dir;
		bool hitNormalKnown = false;
		uint hitGeom = 0u;
		mat4x3 hitToWorld = mat4x3( 1.0 );
		if( hit )
		{
			hitSlot = uint( rayQueryGetIntersectionInstanceCustomIndexEXT( rq, true ) );
			hitPrim = uint( rayQueryGetIntersectionPrimitiveIndexEXT( rq, true ) );
			hitBary = rayQueryGetIntersectionBarycentricsEXT( rq, true );
			hitGeom = uint( rayQueryGetIntersectionGeometryIndexEXT( rq, true ) );
			hitToWorld = rayQueryGetIntersectionObjectToWorldEXT( rq, true );
			hitNormalKnown = jahHitGeometricNormal( hitSlot, hitGeom, hitPrim, hitToWorld, dir, hitN );
		}
		// THE FAR QUERY, for an escaping ray only: the far copies (kRayMaskFar),
		// from p.plane.z to the far plane. The same origin and direction; the far
		// segment starts BEFORE the near one ended by the widest coarse-vs-fine
		// gap of the traced set (audit F2), so a coarse surface just inside the
		// near length whose fine one lies just outside is not passed by both
		// queries. A coarse hit in the overlap is honest: the near query has
		// already proved no fine surface lies there.
		if( !hit && farT > maxT )
		{
			rayQueryEXT rqFar;
			rayQueryInitializeEXT( rqFar, tlas, jahAlphaRayFlags( gl_RayFlagsNoneEXT ), 0x10u, origin,
								   p.plane.z, dir, farT );
			JAH_RQ_PROCEED_PANES( rqFar, panesFar )
			if( rayQueryGetIntersectionTypeEXT( rqFar, true ) ==
				gl_RayQueryCommittedIntersectionTriangleEXT )
			{
				hit = true;
				far = true;
				tHit = rayQueryGetIntersectionTEXT( rqFar, true );
				hitSlot = uint( rayQueryGetIntersectionInstanceCustomIndexEXT( rqFar, true ) );
				hitPrim = uint( rayQueryGetIntersectionPrimitiveIndexEXT( rqFar, true ) );
				hitBary = rayQueryGetIntersectionBarycentricsEXT( rqFar, true );
			}
			// (a pane the near query already crossed is not crossed twice: the far copies' past its end)
			jahPanesBetween( panesFar, maxT, hit ? tHit : farT );
		}

		// THE RAY'S FOOTPRINT AT ITS HIT. One of `rays` directions covers a
		// solid angle 2*pi/rays, whose half-angle has tan ~ sqrt(2/rays) at
		// these counts; the mip that matches it is the one whose texel is that
		// wide at distance t. A gather ray reading the FINEST mip would alias
		// exactly as a cone march with no cone does.
		const float spread = sqrt( 2.0 / float( rays ) );
		float through = 1.0;
		vec3 paneLight = vec3( 0.0 );
		if( panes.n + panesFar.n > 0 )
		{
			// the near list, then the far one, through ONE call of the fold
			[[dont_unroll]] for( int list = 0; list < 2; ++list )
			{
				float th = 1.0;
				const vec3 own = jahPanesOwnLight( list == 0 ? panes : panesFar, origin, dir, th );
				paneLight += through * own;
				through *= th;
			}
		}
		vec3 radiance = vec3( 0.0 );
		uint source = 0u;		// the instrument's (FAR-SUN-1): what answered this ray
		float hitSun = 0.0;
		float distance = -1.0;
		bool ok = false;
		bool recorded = false;
		if( hit )
		{
			distance = tHit;
			// A MOVER, a RIGGED item, or a hit neither its card nor a cascade
			// answers (a far hit asks the cascades only: its triangle is the
			// COARSE level's, which no card describes): a record, shaded by the
			// visibility-buffer decode and written back into this texel by
			// rq_hit_composite.comp (PHOTON-HIT-SHADE-1). There is no black: a hit
			// is always shaded (a card, a voxel, or the decode).
			// (The arm "gather.decodeHits" sends EVERY hit here: the route-agreement
			// instrument, gi.speckle.)
			const bool decodeAlways = jahHitAlwaysDecodes( hitSlot ) || p.alpha.z > 0.5;
			uint cacheSource = 0u;
			// THE HIT, for its direct light at the hit (FAR-SUN-2): a near hit whose triangle
			// gave its normal; a FAR copy's names no near row (its normal is the ray's
			// reverse) and reads the store whole.
			jahHitSurf = JahHitSurface( hitSlot, hitGeom, hitPrim, hitBary, hitToWorld, tHit, far,
										!far && hitNormalKnown );
			// an area light's stratum there (jah_rq_hit_direct.glsl, 7-H): this probe's cell and ray, this frame (the hash the
			// deleted mover gate's rotation shared)
			jahHitAreaSeq = cellIndex * 73856093u ^ lane * 19349663u ^ frame * 2654435761u;
			if( !decodeAlways )
				radiance = paneLight + through * jahHitRadianceStore( far ? 0xFFFFFFFFu : hitSlot, origin + dir * tHit, hitN, dir,
													  max( tHit * spread, 1e-4 ), false, ok, cacheSource );
			source = cacheSource == 1u ? kGatherSrcCard : kGatherSrcVoxel;
			if( decodeAlways || !ok || !finite3( radiance ) )
			{
				const vec3 hitPos = origin + dir * tHit;
				const float sunVis = jahHitSunVisibility( hitPos, hitN, tHit, far );
				const ivec2 dest = block + texel;
				recorded = jahHitAppend( hitSlot, far, hitPrim,
										 hitBary, dir, sunVis, max( tHit * spread, 1e-4 ), reweight * through,
										 jahHitDestPack( dest, true, 0 ), origin.y, tHit, 0.0, vec3( 0.0 ), 1.0,
										 vec4( 0.0, 0.0, 0.0, 1.0 ), false );
				// THE COMPOSITE ADDS the hit's radiance x the record's weight (the re-weight x the panes' throughput) to
				// what this trace wrote - the panes' own light (PHOTON-7 10-4 R7; 0 where no pane is crossed); a DROPPED
				// record (the list was full — counted) is NO SAMPLE (PHOTON-2 stage 2's tail, 1.6 A2): its
				// texel's distance kAtlasNoSample keeps it out of the filter and the SH
				// sums (rq_probe_filter.comp) - never a black ray that darkens the probe.
				radiance = paneLight;
				if( !recorded )
					distance = kAtlasNoSample;
				source = !recorded ? kGatherSrcDropped : far ? kGatherSrcDecodeFar : kGatherSrcDecode;
			}
			// THE INSTRUMENT'S SUN (FAR-SUN-1): the hit's own sun ray, whatever answered it - the
			// truth a source's radiance is held against (one more ray, only under the arm).
			if( p.hits.x > 0.5 && !adaptive )
				hitSun = jahHitSunVisibility( origin + dir * tHit, hitN, tHit, far );
		}
		else
		{
			// ---- THE SKY. Nothing near and nothing far (or the far query off):
			// the ray escaped the world.
			radiance = paneLight + through * jahSkyRadiance( dir, spread );	// at the ray's own footprint (GA-SKY)
			source = kGatherSrcSky;
		}
		if( !finite3( radiance ) )
			radiance = vec3( 0.0 );
		atlasTexel = vec4( min( radiance * reweight, vec3( kMaxRadiance ) ), distance );
		// THE STILL CAMERA's DISTANCES (PHOTON-7 stage 8B, B1): this ray's bin of world directions keeps the least and the
		// most distance its cell's rays went to a hit since the camera stopped, or a bit that one escaped
		if( keepsDistance )
		{
			const uint bin = jahRestBin( dir );
			const uint at = kRestStoreWords * cellIndex;
			if( hit )
			{
				atomicMin( jahCellStore[at + bin], floatBitsToUint( max( tHit, 0.0 ) ) );
				atomicMax( jahCellStore[at + 64u + bin], floatBitsToUint( max( tHit, 0.0 ) ) );
			}
			else
				atomicOr( jahCellStore[at + 128u + ( bin >> 5u )], 1u << ( bin & 31u ) );
		}
		// ---- THE GATHER-HITS INSTRUMENT (FAR-SUN-1): the uniform probes' rays only (an
		// adaptive probe is its cell's second, and the readback is the grid's).
		if( !adaptive && ( p.hits.x > 0.5 || p.hits.y > 0.5 ) )
		{
			const int cascade = source == kGatherSrcVoxel ? max( jahVoxelAnswerCascade, 0 ) : 0;
			if( p.hits.x > 0.5 )
			{
				const vec3 hp = hit ? origin + dir * tHit : vec3( 0.0 );
				// a FAR hit names no triangle (its hitN is the ray's reverse, not a geometric normal):
				// it records a zero normal, so no reader files it as a surface facing any way
				const vec3 hn = ( hit && !far ) ? clamp( hitN, vec3( -1.0 ), vec3( 1.0 ) ) : vec3( 0.0 );
				const uint word = ( source & 0xFu ) | ( uint( cascade & 0xF ) << 4u ) |
								  ( uint( clamp( hitSun, 0.0, 1.0 ) * 255.0 + 0.5 ) << 8u ) |
								  ( ( uint( int( round( hn.y * 127.0 ) ) ) & 0xFFu ) << 16u ) | ( 1u << 24u );
				const uint weightNormal = ( packHalf2x16( vec2( reweight, 0.0 ) ) & 0xFFFFu ) |
										  ( ( uint( int( round( hn.x * 127.0 ) ) ) & 0xFFu ) << 16u ) |
										  ( ( uint( int( round( hn.z * 127.0 ) ) ) & 0xFFu ) << 24u );
				jahGatherRays[probe * uint( kOctResMax * kOctResMax ) + lane] =
					uvec4( word, weightNormal, packHalf2x16( hp.xy ),
						   packHalf2x16( vec2( hp.z, distance ) ) );
			}
			if( p.hits.y > 0.5 )
				gatherHitPaint( cell, t, octRes, kGatherHitColour( source, cascade ) );
		}
	}
	else if( !adaptive && lane < rays && p.hits.y > 0.5 )
		// A CELL WITH NO PROBE (its pixel holds nothing the prepass could place one on): veiled.
		gatherHitPaint( cell, texel, octRes, kGatherHitColour( 0u, 0 ) );
	// ...and a ray the readback holds no answer for (no probe, or the padding of a 6 x 6 map):
	// an empty record, so a stale frame's never reads as this one's.
	if( p.hits.x > 0.5 && !adaptive && !( onSurface && lane < rays ) )
		jahGatherRays[probe * uint( kOctResMax * kOctResMax ) + lane] = uvec4( 0u );

	// THE RAY'S TEXEL, from the lanes that own a direction.
	if( lane < rays )
		imageStore( probeAtlas, block + texel, atlasTexel );
	// ...AND THE 8x8 BLOCK'S PADDING, cleared so a reader never finds an older
	// frame's radiance in it: each lane clears the block texel at its OWN 8x8
	// position when that texel lies outside the octRes x octRes map. The padding
	// is never addressed by lane - rays (PHOTON-GATHER-1d): at Medium (octRes 6)
	// lanes 36..63 at (lane % 8, lane / 8) land on (4,4), (5,4), (0,5)...(5,5) —
	// texels of the map itself — and a padding clear raced the ray store in the
	// same texel, so a probe's irradiance was the scheduler's choice (two
	// editor.screenshot shots of one still scene differed on ~5 % of pixels).
	// Here every block texel has exactly one writer. (At octRes 8 there is no
	// padding.)
	const ivec2 own = ivec2( int( lane ) % kOctResMax, int( lane ) / kOctResMax );
	if( own.x >= octRes || own.y >= octRes )
		imageStore( probeAtlas, block + own, vec4( 0.0, 0.0, 0.0, -1.0 ) );
}
