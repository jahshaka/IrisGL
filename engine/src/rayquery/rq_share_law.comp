#version 460
// gi.share_law's GPU half (BISTRO-REST-1, the lead's ruling (B)): THE HIT READ's BOUNCE SHARE, the shipped function
// (jah_rq_hit.glsl jahVoxelRadiance - the SAME include every ray job reads - and its bounce part), asked over a fixture store set by the
// host, and the loop it closes. A test-only job: nothing in a frame dispatches it (RayQueryTier::shareLawBlocking records
// it on its own command buffer and stalls on the answer).
// THE FIXTURE STORE: uniform (below) - the read's taps hold what the question names.
// THE QUESTIONS (one invocation each):
//   mode 0, THE SWEEP: T = q.x, D = q.y, k = q.z - the share of the read that is bounce, the
//     bounce part the read hands back and the read's radiance;
//   mode 1, THE LOOP: two halves of ONE cell reading each other - each a fraction F = q.y of its rays to the other, albedo
//     rho = q.z, source S = q.x (premultiplied), coverage k = q.w - under the Jacobi door (both from the last iterate),
//     from OUT OF PHASE (X high, Y 0), each iterate rounded to the store's half float: X' = S + rho F k answer(Y),
//     answer(Y) the bounce part of the read of a store holding Y (D = 0); the last four iterates written back.
#extension GL_GOOGLE_include_directive : require

layout( local_size_x = 64, local_size_y = 1, local_size_z = 1 ) in;

struct Question
{
	vec4 q;		// see the head
	uvec4 mode;	// x the mode, y the loop's iterations
};
layout( std430, set = 0, binding = 0 ) readonly buffer QuestionBuf { Question questions[]; };
struct Answer
{
	vec4 a;		// mode 0: share, answer, rad, 0; mode 1: X at n-3 .. n
	vec4 b;		// mode 1: Y at n-3 .. n
};
layout( std430, set = 0, binding = 1 ) writeonly buffer AnswerBuf { Answer answers[]; };
layout( std430, set = 0, binding = 2 ) readonly buffer CountBuf { uint questionCount; };

// THE FIXTURE STORE, read through the include's macros: one cascade, a 16^3 box of unit cells at the origin, UNIFORM - every
// cell's half (and every level of every chain) holds the question's light T (premultiplied: radiance x k), its direct
// term D and the coverage k: the half store and its direct terms, the total's and the direct's directional chains, the
// coverage per half. The read is the shipped one (jah_rq_hit.glsl jahVoxelRadiance, through jah_voxel_sample.glsl's one
// reader), at the hit's level-0 half (the only level a hit reads: BISTRO-REST-1).
const int kFixRes = 16;
float jahFixT = 0.0, jahFixD = 0.0, jahFixK = 0.0;
#define JAH_VOX_COUNT 1
#define JAH_VOX_ORIGIN( c ) vec4( 0.0 )
#define JAH_VOX_INVSIZE( c ) vec4( vec3( 1.0 / float( kFixRes ) ), 1.0 )
#define JAH_SKY_ON false
#define JAH_SKY_COLOUR vec3( 0.0 )
#define JAH_VOX_SAMPLE_ISO( c, u, l ) vec4( vec3( jahFixT ), jahFixK )
#define JAH_VOX_SAMPLE_DIRECT( c, u, l ) vec4( vec3( jahFixD ), jahFixK )
#define JAH_VOX_SAMPLE_X( c, u, l ) vec4( vec3( jahFixT ), jahFixK )
#define JAH_VOX_SAMPLE_Y( c, u, l ) vec4( vec3( jahFixT ), jahFixK )
#define JAH_VOX_SAMPLE_Z( c, u, l ) vec4( vec3( jahFixT ), jahFixK )
#define JAH_VOX_SAMPLE_DX( c, u, l ) vec4( vec3( jahFixD ), jahFixK )
#define JAH_VOX_SAMPLE_DY( c, u, l ) vec4( vec3( jahFixD ), jahFixK )
#define JAH_VOX_SAMPLE_DZ( c, u, l ) vec4( vec3( jahFixD ), jahFixK )
#define JAH_VOX_SAMPLE_COVP( c, u, l ) vec4( vec3( jahFixK ), 0.0 )
#define JAH_VOX_SAMPLE_COVN( c, u, l ) vec4( vec3( jahFixK ), 0.0 )
#define JAH_VOX_SAMPLE_POSP( c, u, l ) vec4( vec3( 0.5 * jahFixK ), 0.0 )
#define JAH_VOX_SAMPLE_POSN( c, u, l ) vec4( vec3( 0.5 * jahFixK ), 0.0 )
#define JAH_VOX_LEVEL_ON false
#define JAH_VOX_LEVEL( c ) vec4( 0.0 )
#define JAH_VOX_LEVEL_CAM vec3( 0.0 )
// (no environment: the read never reaches one)
#define JAH_ENV_CUBE_ON false
#define JAH_ENV_SAMPLE( d, l ) vec3( 0.0 )
#define JAH_ENV_MIPS 1.0
#define JAH_ENV_SH_C0 vec3( 0.0 )
#define JAH_ENV_SH_C1 vec3( 0.0 )
#define JAH_ENV_SH_C2 vec3( 0.0 )
#define JAH_ENV_SH_C3 vec3( 0.0 )
#define JAH_ENV_SH_C4 vec3( 0.0 )
#define JAH_ENV_SH_C5 vec3( 0.0 )
#define JAH_ENV_SH_C6 vec3( 0.0 )
#define JAH_ENV_SH_C7 vec3( 0.0 )
#define JAH_ENV_SH_C8 vec3( 0.0 )
#include "jah_rq_hit.glsl"

/// THE STORE's ROUNDING (the half float, to nearest): what a pass's write leaves of a value
float jahFixRoundHalf( float v )
{
	const float a = abs( v );
	const float step = a < 6.1035156e-5 ? 5.9604645e-8 : exp2( floor( log2( a ) ) - 10.0 );
	return sign( v ) * round( a / step ) * step;
}

/// The shipped read of a store holding (T, D) at coverage k (the hit's level-0 half): its radiance and, returned, the
/// share of it that is bounce (the store's bounce part over the read: jahVoxelBounceOut / rad)
float jahFixShare( float T, float D, float k, out float rad, out float bounce )
{
	jahFixT = T;
	jahFixD = D;
	jahFixK = k;
	bool ok = false;
	const vec3 r = jahVoxelRadiance( vec3( 8.3, 8.4, 8.6 ), vec3( 0.0, -1.0, 0.0 ), vec3( 0.0, 1.0, 0.0 ), false, ok );
	rad = ok ? r.x : 0.0;
	bounce = ok ? jahVoxelBounceOut.x : 0.0;
	return rad > 0.0 ? bounce / rad : 0.0;
}

void main()
{
	const uint i = gl_GlobalInvocationID.x;
	if( i >= questionCount )
		return;
	const Question qu = questions[i];
	Answer an;
	an.a = vec4( 0.0 );
	an.b = vec4( 0.0 );
	if( qu.mode.x == 0u )
	{
		float rad, bounce;
		const float sh = jahFixShare( qu.q.x, qu.q.y, qu.q.z, rad, bounce );
		an.a = vec4( sh, bounce, rad, 0.0 );
	}
	else
	{
		const float S = qu.q.x, F = qu.q.y, rho = qu.q.z, k = qu.q.w;
		float X = jahFixRoundHalf( 2.0 * S / max( 1.0 - rho * F, 1e-6 ) ), Y = 0.0;
		const int n = int( max( qu.mode.y, 4u ) );
		float hx[4], hy[4];
		for( int it = 0; it < n; ++it )
		{
			float radX, radY, bX, bY;
			jahFixShare( X, 0.0, k, radX, bX );
			jahFixShare( Y, 0.0, k, radY, bY );
			const float nX = jahFixRoundHalf( S + rho * F * k * bY );   // (the bounce part each reads of the other)
			const float nY = jahFixRoundHalf( S + rho * F * k * bX );
			X = nX;
			Y = nY;
			if( it >= n - 4 )
			{
				hx[it - ( n - 4 )] = X;
				hy[it - ( n - 4 )] = Y;
			}
		}
		an.a = vec4( hx[0], hx[1], hx[2], hx[3] );
		an.b = vec4( hy[0], hy[1], hy[2], hy[3] );
	}
	answers[i] = an;
}
