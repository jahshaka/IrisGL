#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

// THE PIXEL'S AREA LIGHT VISIBILITY, JOB 1 OF 2: THE TRACE (PHOTON-7 stage 7, 7-A; SPECS/PHOTON_7_SPEC.md "AREA LIGHTS,
// ONE LAW ON EVERY PATH" (a)). Ogre-Next draws an LTC area light with no shadow, so a pixel's area direct passed
// through walls while the voxels and the cards shadowed it. The pixel takes THE CARDS' LAW (jah_area_strata.glsl, one
// text): the ratio of the light's visible form factor over n x n strata of its rectangle, S = sum( V f ) over
// U = sum( f ) (Heitz et al. 2018), which the shading pass multiplies the analytic LTC terms by (the fork's hook
// custom_ps_areaLtcVisibility) - the unshadowed energy exact, only the visibility sampled.
// THE LAW IS jah_area_vis_law.glsl's (one text with the no-ray route's Jahshaka/ScreenAreaVis, 7-6): this job binds
// it - a stratum seen by ONE RAY against the TLAS (jahAreaStratum's ray, under the shadow casters' mask), its images
// the ray tier's (two rgba16f sums a set, ping-ponged, the surface words, the rest means).
// THE SPATIAL HALF - the joint-bilateral upsample to the full target and the ratios - is job 2 (rq_area_vis_resolve.comp).
// MONO ONLY (the sun contact's rule: a stereo view declines, its area lights unshadowed - a leftover, named).

layout( local_size_x = 8, local_size_y = 8, local_size_z = 1 ) in;

layout( set = 0, binding = 0 ) uniform accelerationStructureEXT tlas;

#define JAH_AREA_VIS_PARAMS_BINDING 1
#include "jah_area_vis_params.glsl"

layout( set = 0, binding = 2 ) uniform sampler2D gBufNormals;
layout( set = 0, binding = 3 ) uniform sampler2D sceneDepth;
/// THE HISTORY, ping-ponged: the two sums (light i in channel i) and the surface word (x the view distance's bits, y
/// the count, z the normal, jahAreaPackNormal) - the previous frame's read at the reprojection, this frame's written at
/// the texel.
layout( rgba16f, set = 0, binding = 4 ) uniform readonly image2D histSPrev;
layout( rgba16f, set = 0, binding = 5 ) uniform readonly image2D histUPrev;
layout( rgba32ui, set = 0, binding = 6 ) uniform readonly uimage2D histGPrev;
layout( rgba16f, set = 0, binding = 7 ) uniform writeonly image2D histSCur;
layout( rgba16f, set = 0, binding = 8 ) uniform writeonly image2D histUCur;
layout( rgba32ui, set = 0, binding = 9 ) uniform writeonly uimage2D histGCur;
/// THE REST MEANS of the two sums (the same texel reads and writes them: the camera has not moved).
layout( rgba16f, set = 0, binding = 10 ) uniform image2D restS;
layout( rgba16f, set = 0, binding = 11 ) uniform image2D restU;
/// THE SPECULAR SET (the head): its two sums' history pair and rest means, and the prepass's roughness (.y the GGX
/// alpha, fork 16d8e29d4's packing - rq_reflect.comp's decode).
layout( rgba16f, set = 0, binding = 12 ) uniform readonly image2D histS2Prev;
layout( rgba16f, set = 0, binding = 13 ) uniform readonly image2D histU2Prev;
layout( rgba16f, set = 0, binding = 14 ) uniform writeonly image2D histS2Cur;
layout( rgba16f, set = 0, binding = 15 ) uniform writeonly image2D histU2Cur;
layout( rgba16f, set = 0, binding = 16 ) uniform image2D restS2;
layout( rgba16f, set = 0, binding = 17 ) uniform image2D restU2;
layout( set = 0, binding = 18 ) uniform sampler2D gBufShadowRoughness;

#define JAH_ALPHA_TABLE floatBitsToUint( p.alpha.xy )
#include "jah_rq_alpha.glsl"
#include "jah_area_strata.glsl"
#include "jah_reproject.glsl"

/// A STRATUM SEEN BY ONE RAY: from its start along its direction for its reach against every shadow caster (0 or 1)
float jahAreaRayVisible( vec3 originQ, vec3 wq, float reachQ )
{
	rayQueryEXT rqa;
	rayQueryInitializeEXT( rqa, tlas, jahAlphaRayFlags( gl_RayFlagsTerminateOnFirstHitEXT ), uint( p.knobs.z ), originQ,
						   0.0, wq, reachQ );
	JAH_RQ_PROCEED( rqa )
	return rayQueryGetIntersectionTypeEXT( rqa, true ) == gl_RayQueryCommittedIntersectionTriangleEXT ? 0.0 : 1.0;
}
#define JAH_AREA_DEPTH( pix ) texelFetch( sceneDepth, pix, 0 ).x
#define JAH_AREA_NORMAL( pix ) texelFetch( gBufNormals, pix, 0 ).xyz
#define JAH_AREA_ALPHA( pix ) texelFetch( gBufShadowRoughness, pix, 0 ).y
#define JAH_AREA_PREV_S( pc ) imageLoad( histSPrev, pc )
#define JAH_AREA_PREV_U( pc ) imageLoad( histUPrev, pc )
#define JAH_AREA_PREV_S2( pc ) imageLoad( histS2Prev, pc )
#define JAH_AREA_PREV_U2( pc ) imageLoad( histU2Prev, pc )
#define JAH_AREA_PREV_G( pc ) imageLoad( histGPrev, pc )
#define JAH_AREA_STORE_CUR( tc, S, U, S2, U2, G )                                                                       \
	{                                                                                                                  \
		imageStore( histSCur, tc, S );                                                                                 \
		imageStore( histUCur, tc, U );                                                                                 \
		imageStore( histS2Cur, tc, S2 );                                                                               \
		imageStore( histU2Cur, tc, U2 );                                                                               \
		imageStore( histGCur, tc, G );                                                                                 \
	}
#define JAH_AREA_REST_LOAD( tc, S, U, S2, U2 )                                                                          \
	{                                                                                                                  \
		S = imageLoad( restS, tc );                                                                                    \
		U = imageLoad( restU, tc );                                                                                    \
		S2 = imageLoad( restS2, tc );                                                                                  \
		U2 = imageLoad( restU2, tc );                                                                                  \
	}
#define JAH_AREA_REST_STORE( tc, S, U, S2, U2 )                                                                         \
	{                                                                                                                  \
		imageStore( restS, tc, S );                                                                                    \
		imageStore( restU, tc, U );                                                                                    \
		imageStore( restS2, tc, S2 );                                                                                  \
		imageStore( restU2, tc, U2 );                                                                                  \
	}
#define JAH_AREA_VISIBLE( originQ, wq, reachQ ) jahAreaRayVisible( originQ, wq, reachQ )
// THE CLEARANCE AND ITS NORMAL (the ray origin's one law, jah_ray_origin.glsl - the sun contact's terms, rq_sun_contact.comp):
// the pixel's GEOMETRIC normal (jah_geometric_normal.glsl), its lift the point's float bound, the depth-rebuilt point's
// error (knobs.y: the sub-pixel snap) and the drawn surface's bound against level 0 at its distance (knobs.x: the drawn
// footprints)
#include "jah_rq_finite.glsl"
#define JAH_GN_RAW( q ) texelFetch( sceneDepth, ( q ), 0 ).x
#define JAH_GN_WORLD( q, raw ) jahAreaWorldAt( ( vec2( q ) + 0.5 ) / vec2( fullRes ), jahAreaViewDistance( raw ) )
#include "jah_geometric_normal.glsl"
#include "jah_ray_origin.glsl"
float jahAreaLiftRays( ivec2 pix, float raw, vec3 P, vec3 N, float dist, out vec3 geomN )
{
	const ivec2 fullRes = ivec2( p.resolution.zw );
	const bool perspective = p.camPos.w > 0.5;
	const vec3 V = perspective ? normalize( p.camPos.xyz - P ) : -p.fwd.xyz;
	geomN = jahGeometricNormal( pix, fullRes, raw, P, N, V );
	const float pixelSize = length( p.rayDown.xyz ) / float( fullRes.y ) * ( perspective ? dist : 1.0 );
	const float pointError = jahDepthPointError( raw, dist, p.projParams.y, perspective,
												 perspective ? ( P - p.camPos.xyz ) / max( dist, 1e-6 ) : p.fwd.xyz,
												 p.fwd.xyz, geomN, pixelSize, p.knobs.y );
	return jahRayFloatBound( P, dist ) + pointError +
		   jahViewDrawnBound( p.knobs.x, P, p.camPos.xyz, p.rayDown.xyz, float( fullRes.y ), perspective );
}
#define JAH_AREA_LIFT( pix, raw, P, N, dist, liftN ) jahAreaLiftRays( pix, raw, P, N, dist, liftN )
#include "jah_half_stochastic.glsl"
#include "jah_area_vis_law.glsl"

void main()
{
	jahAreaVisTrace( ivec2( gl_GlobalInvocationID.xy ) );
}
