#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

// THE SUN'S AND THE LAMPS' VISIBILITY ON THE CARDS: one ray per card texel towards the sun, in
// two modes of one job (knobs.y), and one per lamp in a third.
//
// A card's sun visibility has two halves, both TRACED:
//   * THE STILL WORLD's (ATOM-S3-CARDCAP, mode 1): every texel of a card just
//     captured, and of a card whose still term went stale (the sun turned, a
//     still caster moved), against the still world's shadow casters
//     (kRayMaskStillCaster, their near copies). The answer goes into the x
//     channel of the card's ShadowRough layer (y, the GGX alpha the capture
//     wrote, is kept). A card stores the still world's sun term at its own
//     texel scale, and one ray per texel IS that term — no shadow map fit per
//     card, no filter of a quantity the relight reads as a texel.
//   * THE MOVERS' (PHOTON-CARDS-4, mode 0): one ray per texel of every card a
//     shadow-casting mover's sun-projected footprint reaches, against the movers
//     alone (kRayMaskMoverCaster), into the cache's R8 mover-visibility layer.
// The relight job (JahCardLight_cs.glsl) multiplies the two into the sun's term.
//   * THE LAMPS' (PHOTON-7 stage 5, 5-3; mode 2): every texel of a card the relight is about to light, one FINITE ray
//     per point or spot light of the relight's own list (binding 7, the light buffer the relight reads) that reaches
//     the texel, from the lifted point toward the lamp and stopping short of it by its source radius and kLampEnd
//     (a lamp's own bulb is not its shadow), against every shadow caster, still and moving (the voxel injection's
//     lamp visibility is a voxel march of the same law, never bit-equal). Into the SunVis layer (r the sun's, kept):
//     g and a = a 16-bit mask (g the low byte), bit j the visibility of lamp j of the CARD'S LAMP TABLE (its record's
//     world ids: each light record carries its id in spotParams.w) - exact per lamp, whatever its colour, and the
//     relight and the hit read's lobe find their lamps' bits by id; b = THE FRACTIONAL LAMPS - the area lights (never
//     in the table, their visibility sampled over the rectangle: below) and the lamps past the table - their
//     visibilities weighted by their shares of the texel's direct luminance (the relight's diffuse shape,
//     jahCardDiffuse; an area light's own form factor), exact for one such lamp a card, the colour error of a mix
//     bounded by its share. ONE BYTE FOR EVERY LAMP multiplied each lamp's light by the
//     luminance mean - exact in luminance, wrong in colour: gi.leak_room's red lamp passed a wall at 98 % onto a face
//     the green lamp lit, the green dimmed as much (measured, PHOTON-7 stage 5).
//
// The texel's world point and normal are the relight's own reconstruction
// (JahCardLight_cs.glsl main: the capture camera's position, the ortho window
// on axisU/axisV, the depth back along axisD; the normal decoded from the card's
// view space) — the jobs must agree texel for texel.
//
// A HARD term: one ray, no filter; an edge is one card texel wide.
//
// THE LIFT (still mode only): the receiver IS a still caster, so the ray starts on
// a surface it can hit - the ORIGIN LAW every ray job keeps (jah_ray_origin.glsl,
// READ_B finding 3). The origin moves along the CAPTURED surface's GEOMETRIC normal
// (the card's Depth layer, jah_geometric_normal.glsl: the Normal layer is the shaded
// one, and a lift along a tilted shading normal clears the surface by cos(tilt) of
// itself) by the point's float bound plus the record's lift (rect.w,
// OgreSurfaceCache.cpp sunLiftOf: the texel's own reconstruction - one card texel
// and the depth layer's quantum - plus the captured level's bound against level 0,
// the near copy traced, times the bake's drift ratio), tMin zero. The movers' mode
// lifts nothing: a receiver is never a mover (movers carry no cards). THE LAMPS' MODE TAKES THE SAME LAW (the merge's
// one form, PHOTON-7 stage 6 into 7): the same lift along the same geometric normal, and each ray - a lamp's point or
// an area light's stratum, at a FINITE distance - AIMED FROM THE LIFTED START at its point (jah_area_strata.glsl's
// jahAreaRayOrigin), so the segment tested ends on the light: the lift's parallax is the start's alone and vanishes at
// the light (stage 5's normal lift kept its direction and moved the whole segment: -6.4 codes across a penumbra), and
// no start runs along a grazing ray past an occluder (stage 5's lift / cos did: unbounded at grazing).

layout( local_size_x = 8, local_size_y = 8, local_size_z = 1 ) in;

layout( set = 0, binding = 0 ) uniform accelerationStructureEXT tlas;

layout( set = 0, binding = 1 ) uniform Params
{
	vec4 toSun;		// xyz = the unit direction TOWARDS the sun, w = the ray's length
	vec4 knobs;		// x = the mask, y = the mode (0 movers, 1 still), zw = the alpha table's address (float bits)
} p;

/// A CUT-OUT CASTS ITS HOLES ON A CARD TOO (REFLECT-MOVERS-2, jah_rq_alpha.glsl).
#define JAH_ALPHA_TABLE floatBitsToUint( p.knobs.zw )
#include "jah_rq_alpha.glsl"
// the lamps' falloff, cone and the relight's diffuse shape: the fork's own text (unwrapped at build)
#include "jah_fork_brdf.glsl"

// ONE CARD, the relight's record layout (CardRelight): rect = (atlasX, atlasY,
// size, the still mode's lift in metres); camPos; axisU.xyz/axisV.xyz with the ortho window's width /
// height in .w; axisD.
struct CardRec
{
	vec4 rect;
	vec4 camPos;
	vec4 axisU;
	vec4 axisV;
	vec4 axisD;
	uvec4 lampIds[4];   // THE CARD'S LAMP TABLE (the lamps mode): bit j of the mask = lamp j's visibility
};
layout( std430, set = 0, binding = 2 ) readonly buffer Cards { CardRec cards[]; };

layout( set = 0, binding = 3 ) uniform sampler2D cardDepth;
layout( set = 0, binding = 4 ) uniform sampler2D cardNormal;
layout( r8, set = 0, binding = 5 ) uniform writeonly image2D moverVis;
layout( rg16, set = 0, binding = 6 ) uniform image2D shadowRough;
// THE LAMPS' MODE: the relight's light list (OgreSurfaceCache.cpp relightCards, JahCardLight_cs.glsl's layout: the
// count, then nine vec4 a light - position (w the type: 0 directional, 1 point, 2 spot, 3 area), diffuse (w the sun's
// flag), attenuation, spot direction, spot parameters, an area light's four corners) and the SunVis layer (r the
// sun's, kept; g and a the table's lamps', b the fractional lamps', written). AN AREA LIGHT'S VISIBILITY IS FRACTIONAL
// (the 5-3 fix: one ray to its centre was a hard shadow standing in for a soft one - 49 % of the unoccluded direct at
// the edge, over a code across 63 of a 64-texel penumbra, gi.card_lamp_shadow (4)): n x n stratified rays over its
// rectangle (n = knobs' toSun.x, GiQualityFacts::cardAreaStrata, whose law is written there), one a stratum, jittered
// by the texel's world point (never the frame), the visibility the RATIO sum( V_i f_i ) / sum( f_i ) of the samples'
// form-factor weights f_i = cos cos' / r^2 (Heitz et al. 2018) - the relight multiplies the analytic LTC form factor
// by it, so the unshadowed energy stays exact and only the visibility is sampled. An area light is never in the
// card's table: it takes the fractional byte, beside the lamps past the table, each weighted by its share (an area
// light's: its samples' own form factor in the range window).
struct CardLightRec
{
	vec4 position;
	vec4 diffuse;
	vec4 attenuation;
	vec4 spotDirection;
	vec4 spotParams;
	vec4 points[4];   // an area light's rectangle, its corners counter-clockwise from -x -y (points[0].w: two-sided)
};
layout( std430, set = 0, binding = 7 ) readonly buffer Lamps
{
	uvec4 lampCount;
	CardLightRec lamps[];
};
layout( rgba8, set = 0, binding = 8 ) uniform image2D sunVis;
/// A lamp's ray stops this far short of its source (beyond its source radius): its own bulb is not its shadow.
const float kLampEnd = 0.05;
// THE AREA LIGHT'S STRATA (PHOTON-7 stage 7, 7-A): one text with the pixel's trace - the key, the one origin function,
// a stratum's form factor and ray.
#define JAH_AREA_STRATA_RAY 1   // the stratum seen by one ray (jahAreaStratum)
#include "jah_area_strata.glsl"
/// THE RELIGHT'S DIFFUSE SHAPE (JahCardLight_cs.glsl's jahCardDiffuse, the same text - BRDF_Default's diffuse at
/// V = N, times NdotL): the weight a lamp's visibility takes in the byte is its share of the relight's own sum.
float jahCardLampShape( vec3 N, vec3 L, float perceptualRoughness )
{
	float NdotL = clamp( dot( N, L ), 0.0, 1.0 );
	vec3 H = normalize( L + N );
	float VdotH = clamp( dot( N, H ), 0.0, 1.0 );
	return NdotL * jahDisneyDiffuse( NdotL, 1.0, VdotH, perceptualRoughness );
}

/// THE CARD TEXEL'S WORLD POINT at depth `depth` (the relight's reconstruction): image row 0 is the card's +v side (the
/// capture camera's +Y), the ortho window on axisU/axisV, the depth back along axisD.
vec3 cardPoint( CardRec r, ivec2 t, float depth )
{
	const vec2 f = ( vec2( t ) + 0.5 ) / max( r.rect.z, 1.0 );
	return r.camPos.xyz + r.axisU.xyz * ( r.axisU.w * ( f.x - 0.5 ) ) + r.axisV.xyz * ( r.axisV.w * ( 0.5 - f.y ) ) -
		   r.axisD.xyz * depth;
}

/// THE CAPTURED SURFACE'S GEOMETRIC NORMAL: the one text (jah_geometric_normal.glsl) over the card's own block of the
/// Depth layer - metres from the capture's near plane, R16F (10 stored mantissa bits), 0 = nothing captured; the
/// depth is linear under the capture's orthographic camera, so a plane is affine in it as the include requires.
#include "jah_ray_origin.glsl"
CardRec gnCard;
#define JAH_GN_RAW( q ) texelFetch( cardDepth, ivec2( gnCard.rect.xy ) + ( q ), 0 ).x
#define JAH_GN_WORLD( q, raw ) cardPoint( gnCard, ( q ), ( raw ) )
#define JAH_GN_DRAWN( raw ) ( ( raw ) > 0.0 )
#define JAH_GN_MANTISSA_BITS 10.0
#include "jah_geometric_normal.glsl"

void main()
{
	const CardRec r = cards[gl_WorkGroupID.z];
	const uint size = uint( r.rect.z );
	const uvec2 t = gl_GlobalInvocationID.xy;
	if( t.x >= size || t.y >= size )
		return;
	const ivec2 at = ivec2( uint( r.rect.x ) + t.x, uint( r.rect.y ) + t.y );

	float vis = 1.0;
	const float depth = texelFetch( cardDepth, at, 0 ).x;
	if( p.knobs.y > 1.5 )
	{
		// THE LAMPS' MODE (the head of this file)
		float wRest = 0.0, vRest = 0.0;
		uint mask = 0xFFFFu;
		if( depth > 0.0 )
		{
			const vec3 nV = texelFetch( cardNormal, at, 0 ).xyz * 2.0 - 1.0;
			const vec3 N = normalize( r.axisU.xyz * nV.x + r.axisV.xyz * nV.y + r.axisD.xyz * nV.z );
			// the relight's plane-snapped normal and roughness (JahCardLight_cs.glsl main), for its diffuse shape
			const vec3 planeN = normalize( r.axisD.xyz );
			const vec3 Ncone = dot( N, planeN ) > 0.99985 ? planeN : N;
			const float alpha = imageLoad( shadowRough, at ).y / 1.001001 + 0.001;
			const float roughness = sqrt( max( alpha, 0.0 ) );
			const vec2 f = ( vec2( t ) + 0.5 ) / float( size );
			const vec3 P = r.camPos.xyz + r.axisU.xyz * ( r.axisU.w * ( f.x - 0.5 ) ) +
						   r.axisV.xyz * ( r.axisV.w * ( 0.5 - f.y ) ) - r.axisD.xyz * depth;
			// THE CLEARANCE AND ITS NORMAL (the ray origin's one law, the still mode's - the head of this file): the
			// captured surface's GEOMETRIC normal, the lift the point's float bound plus the record's (rect.w); every
			// ray starts there and is AIMED FROM THERE at its lamp's point (jahAreaRayOrigin)
			gnCard = r;
			const vec3 Ng = jahGeometricNormal( ivec2( t ), ivec2( int( size ) ), depth, P, N, r.axisD.xyz );
			const float lift = jahRayFloatBound( P, depth ) + r.rect.w;
			for( uint i = 0u; i < lampCount.x; ++i )
			{
				const CardLightRec l = lamps[i];
				if( l.position.w < 0.5 )
					continue;   // a directional light: the sun's modes
				const vec3 toLamp = l.position.xyz - P;
				const float d = length( toLamp );
				if( d > l.attenuation.x || !( d > 0.0 ) )
					continue;
				const vec3 L = toLamp / d;
				const bool area = l.position.w > 2.5;
				float atten = area ? jahLightWindow( d, l.attenuation.x ) : jahLightAttenuation( d, l.attenuation );
				if( !area && l.position.w > 1.5 )
				{
					const float spotCos = dot( -L, l.spotDirection.xyz );
					if( spotCos < l.spotParams.y )
						continue;
					atten *= jahSpotAttenuation( spotCos, l.spotParams.xyz );
				}
				// its slot in the card's table, by its world id (-1: past the table, the overflow's)
				int slot = -1;
				const uint id = floatBitsToUint( l.spotParams.w );
				for( int q = 0; q < 16 && slot < 0 && !area; ++q )
					if( r.lampIds[q >> 2][q & 3] == id )
						slot = q;
				if( area )
				{
					// THE AREA LIGHT'S FRACTIONAL VISIBILITY (the head of this file)
					const uint n = clamp( uint( p.toSun.x + 0.5 ), 1u, kAreaStrataMax );   // an n^2 loop: bounded
					const vec3 c0 = l.points[0].xyz, eu = l.points[1].xyz - c0, ev = l.points[3].xyz - c0;
					const vec3 emit = l.spotDirection.xyz;   // the light shines down its -Z: the record's direction
					const bool twoSided = l.points[0].w != 0.0;
					const uint key = jahAreaStrataKey( P );
					float sf = 0.0, svf = 0.0;
					for( uint k = 0u; k < n * n; ++k )
					{
						float vq, unusedCl;
						vec3 unusedDir;
						const float f = jahAreaStratum( P, Ng, Ncone, lift, c0, eu, ev, emit, twoSided, n, k, key,
														uint( p.knobs.x ), kAreaLampEnd, vq, unusedDir, unusedCl );
						if( !( f > 0.0 ) )
							continue;
						sf += f;
						svf += f * vq;
					}
					// its share: the samples' own form factor ( sum f ) A / ( n^2 pi ), in the range window
					const float areaM2 = length( cross( eu, ev ) );
					const float wA = dot( l.diffuse.xyz, vec3( 0.2126, 0.7152, 0.0722 ) ) *
									 ( sf * areaM2 / ( float( n * n ) * 3.14159265 ) ) * atten;
					if( wA > 0.0 )
					{
						wRest += wA;
						vRest += wA * ( svf / sf );
					}
					continue;
				}
				const float w = dot( l.diffuse.xyz, vec3( 0.2126, 0.7152, 0.0722 ) ) * jahCardLampShape( Ncone, L, roughness ) *
								atten;
				if( !( w > 0.0 ) )
					continue;   // lights nothing here: its bit stays set
				float v = 1.0;
				const vec3 origin = jahAreaRayOrigin( P, Ng, L, lift );
				const vec3 toLampO = l.position.xyz - origin;
				const float dO = length( toLampO );
				const vec3 Lo = dO > 0.0 ? toLampO / dO : L;
				const float reach = dO - max( l.attenuation.y, 0.0 ) - kLampEnd;
				if( reach > 0.0 )
				{
					rayQueryEXT rq;
					rayQueryInitializeEXT( rq, tlas, jahAlphaRayFlags( gl_RayFlagsTerminateOnFirstHitEXT ),
										   uint( p.knobs.x ), origin, 0.0, Lo, reach );
					// THROUGH THE PANES (PHOTON-7 10-4 R8; the table's bit keeps a lamp passing half or more of its light,
					// the rest's weight takes the fraction)
					JahPanes panes = jahPanesNone();
					JAH_RQ_PROCEED_PANES( rq, panes )
					v = rayQueryGetIntersectionTypeEXT( rq, true ) == gl_RayQueryCommittedIntersectionTriangleEXT
							? 0.0 : jahPanesTransmit( panes, reach );
				}
				if( slot >= 0 )
				{
					if( !( v > 0.5 ) )
						mask &= ~( 1u << uint( slot ) );
				}
				else
				{
					wRest += w;
					vRest += w * v;
				}
			}
		}
		const vec4 was = imageLoad( sunVis, at );
		imageStore( sunVis, at, vec4( was.x, float( mask & 0xFFu ) / 255.0, wRest > 0.0 ? vRest / wRest : 1.0,
									  float( mask >> 8u ) / 255.0 ) );
		return;
	}
	if( depth > 0.0 )
	{
		const vec3 nV = texelFetch( cardNormal, at, 0 ).xyz * 2.0 - 1.0;
		const vec3 N = normalize( r.axisU.xyz * nV.x + r.axisV.xyz * nV.y + r.axisD.xyz * nV.z );
		const vec3 L = p.toSun.xyz;
		if( dot( N, L ) > 0.0 )
		{
			const vec3 P = cardPoint( r, ivec2( t ), depth );
			// THE LIFT (the head of this file): the still mode's, from the record, along the captured surface's
			// geometric normal - facing the capture camera, which looks down -axisD.
			gnCard = r;
			const vec3 origin = p.knobs.y > 0.5
									? jahRayOrigin( P, jahGeometricNormal( ivec2( t ), ivec2( int( size ) ), depth, P, N,
																		   r.axisD.xyz ),
													depth, r.rect.w )
									: P;
			rayQueryEXT rq;
			rayQueryInitializeEXT( rq, tlas, jahAlphaRayFlags( gl_RayFlagsTerminateOnFirstHitEXT ),
								   uint( p.knobs.x ), origin, 0.0, L, p.toSun.w );
			// THROUGH THE PANES (PHOTON-7 10-4 R8): the card's traced sun takes their transmittance
			JahPanes panes = jahPanesNone();
			JAH_RQ_PROCEED_PANES( rq, panes )
			vis = rayQueryGetIntersectionTypeEXT( rq, true ) == gl_RayQueryCommittedIntersectionTriangleEXT
					  ? 0.0 : vis * jahPanesTransmit( panes, p.toSun.w );
		}
	}
	if( p.knobs.y > 0.5 )
	{
		const vec4 was = imageLoad( shadowRough, at );
		imageStore( shadowRough, at, vec4( vis, was.y, 0.0, 0.0 ) );
	}
	else
	{
		imageStore( moverVis, at, vec4( vis ) );
	}
}
