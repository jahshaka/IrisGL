#version 460
// PHOTON R5, PHOTON-7 STAGE 6 (commit 7) — THE SPATIAL FILTER = LUMEN'S (LumenReflectionDenoiserSpatial.usf,
// SPECS/research/LUMEN_VR_FACTS_2026-10-22.md C7.3), and the write of the reflection.
//
// ONE THREAD PER FULL-RESOLUTION PIXEL, every pixel of `jahSsrReflection` written every frame - the odd remainder of an
// odd-sized half-resolution target included (AB section 3 #19), a pixel with no answer written as no reflection (w 0:
// the probe's) - so nothing of the resolve's scratch or of an older frame survives into the picture HlmsPbs reads.
//
//   THE CENTRE: the temporal pass' mean at this pixel - its own trace texel at full resolution; at half resolution the
//   JOINT-BILATERAL UPSAMPLE of the four trace texels around it (bilinear, times the plane weight and the normal weight
//   of each texel's surface against this pixel's: an edge's texels on the other surface carry nothing) - its count N and
//   its temporal standard deviation sigma = sqrt( E[ L^2 ] - L^2 ) (the history's second moment, denoiser space). AT REST
//   the rest's answer composed (the frozen moving mean handed over to the rest mean, jah_reflect_rest.glsl) and sigma
//   := the REST MEAN'S STANDARD ERROR (the luminance stop tightens as it converges; jahRestReach is deleted).
//   THE KERNEL: LUMEN'S SUPPORT AND WEIGHTS, ENOUGH TAPS FOR A PIPELINE WITHOUT TSR (the lead's ruling on commit 7):
//   the support is the lobe's projected footprint, Lumen's 8 saturate( 8 r ) full-resolution pixels (r the perceptual
//   roughness) - filtering inside the lobe's own footprint leaves the expected image as it is - times the lobe's chance
//   of a stochastic draw ( 1 - p: a centre-ray texel is its lobe's integral and is never blurred, the mirror ramp). The
//   weights are Lumen's: depth (the plane distance relative to the depth, scale 10000), normal (against the lobe's half
//   angle atan( 3 r^2 ) + 0.01) and luminance (exp2( -|dL| / sigma )); D = 1 - saturate( N / 2 ), the disocclusion
//   factor, widens the normal lobe x4, turns the luminance stop off and adds a Reinhard of strength D. THE TAPS: 32 on a
//   Vogel disk over the support (the effective sample count of the interim 7 x 7 tent at its widest, 33), turned by a
//   hash of the PIXEL - FIXED, the same every frame, moving and at rest (the hold law holds; nothing flickers without
//   a temporal reconstruction after it) - read from a TILE of the group's trace texels in shared memory. ALWAYS ON
//   where the support is over a pixel: Lumen's relative-noise gate (50 %) and its 4-8 jittered taps belong to a
//   pipeline whose TSR re-jitters and accumulates them; this one has none (measured: the literal arm doubled the glass
//   walk's glossy flicker, p99 3.63 -> 6.25). Never fed back into the history.
//   THE WRITE: the result in linear radiance, w = the roughness gate's feather times the young VIEW's fade (a graded
//   screenshot's two frames).
//
// SAME DESCRIPTOR SET as rq_reflect.comp — the same layout, the same bound set, the same Params (through `denoiser`).
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require

layout( local_size_x = 8, local_size_y = 8, local_size_z = 1 ) in;

const int kMaxCascades = 4;
layout( set = 0, binding = 0 ) uniform accelerationStructureEXT tlas;

layout( set = 0, binding = 1 ) uniform Params
{
	/// xyz = the camera in world space, w = 1 for a perspective camera and 0
	/// for an orthographic one (the reconstruction differs — see worldAt()).
	vec4 camPos;
	/// The world-space ray basis: worldDir(u,v) = rayTL + rayRight*u + rayDown*v,
	/// scaled so its component along the camera's forward axis is exactly 1.
	/// Then `camPos + worldDir * viewDistance` is the surface. Under an
	/// orthographic camera rayTL/rayRight/rayDown carry the image PLANE instead
	/// (an offset, not a ray) and `fwd` is the one view direction.
	vec4 rayTL;
	vec4 rayRight;
	vec4 rayDown;
	vec4 fwd;
	/// x = A, y = B of Camera::getProjectionParamsAB() (reverse-Z safe),
	/// z = the far plane (the orthographic depth scale), w = the roughness
	/// gate's FEATHER half-width (kRayReflectFeather).
	vec4 projParams;
	/// xy = the trace resolution in pixels, zw = the full-resolution size of
	/// jahSsrReflection.
	vec4 resolution;
	/// x = the roughness gate — the PROJECT's dial, not a renderer constant:
	/// above it the probe/field photograph is a good enough integral of a wide
	/// lobe and a ray is spent for nothing. The transition is FEATHERED over
	/// projParams.w either side of it. y = the ray's maximum length in
	/// world units, z = the frame index (the sample sequence's only input),
	/// w = how many cascades are bound.
	vec4 knobs;
	/// x = THE REST FRAME k, 1..N on a frame the view rests (PHOTON-2 1e, fix F1: the gather's rule — a rest mean handed
	/// over from the frozen moving history, rq_reflect_temporal.comp), 0 while it moves, y = the
	/// drawn cut's error per unit of view distance (the view's pixel tolerance x the LOD bias x one full-resolution
	/// pixel; world units under an orthographic camera) - rq_reflect.comp's RAY ORIGIN,
	/// z = 1 when a sky cubemap is bound, w = the history's minimum blend
	/// weight (the floor on 1/n — how long the temporal mean remembers).
	vec4 knobs2;
	/// The colour an escaping ray reads when no sky cubemap is bound.
	vec4 skyColour;
	/// The VIEW space's three axes in world space (the camera's orientation as
	/// a rotation): what turns the G-buffer's view-space normal back into one.
	vec4 viewAxisX;
	vec4 viewAxisY;
	vec4 viewAxisZ;
	/// Per cascade: xyz = the voxel box's world origin, w = the box's largest
	/// side in world units (the cell size times the resolution).
	vec4 voxelOrigin[kMaxCascades];
	/// Per cascade: xyz = 1 / the voxel box's world size, w = one cell in world
	/// units (the sample point's bias along the ray).
	vec4 voxelInvSize[kMaxCascades];
	/// THE PREVIOUS FRAME'S CAMERA, in exactly the same five numbers as this
	/// frame's (camPos, rayTL, rayRight, rayDown, fwd). Not a view-projection
	/// matrix, deliberately: inverting the basis above is the same arithmetic
	/// forwards and backwards, so the reprojection cannot disagree with the
	/// reconstruction about a handedness, a y-flip or a depth convention — and
	/// each of those is a silent half-pixel-to-whole-image error that only shows
	/// up as a smear while the camera moves.
	vec4 prevCamPos;
	vec4 prevRayTL;
	vec4 prevRayRight;
	vec4 prevRayDown;
	vec4 prevFwd;
	/// ---- THE SECOND EYE (lane REFLECT-VR-1, LAYERED-STEREO-1) ------------
	/// x = 1 when this target carries TWO EYES, one per LAYER of every screen
	/// image here (the dispatch's z). Then the five basis vectors above are the
	/// LEFT eye's and the five below the right eye's, each over its own layer
	/// as a 0..1 image; with x = 0 the block below is unread and the basis
	/// above is the one camera's, exactly as before. One dispatch, one
	/// descriptor set, one history ring: the eye is the layer (gEye).
	///
	/// y = THE VIEW'S AGE: how many consecutive frames this history has been
	/// written (0 on a first frame, a resize, a scene bind): the filter's young-VIEW fade (a two-frame screenshot).
	/// z = 1 writes THE PHOTON VIEW'S Hits overlay (binding 37, PHOTON-VIEW-1).
	/// w = THE REST'S LENGTH N (PHOTON-2 fix F1): the frames the rest mean is handed over in, the gather's own
	/// settleFramesOf(the reflection's 32-frame history) — after which the view holds.
	vec4 stereo;
	vec4 camPos2;
	vec4 rayTL2;
	vec4 rayRight2;
	vec4 rayDown2;
	vec4 fwd2;
	vec4 prevCamPos2;
	vec4 prevRayTL2;
	vec4 prevRayRight2;
	vec4 prevRayDown2;
	vec4 prevFwd2;
	/// ---- THE SURFACE CACHE (PHOTON-CARDS-2) ------------------------------
	/// x = the instance-table entries bound (0 = the scene holds no cache: the
	/// card read declines every hit and the voxels answer, as before), y = the
	/// card records bound, z: unused (the card read's footprint gate is deleted,
	/// PHOTON-7 stage 6), w = the per-slot geometry-row entries
	/// bound (the hit's geometric normal; 0 = none — the reversed ray faces).
	vec4 cards;
	/// ---- THE HIT RECORD (PHOTON-HIT-SHADE-1) ------------------------------
	/// hitList: x = the list's capacity in records, y = its grid width, z = the
	/// GPU scene instance entries bound (the flags a hit reads: mover, rigged),
	/// w = 1 when the list is bound. hitSun: xyz = towards the sun, w = 1 when the
	/// pass has one. hitSun2: x = the sun ray's TLAS mask (the casters), y unused
	/// (a near hit is ON level 0: its sun leg's surface term is 0, the one origin law), z = its length, w = a FAR
	/// copy's hit's surface term (the traced set's widest coarse-vs-fine gap under the drift law, farOverlap).
	vec4 hitList;
	vec4 hitSun;
	vec4 hitSun2;
	/// ---- A MOVING OBJECT (REFLECT-MOVERS-1) --------------------------------
	/// x = 1 when the VIEW'S ID IMAGE is bound (binding 38, the visibility
	/// buffer's `jahAtomIds`: which slot drew each pixel) — then a pixel on a
	/// moving slot reprojects through that slot's two poses (jah_reproject.glsl).
	/// 0 = no id pass on this chain (a stereo chain, the split off): every
	/// surface takes the camera path. yz = the id image's size in pixels.
	/// w = 1 with the lane's hit-motion rules on, 2 when a mover also moved in the
	/// last two frames (the departure rule's gate), 3 when a POSE moved in the last
	/// two frames (SKINNED-VELOCITY-1: the pixels no moving Atom item drew are
	/// identified through the TLAS; the arm "reflect.posed" off keeps it at 2 — the paired
	/// cost arm); 0 = the arm "reflect.motion" off: the camera-only
	/// history of before.
	vec4 motion;
	/// THE ALPHA TABLE (REFLECT-MOVERS-2, jah_rq_alpha.glsl): xy = its device
	/// address, float bits (0 = none: the rays stay opaque). z: unused (the edge-class overlay is deleted with the
	/// moving hit's history, PHOTON-7 stage 6). w = 1: the hit's mover gate runs.
	vec4 alpha;
	/// THE MEDIA ALONG THE REFLECTION (PHOTON-I-1 fix 5): OgreScene::fogAlong's eight
	/// (jah_fog_along.glsl states them).
	vec4 fog[8];
	/// THE METAL HIT'S ROUTE (REFLECT-FIX-1): x = the reflector's perceptual roughness
	/// below which a hit on a metal is decoded; above it the voxel store answers it.
	vec4 metal;
	/// THE HIT'S OWN SURFACE (FAR-SUN-2, jah_rq_hit_direct.glsl): xy = the hit table's device
	/// address (float bits; 0 = none), z = 1 the texture pool is bound, w = 1 the cloud layer
	/// shades the sun; then the cloud shadow's map and sun (jah_cloud_shadow.glsl).
	vec4 hitTable;
	vec4 cloudMap;
	vec4 cloudSun;
	/// THE REST BLOCK (PHOTON-2 round 2): x = 1 = THE GI FREEZE (the arm "gi.freeze", M1's measuring arm: the temporal
	/// pass keeps every moving history as carried - no new sample, no clamp; a fixed estimator takes its ray;
	/// rq_reflect_temporal.comp).
	/// z = THE REST'S RAYS A FRAME (commit 8: the trace's batch at rest, GiQualityFacts::reflectRestRays).
	vec4 rest;
	/// THE REST BREAKS PER TEXEL FOR MOVERS (PHOTON-2 round 2, G6): x = how many moved instances' SWEPT BOXES follow
	/// (their bounds this frame and last, joined; at most 16 - more moved breaks the view's rest whole, on the host);
	/// a resting texel resumes when its ray, its lobe's mean segment or its hit's sun leg crosses one.
	vec4 restMovers;
	vec4 restMoverBox[32];   // per box: [2i] = min, [2i + 1] = max (xyz)
	/// THE ONE ESTIMATOR'S SOURCES (PHOTON-7 stage 6): screen.x = 1 when the SCREEN TRACE runs (the chain's screen
	/// sources are bound: PostFxDesc::reflectSources Both or Screen, a mono view), y = 1 for THE SCREEN ALONE (Screen: a
	/// miss is no sample - no ray follows it), z = the march's step count, w = its phase rule (PostFxDesc::ssrMarchPhase);
	/// screen2.x = the march's length (ssrMaxDistance), y = its thickness (ssrThickness), z = where the FAR COPIES' query
	/// starts (the near length less the far copies' widest hand-over gap, the gather's rule), w = where it ends (the far
	/// plane; 0 = no far query).
	vec4 screen;
	vec4 screen2;
	/// THE DENOISER SPACE'S EXPOSURE (PHOTON-7 stage 6 commit 6, jah_reflect_denoise.glsl: Lumen's space is on
	/// PRE-EXPOSED colour): x = the view's exposure multiplier where it is a constant (a fixed tonemap: the chain's
	/// cleared 1x1; 1 without a tonemap), y = 1 when the chain's MEASURED history is bound at binding 50 instead (the
	/// multiplier the tonemapper scaled the last frame by). z = the lobe draw's seed offset (the arm reflect.seedOffset).
	vec4 denoiser;
	/// THE DISPLAY'S CODE SLOPE (commit 8's hold): 64 entries (jah_reflect_rest.glsl jahDisplayCodes).
	vec4 display[16];
} p;

int gEye = 0;
layout( set = 0, binding = 2 ) uniform sampler2DArray gBufNormals;
layout( set = 0, binding = 3 ) uniform sampler2DArray gBufShadowRoughness;
layout( set = 0, binding = 4 ) uniform sampler2DArray sceneDepth;
layout( rgba16f, set = 0, binding = 5 ) uniform writeonly image2DArray ssrReflection;
layout( rgba16f, set = 0, binding = 6 ) uniform readonly image2DArray historyPrev;   // at rest: the frozen H (R1)
layout( rgba16f, set = 0, binding = 7 ) uniform readonly image2DArray historyCur;
layout( rg32ui, set = 0, binding = 8 ) uniform readonly uimage2DArray statePrev;
layout( rg32ui, set = 0, binding = 9 ) uniform readonly uimage2DArray stateCur;
/// THE REST'S REFERENCE (PHOTON-2 round 2, R1 (f)'s arm, rest.y): composited UNFILTERED at rest under the arm.
layout( rgba32f, set = 0, binding = 46 ) uniform readonly image2DArray restReference;
/// THE EXPOSURE HISTORY (the chain's measured 1 x 1; a stand-in where p.denoiser.y = 0).
layout( set = 0, binding = 50 ) uniform sampler2D jahExposure;

/// THE REST'S DISPLAYED STANDARD ERROR (commit 8's hold): written here at rest, at each trace texel's own pixel, for
/// the next frame's stop - display codes + 1 (0 = not measured). A statistic, never colour fed back.
layout( r32f, set = 0, binding = 51 ) uniform writeonly image2DArray restDisplay;

#include "jah_rq_finite.glsl"
#include "jah_reflect_draw.glsl"
float gExposure = 1.0;
#define JAH_DENOISE_EXPOSURE gExposure
#include "jah_reflect_denoise.glsl"
#define JAH_DISPLAY_LUT( i ) p.display[( i ) >> 2][( i ) & 3]
#include "jah_reflect_rest.glsl"
#include "jah_reflect_state.glsl"

/// THE YOUNG VIEW'S FADE (a graded screenshot's view lives about two frames): a traced reflection is shown whole once
/// the VIEW has this many frames of history - a fact about the view, not about a texel.
const float kYoungViewFrames = 8.0;
/// Lumen's spatial constants (r.Lumen.Reflections.BilateralFilter.*): the kernel radius in pixels, the samples, the depth
/// weight's scale, the disocclusion frames.
const float kKernelRadius = 8.0;
/// THE TAPS: a Vogel disk of kTaps over the support (the golden angle), and the tile they are read from - per 8 x 8 group
/// of full-resolution pixels, the trace texels its kernels and its bilinear centres reach (kKernelRadius pixels and one
/// texel around the group's own): 26 x 26 at full resolution, 14 x 14 at half.
const int kTaps = 32;
const float kGoldenAngle = 2.39996323;
const int kTileSide = 26;
const float kDepthWeightScale = 10000.0;
const float kMaxDisocclusionFrames = 2.0;

float viewDistance( float rawDepth )
{
	if( p.camPos.w < 0.5 )
		return abs( ( rawDepth - p.projParams.x ) / p.projParams.y );
	return p.projParams.y / ( rawDepth - p.projParams.x );
}
struct EyeImage { vec3 camPos; float perspective; vec3 rayTL; vec3 rayRight; vec3 rayDown; vec3 fwd; };
EyeImage eyeNow( int eye )
{
	EyeImage e;
	if( eye == 1 ) { e.camPos = p.camPos2.xyz; e.perspective = p.camPos2.w; e.rayTL = p.rayTL2.xyz;
					 e.rayRight = p.rayRight2.xyz; e.rayDown = p.rayDown2.xyz; e.fwd = p.fwd2.xyz; }
	else { e.camPos = p.camPos.xyz; e.perspective = p.camPos.w; e.rayTL = p.rayTL.xyz;
		   e.rayRight = p.rayRight.xyz; e.rayDown = p.rayDown.xyz; e.fwd = p.fwd.xyz; }
	return e;
}
vec3 worldAt( EyeImage e, vec2 uv, float dist )
{
	const vec3 plane = e.rayTL + e.rayRight * uv.x + e.rayDown * uv.y;
	if( e.perspective < 0.5 )
		return e.camPos + plane + e.fwd * dist;
	return e.camPos + plane * dist;
}
float exposureOf()
{
	const float e = p.denoiser.y > 0.5 ? texelFetch( jahExposure, ivec2( 0 ), 0 ).x : p.denoiser.x;
	return finite1( e ) && e > 0.0 ? e : 1.0;
}

/// A SURFACE POINT OF THE PICTURE: a full-resolution pixel's (its centre, read exactly).
struct Surf { bool ok; vec3 world; vec3 N; float dist; };
Surf surfOfPixel( ivec2 px, EyeImage e, ivec2 fullRes )
{
	Surf s;
	s.ok = false;
	const float raw = texelFetch( sceneDepth, ivec3( px, gEye ), 0 ).x;
	vec3 n = texelFetch( gBufNormals, ivec3( px, gEye ), 0 ).xyz * 2.0 - 1.0;
	if( !( raw > 0.0 && raw < 1.0 ) || dot( n, n ) < 1e-6 )
		return s;
	s.dist = viewDistance( raw );
	s.world = worldAt( e, ( vec2( px ) + 0.5 ) / vec2( fullRes ), s.dist );
	n = normalize( n );
	s.N = normalize( p.viewAxisX.xyz * n.x + p.viewAxisY.xyz * n.y + p.viewAxisZ.xyz * n.z );
	s.ok = true;
	return s;
}

/// A TRACE TEXEL'S ANSWER in the denoiser space: rgb, its sigma (the temporal standard deviation of its luminance, or at
/// rest the rest mean's standard error), its frame count; w of the result = 1 where it holds an answer.
struct Answer { bool ok; vec3 d; float sigma; float n; };
Answer answerAt( ivec2 t )
{
	Answer a;
	a.ok = false; a.d = vec3( 0.0 ); a.sigma = 0.0; a.n = 0.0;
	const JahReflectState sc = jahStateUnpack( imageLoad( stateCur, ivec3( t, gEye ) ).xy );
	if( !( sc.surfDist > 0.0 ) )
		return a;
	const vec4 M = imageLoad( historyCur, ivec3( t, gEye ) );
	if( p.knobs2.x < 0.5 )
	{
		// MOVING: the temporal mean and its second moment (Lumen's SpecularAndSecondMoment).
		if( !finite3( M.xyz ) )
			return a;
		a.ok = true;
		a.d = jahToDenoise( clamp( M.xyz, vec3( 0.0 ), vec3( kMaxRadiance ) ) );
		const float l = jahDenoiseLuma( a.d );
		a.sigma = sqrt( max( M.w - l * l, 0.0 ) );
		a.n = sc.N;
		return a;
	}
	// AT REST: the frozen moving history H and the rest mean M composed; sigma from H's second moment handed over to
	// the rest mean's standard error (the second moment of its samples' denoiser-space luma kept beside it, over its v
	// samples - both in the denoiser space, commit 8).
	const vec4 Hr = imageLoad( historyPrev, ivec3( t, gEye ) );
	const float Hn = jahStateUnpack( imageLoad( statePrev, ivec3( t, gEye ) ).xy ).N;
	const bool hasH = finite3( Hr.xyz ) && Hn > 0.0;
	const float v = float( sc.v );
	if( !hasH && !( v > 0.0 ) )
		return a;
	const float N = max( p.stereo.w, 1.0 );
	const vec3 answer = jahRestAnswer( hasH ? Hr.xyz : vec3( 0.0 ), hasH, M.xyz, v, N );
	if( !finite3( answer ) )
		return a;
	a.ok = true;
	a.d = jahToDenoise( clamp( answer, vec3( 0.0 ), vec3( kMaxRadiance ) ) );
	float sigmaH = 0.0;
	if( hasH )
	{
		const float lh = jahDenoiseLuma( jahToDenoise( clamp( Hr.xyz, vec3( 0.0 ), vec3( kMaxRadiance ) ) ) );
		sigmaH = sqrt( max( Hr.w - lh * lh, 0.0 ) );
	}
	float se = 0.0;
	if( v >= 1.0 )
	{
		// (the rest half's w is the second moment of the samples' denoiser-space luma, commit 8: the SE is in the space)
		const float lm = jahDenoiseLuma( jahToDenoise( clamp( M.xyz, vec3( 0.0 ), vec3( kMaxRadiance ) ) ) );
		se = sqrt( max( M.w - lm * lm, 0.0 ) / v );
	}
	a.sigma = hasH ? mix( sigmaH, se, jahRestHandOverWeight( v, N ) ) : se;
	a.n = ( hasH ? Hn : 0.0 ) + v;
	return a;
}
/// The disocclusion factor's extra Reinhard (Lumen's Tm / InvTm).
vec3 tm( vec3 x, float d ) { return x / ( 1.0 + d * jahDenoiseLuma( x ) ); }
vec3 invTm( vec3 y, float d ) { return y / max( 1.0 - d * jahDenoiseLuma( y ), 1e-4 ); }

/// THE TILE (shared): each trace texel's answer once - rgb and sigma as halves, the count - and its surface point and
/// normal; a texel with no answer or no surface has count -1.
shared uvec2 sAnswer[kTileSide * kTileSide];
shared vec4  sPoint[kTileSide * kTileSide];   // xyz = the surface point, w = the count (-1: none)
shared vec4  sNormal[kTileSide * kTileSide];  // xyz = the shading normal

void main()
{
	const ivec2 fullRes = ivec2( p.resolution.zw );
	const ivec2 traceRes = ivec2( p.resolution.xy );
	const ivec2 px = ivec2( gl_GlobalInvocationID.xy );
	gEye = int( gl_GlobalInvocationID.z );
	gExposure = exposureOf();
	const ivec2 scale = max( fullRes / max( traceRes, ivec2( 1 ) ), ivec2( 1 ) );
	const EyeImage e = eyeNow( gEye );
	// ---- THE TILE: every invocation loads its share, then the barrier ----
	const int reachT = int( ceil( kKernelRadius / float( scale.x ) ) ) + 1;
	const ivec2 groupPx = ivec2( gl_WorkGroupID.xy ) * 8;
	const ivec2 tile0 = groupPx / scale - ivec2( reachT );
	const int side = min( ( groupPx.x + 7 ) / scale.x - groupPx.x / scale.x + 1 + 2 * reachT, kTileSide );
	for( int i = int( gl_LocalInvocationIndex ); i < side * side; i += 64 )
	{
		const ivec2 t = tile0 + ivec2( i % side, i / side );
		uvec2 ans = uvec2( 0u );
		vec4 pt = vec4( 0.0, 0.0, 0.0, -1.0 );
		vec4 nr = vec4( 0.0 );
		if( all( greaterThanEqual( t, ivec2( 0 ) ) ) && all( lessThan( t, traceRes ) ) )
		{
			const Answer a = answerAt( t );
			const Surf ts = a.ok ? surfOfPixel( jahTexelPixel( t, scale, fullRes ), e, fullRes ) : Surf( false, vec3( 0.0 ), vec3( 0.0 ), 0.0 );
			if( a.ok && ts.ok )
			{
				ans = uvec2( packHalf2x16( a.d.xy ), packHalf2x16( vec2( a.d.z, a.sigma ) ) );
				pt = vec4( ts.world, a.n );
				nr = vec4( ts.N, 0.0 );
			}
		}
		sAnswer[i] = ans;
		sPoint[i] = pt;
		sNormal[i] = nr;
	}
	barrier();
	if( any( greaterThanEqual( px, fullRes ) ) )
		return;
	const Surf c = surfOfPixel( px, e, fullRes );
	const float roughGate = p.knobs.x;
	const float feather = p.projParams.w;
	const float alpha = max( texelFetch( gBufShadowRoughness, ivec3( px, gEye ), 0 ).y * 0.999 + 0.001, 1e-6 );
	const float r = sqrt( alpha );
	// THIS PIXEL IS ITS TRACE TEXEL'S OWN (the one the texel was traced from): it reports the displayed SE the stop reads.
	const ivec2 own = min( px / scale, traceRes - 1 );
	const bool ownPixel = all( equal( px, jahTexelPixel( own, scale, fullRes ) ) );
	if( !c.ok || r > roughGate + feather )
	{
		imageStore( ssrReflection, ivec3( px, gEye ), vec4( 0.0 ) );
		if( ownPixel )
			imageStore( restDisplay, ivec3( own, gEye ), vec4( 0.0 ) );   // not measured
		return;
	}
	// ---- THE CENTRE: the pixel's own trace texel (full resolution), or the joint-bilateral upsample (half) ----
	vec3 cd = vec3( 0.0 );
	float sigma = 0.0, n = 0.0, sumW = 0.0;
	{
		const vec2 at = ( vec2( px ) + 0.5 ) / vec2( scale ) - 0.5;   // this pixel in trace-texel coordinates
		const ivec2 base = scale.x > 1 ? ivec2( floor( at ) ) : own;
		const vec2 f = scale.x > 1 ? at - vec2( base ) : vec2( 0.0 );
		const int taps = scale.x > 1 ? 4 : 1;
		for( int k = 0; k < taps; ++k )
		{
			const ivec2 o = ivec2( k & 1, k >> 1 );
			const ivec2 li = clamp( base + o, ivec2( 0 ), traceRes - 1 ) - tile0;
			if( any( lessThan( li, ivec2( 0 ) ) ) || any( greaterThanEqual( li, ivec2( side ) ) ) )
				continue;
			const int j = li.y * side + li.x;
			const vec4 pt = sPoint[j];
			if( pt.w < 0.0 )
				continue;
			float w = taps > 1 ? ( o.x == 1 ? f.x : 1.0 - f.x ) * ( o.y == 1 ? f.y : 1.0 - f.y ) : 1.0;
			if( taps > 1 )
			{
				// the texel's surface against this pixel's: the plane distance and the normals
				const float rel = abs( dot( pt.xyz - c.world, c.N ) ) / max( c.dist, 1e-4 );
				w *= exp2( -kDepthWeightScale * rel * rel ) * pow( max( dot( sNormal[j].xyz, c.N ), 0.0 ), 8.0 );
				if( !( w > 1e-4 ) )
					continue;
			}
			const uvec2 aw = sAnswer[j];
			const vec2 a01 = unpackHalf2x16( aw.x ), a23 = unpackHalf2x16( aw.y );
			cd += vec3( a01, a23.x ) * w;
			sigma += a23.y * w;
			n += pt.w * w;
			sumW += w;
		}
		if( sumW > 0.0 )
		{
			cd /= sumW; sigma /= sumW; n /= sumW;
		}
	}
	// THE REST'S REFERENCE (R1 (f)'s arm): the texel's 32-bit mean of its raw rest samples, composited unfiltered.
	bool referenceShown = false;
	if( p.rest.y > 0.5 && p.knobs2.x >= 0.5 )
	{
		const vec4 R = imageLoad( restReference, ivec3( own, gEye ) );
		if( R.w > 0.0 && finite3( R.xyz ) )
		{
			cd = jahToDenoise( clamp( R.xyz, vec3( 0.0 ), vec3( kMaxRadiance ) ) );
			sumW = 1.0;
			referenceShown = true;
		}
	}
	if( !( sumW > 0.0 ) || !finite3( cd ) )
	{
		imageStore( ssrReflection, ivec3( px, gEye ), vec4( 0.0 ) );   // no answer here: the probe's
		if( ownPixel )
			imageStore( restDisplay, ivec3( own, gEye ), vec4( 0.0 ) );   // not measured
		return;
	}
	const JahReflectState os = jahStateUnpack( imageLoad( stateCur, ivec3( own, gEye ) ).xy );
	const float centreChance = jahReflectCentreChance( alpha, os.hitT, length( c.world - e.camPos ),
													   length( e.rayDown ) / float( traceRes.y ), e.perspective > 0.5 );
	// ---- THE KERNEL ----
	const float maxFrames = jahReflectMaxFrames( centreChance, 1.0 / max( p.knobs2.w, 1e-3 ) );
	const float D = maxFrames > 1.0 ? 1.0 - clamp( n / kMaxDisocclusionFrames, 0.0, 1.0 ) : 0.0;
	const float radius = kKernelRadius * clamp( r * 8.0, 0.0, 1.0 ) * ( 1.0 - centreChance );
	const float cl = jahDenoiseLuma( cd );
	vec3 sum = tm( cd, D );
	float wsum = 1.0;
	// THE DISPLAYED STANDARD ERROR at rest (lever (ii)): the taps' rest SEs combined by the fixed weights - the centre
	// at weight 1 with its own (the upsample's mean sigma at half resolution: never under its taps' combined one)
	float se2 = sigma * sigma;
	if( !referenceShown && radius > 1.0 )
	{
		const float halfAngle = clamp( ( atan( 3.0 * r * r ) + 0.01 ) * mix( 1.0, 4.0, D ), 0.01, 1.5707963 );
		// the disk's turn: a hash of the PIXEL - never of the frame
		const float turn = float( jahReflectPcg( uint( px.x ) * 73856093u ^ uint( px.y ) * 19349663u ^
												 uint( gEye ) * 83492791u ) & 0xFFFFu ) * ( 6.2831853 / 65536.0 );
		for( int i = 0; i < kTaps; ++i )
		{
			const float a = float( i ) * kGoldenAngle + turn;
			const vec2 off = radius * sqrt( ( float( i ) + 0.5 ) / float( kTaps ) ) * vec2( cos( a ), sin( a ) );
			const ivec2 q = ivec2( floor( vec2( px ) + off + 0.5 ) );
			if( any( lessThan( q, ivec2( 0 ) ) ) || any( greaterThanEqual( q, fullRes ) ) )
				continue;
			const ivec2 li = min( q / scale, traceRes - 1 ) - tile0;
			if( any( lessThan( li, ivec2( 0 ) ) ) || any( greaterThanEqual( li, ivec2( side ) ) ) )
				continue;
			const int j = li.y * side + li.x;
			const vec4 pt = sPoint[j];
			if( pt.w < 0.0 )
				continue;
			const uvec2 aw = sAnswer[j];
			const vec2 a01 = unpackHalf2x16( aw.x ), a23 = unpackHalf2x16( aw.y );
			const vec3 xd = vec3( a01, a23.x );
			const float rel = abs( dot( pt.xyz - c.world, c.N ) ) / max( c.dist, 1e-4 );
			const float wDepth = exp2( -kDepthWeightScale * rel * rel );
			const float wNorm = 1.0 - clamp( acos( clamp( dot( c.N, sNormal[j].xyz ), 0.0, 1.0 ) ) / halfAngle, 0.0, 1.0 );
			const float wLum = mix( exp2( -abs( cl - jahDenoiseLuma( xd ) ) / max( sigma, 0.001 ) ), 1.0, D );
			const float w = wDepth * wNorm * wLum;
			if( !( w > 0.0 ) )
				continue;
			sum += tm( xd, D ) * w;
			wsum += w;
			se2 += w * w * a23.y * a23.y;
		}
	}
	const vec3 outRgb = clamp( jahFromDenoise( invTm( sum / wsum, D ) ), vec3( 0.0 ), vec3( kMaxRadiance ) );
	// ...in DISPLAY CODES at this pixel's value (lever (i)): the denoiser space's SE carried to linear luma by the space's
	// slope there, then through the display's (jahDisplayCodes). Reported at rest, at the texel's own pixel.
	if( ownPixel )
	{
		const float LD = jahDenoiseLuma( sum / wsum );
		const float codes = p.knobs2.x >= 0.5 && !referenceShown
								? jahDisplayCodes( jahDenoiseLuma( outRgb ), sqrt( se2 ) / wsum * jahDenoiseSlopeAt( LD ) )
								: -1.0;
		imageStore( restDisplay, ivec3( own, gEye ), vec4( finite1( codes ) && codes >= 0.0 ? codes + 1.0 : 0.0 ) );
	}
	// ---- THE WRITE: the feather (owner, ledger section 426) and the young VIEW's fade ----
	float gate = 1.0 - smoothstep( roughGate - feather, roughGate + feather, r );
	const float young = min( ( p.stereo.y + 1.0 ) / kYoungViewFrames, 1.0 );
	gate *= mix( young, 1.0, centreChance );
	imageStore( ssrReflection, ivec3( px, gEye ), finite3( outRgb ) && gate > 0.0 ? vec4( outRgb, gate ) : vec4( 0.0 ) );
}
