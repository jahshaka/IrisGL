#version 460
// THE SCREEN-PROBE GATHER, JOB 1 OF 3: WHERE THE PROBES GO
// (GATHER-1a; SPECS/SCREEN_PROBE_GATHER_SPEC.md section 2 item 1).
//
// ONE WORKGROUP PER CELL of the uniform grid (one cell per NxN pixels of the
// view; pass 2 below is one thread per cell). Each cell does two things and nothing else:
//
//   1. PLACES its cell's probe. The probe sits at a pixel inside the cell,
//      JITTERED by an integer hash of (cell, frame) rather than pinned at the
//      centre — a fixed probe samples the same 1/256th of the picture for ever
//      and bakes its own aliasing into every frame, while a jittered one walks
//      its cell and its error becomes noise a temporal filter can remove
//      (phase 3's whole job). The surface under that pixel comes from the
//      PREPASS' depth and normals, which is why the gather needs the prepass
//      and why `ChainDesc::probeGather` exists.
//
//   2. ASKS WHETHER THE GRID ANSWERS EVERY PIXEL of the cell, and appends a
//      second probe where it does not. This is Lumen's adaptive placement
//      (ScreenProbeAdaptivePlacementMarkCS) with one twin a cell: EVERY pixel of
//      the cell is tested for SUPPORT - the bilinear x plane weights of the
//      uniform probes around it, exactly the integrate's read (the PLANE: how
//      far it lies off a probe's, as a fraction of its own view distance — an
//      angular tolerance, so one number works at every depth — and the NORMAL) -
//      and the least-supported pixel, where that falls under the integrate's
//      floor, gets a probe of its own, appended to the list through an atomic
//      counter and capped per frame. A flat wall appends nothing; a railing, a
//      silhouette, a step or a 1-px sliver of another surface appends one per
//      cell it crosses.
//
// WHICH CELLS GET THEIR SECOND PROBE IS DECIDED IN A FIXED ORDER, NEVER BY AN ATOMIC
// (PHOTON-VIEW-NOISE-1, 2026-10-03). The budget (`cap`, half the grid; the grid at Low)
// binds whenever more cells fail than it allows — a busy view (Bistro asks 0.45-0.49 of
// its cells at High). While the winners were the first `cap` cells
// to reach an atomic counter, WHICH cells got a probe was the scheduler's choice: two
// shots of one still scene differed by up to 14 codes over a whole cell (photon.view's
// "noise", 780 px of 14,400; bit-identical 13 times out of 13 with the cap lifted). So
// the job runs TWICE over the grid:
//   PASS 1 (this file as written) places every cell's probe, tests it, and where one
//   probe is not enough stashes the worst pixel's surface in the cell's own record
//   (sh[0..1], which the filter overwrites later) and counts the cell in its eye's
//   row's tally — integer adds, so every count is the same whatever the order.
//   PASS 2 (JAH_PLACE_SELECT) ranks each EYE's failing cells in ONE FIXED ORDER (row by
//   row) and gives the eye's share of the budget to a WINDOW of them that slides on by
//   its size every frame — so no cell is starved (every asking cell is served within
//   ceil(demand / share) frames, gi.gather_adaptive_fair) and the two eyes of one pose
//   choose the same cells (vr.session) — the winner at slot = eye x share + its place. The picture is a
//   pure function of (scene, frame), the property spec section 5 item 2 asks for.
// THE INDIRECT DISPATCH ARGUMENT is written by pass 2: `atomicMax( args.x,
// uniformProbes + slot + 1 )` over the appended slots reaches exactly the count (fork
// 1bccc3f93+a98e2b0af (was 0032)'s count/work pair is the same shape in the Hlms; a raw
// compute job can write its own arguments and needs no patch). The buffer is pre-set to
// `uniformProbes` by a transfer before pass 1, so a frame that appends nothing still
// dispatches the grid.
#extension GL_GOOGLE_include_directive : require

layout( local_size_x = 8, local_size_y = 8, local_size_z = 1 ) in;

#define JAH_PROBE_PARAMS_BINDING 0
#include "jah_probe_params.glsl"

layout( set = 0, binding = 1 ) uniform sampler2DArray gBufNormals;
layout( set = 0, binding = 2 ) uniform sampler2DArray sceneDepth;
layout( std430, set = 0, binding = 3 ) buffer Records { JahProbeRecord r[]; } records;
/// `appended` = how many cells asked for a second probe this frame (the DEMAND, the
/// budget aside); then each eye row's count of them (pass 1 adds, pass 2 ranks).
layout( std430, set = 0, binding = 4 ) buffer Counter { uint appended; uint pad[3]; uint row[]; } counter;
layout( std430, set = 0, binding = 5 ) buffer Args { uint x; uint y; uint z; } args;
/// THE REST CLOCK (PHOTON-7 stage 8B, B1): the frame's sample index is the GPU's (jah_probe_rest.glsl) - the jitter and
/// the adaptive window follow the view's one rest clock, so every active cell's probes stand where its rest needs them.
#define JAH_REST_CLOCK_BINDING 6
#include "jah_probe_rest.glsl"

/// The surface a pixel drew, or `valid` false where it drew none (the sky, a
/// pixel the prepass never touched); `geomN` = its GEOMETRIC normal (the ray
/// origin's direction, jah_ray_origin.glsl), the shading one where the depth has
/// no plane through the pixel.
struct Surface { vec3 world; vec3 normal; vec3 geomN; float pointError; float dist; bool valid; };

/// THE GEOMETRIC NORMAL (READ_B F3: every ray job's origin is lifted along the drawn surface's geometric normal): the
/// one text over the eye's own layer of the depth, at the pixel's centre.
int gnEye = 0;
#define JAH_GN_RAW( q ) texelFetch( sceneDepth, ivec3( ( q ), gnEye ), 0 ).x
#define JAH_GN_WORLD( q, raw ) jahWorldAt( jahEyeNow( gnEye ), ( vec2( q ) + 0.5 ) / p.resolution.zw, \
										   jahViewDistance( raw ) )
#include "jah_geometric_normal.glsl"
#include "jah_ray_origin.glsl"

Surface surfaceAt( vec2 pix, int eye )
{
	Surface s;
	s.world = vec3( 0.0 );
	s.normal = vec3( 0.0 );
	s.geomN = vec3( 0.0 );
	s.pointError = 0.0;
	s.dist = 0.0;
	s.valid = false;
	// CLAMPED TO THE EYE'S OWN IMAGE: the grid is a ceiling division, so the
	// last cell of a row can reach past the eye's edge, and a sampler's clamp
	// would read the edge texel while the reconstruction claimed the outside
	// position. `pix` is in the eye's OWN image, which is its own layer of every
	// screen texture (LAYERED-STEREO-1): the eyes run the same arithmetic.
	const vec2 local = clamp( pix / p.resolution.zw, vec2( 0.0 ), vec2( 0.999999 ) );
	const vec3 uv = vec3( local, float( eye ) );
	const float rawDepth = texture( sceneDepth, uv ).x;
	if( rawDepth <= 0.0 || rawDepth >= 1.0 )
		return s;
	vec3 normalVS = texture( gBufNormals, uv ).xyz * 2.0 - 1.0;
	if( dot( normalVS, normalVS ) <= 1e-6 )
		return s;
	normalVS = normalize( normalVS );
	s.normal = normalize( p.viewAxisX.xyz * normalVS.x + p.viewAxisY.xyz * normalVS.y +
						  p.viewAxisZ.xyz * normalVS.z );
	s.dist = jahViewDistance( rawDepth );
	s.world = jahWorldAt( jahEyeNow( eye ), local, s.dist );
	s.valid = finite3( s.world ) && finite3( s.normal ) && finite1( s.dist );
	if( s.valid )
	{
		// At the TEXEL the point-sampled depth was read from, through the eye that drew it, facing that eye.
		const ivec2 res = ivec2( p.resolution.zw );
		const ivec2 q = min( ivec2( local * vec2( res ) ), res - 1 );
		gnEye = eye;
		const JahEye e = jahEyeNow( eye );
		const vec3 centre = JAH_GN_WORLD( q, rawDepth );
		const vec3 V = e.perspective < 0.5 ? -e.fwd : normalize( e.camPos - centre );
		s.geomN = jahGeometricNormal( q, res, rawDepth, centre, s.normal, V );
		// THE POINT'S OWN ERROR beyond the float bound (READ_B F5 (b), jahDepthPointError: projParams.w = the snap in
		// pixels, 0 = off) - the depth this probe was rebuilt from is only here
		const bool perspective = e.perspective > 0.5;
		const float pixelSize = length( e.rayDown ) / p.resolution.w * ( perspective ? s.dist : 1.0 );
		s.pointError = jahDepthPointError( rawDepth, s.dist, p.projParams.y, perspective,
										   perspective ? ( s.world - e.camPos ) / s.dist : e.fwd, e.fwd, s.geomN,
										   pixelSize, p.projParams.w );
		s.valid = finite3( s.geomN ) && finite1( s.pointError );
	}
	return s;
}

void writeRecord( uint index, Surface s, float adaptiveLink )
{
	records.r[index].posW = vec4( s.world, s.valid ? 1.0 : 0.0 );
	records.r[index].normalW = vec4( s.normal, adaptiveLink );
	records.r[index].geomW = vec4( s.geomN, s.pointError );
	// The trace overwrites this; zeroing it here is what makes a probe that the
	// trace declines (no surface) read as "no answer" rather than as last
	// frame's answer at a place the camera has left.
	records.r[index].irradiance = vec4( 0.0 );
}

/// The counter's word for a cell: its EYE'S ROW (eye x grid rows + row) — the asking
/// cells are counted per eye and row, so each eye ranks its own (PHOTON-GA-VR: the two
/// eyes of one pose must choose the same cells).
uint jahPlaceRow( ivec2 cell )
{
	return uint( jahEyeOfCell( cell.x ) ) * uint( p.resolution.y ) + uint( cell.y );
}

#ifdef JAH_PLACE_SELECT
// ---- PASS 2: THE RANK (see the header) ---------------------------------------
void main()
{
	const ivec2 grid = ivec2( p.resolution.xy );
	const ivec2 cell = ivec2( gl_GlobalInvocationID.xy );
	if( any( greaterThanEqual( cell, grid ) ) )
		return;
	const uint index = uint( cell.y * grid.x + cell.x );
	if( records.r[index].sh[1].w < 0.5 )
		return;
	// THE RAW RANK, IN THE CELL'S OWN EYE: its asking cells in ONE FIXED ORDER, row by row
	// (the rows above from the counter, this row's cells to the left from their stash).
	const int eye = jahEyeOfCell( cell.x );
	const int eyeGridW = jahEyeGridW();
	const int x0 = eye * eyeGridW;
	const uint rowBase = uint( eye ) * uint( grid.y );
	uint raw = 0u, demand = 0u;
	for( uint y = 0u; y < uint( grid.y ); ++y )
	{
		const uint n = counter.row[rowBase + y];
		demand += n;
		if( y < uint( cell.y ) )
			raw += n;
	}
	for( int x = x0; x < cell.x; ++x )
		if( records.r[uint( cell.y * grid.x + x )].sh[1].w > 0.5 )
			++raw;
	// THE WINDOW SLIDES (the merge read's F3): each eye's share of the budget is a window
	// of that order that moves on by its size every frame, so every asking cell is served
	// within ceil(demand / share) frames whatever its place; and both eyes of one pose
	// choose the same cells (each eye ranks its own, with the same share and shift).
	const uint eyes = jahStereo() ? 2u : 1u;
	const uint cap = uint( max( p.knobs3.y, 0.0 ) ) / eyes;
	demand = max( demand, 1u );
	// (THE CELL's OWN SAMPLE INDEX, PHOTON-7 stage 8B, B1: its component's rest clock - every cell of a component and of
	// its ring shares it, so the window a component sees is the one its rest sequence names)
	const uint shift = ( ( jahFrameIndexOf( index ) % demand ) * ( cap % demand ) ) % demand;   // no 32-bit overflow
	const uint rank = ( raw + demand - shift ) % demand;
	if( rank >= cap )
		return;
	// THE SLOT: the raw rank where every asking cell is served (demand <= the share: unique whatever the shifts); past
	// it two components' windows may name one rank, so the slot is counted out (a probe's rays key on its CELL, never its
	// slot - rq_probe_gather.comp) and a winner past the share is not given one (counter.row's last words count them)
	uint slot = uint( eye ) * cap + raw;
	if( demand > cap )
	{
		const uint rows = ( jahStereo() ? 2u : 1u ) * uint( grid.y );
		const uint taken = atomicAdd( counter.row[rows + uint( eye )], 1u );
		if( taken >= cap )
			return;
		slot = uint( eye ) * cap + taken;
	}
	const uint adaptiveIndex = uint( p.knobs3.x ) + slot;
	Surface w;
	w.world = records.r[index].sh[0].xyz;
	w.dist = records.r[index].sh[0].w;
	w.normal = records.r[index].sh[1].xyz;
	w.geomN = records.r[index].sh[2].xyz;
	w.pointError = records.r[index].sh[2].w;
	w.valid = true;
	// ITS SOURCE CELL travels with it, in the same float the uniform records use for
	// their link: the trace keys an adaptive probe's ray directions on the CELL it was
	// placed for (rq_probe_gather.comp's note).
	writeRecord( adaptiveIndex, w, float( index + 1u ) );
	records.r[index].normalW.w = float( adaptiveIndex + 1u );
	atomicMax( args.x, adaptiveIndex + 1u );
}
#else
// ---- PASS 1: ONE WORKGROUP PER CELL (64 threads), every pixel of the cell tested -------------
/// The cell's 3 x 3 neighbourhood of uniform probes (a pixel's bilinear bracket lies in it: the
/// grid is shifted by the frame's one offset, so a pixel's bracket starts one cell left or up of
/// its own at most), read once per workgroup.
shared vec4 nbWorld[9];    // xyz the probe's point, w 1 = a surface under it
shared vec3 nbNormal[9];
/// The pixels the grid does not answer (their count and pixel sums, for their centre), then each
/// thread's nearest of them to that centre (the reduction below, in a fixed order).
shared uint unCount, unSumX, unSumY;
shared uint bestDist[64];
shared uint bestPixel[64];

/// THE SURFACE WITHOUT ITS RAY-ORIGIN TERMS (the per-pixel test reads only the point, the normal
/// and the distance; the winner's full surface is read once, surfaceAt).
bool surfaceLite( vec2 pix, int eye, out vec3 world, out vec3 normal, out float dist )
{
	world = vec3( 0.0 );
	normal = vec3( 0.0 );
	dist = 0.0;
	const vec2 local = clamp( pix / p.resolution.zw, vec2( 0.0 ), vec2( 0.999999 ) );
	const vec3 uv = vec3( local, float( eye ) );
	const float rawDepth = texture( sceneDepth, uv ).x;
	if( rawDepth <= 0.0 || rawDepth >= 1.0 )
		return false;
	vec3 normalVS = texture( gBufNormals, uv ).xyz * 2.0 - 1.0;
	if( dot( normalVS, normalVS ) <= 1e-6 )
		return false;
	normalVS = normalize( normalVS );
	normal = normalize( p.viewAxisX.xyz * normalVS.x + p.viewAxisY.xyz * normalVS.y + p.viewAxisZ.xyz * normalVS.z );
	dist = jahViewDistance( rawDepth );
	world = jahWorldAt( jahEyeNow( eye ), local, dist );
	return finite3( world ) && finite3( normal ) && finite1( dist );
}

void main()
{
	const ivec2 grid = ivec2( p.resolution.xy );
	const ivec2 cell = ivec2( gl_WorkGroupID.xy );
	const uint tid = gl_LocalInvocationIndex;
	if( any( greaterThanEqual( cell, grid ) ) )
		return;   // (uniform across the workgroup)
	const uint index = uint( cell.y * grid.x + cell.x );
	const float stride = max( p.knobs.x, 1.0 );
	const int s = int( stride );
	const uint frame = jahFrameIndexOf( index );
	// THE CELL'S EYE AND ITS ORIGIN IN THAT EYE'S IMAGE (PHOTON-GA-VR,
	// LAYERED-STEREO-1): under stereo the right eye's cells follow the left
	// eye's in the probe LIST, and a cell's origin is its own-grid coordinate x
	// stride in its eye's layer; with one eye that is exactly as before.
	const int eye = jahEyeOfCell( cell.x );
	const ivec2 own = jahLocalCell( cell );
	const ivec2 gridEye = ivec2( jahEyeGridW(), grid.y );
	const vec2 cellOrigin = vec2( own ) * stride;

	// ---- 1. THE PROBE'S PIXEL, jittered inside its own cell ---------------
	// (THE GRID'S JITTER, ENGINE-POLISH-PHOTON-2: ONE offset a frame for every cell, the same hash
	// the integrate's bilinear shifts its grid by, so a probe is read where it stands. The pixel
	// CENTRE of a jittered texel, not a continuous position: the depth and normals are point-
	// sampled, so a sub-pixel position would read one texel and claim another's place.)
	vec2 offset = vec2( 0.5, 0.5 );
	if( p.plane.w < 0.5 )
		offset = floor( jahSample2( ivec2( 0 ), 0u, frame ) * stride ) + 0.5;
	else
		offset = vec2( floor( stride * 0.5 ) + 0.5 );
	const vec2 probePix = cellOrigin + offset;
	// THE NEIGHBOURHOOD'S PROBES: every cell's probe stands at its origin + the same offset, so any
	// thread can read any neighbour's from the depth and normals (no race on the records the other
	// workgroups write).
	if( tid < 9u )
	{
		const ivec2 c = clamp( own + ivec2( int( tid % 3u ) - 1, int( tid / 3u ) - 1 ), ivec2( 0 ), gridEye - 1 );
		vec3 w, n;
		float d;
		const bool ok = surfaceLite( vec2( c ) * stride + offset, eye, w, n, d );
		nbWorld[tid] = vec4( w, ok ? 1.0 : 0.0 );
		nbNormal[tid] = n;
	}
	barrier();

	// ---- 2. DOES THE GRID ANSWER EVERY PIXEL OF THE CELL? ------------------
	// LUMEN'S TEST (ScreenProbeAdaptivePlacementMarkCS: a candidate pixel becomes a probe when the
	// bilinear x plane weights of the uniform probes around it sum under a floor), over EVERY pixel
	// of the cell rather than Lumen's 8 jittered candidates (PHOTON-7 stage 10: the four quarter
	// samples this replaces sat at offsets 2.5 and 10.5 of a 16-px cell, so a sliver of another
	// surface between them - a 1-px column of floor behind a pillar at the view's edge - was never
	// tested, and only the frame's jitter put a probe on it, 1 frame in 16: 51 codes a frame).
	// A pixel's SUPPORT is exactly the integrate's bilinear four (rq_probe_integrate.comp's
	// bilinearTaps: the bracket on the shifted grid, a cell off the grid clamped onto the border's,
	// each weighed by jahPlaneWeight); under the integrate's own floor (knobs4.y) the four cannot
	// answer it. ONE TWIN A CELL, at the unanswered pixel NEAREST THE CENTRE of the cell's
	// unanswered pixels (ties: the first in the cell's scan order) - every unanswered pixel weighs
	// nothing, so the worst is a tie, and the twin answers the region it stands in by its plane:
	// at the region's centre its single value is the region's own, not its edge's.
	if( tid == 0u )
	{
		unCount = 0u;
		unSumX = 0u;
		unSumY = 0u;
	}
	barrier();
	const float floorW = max( p.knobs4.y, 1e-6 );
	uvec2 mine = uvec2( 0u );   // this thread's unanswered pixels, bit j = pixel tid + 64 j
	uint myCount = 0u, mySumX = 0u, mySumY = 0u;
	for( uint k = tid, j = 0u; k < uint( s * s ); k += 64u, ++j )
	{
		const ivec2 q = ivec2( int( k ) % s, int( k ) / s );
		const ivec2 lp = ivec2( cellOrigin ) + q;
		vec3 w, n;
		float d;
		if( !surfaceLite( vec2( lp ) + 0.5, eye, w, n, d ) )
			continue;   // the sky: no hemisphere, nothing to answer
		vec2 g = ( vec2( lp ) + 0.5 ) / stride - 0.5;
		if( p.plane.w < 0.5 )
			g = ( vec2( lp ) + 0.5 - offset ) / stride;
		const ivec2 c0 = ivec2( floor( g ) );
		const vec2 f = g - vec2( c0 );
		float support = 0.0;
		for( int t = 0; t < 4; ++t )
		{
			const ivec2 o = ivec2( t & 1, t >> 1 );
			const ivec2 c = clamp( c0 + o, ivec2( 0 ), gridEye - 1 ) - own + 1;   // in the 3 x 3
			const int ni = clamp( c.y, 0, 2 ) * 3 + clamp( c.x, 0, 2 );
			const float wb = ( o.x == 1 ? f.x : 1.0 - f.x ) * ( o.y == 1 ? f.y : 1.0 - f.y );
			if( nbWorld[ni].w > 0.5 && wb > 0.0 )
				support += wb * jahPlaneWeight( nbWorld[ni].xyz, nbNormal[ni], w, n, d );
		}
		if( support >= floorW )
			continue;
		if( j < 32u )
			mine.x |= 1u << j;
		else
			mine.y |= 1u << ( j - 32u );
		++myCount;
		mySumX += uint( q.x );
		mySumY += uint( q.y );
	}
	if( myCount > 0u )
	{
		atomicAdd( unCount, myCount );
		atomicAdd( unSumX, mySumX );
		atomicAdd( unSumY, mySumY );
	}
	barrier();
	// the centre, in units of 1/count of a pixel: |count q - sum| is the distance scaled by count
	const uint count = unCount;
	uint myDist = 0xFFFFFFFFu, myPixel = 0xFFFFFFFFu;
	for( uint k = tid, j = 0u; k < uint( s * s ) && count > 0u; k += 64u, ++j )
	{
		if( ( ( j < 32u ? mine.x >> j : mine.y >> ( j - 32u ) ) & 1u ) == 0u )
			continue;
		const ivec2 q = ivec2( int( k ) % s, int( k ) / s );
		const int dx = int( count ) * q.x - int( unSumX ), dy = int( count ) * q.y - int( unSumY );
		// (the scaled distance fits: count <= 4096 and a pixel coordinate <= 63, so each term < 2^18)
		const uint dist = uint( abs( dx ) ) + uint( abs( dy ) );   // L1: exact in integers
		if( dist < myDist )
		{
			myDist = dist;
			myPixel = k;
		}
	}
	bestDist[tid] = myDist;
	bestPixel[tid] = myPixel;
	barrier();
	if( tid != 0u )
		return;
	// THE REDUCTION, in one fixed order (the key: the distance, then the scan index - the same
	// winner whatever the threads' timing)
	uint dist = 0xFFFFFFFFu, pixel = 0xFFFFFFFFu;
	for( uint t = 0u; t < 64u; ++t )
		if( bestPixel[t] != 0xFFFFFFFFu &&
			( bestDist[t] < dist || ( bestDist[t] == dist && bestPixel[t] < pixel ) ) )
		{
			dist = bestDist[t];
			pixel = bestPixel[t];
		}
	const Surface probe = surfaceAt( probePix, eye );
	// THE DEMAND IS COUNTED WHATEVER THE BUDGET IS (the budget decides only what is
	// appended, in pass 2): a reading that could not say whether the cap is costing
	// anything would not answer the one question a budget's reading exists for.
	// (A cell whose own probe found no surface - the sky - asks too where its surface pixels have no
	// support: Lumen's test, a sky probe weighing nothing.)
	Surface worst = probe;
	if( pixel != 0xFFFFFFFFu )
		worst = surfaceAt( vec2( ivec2( cellOrigin ) + ivec2( int( pixel ) % s, int( pixel ) / s ) ) + 0.5, eye );
	const bool wants = pixel != 0xFFFFFFFFu && worst.valid;
	if( wants )
	{
		atomicAdd( counter.appended, 1u );
		atomicAdd( counter.row[jahPlaceRow( cell )], 1u );
	}
	// (no surface under this probe: the record says so and the integrate hands its pixels to the
	// twin or the fallback - a probe on the sky is not an error, it is most of the border)
	writeRecord( index, probe, 0.0 );
	// THE STASH for pass 2: the worst pixel's surface, and whether the cell asks.
	records.r[index].sh[0] = vec4( worst.world, worst.dist );
	records.r[index].sh[1] = vec4( worst.normal, wants ? 1.0 : 0.0 );
	records.r[index].sh[2] = vec4( worst.geomN, worst.pointError );
}
#endif   // JAH_PLACE_SELECT
