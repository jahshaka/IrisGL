#version 460
// THE SCREEN-PROBE GATHER, JOB 1 OF 3: WHERE THE PROBES GO
// (GATHER-1a; SPECS/SCREEN_PROBE_GATHER_SPEC.md section 2 item 1).
//
// ONE THREAD PER CELL of the uniform grid (one cell per NxN pixels of the
// view). Each thread does two things and nothing else:
//
//   1. PLACES its cell's probe. The probe sits at a pixel inside the cell,
//      JITTERED by an integer hash of (cell, frame) rather than pinned at the
//      centre — a fixed probe samples the same 1/256th of the picture for ever
//      and bakes its own aliasing into every frame, while a jittered one walks
//      its cell and its error becomes noise a temporal filter can remove
//      (phase 3's whole job). The surface under that pixel comes from the
//      PREPASS' depth and normals, which is why the gather needs the prepass
//      and why `ChainDesc::probeGather` exists.
//
//   2. ASKS WHETHER ONE PROBE IS ENOUGH for the cell, and appends a second
//      where it is not. This is Lumen's adaptive placement in its smallest
//      honest form: the cell's pixels are sampled on a coarse lattice and each
//      is tested against the cell probe's PLANE (how far it lies off it, as a
//      fraction of its own view distance — an angular tolerance, so one number
//      works at every depth) and against its NORMAL. The pixel that fails
//      worst gets a probe of its own, appended to the list through an atomic
//      counter and capped per frame. A flat wall appends nothing; a railing, a
//      silhouette or a step appends one per cell it crosses.
//
// WHICH CELLS GET THEIR SECOND PROBE IS DECIDED IN A FIXED ORDER, NEVER BY AN ATOMIC
// (PHOTON-VIEW-NOISE-1, 2026-10-03). The budget (`cap`, a quarter of the grid) binds
// whenever more cells fail than it allows — a small view (a screenshot's 160 x 90 is
// 60 cells and a cap of 15), a busy one. While the winners were the first `cap` cells
// to reach an atomic counter, WHICH cells got a probe was the scheduler's choice: two
// shots of one still scene differed by up to 14 codes over a whole cell (photon.view's
// "noise", 780 px of 14,400; bit-identical 13 times out of 13 with the cap lifted). So
// the job runs TWICE over the grid:
//   PASS 1 (this file as written) places every cell's probe, tests it, and where one
//   probe is not enough stashes the worst pixel's surface in the cell's own record
//   (sh[0..1], which the filter overwrites later) and counts the cell in its eye's
//   row's tally — integer adds, so every count is the same whatever the order.
//   PASS 2 (JAH_PLACE_SELECT) ranks each EYE's failing cells in ONE FIXED ORDER (row by
//   row) and gives the eye's share of the budget to a WINDOW of them that slides on by
//   its size every frame — so no cell is starved (every asking cell is served within
//   ceil(demand / share) frames, gi.gather_adaptive_fair) and the two eyes of one pose
//   choose the same cells (vr.session) — the winner at slot = eye x share + its place. The picture is a
//   pure function of (scene, frame), the property spec section 5 item 2 asks for.
// THE INDIRECT DISPATCH ARGUMENT is written by pass 2: `atomicMax( args.x,
// uniformProbes + slot + 1 )` over the appended slots reaches exactly the count (fork
// 1bccc3f93+a98e2b0af (was 0032)'s count/work pair is the same shape in the Hlms; a raw
// compute job can write its own arguments and needs no patch). The buffer is pre-set to
// `uniformProbes` by a transfer before pass 1, so a frame that appends nothing still
// dispatches the grid.
#extension GL_GOOGLE_include_directive : require

layout( local_size_x = 8, local_size_y = 8, local_size_z = 1 ) in;

#define JAH_PROBE_PARAMS_BINDING 0
#include "jah_probe_params.glsl"

layout( set = 0, binding = 1 ) uniform sampler2DArray gBufNormals;
layout( set = 0, binding = 2 ) uniform sampler2DArray sceneDepth;
layout( std430, set = 0, binding = 3 ) buffer Records { JahProbeRecord r[]; } records;
/// `appended` = how many cells asked for a second probe this frame (the DEMAND, the
/// budget aside); then each eye row's count of them (pass 1 adds, pass 2 ranks).
layout( std430, set = 0, binding = 4 ) buffer Counter { uint appended; uint pad[3]; uint row[]; } counter;
layout( std430, set = 0, binding = 5 ) buffer Args { uint x; uint y; uint z; } args;

/// The surface a pixel drew, or `valid` false where it drew none (the sky, a
/// pixel the prepass never touched).
struct Surface { vec3 world; vec3 normal; float dist; bool valid; };

Surface surfaceAt( vec2 pix, int eye )
{
	Surface s;
	s.world = vec3( 0.0 );
	s.normal = vec3( 0.0 );
	s.dist = 0.0;
	s.valid = false;
	// CLAMPED TO THE EYE'S OWN IMAGE: the grid is a ceiling division, so the
	// last cell of a row can reach past the eye's edge, and a sampler's clamp
	// would read the edge texel while the reconstruction claimed the outside
	// position. `pix` is in the eye's OWN image, which is its own layer of every
	// screen texture (LAYERED-STEREO-1): the eyes run the same arithmetic.
	const vec2 local = clamp( pix / p.resolution.zw, vec2( 0.0 ), vec2( 0.999999 ) );
	const vec3 uv = vec3( local, float( eye ) );
	const float rawDepth = texture( sceneDepth, uv ).x;
	if( rawDepth <= 0.0 || rawDepth >= 1.0 )
		return s;
	vec3 normalVS = texture( gBufNormals, uv ).xyz * 2.0 - 1.0;
	if( dot( normalVS, normalVS ) <= 1e-6 )
		return s;
	normalVS = normalize( normalVS );
	s.normal = normalize( p.viewAxisX.xyz * normalVS.x + p.viewAxisY.xyz * normalVS.y +
						  p.viewAxisZ.xyz * normalVS.z );
	s.dist = jahViewDistance( rawDepth );
	s.world = jahWorldAt( jahEyeNow( eye ), local, s.dist );
	s.valid = finite3( s.world ) && finite3( s.normal ) && finite1( s.dist );
	return s;
}

void writeRecord( uint index, Surface s, float adaptiveLink )
{
	records.r[index].posW = vec4( s.world, s.valid ? 1.0 : 0.0 );
	records.r[index].normalW = vec4( s.normal, adaptiveLink );
	// The trace overwrites this; zeroing it here is what makes a probe that the
	// trace declines (no surface) read as "no answer" rather than as last
	// frame's answer at a place the camera has left.
	records.r[index].irradiance = vec4( 0.0 );
}

/// The counter's word for a cell: its EYE'S ROW (eye x grid rows + row) — the asking
/// cells are counted per eye and row, so each eye ranks its own (PHOTON-GA-VR: the two
/// eyes of one pose must choose the same cells).
uint jahPlaceRow( ivec2 cell )
{
	return uint( jahEyeOfCell( cell.x ) ) * uint( p.resolution.y ) + uint( cell.y );
}

#ifdef JAH_PLACE_SELECT
// ---- PASS 2: THE RANK (see the header) ---------------------------------------
void main()
{
	const ivec2 grid = ivec2( p.resolution.xy );
	const ivec2 cell = ivec2( gl_GlobalInvocationID.xy );
	if( any( greaterThanEqual( cell, grid ) ) )
		return;
	const uint index = uint( cell.y * grid.x + cell.x );
	if( records.r[index].sh[1].w < 0.5 )
		return;
	// THE RAW RANK, IN THE CELL'S OWN EYE: its asking cells in ONE FIXED ORDER, row by row
	// (the rows above from the counter, this row's cells to the left from their stash).
	const int eye = jahEyeOfCell( cell.x );
	const int eyeGridW = jahEyeGridW();
	const int x0 = eye * eyeGridW;
	const uint rowBase = uint( eye ) * uint( grid.y );
	uint raw = 0u, demand = 0u;
	for( uint y = 0u; y < uint( grid.y ); ++y )
	{
		const uint n = counter.row[rowBase + y];
		demand += n;
		if( y < uint( cell.y ) )
			raw += n;
	}
	for( int x = x0; x < cell.x; ++x )
		if( records.r[uint( cell.y * grid.x + x )].sh[1].w > 0.5 )
			++raw;
	// THE WINDOW SLIDES (the merge read's F3): each eye's share of the budget is a window
	// of that order that moves on by its size every frame, so every asking cell is served
	// within ceil(demand / share) frames whatever its place; and both eyes of one pose
	// choose the same cells (each eye ranks its own, with the same share and shift).
	const uint eyes = jahStereo() ? 2u : 1u;
	const uint cap = uint( max( p.knobs3.y, 0.0 ) ) / eyes;
	demand = max( demand, 1u );
	const uint shift = ( ( uint( p.knobs.z ) % demand ) * ( cap % demand ) ) % demand;   // no 32-bit overflow
	const uint rank = ( raw + demand - shift ) % demand;
	if( rank >= cap )
		return;
	const uint slot = uint( eye ) * cap + rank;
	const uint adaptiveIndex = uint( p.knobs3.x ) + slot;
	Surface w;
	w.world = records.r[index].sh[0].xyz;
	w.dist = records.r[index].sh[0].w;
	w.normal = records.r[index].sh[1].xyz;
	w.valid = true;
	// ITS SOURCE CELL travels with it, in the same float the uniform records use for
	// their link: the trace keys an adaptive probe's ray directions on the CELL it was
	// placed for (rq_probe_gather.comp's note).
	writeRecord( adaptiveIndex, w, float( index + 1u ) );
	records.r[index].normalW.w = float( adaptiveIndex + 1u );
	atomicMax( args.x, adaptiveIndex + 1u );
}
#else
void main()
{
	const ivec2 grid = ivec2( p.resolution.xy );
	const ivec2 cell = ivec2( gl_GlobalInvocationID.xy );
	if( any( greaterThanEqual( cell, grid ) ) )
		return;
	const uint index = uint( cell.y * grid.x + cell.x );
	const float stride = max( p.knobs.x, 1.0 );
	const uint frame = uint( p.knobs.z );
	// THE CELL'S EYE AND ITS ORIGIN IN THAT EYE'S IMAGE (PHOTON-GA-VR,
	// LAYERED-STEREO-1): under stereo the right eye's cells follow the left
	// eye's in the probe LIST, and a cell's origin is its own-grid coordinate x
	// stride in its eye's layer; with one eye that is exactly as before.
	const int eye = jahEyeOfCell( cell.x );
	const vec2 cellOrigin = vec2( jahLocalCell( cell ) ) * stride;

	// ---- 1. THE PROBE'S PIXEL, jittered inside its own cell ---------------
	vec2 offset = vec2( 0.5, 0.5 );
	if( p.plane.w < 0.5 )
	{
		// The pixel CENTRE of a jittered texel, not a continuous position: the
		// depth and normals are point-sampled, so a sub-pixel position would
		// read one texel and claim another's place.
		const vec2 j = jahSample2( jahLocalCell( cell ), 0u, frame );
		offset = floor( j * stride ) + 0.5;
	}
	else
	{
		offset = vec2( floor( stride * 0.5 ) + 0.5 );
	}
	const vec2 probePix = cellOrigin + offset;
	const Surface probe = surfaceAt( probePix, eye );
	if( !probe.valid )
	{
		// No surface under this probe: the record says so and the integrate
		// hands its pixels back to whatever the pixel path already had. A probe
		// on the sky is not an error, it is most of the border.
		writeRecord( index, probe, 0.0 );
		records.r[index].sh[1] = vec4( 0.0 );
		return;
	}

	// ---- 2. DOES ONE PROBE ANSWER FOR THIS CELL? --------------------------
	// Four samples on the cell's own quarters, which is the coarsest lattice
	// that can see a silhouette crossing a cell in either axis. More samples
	// would find more detail and cost linearly; this pass exists to find the
	// cells where ONE probe is plainly wrong, not to survey them.
	float worstError = 0.0;
	vec2 worstPix = probePix;
	Surface worstSurface = probe;
	const float planeTol = max( p.plane.x, 1e-4 );
	const float normalTol = p.plane.y;
	for( int i = 0; i < 4; ++i )
	{
		const vec2 q = vec2( float( i & 1 ), float( ( i >> 1 ) & 1 ) );
		const vec2 pix = cellOrigin + ( q + 0.25 ) * 0.5 * stride + vec2( 0.5 );
		const Surface s = surfaceAt( pix, eye );
		if( !s.valid )
			continue;
		// How far off the probe's plane this pixel lies, as a fraction of its
		// own view distance, and how far its normal has turned.
		const float offPlane = abs( dot( probe.normal, s.world - probe.world ) ) /
							   max( s.dist, 1e-3 );
		const float turn = max( 0.0, normalTol - dot( probe.normal, s.normal ) );
		const float error = max( offPlane / planeTol, turn / max( 1.0 - normalTol, 1e-3 ) );
		if( error > worstError )
		{
			worstError = error;
			worstPix = pix;
			worstSurface = s;
		}
	}

	// THE DEMAND IS COUNTED WHATEVER THE BUDGET IS (the budget decides only what is
	// appended, in pass 2): a reading that could not say whether the cap is costing
	// anything would not answer the one question a budget's reading exists for.
	const bool wants = worstError > 1.0;
	if( wants )
	{
		atomicAdd( counter.appended, 1u );
		atomicAdd( counter.row[jahPlaceRow( cell )], 1u );
	}
	writeRecord( index, probe, 0.0 );
	// THE STASH for pass 2: the worst pixel's surface, and whether the cell asks.
	records.r[index].sh[0] = vec4( worstSurface.world, worstSurface.dist );
	records.r[index].sh[1] = vec4( worstSurface.normal, wants ? 1.0 : 0.0 );
}
#endif   // JAH_PLACE_SELECT
