#version 460
// PHOTON-2 STAGE 1b, PHOTON-7 STAGE 6 (commit 6) — THE REFLECTION'S TEMPORAL PASS = LUMEN'S DENOISER
// (LumenReflectionDenoiserTemporal.usf, SPECS/research/LUMEN_VR_FACTS_2026-10-22.md C7.2), at TRACE resolution (our
// memory rule: Lumen's full-extent history is refused), between the resolve (rq_reflect_resolve.comp: each texel's
// current answer, reconstructed) and the spatial filter (rq_reflect_filter.comp).
//
//   THE SPACE: Lumen's denoiser space on pre-exposed colour (jah_reflect_denoise.glsl) - the box, the clamp, the pick
//   and the blend are all taken there; the history is stored LINEAR (rgb) with the VARIANCE of the denoiser-space
//   luminance in its alpha - Lumen's SpecularAndSecondMoment CENTRED (PHOTON-7 stage 6, the lead's ruling on the moment's
//   precision: a raw second moment in the fp16 slot loses the variance to m2 - mean^2's cancellation below ~2 % relative
//   noise, mean^2 x 2^-11; the variance itself keeps its precision relative to itself, no memory), the frame count in
//   the state (Lumen's 5.3 step).
//   THE NEIGHBOURHOOD: 21 taps (a 5 x 5 minus its corners) of the RESOLVED answers, YCoCg, unweighted mean +- 1 sigma
//   (k = 1), a per-channel AABB. (The linear box of a bilateral 3 x 3 reconstruction and the box's extension to hold
//   the texel's own raw sample it replaces were PHOTON-2's measured deviations; the paired run on gi.reflect_mover's
//   floor found Lumen's form not worse - spikes/photon-7/stage6/c6-paired.txt.)
//   TWO HISTORIES, read HERE now (the trace only draws and traces): the VIRTUAL-HIT history - the point behind the
//   mirror, the surface's depth plus the resolved hit distance along the view ray, reprojected with no depth test - for
//   a lobe whose dominant direction is the reflection's (GetSpecularDominantDirFactor > 0.5: perceptual roughness under
//   0.594, every texel this tier traces); and the SURFACE history with Lumen's relative depth test (0.03 x [0.5, 1.5] of
//   the distance, over max( N.V, 0.1 )). Both bilinear over the previous trace grid with per-tap rejection,
//   renormalised. The surface's own motion (a moving slot: the trace's step in the half's alpha-flagged texel) moves
//   both points.
//   THE PICK AND THE CONFIDENCE (Lumen's exactly): the surface history takes 0.8 only where the hit history is farther
//   from the box's centre by more than 0.01; confidence = saturate( 1 - |clamp shift| / max( extent, 0.1 ) ), floored at
//   0.25 ( 0.75 c + 0.25 ); N = min( N_hist c + 1, MaxFrames ); the blend is 1 / N.
//   THE MEMORY: MaxFrames = 1 + ( 12 - 1 ) ( 1 - p ), p the centre ray's chance (the mirror ramp, jah_reflect_draw.glsl):
//   12 frames for a stochastic lobe (Lumen's; PHOTON-2's 32 deleted with its six readers re-derived), ONE for a lobe
//   under a texel - its centre ray is the integral, and the reflected direction changes with the view.
//   A TEXEL WITH NO HISTORY (a disocclusion, a new surface) shows its current answer, N = 0 - no fade, no warm seed: the
//   spatial filter widens over it (DRAG-1, PAN-SMEAR-1 (a) and (b) deleted: Lumen's N = 0 covers them). A texel with no
//   answer this frame (a dropped or unshaded record, the screen alone's miss) keeps its history as it is.
//   DELETED with the old pass: the distrust of an arriving mover's hit, the two-miss departure, a moving reflector's
//   1/8 floor (the clamp and the confidence and MaxFrames 12 cover them - Lumen has none), and the moving hit's
//   reflected-image history with its mover age (rq_reflect.comp).
//
// AT REST (PHOTON-2 fix F1, round 2): THE GATHER'S RULE, not a blend - a rest mean restarted at the first rest frame on
// the rest frames' own samples (the resolve hands each texel's raw sample through), the answer handed over from the
// frozen moving history over 2N samples (N = settleFramesOf( 12 ) = 19), then converging per texel until its standard
// error stops it (main(), "AT REST"). A RESUMING texel takes the moving rule from its composed answer.
//
// COMPILED AT BUILD TIME by glslangValidator at --target-env spirv1.4, like the trace and the filter beside it; the
// same descriptor set and the same Params (declared through `denoiser`).
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require

layout( local_size_x = 8, local_size_y = 8, local_size_z = 1 ) in;

layout( set = 0, binding = 0 ) uniform accelerationStructureEXT tlas;

#include "jah_half_round.glsl"   // the fp16 store truncates on NVIDIA 595.x: every half-float store rounds first
#include "jah_reflect_params.glsl"

int gEye = 0;
layout( set = 0, binding = 2 ) uniform sampler2DArray gBufNormals;
layout( set = 0, binding = 3 ) uniform sampler2DArray gBufShadowRoughness;
layout( set = 0, binding = 4 ) uniform sampler2DArray sceneDepth;
/// THE RESOLVE'S SCRATCH (trace texels): rgb = the resolved answer (linear), w = the resolved hit distance, 0 = none.
layout( rgba16f, set = 0, binding = 5 ) uniform readonly image2DArray ssrReflection;
/// THE HISTORY: rgb = the mean (linear), alpha = the VARIANCE of its denoiser-space luminance (centred: the precision is
/// the variance's own) - at rest the REST half's alpha holds the rest samples' second moment with its store's residual
/// (jah_reflect_rest.glsl: the stop reads it, exact to the residual's ~2^-22). The previous half
/// is written at rest on a resume, own texel only (R1). THIS frame's half arrives holding the trace's message: the
/// surface's own step since last frame (w = 1 on a moving slot).
layout( rgba16f, set = 0, binding = 6 ) uniform image2DArray historyPrev;
layout( rgba16f, set = 0, binding = 7 ) uniform image2DArray historyCur;
/// THE STATE TEXEL (jah_reflect_state.glsl): the counts, the throw, the stop; the previous half is written on a resume
/// at rest, own texel only.
layout( rg32ui, set = 0, binding = 8 ) uniform uimage2DArray statePrev;
layout( rg32ui, set = 0, binding = 9 ) uniform uimage2DArray stateCur;
/// THIS FRAME'S RAW SAMPLE (the rest takes it raw): rgb = the radiance, w = the hit distance (> 0), 0 = none.
layout( rgba16f, set = 0, binding = 45 ) uniform readonly image2DArray reflectSample;
/// THE REST'S REFERENCE (PHOTON-2 round 2, R1 (f)'s arm "reflect.restReference", rest.y): the texel's raw rest samples'
/// running mean in 32 bits (rgb) and their count (w) - 1 x 1 and never touched unless the arm is on.
layout( rgba32f, set = 0, binding = 46 ) uniform image2DArray restReference;
/// THE EXPOSURE HISTORY (the chain's measured 1 x 1; a stand-in where p.denoiser.y = 0).
layout( set = 0, binding = 50 ) uniform sampler2D jahExposure;

#include "jah_reproject.glsl"
/// kMaxRadiance, finite1, finite3: the one copy.
#include "jah_rq_finite.glsl"
float gExposure = 1.0;
#define JAH_DENOISE_EXPOSURE gExposure
#include "jah_reflect_denoise.glsl"
/// (after the denoiser space: the rest's fold is a denoiser-space mean; its stop reads the display's code)
#define JAH_DISPLAY_LUT( i ) p.display[( i ) >> 2][( i ) & 3]
#include "jah_reflect_rest.glsl"
/// THE REST'S STOP SHARE (jah_reflect_rest.glsl's stop): the filter's, last frame - the MIN over the pixels that read
/// this texel of each one's share, a denoiser-space standard error (a float's bits; all ones = no pixel measured it).
/// Read here, then reset to all ones for this frame's filter.
layout( r32ui, set = 0, binding = 51 ) uniform uimage2DArray restShare;
/// THE HIT LIST'S BUFFER (binding 28, the hit set's): its words 8-9 take THE REST's BOUND at rest frame 2N (PHOTON-7
/// stage 11, 11-1c) - the samples the converging texels still need and the most one needs.
layout( std430, set = 0, binding = 28 ) buffer JahHitBuf { uint jahHitBuf[]; };
uint gShareRaw = 0xFFFFFFFFu;
#include "jah_reflect_state.glsl"
#include "jah_reflect_draw.glsl"

/// The box's half-extent in standard deviations (Lumen's r.Lumen.Reflections.Temporal.NeighborhoodClampScale, 1).
const float kClampSigma = 1.0;
/// How much farther from the box's centre the hit history may be before the surface history takes 0.8 of the pick, and
/// the extent's floor in the confidence (both Lumen's, in its denoiser space's YCoCg units).
const float kHitErrorMargin = 0.01;
const float kExtentFloor = 0.1;
/// The surface history's relative depth test (Lumen's r.Lumen.Reflections.Temporal.DistanceThreshold).
const float kHistoryDistanceThreshold = 0.03;

/// YCoCg's luma (the rest's firefly bound and its second moment read it).
float lumaOf( vec3 c ) { return dot( c, vec3( 0.25, 0.5, 0.25 ) ); }

float viewDistance( float rawDepth )
{
	if( p.camPos.w < 0.5 )
		return abs( ( rawDepth - p.projParams.x ) / p.projParams.y );
	return p.projParams.y / ( rawDepth - p.projParams.x );
}

struct EyeImage { vec3 camPos; float perspective; vec3 rayTL; vec3 rayRight; vec3 rayDown; vec3 fwd; };
EyeImage eyeNow( int eye )
{
	EyeImage e;
	if( eye == 1 ) { e.camPos = p.camPos2.xyz; e.perspective = p.camPos2.w; e.rayTL = p.rayTL2.xyz;
					 e.rayRight = p.rayRight2.xyz; e.rayDown = p.rayDown2.xyz; e.fwd = p.fwd2.xyz; }
	else { e.camPos = p.camPos.xyz; e.perspective = p.camPos.w; e.rayTL = p.rayTL.xyz;
		   e.rayRight = p.rayRight.xyz; e.rayDown = p.rayDown.xyz; e.fwd = p.fwd.xyz; }
	return e;
}
EyeImage eyeBefore( int eye )
{
	EyeImage e;
	if( eye == 1 ) { e.camPos = p.prevCamPos2.xyz; e.perspective = p.prevCamPos2.w; e.rayTL = p.prevRayTL2.xyz;
					 e.rayRight = p.prevRayRight2.xyz; e.rayDown = p.prevRayDown2.xyz; e.fwd = p.prevFwd2.xyz; }
	else { e.camPos = p.prevCamPos.xyz; e.perspective = p.prevCamPos.w; e.rayTL = p.prevRayTL.xyz;
		   e.rayRight = p.prevRayRight.xyz; e.rayDown = p.prevRayDown.xyz; e.fwd = p.prevFwd.xyz; }
	return e;
}
vec3 worldAt( EyeImage e, vec2 uv, float dist )
{
	const vec3 plane = e.rayTL + e.rayRight * uv.x + e.rayDown * uv.y;
	if( e.perspective < 0.5 )
		return e.camPos + plane + e.fwd * dist;
	return e.camPos + plane * dist;
}
float exposureOf()
{
	const float e = p.denoiser.y > 0.5 ? texelFetch( jahExposure, ivec2( 0 ), 0 ).x : p.denoiser.x;
	return finite1( e ) && e > 0.0 ? e : 1.0;
}
/// Lumen's InterleavedGradientNoise( coord, frame mod 8 ): the depth test's per-texel jitter.
float interleavedGradientNoise( vec2 uv, float frame )
{
	uv += frame * ( vec2( 47.0, 17.0 ) * 0.695 );
	return fract( 52.9829189 * fract( dot( uv, vec2( 0.06711056, 0.00583715 ) ) ) );
}

/// THE TILE: the group's 8 x 8 and the 2-texel ring the 5 x 5 box reaches - the resolved answers in YCoCg of the
/// denoiser space, w = 1 where the texel has one.
const int kReach = 2;
const int kTileSide = 8 + 2 * kReach;
shared vec4 sTile[kTileSide * kTileSide];

/// ONE HISTORY CANDIDATE, bilinear over the previous trace grid: the denoiser-space mean, its luma's variance, the frame
/// count and the throw, renormalised over the taps that held an answer (and, for the surface history, passed the
/// relative depth test). The taps' mixture's variance is theirs plus their means' spread about the mixture's mean (the
/// spread in fp32 from the taps' means: what the raw second moment's bilinear carried implicitly).
struct History { bool ok; vec3 d; float var; float n; float hitT; };
History historyNone()
{
	History h;
	h.ok = false; h.d = vec3( 0.0 ); h.var = 0.0; h.n = 0.0; h.hitT = 0.0;
	return h;
}
History historyAt( vec2 puv, float pz, bool depthTest, float threshold, ivec2 traceRes )
{
	History h = historyNone();
	const vec2 at = puv * vec2( traceRes ) - 0.5;
	const ivec2 base = ivec2( floor( at ) );
	const vec2 f = at - vec2( base );
	float sumW = 0.0;
	float sumL = 0.0, sumL2 = 0.0;
	for( int k = 0; k < 4; ++k )
	{
		const ivec2 o = ivec2( k & 1, k >> 1 );
		const ivec2 t = base + o;
		if( any( lessThan( t, ivec2( 0 ) ) ) || any( greaterThanEqual( t, traceRes ) ) )
			continue;
		const float w = ( o.x == 1 ? f.x : 1.0 - f.x ) * ( o.y == 1 ? f.y : 1.0 - f.y );
		if( w <= 0.0 )
			continue;
		const JahReflectState s = jahStateUnpack( imageLoad( statePrev, ivec3( t, gEye ) ).xy );
		if( !( s.surfDist > 0.0 ) || ( depthTest && !( abs( s.surfDist - pz ) < pz * threshold ) ) )
			continue;
		const vec4 c = imageLoad( historyPrev, ivec3( t, gEye ) );
		if( !finite3( c.xyz ) || !finite1( c.w ) )
			continue;
		const vec3 dk = jahToDenoise( clamp( c.xyz, vec3( 0.0 ), vec3( kMaxRadiance ) ) );
		const float lk = jahDenoiseLuma( dk );
		h.d += dk * w;
		h.var += max( c.w, 0.0 ) * w;
		sumL += lk * w;
		sumL2 += lk * lk * w;
		h.n += s.N * w;
		h.hitT += s.hitT * w;
		sumW += w;
	}
	if( sumW > 0.01 )
	{
		h.ok = true;
		h.d /= sumW; h.n /= sumW; h.hitT /= sumW;
		const float lMean = sumL / sumW;
		h.var = h.var / sumW + max( sumL2 / sumW - lMean * lMean, 0.0 );
	}
	return h;
}
/// A point of last frame's picture: the history candidate there (a point behind the previous camera or outside its
/// picture has none).
History historyOfPoint( vec3 point, EyeImage before, bool depthTest, float threshold, ivec2 traceRes )
{
	vec2 puv;
	float pz;
	if( jahReproject( point, before.camPos, before.perspective, before.rayTL, before.rayRight, before.rayDown,
					  before.fwd, puv, pz ) != 0 )
		return historyNone();
	return historyAt( puv, pz, depthTest, threshold, traceRes );
}

/// THE MOVING SE INSTRUMENT (binding 53, OgreRayQuery.cpp kReflectMovingSeBinding; the arm reflect.historyReadback):
/// a float a texel - the moving mean's standard error in display codes. Unarmed it is a 16-byte stand-in and nothing is
/// written past its length.
layout( std430, set = 0, binding = 53 ) buffer JahMovingSe { float movingSe[]; };
// THE PICK (binding 56, rq_reflect.comp jahPickSlot): the picked texel's rest terms into its slot's words 32-47
layout( std430, set = 0, binding = 56 ) buffer JahPick { uint jahPick[]; };
/// THE REFINEMENT (binding 62, jah_reflect_rest.glsl: the no-pop hand-over of a card-only reach) - this pass runs it.
layout( rgba32ui, set = 0, binding = 62 ) uniform uimage2DArray restRefine;
/// THE CODE-A-FRAME SLEW (B2's refinement): the shown answer D moved toward the composed answer T by at most ONE display
/// code per channel - the code distance from D to T integrated along the line (the display slope at four midpoints), and
/// D moved that fraction of the way that is one code of it (all of it under a code). The same curve at every brightness.
vec3 refineSlew( vec3 D, vec3 T )
{
	vec3 r;
	for( int c = 0; c < 3; ++c )
	{
		const float d = abs( T[c] - D[c] );
		float codes = 0.0;
		for( int k = 0; k < 4; ++k )
			codes += jahDisplayCodes( mix( D[c], T[c], ( float( k ) + 0.5 ) * 0.25 ), 0.25 * d );
		r[c] = codes <= 1.0 ? T[c] : D[c] + ( T[c] - D[c] ) / codes;
	}
	return r;
}
int jahPickSlotT( ivec2 tc )
{
	const uint w = floatBitsToUint( p.alpha.y );
	if( ( w & ( 1u << 30u ) ) == 0u || gEye != 0 )
		return -1;
	const ivec2 full = ivec2( p.resolution.zw );
	const ivec2 traceRes = max( ivec2( p.resolution.xy ), ivec2( 1 ) );
	const ivec2 scale = max( full / traceRes, ivec2( 1 ) );
	const ivec2 px = ivec2( int( w & 4095u ), int( ( w >> 12u ) & 4095u ) );
	return all( equal( px / scale, tc ) ) ? int( ( w >> 24u ) & 63u ) : -1;
}
/// THE STORE: the mean (linear) and its luma's variance into this half, the count and the throw in the state - and, for
/// a texel RESUMING at rest, into the frozen half too (H = M: its rest restarts from here). The instrument takes the
/// mean's standard error, sqrt( variance / count ), in display codes (0 with no count).
void storeMean( ivec2 tc, vec3 meanD, float var, float count, float hitT, bool resumed, JahReflectState st )
{
	{
		const uint i = ( uint( gEye ) * uint( p.resolution.y ) + uint( tc.y ) ) * uint( p.resolution.x ) + uint( tc.x );
		if( i < uint( movingSe.length() ) )
		{
			const float lD = jahDenoiseLuma( meanD );
			const float seD = count >= 1.0 ? sqrt( max( var, 0.0 ) / count ) : 0.0;
			movingSe[i] = jahDisplayCodes( jahDenoiseLuma( jahFromDenoise( max( meanD, vec3( 0.0 ) ) ) ),
										   seD * jahDenoiseSlopeAt( lD ) );
		}
	}
	const vec4 hist = vec4( clamp( jahFromDenoise( max( meanD, vec3( 0.0 ) ) ), vec3( 0.0 ), vec3( kMaxRadiance ) ),
							max( var, 0.0 ) );
	imageStore( historyCur, ivec3( tc, gEye ), jahRoundHalf( hist ) );
	st.N = count;
	st.hitT = hitT;
	imageStore( stateCur, ivec3( tc, gEye ), uvec4( jahStatePack( st ), 0u, 0u ) );
	if( resumed )
	{
		imageStore( historyPrev, ivec3( tc, gEye ), jahRoundHalf( hist ) );
		JahReflectState h = jahStateUnpack( imageLoad( statePrev, ivec3( tc, gEye ) ).xy );
		h.N = count;
		h.hitT = hitT;
		imageStore( statePrev, ivec3( tc, gEye ), uvec4( jahStatePack( h ), 0u, 0u ) );
	}
}

void main()
{
	const ivec2 traceRes = ivec2( p.resolution.xy );
	const ivec2 tc = ivec2( gl_GlobalInvocationID.xy );
	// THE STOP SHARE, read and reset for this frame's filter (every texel, before any early return).
	if( all( lessThan( tc, traceRes ) ) )
	{
		gShareRaw = imageLoad( restShare, ivec3( tc, int( gl_GlobalInvocationID.z ) ) ).x;
		imageStore( restShare, ivec3( tc, int( gl_GlobalInvocationID.z ) ), uvec4( 0xFFFFFFFFu ) );
	}
	gEye = int( gl_GlobalInvocationID.z );
	gExposure = exposureOf();
	const ivec2 fullRes = ivec2( p.resolution.zw );
	const ivec2 scale = max( fullRes / max( traceRes, ivec2( 1 ) ), ivec2( 1 ) );
	const ivec2 tileOrigin = ivec2( gl_WorkGroupID.xy ) * 8 - ivec2( kReach );
	for( int i = int( gl_LocalInvocationIndex ); i < kTileSide * kTileSide; i += 64 )
	{
		const ivec2 t = tileOrigin + ivec2( i % kTileSide, i / kTileSide );
		vec4 v = vec4( 0.0 );
		if( all( greaterThanEqual( t, ivec2( 0 ) ) ) && all( lessThan( t, traceRes ) ) )
		{
			const vec4 r = imageLoad( ssrReflection, ivec3( t, gEye ) );
			if( r.w > 0.0 && finite3( r.xyz ) )
				v = vec4( jahToYCoCg( jahToDenoise( clamp( r.xyz, vec3( 0.0 ), vec3( kMaxRadiance ) ) ) ), 1.0 );
		}
		sTile[i] = v;
	}
	barrier();
	if( any( greaterThanEqual( tc, traceRes ) ) )
		return;
	// THE REFINEMENT WORD (B2): a rest's own - cleared on every frame off rest (the break's compose read it first)
	uvec4 refine = imageLoad( restRefine, ivec3( tc, gEye ) );
	if( p.knobs2.x < 0.5 && refine != uvec4( 0u ) )
	{
		refine = uvec4( 0u );
		imageStore( restRefine, ivec3( tc, gEye ), refine );
	}
	// A texel the trace declined this frame keeps what it holds (the filter reads no answer there).
	JahReflectState st = jahStateUnpack( imageLoad( stateCur, ivec3( tc, gEye ) ).xy );
	if( !( st.surfDist > 0.0 ) )
		return;
	const vec4 resolved = imageLoad( ssrReflection, ivec3( tc, gEye ) );
	const bool hasCurrent = resolved.w > 0.0 && finite3( resolved.xyz );
	// THIS TEXEL'S SURFACE (its block's centre pixel, the trace's), its lobe and its memory.
	const EyeImage now = eyeNow( gEye );
	const ivec2 px = jahTexelPixel( tc, scale, fullRes );
	const vec2 uv = jahTexelUv( tc, scale, fullRes );
	const float rawDepth = texelFetch( sceneDepth, ivec3( px, gEye ), 0 ).x;
	const float alpha = max( texelFetch( gBufShadowRoughness, ivec3( px, gEye ), 0 ).y * 0.999 + 0.001, 1e-6 );
	const vec3 world = worldAt( now, uv, viewDistance( rawDepth ) );
	const bool persp = now.perspective > 0.5;
	const vec3 viewDir = persp ? normalize( world - now.camPos ) : now.fwd;
	vec3 nrm = texelFetch( gBufNormals, ivec3( px, gEye ), 0 ).xyz * 2.0 - 1.0;
	nrm = dot( nrm, nrm ) > 1e-6 ? normalize( p.viewAxisX.xyz * nrm.x + p.viewAxisY.xyz * nrm.y + p.viewAxisZ.xyz * nrm.z )
								 : -viewDir;
	const float maxFramesLobe = 1.0 / max( p.knobs2.w, 1e-3 );   // Lumen's MaxFrames, 12
	const float texelAngle = length( now.rayDown ) / float( traceRes.y );
	// THE THROW the trace drew with (the frozen half's at rest: the same chance the trace took).
	const JahReflectState ownPrev = jahStateUnpack( imageLoad( statePrev, ivec3( tc, gEye ) ).xy );
	const float throwT = ownPrev.surfDist > 0.0 ? ownPrev.hitT : 0.0;
	const float centreChance = jahReflectCentreChance( alpha, throwT, length( world - now.camPos ), texelAngle, persp );
	const float maxFrames = jahReflectMaxFrames( centreChance, maxFramesLobe );
	const vec3 curD = hasCurrent ? jahToDenoise( clamp( resolved.xyz, vec3( 0.0 ), vec3( kMaxRadiance ) ) ) : vec3( 0.0 );

	// ---- AT REST: THE REST CONVERGES PER TEXEL, THEN HOLDS (PHOTON-2 round 2: R1, G1-G3, G6; commit 8; jah_reflect_rest.glsl)
	// The frozen moving history H is this texel's `historyPrev` (from the second rest frame the ping-pong does not flip)
	// and its rest mean M lives in place in `historyCur` (the state's v = the rest samples it holds). THE TRACE FOLDS ITS
	// BATCH (the rest's k rays a frame) into M in place, up to the first ray that needs a RECORD; this pass folds the
	// frame's SAMPLE - that record's, or the one ray of a frame without a batch (the first rest frame, a fixed estimator,
	// the reference arm) - by the same fold (G1: a frame with none adds none), and then, for every texel still
	// converging, makes the frame's STOP test: the rest mean's standard error under one output code for
	// kReflectStopFrames frames in a row (once the hand-over is done) stops it - the trace skips it; the view holds when
	// no texel is left (OgreRayQuery.cpp). The ANSWER is composed at every read, lerp( H, M, w( v ) ). A texel with no
	// moving history (a disocclusion at the stop) or whose draw is the centre ray every frame takes the plain mean of its
	// rest samples. A RESUMING texel (G6: a moved instance crossed its ray) takes THE MOVING RULE this frame from its
	// composed answer (the count it holds, the box's clamp and confidence - never one raw sample: G4) into both halves,
	// its stop count cleared: its rest restarts from there. No firefly bound: the denoiser space bounds a sample's weight
	// (every sample's luma in [0, 10)).
	const float restK = p.knobs2.x;
	History hs = historyNone(), hh = historyNone();
	bool resumed = false;
	if( restK >= 0.5 )
	{
		if( st.stop >= kReflectStopFrames && !st.resume )
		{
			// a stopped texel: its rest is held as it is - and one still REFINING (B2) slews its shown answer a code toward
			// its composed answer, the word cleared once it has arrived
			if( ( refine.w & kRefineRefining ) != 0u )
			{
				const float Nr = max( p.stereo.w, 1.0 );
				const vec4 Hq = imageLoad( historyPrev, ivec3( tc, gEye ) );
				const bool hasHq = finite3( Hq.xyz ) && ownPrev.N > 0.0;
				const vec4 Mq = imageLoad( historyCur, ivec3( tc, gEye ) );
				const vec3 T = jahRestAnswer( hasHq ? clamp( Hq.xyz, vec3( 0.0 ), vec3( kMaxRadiance ) ) : vec3( 0.0 ), hasHq,
											  clamp( Mq.xyz, vec3( 0.0 ), vec3( kMaxRadiance ) ), float( st.v ), Nr );
				const vec3 D = refineSlew( jahRefineD( refine ), T );
				refine = all( equal( jahRefineD( jahRefineWithD( refine, D ) ), jahRefineD( jahRefineWithD( refine, T ) ) ) )
							 ? uvec4( 0u ) : jahRefineWithD( uvec4( 0u, 0u, 0u, kRefineRefining ), D );
				imageStore( restRefine, ivec3( tc, gEye ), refine );
			}
			return;
		}
		const vec4 s = imageLoad( reflectSample, ivec3( tc, gEye ) );
		const bool hasSample = s.w > 0.0 && finite3( s.xyz );
		const vec3 sample1 = hasSample ? clamp( s.xyz, vec3( 0.0 ), vec3( kMaxRadiance ) ) : vec3( 0.0 );
		const float N = max( p.stereo.w, 1.0 );
		// H = the frozen moving history (its count: the frozen half's state); M = the rest half in place, its v rest
		// samples the state's (the first rest frame: v = 0).
		const float Hn = ownPrev.N;
		const vec4 Hr = imageLoad( historyPrev, ivec3( tc, gEye ) );
		const bool hasH = finite3( Hr.xyz ) && Hn > 0.0;
		const vec3 H = hasH ? clamp( Hr.xyz, vec3( 0.0 ), vec3( kMaxRadiance ) ) : vec3( 0.0 );
		const vec4 Mt = imageLoad( historyCur, ivec3( tc, gEye ) );
		const bool reference = p.rest.y > 0.5;
		if( reference && hasSample )
		{
			// THE REFERENCE (R1 (f)): the raw sample, unbounded but for the radiance cap - the integral, not the held
			// estimate - restarted at the first rest frame.
			const vec4 R0 = restK < 1.5 ? vec4( 0.0 ) : imageLoad( restReference, ivec3( tc, gEye ) );
			const float n = R0.w + 1.0;
			imageStore( restReference, ivec3( tc, gEye ), vec4( R0.xyz + ( sample1 - R0.xyz ) / n, n ) );
		}
		const float vPrev = float( st.v );
		const bool centreOnly = centreChance >= 1.0;
		JahRestStats rs;
		rs.M = vPrev > 0.0 && finite3( Mt.xyz ) ? Mt.xyz : H;
		rs.m2 = vPrev > 0.0 && finite1( Mt.w ) ? Mt.w : 0.0;
		rs.res = jahRestHasResidual( vPrev, hasH, N ) && finite3( Hr.xyz ) && finite1( Hr.w ) ? Hr : vec4( 0.0 );
		if( st.resume )
		{
			if( !hasSample )
				return;   // a resume with no answer: the texel's rest restarts next frame, as it stands
			// THE COMPOSED ANSWER IS THIS TEXEL'S HISTORY for the moving rule below (the surface's, in place) - what it
			// SHOWS (a refinement's held answer or its walk, B2: a real change resumes from what is on screen)
			const vec3 sofar = jahRefineShown( jahRestAnswer( H, hasH, rs.M, vPrev, N ), refine );
			// B2: A CARD-ONLY REACH (the trace's mark: any texel at rest, stopped or converging) RE-RESTS IN THE
			// BACKGROUND - the readers show `sofar` until the new rest stops and its walk is done; any other resume
			// ends a refinement
			refine = ( refine.w & kRefineReach ) != 0u ? jahRefineWithD( uvec4( 0u, 0u, 0u, kRefineRefining ), sofar )
													   : uvec4( 0u );
			imageStore( restRefine, ivec3( tc, gEye ), refine );
			if( vPrev > 0.0 || hasH )
			{
				hs.ok = true;
				hs.d = jahToDenoise( sofar );
				// (its variance: the rest samples' - the per-sample spread, not the mean's - else none known)
				const float eR = jahRestErrorD( rs, vPrev );
				hs.var = vPrev >= 2.0 ? eR * eR * vPrev : 0.0;
				hs.n = ( hasH ? Hn : 0.0 ) + vPrev;
				hs.hitT = st.hitT;
			}
			resumed = true;
			st.stop = 0u;
			st.v = 0u;
		}
		else
		{
			// THE GI FREEZE AT REST (PHOTON-2 1b W4): no new sample enters the rest either - the texel keeps its rest
			// mean, its second moment and its stop count as they are.
			if( p.rest.x > 0.5 )
				return;
			float v = vPrev;
			if( hasSample && st.v < kReflectRestVCap )
			{
				jahRestFold( rs, sample1, vPrev );
				v = vPrev + 1.0;
				// (the rest's mean length: the rest samples' own running mean)
				st.hitT = vPrev > 0.0 && st.hitT > 0.0 ? max( st.hitT + ( s.w - st.hitT ) / v, 1e-3 ) : s.w;
				st.v = uint( v );
				imageStore( historyCur, ivec3( tc, gEye ), jahRoundHalf( vec4( rs.M, rs.m2 ) ) );
				if( jahRestHasResidual( v, hasH, N ) )
					imageStore( historyPrev, ivec3( tc, gEye ), jahRoundHalf( rs.res ) );   // the stores' residual (jahRestFold)
				else if( centreOnly )
					imageStore( historyPrev, ivec3( tc, gEye ), jahRoundHalf( vec4( rs.M, 0.0 ) ) );   // the plain mean: every reader composes M
			}
			if( !( v >= 1.0 ) )
				return;   // nothing in the rest mean yet
			// THE STOP (R1; jah_reflect_rest.glsl): the texel's OWN rest mean's standard error (the denoiser space's)
			// within its share - the strictest over the pixels that read it of each one's slice of the one-code display
			// budget - counted over consecutive frames once the hand-over is done (a texel with no hand-over: once
			// kReflectStopFrames samples are in). The filter measured the share last frame (restShare); where no pixel
			// measured it (the first rest frame, a texel no pixel reads with a variance) the share is one code at its
			// own value.
			const bool handOver = hasH && !centreOnly;
			const vec3 answer = jahRestAnswer( handOver ? H : rs.M, hasH, rs.M, v, N );
			// (no pixel measured it: the whole code at its own value)
			const float LD = jahDenoiseLuma( jahToDenoise( clamp( answer, vec3( 0.0 ), vec3( kMaxRadiance ) ) ) );
			const float share = gShareRaw != 0xFFFFFFFFu
									? uintBitsToFloat( gShareRaw )
									: 1.0 / max( jahDisplayCodes( jahDenoiseLuma( answer ), jahDenoiseSlopeAt( LD ) ), 1e-12 );
			const float e = jahRestErrorD( rs, v );
			// (and never before ONE FULL CYCLE of the hits' time-stratified area draw where the hit table holds an area
			// light: p.alpha.w = its S samples, 0 without - 11-2 (2): a stop never judges a stream it has not seen whole)
			const bool settled = v >= max( handOver ? jahRestHandOverLength( N ) : float( kReflectStopFrames ), p.alpha.w );
			// A CAPPED TEXEL (its count at the field's ceiling) stops as it stands - the defect the trace counts.
			const bool capped = st.v >= kReflectRestVCap;
			// THE STOP (B2's (e)): within the share for its last kReflectStopFrames frames AND across a window of
			// kReflectStopSamples samples since it first came within it (jah_reflect_rest.glsl) - the window's samples stand
			// across a frame out of the share (its frame count restarts); it closes only while not settled
			const uvec4 refineWas = refine;
			if( capped )
				st.stop = kReflectStopFrames;
			else if( !( e <= share && settled && !reference ) )
			{
				st.stop = 0u;
				if( !settled )
					refine.w &= ~kRefineWindow;
			}
			else
			{
				if( ( refine.w & kRefineWindow ) == 0u )
				{
					refine.z = uint( min( v, 65535.0 ) );
					refine.w |= kRefineWindow;
				}
				const bool enough = v - float( refine.z ) >= kReflectStopSamples;
				st.stop = min( st.stop + 1u, enough ? kReflectStopFrames : kReflectStopFrames - 1u );
			}
			// B2: A REFINING texel's shown answer slews a code toward its composed answer, every frame of its re-convergence
			if( ( refine.w & kRefineRefining ) != 0u )
				refine = jahRefineWithD( refine, refineSlew( jahRefineD( refine ), answer ) );
			if( refine != refineWas )
				imageStore( restRefine, ivec3( tc, gEye ), refine );
			{
				const int ps = jahPickSlotT( tc );   // THE PICK (the reds' instrument)
				if( ps >= 0 )
				{
					const uint b = uint( ps ) * 64u + 32u;
					jahPick[b + 0u] = 1u;
					jahPick[b + 1u] = floatBitsToUint( e );
					jahPick[b + 2u] = floatBitsToUint( share );
					jahPick[b + 3u] = floatBitsToUint( v );
					jahPick[b + 4u] = st.stop;
					jahPick[b + 5u] = ( settled ? 1u : 0u ) | ( capped ? 2u : 0u ) | ( reference ? 4u : 0u ) |
									  ( handOver ? 8u : 0u );
					jahPick[b + 6u] = floatBitsToUint( LD );
					jahPick[b + 7u] = floatBitsToUint( answer.x );
					jahPick[b + 8u] = floatBitsToUint( answer.y );
					jahPick[b + 9u] = floatBitsToUint( answer.z );
					jahPick[b + 10u] = floatBitsToUint( rs.m2 );
					jahPick[b + 11u] = floatBitsToUint( sample1.x );
					jahPick[b + 12u] = floatBitsToUint( sample1.y );
					jahPick[b + 13u] = floatBitsToUint( sample1.z );
				}
			}
			imageStore( stateCur, ivec3( tc, gEye ), uvec4( jahStatePack( st ), 0u, 0u ) );
			// THE REST'S BOUND (PHOTON-7 stage 11, 11-1c), at rest frame 2N - every texel's hand-over is done: a texel
			// still converging needs v_need = v ( e / share )^2 samples (its standard error over v is e, the stop's bar its
			// share: sigma^2 = e^2 v, and sigma^2 / v_need = share^2), so it still owes max( 0, v_need - v ). The words:
			// 8 = their sum (each clamped at 2^20), 9 = the largest v_need (over kReflectRestVCap PREDICTS a capped texel).
			// The trace zeroes both at every frame up to 2N; past it they hold this frame's (OgreRayQuery.cpp publishes
			// RayQueryStatus::reflectRestBound = 2N + ceil( sum / the tail's rays a frame ) + kReflectStopFrames).
			if( JAH_HIT_ON && uint( p.knobs2.x + 0.5 ) == 2u * uint( N + 0.5 ) && !capped && st.stop < kReflectStopFrames &&
				!reference && share > 0.0 && finite1( e ) )
			{
				const float r = e / share;
				const float need = min( ceil( v * r * r ), 16777216.0 );
				const uint owe = need > v ? uint( min( need - v, 1048576.0 ) ) : 0u;
				atomicAdd( jahHitBuf[8], owe );
				atomicMax( jahHitBuf[9], uint( need ) );
			}
			return;
		}
	}
	else
	{
		// ---- MOVING: THE TWO HISTORIES, REPROJECTED HERE (Lumen's GetLightingHistory) ----------------------------
		const EyeImage before = eyeBefore( gEye );
		// THE SURFACE'S OWN MOTION (the trace's message in this half: its step, w = 1 on a moving slot).
		const vec4 motion = imageLoad( historyCur, ivec3( tc, gEye ) );
		const vec3 step = motion.w > 0.5 && finite3( motion.xyz ) ? motion.xyz : vec3( 0.0 );
		const vec3 prevSurf = world + step;
		const float noise = interleavedGradientNoise( vec2( tc ), float( uint( p.knobs.z ) & 7u ) );
		const float threshold = kHistoryDistanceThreshold * mix( 0.5, 1.5, noise ) /
								clamp( dot( -viewDir, nrm ), 0.1, 1.0 );
		hs = historyOfPoint( prevSurf, before, true, threshold, traceRes );
		// THE VIRTUAL POINT, where a mirror's image lies (the surface plus the resolved hit distance along the view ray),
		// moved by the surface's own step; for a lobe whose dominant direction is the reflection's.
		const float rough = sqrt( alpha );
		const float sDom = clamp( 1.0 - rough, 0.0, 1.0 );
		const bool dominant = sDom * ( sqrt( sDom ) + rough ) > 0.5;   // GetSpecularDominantDirFactor
		if( dominant && hasCurrent )
			hh = historyOfPoint( world + viewDir * resolved.w + step, before, false, 0.0, traceRes );
	}
	if( !hasCurrent )
	{
		// NO ANSWER THIS FRAME (a dropped or unshaded record, the screen alone's miss): the history kept as it is - the
		// surface's, else none (and no history at all: the texel holds no answer).
		if( !hs.ok )
		{
			st.surfDist = 0.0;
			st.N = 0.0;
			imageStore( stateCur, ivec3( tc, gEye ), uvec4( jahStatePack( st ), 0u, 0u ) );
			return;
		}
		storeMean( tc, hs.d, hs.var, hs.n, hs.hitT, resumed, st );
		return;
	}
	// ---- THE BOX: the 21 resolved taps (Lumen's GetNeighborhood: the centre always, the neighbours by validity) ----
	vec3 m1 = vec3( 0.0 ), m2 = vec3( 0.0 );
	float n = 0.0;
	{
		const ivec2 l = ivec2( gl_LocalInvocationID.xy ) + ivec2( kReach );
		for( int dy = -kReach; dy <= kReach; ++dy )
			for( int dx = -kReach; dx <= kReach; ++dx )
			{
				if( abs( dx ) == kReach && abs( dy ) == kReach )
					continue;
				const vec4 v = sTile[( l.y + dy ) * kTileSide + l.x + dx];
				if( v.w <= 0.0 )
					continue;
				m1 += v.xyz;
				m2 += v.xyz * v.xyz;
				n += 1.0;
			}
	}
	const vec3 centre = m1 / max( n, 1.0 );
	const vec3 extent = kClampSigma * sqrt( max( m2 / max( n, 1.0 ) - centre * centre, vec3( 0.0 ) ) );
	const float curLuma = jahDenoiseLuma( curD );
	if( !hs.ok && !hh.ok )
	{
		// NO HISTORY (a disocclusion, a new surface, a first frame): the current answer, N = 0 (Lumen's) - the spatial
		// filter widens over it.
		storeMean( tc, curD, 0.0, 0.0, resolved.w, resumed, st );
		return;
	}
	// ---- THE PICK, THE CLAMP AND THE CONFIDENCE (Lumen's step 5) ----
	const vec3 hitY = jahToYCoCg( hh.d ), surfY = jahToYCoCg( hs.d );
	const vec3 lo = centre - extent, hi = centre + extent;
	const vec3 hitYc = clamp( hitY, lo, hi ), surfYc = clamp( surfY, lo, hi );
	float a = 1.0;   // the surface history's share
	if( hh.ok )
		a = hs.ok && length( centre - hitY ) > length( centre - surfY ) + kHitErrorMargin ? 0.8 : 0.0;
	const vec3 hY = mix( hitY, surfY, a ), hYc = mix( hitYc, surfYc, a );
	const float histN = a > 0.5 ? hs.n : hh.n;
	// (the picked mixture's variance: the two histories' and their means' spread)
	const float lHit = jahDenoiseLuma( hh.d ), lSurf = jahDenoiseLuma( hs.d );
	const float histVar = mix( hh.var, hs.var, a ) + a * ( 1.0 - a ) * ( lSurf - lHit ) * ( lSurf - lHit );
	const float histT = mix( hh.hitT, hs.hitT, a );
	// THE GI FREEZE (M1's measuring arm, rest.x): the live estimator's own reprojection - picked as live, its clamp never
	// applied - and nothing else: no sample enters (the motion's own resampling, measured alone). A lobe whose draw is
	// the centre ray every frame takes its ray as it does live (the old radiance is wrong at the new pose).
	if( p.rest.x > 0.5 && maxFrames > 1.0 )
	{
		storeMean( tc, jahFromYCoCg( hY ), histVar, histN, histT, resumed, st );
		return;
	}
	float confidence = clamp( 1.0 - length( abs( hYc - hY ) / max( extent, vec3( kExtentFloor ) ) ), 0.0, 1.0 );
	confidence = 0.75 * confidence + 0.25;
	const float frames = min( histN * confidence + 1.0, maxFrames );
	const float blend = 1.0 / frames;
	// THE VARIANCE'S UPDATE, centred (the exponential mean's exact identity: with the mean m' = m + b ( x - m ), the
	// variance s'^2 = ( 1 - b ) ( s^2 + b ( x - m )^2 ) - about the history's kept mean, the clamped one)
	const float lKept = jahDenoiseLuma( jahFromYCoCg( hYc ) );
	storeMean( tc, mix( jahFromYCoCg( hYc ), curD, blend ),
			   ( 1.0 - blend ) * ( histVar + blend * ( curLuma - lKept ) * ( curLuma - lKept ) ), frames,
			   mix( histT, resolved.w, blend ), resumed, st );
}
