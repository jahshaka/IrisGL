#version 460
#extension GL_GOOGLE_include_directive : require

// THE PIXEL'S AREA LIGHT VISIBILITY, JOB 2 OF 2: THE RESOLVE (PHOTON-7 stage 7, 7-A; rq_area_vis.comp is job 1). One
// thread a FULL-RESOLUTION pixel: the joint-bilateral upsample of the trace's two sums and their ratio into `jahAreaVis`
// (RG32_UINT: x the diffuse visibility of light i in byte i, y the specular's) - jah_area_vis_law.glsl's
// jahAreaVisResolve, one text with the no-ray route's Jahshaka/ScreenAreaVisResolve (7-6); this job binds it.
// THE PASS'S READ: the fork's hook in DoAreaLtcLights (custom_ps_areaLtcVisibility, JahAreaVis_piece_ps.any).

layout( local_size_x = 8, local_size_y = 8, local_size_z = 1 ) in;

#define JAH_AREA_VIS_PARAMS_BINDING 0
#include "jah_area_vis_params.glsl"

layout( set = 0, binding = 1 ) uniform sampler2D sceneDepth;
layout( rgba16f, set = 0, binding = 2 ) uniform readonly image2D histS;
layout( rgba16f, set = 0, binding = 3 ) uniform readonly image2D histU;
layout( rgba32ui, set = 0, binding = 4 ) uniform readonly uimage2D histG;
layout( rg32ui, set = 0, binding = 5 ) uniform writeonly uimage2D areaVis;
layout( set = 0, binding = 6 ) uniform sampler2D gBufNormals;
layout( rgba16f, set = 0, binding = 7 ) uniform readonly image2D histS2;
layout( rgba16f, set = 0, binding = 8 ) uniform readonly image2D histU2;

#define JAH_AREA_DEPTH( pix ) texelFetch( sceneDepth, pix, 0 ).x
#define JAH_AREA_NORMAL( pix ) texelFetch( gBufNormals, pix, 0 ).xyz
#define JAH_AREA_CUR_S( t ) imageLoad( histS, t )
#define JAH_AREA_CUR_U( t ) imageLoad( histU, t )
#define JAH_AREA_CUR_S2( t ) imageLoad( histS2, t )
#define JAH_AREA_CUR_U2( t ) imageLoad( histU2, t )
#define JAH_AREA_CUR_G( t ) imageLoad( histG, t )
#define JAH_AREA_STORE_VIS( pix, words ) imageStore( areaVis, pix, uvec4( words, 0u, 0u ) )
#include "jah_area_vis_law.glsl"

void main()
{
	jahAreaVisResolve( ivec2( gl_GlobalInvocationID.xy ) );
}
