	vec4( ( JAH_VOX_ORIGIN( (c) - 1 ).xyz - JAH_VOX_ORIGIN( c ).xyz ) * JAH_VOX_INVSIZE( c ).xyz, 0.0 )
#include "jah_ray_set.glsl"
#include "jah_voxel_ray.glsl"
