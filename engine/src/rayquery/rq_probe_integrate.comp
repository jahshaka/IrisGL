#include "jah_voxel_cones.glsl"

#include "jah_reproject.glsl"
// THE REST MEANS' STORE (PHOTON_2_SPEC R1: every fp16 running statistic is stored stochastically rounded)
#include "jah_half_stochastic.glsl"
#include "jah_probe_history.glsl"
#include "jah_probe_seen.glsl"

/// THE ROUNDING'S NUMBER on [0,1): a pure function of (the pixel IN ITS EYE'S
/// OWN IMAGE, the view's ADVANCING frame counter p.knobs6.z, which quantity) —
/// the gather's own PCG. The counter is the view's, never the sample sequence's
/// frame (p.knobs.z): a FROZEN frame index (every gather A/B's rule) would fix
/// the number per pixel and turn the rounding into a biased one, which stalls a
/// long history a few quanta from a constant estimate (gi.far_blas' frozen A/B
/// caught exactly that, 5,360 px). Deterministic run to run; two eyes at one
/// pose round alike.
/// AT REST THE KEY IS THE REST FRAME'S OWN INDEX (PHOTON-7 stage 10-3; L1: the picture at rest is the pose's): the
/// view's frame counter counts every frame the view traced before its rest began, so a key on it rounded the rest's
/// history differently by the path - how long the view had lived, which another view's state set (the resize history's
/// row). The rest index (p.knobs6.x: 1, 2, ... N) is the same sequence whatever came before it.
float roundingDither( ivec2 localPix, uint salt )
{
	const uint key = p.knobs6.x >= 1.0 ? 0x80000000u + uint( p.knobs6.x ) : uint( p.knobs6.z );
	const uint h = jahPcg( uint( localPix.x ) * 1973u + uint( localPix.y ) * 9277u + key * 26699u + salt * 104729u );
	return float( h & 0xFFFFFFu ) / 16777216.0;
}

/// A NON-NEGATIVE rgb AS ONE SHARED-EXPONENT WORD (the E5B9G9R9 layout: red in
/// bits 0-8, green 9-17, blue 18-26, the exponent biased by 15 in 27-31), each
/// mantissa rounded up with probability equal to its fraction (`u`). The
/// exponent is the brightest channel's (frexp, exact), bumped once where that
/// channel's mantissa could round to 512.
uint packRgbShared( vec3 c, float u )
{
	c = clamp( c, vec3( 0.0 ), vec3( kMaxRadiance ) );
	const float maxc = max( c.r, max( c.g, c.b ) );
	if( !( maxc >= 1.0 / 16777216.0 ) )
		return 0u;
	int e;
	frexp( maxc, e );   // maxc = m 2^e, m in [0.5, 1): floor( log2( maxc ) ) = e - 1
	int sharedExp = max( e + 15, 0 );   // biased; the scale is 2^( shared - 15 - 9 )
	float scale = exp2( float( 24 - sharedExp ) );
	if( maxc * scale >= 511.0 )
	{
		sharedExp += 1;
		scale *= 0.5;
	}
	const uvec3 m = uvec3( min( floor( c * scale + u ), vec3( 511.0 ) ) );
	return m.r | ( m.g << 9u ) | ( m.b << 18u ) | ( uint( sharedExp ) << 27u );
}
vec3 unpackRgbShared( uint w )
{
	const float scale = exp2( float( int( w >> 27u ) - 24 ) );
	return vec3( float( w & 511u ), float( ( w >> 9u ) & 511u ), float( ( w >> 18u ) & 511u ) ) * scale;
}

/// E/pi of probe `i` at the unit normal n, reading only the vec4s of the SH
/// the bands need straight from the buffer (4 bands = three vec4, 9 = seven):
/// the record is 160 bytes and the integrate's memory traffic is the price the
/// SH9 record was measured at (PHOTON-GATHER-1b item 3).
vec3 shEvalAt( uint i, vec3 n, int bands )
{
	float y[9];
	jahShBasis9( n, y );
	const int vecs = bands > 4 ? 7 : 3;
	float c[28];
	for( int v = 0; v < 7; ++v )
	{
		const vec4 q = v < vecs ? records.r[i].sh[v] : vec4( 0.0 );
		c[4 * v] = q.x; c[4 * v + 1] = q.y; c[4 * v + 2] = q.z; c[4 * v + 3] = q.w;
	}
	vec3 e = vec3( 0.0 );
	for( int k = 0; k < 9; ++k )
	{
		if( k >= bands )
			break;
		e += vec3( c[3 * k], c[3 * k + 1], c[3 * k + 2] ) * y[k];
	}
	return max( e, vec3( 0.0 ) );
}

/// THE DISCS (PHOTON-VIEW-1): the probes of the 3 x 3 cells around the pixel's
/// own (uniform and adaptive), each projected through the pixel's eye; the nearest
/// whose disc holds the pixel colours it — E/pi tonemapped (x / (1 + x)), the
/// radiance a white surface there would show — with a one-pixel dark rim.
vec4 photonDisc( ivec2 pix, int lx, ivec2 cell, ivec2 cellOff, ivec2 gridEye, ivec2 grid,
				 JahEye e, int eyeW, ivec2 full, float stride )
{
	const float radius = max( 0.3 * stride, 1.5 );
	const vec2 here = vec2( float( lx ), float( pix.y ) ) + 0.5;
	float best = radius;
	vec4 outC = vec4( 0.0, 0.0, 0.0, 0.6 );
	for( int dy = -1; dy <= 1; ++dy )
		for( int dx = -1; dx <= 1; ++dx )
		{
			const ivec2 c = cell + ivec2( dx, dy );
			if( any( lessThan( c, cellOff ) ) || any( greaterThanEqual( c, cellOff + gridEye ) ) )
				continue;
			const uint ui = uint( c.y * grid.x + c.x );
			const float link = records.r[ui].normalW.w;
			for( int k = 0; k < 2; ++k )
			{
				if( k == 1 && link < 0.5 )
					break;
				const uint pi = k == 0 ? ui : uint( link ) - 1u;
				const vec4 posW = records.r[pi].posW;
				if( posW.w < 0.5 || records.r[pi].irradiance.w < 0.5 )
					continue;
				vec2 uv;
				float z;
				if( jahReproject( posW.xyz, e.camPos, e.perspective, e.rayTL, e.rayRight, e.rayDown,
								  e.fwd, uv, z ) != 0 )
					continue;
				const float d = length( uv * vec2( float( eyeW ), float( full.y ) ) - here );
				if( d >= best )
					continue;
				best = d;
				const vec3 irr = max( records.r[pi].irradiance.xyz, vec3( 0.0 ) );
				outC = d > radius - 1.0 ? vec4( 0.0, 0.0, 0.0, 1.0 ) : vec4( irr / ( vec3( 1.0 ) + irr ), 1.0 );
			}
		}
	return outC;
}

/// THE FALLBACK OF A PIXEL NO PROBE ANSWERS (7-2): the field's cage at the pixel's point and normal (grid space through
/// the field's world-to-grid rows), at its confidence - and where the confidence fades (past the field's window)
/// the voxel chain's rays answer (jahRayDiffuse: wall-tight by the ray, its sky earned by an escape). It added the
/// environment's diffuse there, unoccluded - the sky through a wall past c0's window in any hall wider than it (PHOTON-7
/// 10-3 R3; L9: a sky read with no visibility is light through a wall) - and for a moment nothing (light by omission
/// on thin geometry: Bistro's curtains). The eye's direction for the sample point's bias: towards the camera, or the
/// view's axis orthographic.
bool gJahFallbackMemo = false;   // one pixel a thread: its fallback is traced once, whichever composition asks
vec3 gJahFallback = vec3( 0.0 );
vec3 fieldFallback( vec3 worldPos, vec3 worldNormal, vec3 toEye )
{
	if( gJahFallbackMemo )
		return gJahFallback;
	const vec3 gridPos = vec3( dot( p.fieldRow0, vec4( worldPos, 1.0 ) ), dot( p.fieldRow1, vec4( worldPos, 1.0 ) ),
							   dot( p.fieldRow2, vec4( worldPos, 1.0 ) ) );
	const vec3 gridNormal = normalize( vec3( dot( p.fieldRow0.xyz, worldNormal ), dot( p.fieldRow1.xyz, worldNormal ),
											 dot( p.fieldRow2.xyz, worldNormal ) ) );
	const vec3 gridView = vec3( dot( p.fieldRow0.xyz, toEye ), dot( p.fieldRow1.xyz, toEye ),
								dot( p.fieldRow2.xyz, toEye ) );
	const uint packed = uint( p.fieldWin.x + 0.5 );
	const JahFieldAnswer a = jahFieldRead( gridPos, gridNormal, gridView,
										   vec3( p.fieldProbes.x, p.fieldWin.y, p.fieldWin.z ),
										   uvec3( packed & 127u, ( packed >> 7u ) & 127u, ( packed >> 14u ) & 127u ),
										   p.fieldProbes.xy, p.fieldDepthAtlas, p.fieldIrradAtlas );
	vec3 r = a.irradiance;
	if( a.confidence < 1.0 && JAH_VOX_COUNT > 0 )
	{
		// THE CHAIN'S RAYS for the share the field does not cover (the screen integrate's construction, in world space)
		const vec3 surfLS = ( worldPos - JAH_VOX_ORIGIN( 0 ).xyz ) * JAH_VOX_INVSIZE( 0 ).xyz;
		const vec3 biasDirLS = jahConeBiasDir( normalize( worldNormal * JAH_VOX_INVSIZE( 0 ).xyz ) );
		r += jahRayDiffuse( surfLS, biasDirLS, jahConeBasisWorld( worldNormal ), kJahPixelDiffuseRays,
							JAH_VOX_INVRES( 0 ).x, ivec4( 0 ), 0.0, 0.0, true ) *
			 ( 1.0 - a.confidence );
	}
	gJahFallbackMemo = true;
	gJahFallback = r;
	return r;
}

/// THE BILINEAR READ'S TAPS (GATHER-1a; one text for the diffuse's own read and the rough specular's lobe, 7-3): the
/// four uniform probes whose cells bracket the pixel (the bracket's weights; a cell off the grid clamps onto the border
/// cell), each weighed by THE PLANE TEST and kept only where the probe is SEEN FROM THE PIXEL ALONG ITS SURFACE (no
/// light through a wall: a floor that runs on under a thin partition is one plane on both sides) - and A CORNER'S
/// ADAPTIVE TWIN (Lumen's GetAdaptiveProbeInterpolationWeight; PHOTON-7 stage 10): where the corner cell has one (it
/// holds a surface its uniform probe is not on), the twin under the same bracket weight and the same two tests, and
/// the corner takes the BETTER of the two. A sliver's pixels then blend the twins of the cells around them as any pixel
/// blends its uniform four (it read only its own cell's twin: one probe's noise, 4.4 x its neighbours' on the
/// residency row's 1-px floor sliver). In that ONE FIXED ORDER. `starved`: a probe with a positive share had no sample
/// this frame (its ray records dropped by a full hit list, rq_probe_filter.comp's irradiance.w -1).
int bilinearTaps( ivec2 c0, vec2 f, ivec2 cell, uint index, ivec2 cellOff, ivec2 gridEye, ivec2 grid, vec3 pixelWorld,
				  vec3 pixelNormal, float pixelDist, vec2 local, JahEye thisEye, int eye, vec2 eyeSize,
				  out uint tapIdx[5], out float tapW[5], out bool starved )
{
	int n = 0;
	starved = false;
	for( int t = 0; t < 5; ++t )
	{
		tapIdx[t] = 0u;
		tapW[t] = 0.0;
	}
	for( int k = 0; k < 4; ++k )
	{
		const ivec2 o = ivec2( k & 1, k >> 1 );
		const ivec2 c = clamp( c0 + o, ivec2( 0 ), gridEye - 1 ) + cellOff;
		const float wb = ( o.x == 1 ? f.x : 1.0 - f.x ) * ( o.y == 1 ? f.y : 1.0 - f.y );
		if( wb <= 0.0 )
			continue;
		const uint probeIndex = uint( c.y * grid.x + c.x );
		float best = 0.0;
		uint bestIdx = 0u;
		// the corner's uniform probe, then its twin; the twin is read only where the uniform is not a perfect answer
		const float link = records.r[probeIndex].normalW.w;
		for( int m = 0; m < 2; ++m )
		{
			if( m == 1 && ( link < 0.5 || best >= wb ) )
				break;
			const uint pi = m == 0 ? probeIndex : uint( link ) - 1u;
			const vec4 posW = records.r[pi].posW;
			starved = starved || ( posW.w > 0.5 && records.r[pi].irradiance.w < -0.5 );
			if( posW.w < 0.5 || records.r[pi].irradiance.w < 0.5 )
				continue;
			const float w = wb * jahPlaneWeight( posW.xyz, records.r[pi].normalW.xyz, pixelWorld, pixelNormal, pixelDist );
			if( w <= best || !seenAlongSurface( pixelWorld, local, posW.xyz, thisEye, eye, eyeSize ) )
				continue;
			best = w;
			bestIdx = pi;
		}
		if( best <= 0.0 )
			continue;
		tapIdx[n] = bestIdx;
		tapW[n] = best;
		++n;
	}
	return n;
}

/// THE LOBE FROM THE PREFILTERED PROBES (7-3; the header's second output): along the lobe's dominant direction d, each
/// tap's prefiltered map - a hemisphere in the probe's own tangent frame (rq_probe_filter.comp's), so d is re-expressed
/// there and read bilinearly inside the probe's block (the sample point clamped half a texel in from the block's edge,
/// which is the hemisphere's horizon) at the two roughness levels around the pixel's, lerped. A probe whose hemisphere
/// does not hold d says nothing and the others renormalise; none holds it, or the taps sum under the weight floor - the
/// pixel's diffuse E/pi.
/// Whether the last lobe read ANSWERED from no probe and returned its fallback (PHOTON-7 stage 10-3, carrier 3: the rough
/// rest takes no sample where that fallback is the diffuse's "no sample" - roughLobeNow sets it, the lobes below).
bool gLobeFellBack = false;

vec3 probeLobe( vec3 N, vec3 V, float roughness, uint tapIdx[5], float tapW[5], int nTap, float floorW, vec3 diffuse )
{
	float tapSum = 0.0;
	for( int t = 0; t < nTap; ++t )
		tapSum += tapW[t];
	if( tapSum < floorW )
		return diffuse;
	const vec3 d = jahEnvDominantDir( N, reflect( -V, N ), roughness * roughness );
	const float levels = max( p.roughLevels.z, 2.0 );
	const float lv = clamp( ( roughness - p.roughLevels.x ) / max( p.roughLevels.y, 1e-4 ), 0.0, levels - 1.0 );
	const float k0 = min( floor( lv ), levels - 2.0 );
	const float fk = lv - k0;
	const float octRes = clamp( p.knobs2.w, 1.0, float( kOctResMax ) );
	const int cols = max( int( p.knobs3.z ), 1 );
	const vec2 atlasSize = vec2( textureSize( prefilteredAtlas, 0 ).xy );
	vec3 acc = vec3( 0.0 );
	float wacc = 0.0;
	for( int t = 0; t < nTap; ++t )
	{
		const uint pi = tapIdx[t];
		const vec3 n = records.r[pi].normalW.xyz;
		vec3 T, B;
		jahTangentFrame( n, T, B );
		const vec3 l = vec3( dot( d, T ), dot( d, B ), dot( d, n ) );
		if( l.z <= 0.0 )
			continue;
		const vec2 block = vec2( float( int( pi ) % cols ), float( int( pi ) / cols ) ) * float( kOctResMax );
		const vec2 at = ( block + clamp( jahOctUv( l ) * octRes, vec2( 0.5 ), vec2( octRes - 0.5 ) ) ) / atlasSize;
		const vec3 L = mix( textureLod( prefilteredAtlas, vec3( at, k0 ), 0.0 ).xyz,
							textureLod( prefilteredAtlas, vec3( at, k0 + 1.0 ), 0.0 ).xyz, fk );
		if( !finite3( L ) )
			continue;
		acc += L * tapW[t];
		wacc += tapW[t];
	}
	gLobeFellBack = !( wacc > 0.0 );
	return wacc > 0.0 ? acc / wacc : diffuse;
}

/// THE ROUGH SPECULAR'S GATE (7-3): 0 where the view's traced reflection owns the lobe (below p.rough.x - p.rough.y:
/// nothing is read), 1 from p.rough.x up (p.rough.x < 0: no traced reflection, 1 everywhere).
float roughGate( float roughness )
{
	return p.rough.x < 0.0 ? 1.0 : smoothstep( p.rough.x - max( p.rough.y, 1e-4 ), p.rough.x, roughness );
}
/// ...and its hand-over to the diffuse E/pi (p.rough.z .. w): 0 the lobe alone, 1 the diffuse alone.
float roughToDiffuse( float roughness )
{
	return clamp( ( roughness - p.rough.z ) / max( p.rough.w - p.rough.z, 1e-4 ), 0.0, 1.0 );
}
/// THE QUADRATURE DOOR'S BRUTE FORCE (a test door, p.roughLevels.w 2; gi.rough_lobe_quadrature): the same taps, each
/// probe's FILTERED map (the layer after the levels) integrated texel by texel against the GGX BRDF at the pixel's own
/// view - D G2 / ( 4 NoV ) times the texel's solid angle (the radiance the split sum's DFG term multiplies is the
/// BRDF-weighted mean, so the weights are normalised) - the split sum's own error is the shipped read against this.
vec3 probeLobeBrute( vec3 N, vec3 V, float roughness, uint tapIdx[5], float tapW[5], int nTap, float floorW, vec3 diffuse )
{
	float tapSum = 0.0;
	for( int t = 0; t < nTap; ++t )
		tapSum += tapW[t];
	if( tapSum < floorW )
		return diffuse;
	const float rc = max( roughness, p.roughLevels.x );
	const float a = rc * rc, a2 = a * a;
	const float NoV = max( dot( N, V ), 1e-4 );
	const int octRes = int( clamp( p.knobs2.w, 1.0, float( kOctResMax ) ) );
	const int cols = max( int( p.knobs3.z ), 1 );
	const float layer = max( p.roughLevels.z, 2.0 );
	vec3 acc = vec3( 0.0 );
	float wacc = 0.0;
	for( int t = 0; t < nTap; ++t )
	{
		const uint pi = tapIdx[t];
		const vec3 n = records.r[pi].normalW.xyz;
		vec3 T, B;
		jahTangentFrame( n, T, B );
		const ivec2 block = ivec2( int( pi ) % cols, int( pi ) / cols ) * kOctResMax;
		vec3 accT = vec3( 0.0 );
		float wT = 0.0;
		for( int k = 0; k < octRes * octRes; ++k )
		{
			const ivec2 tex = ivec2( k % octRes, k / octRes );
			const vec3 o = jahOctPoint( ( vec2( tex ) + 0.5 ) / float( octRes ) );
			const vec3 dl = o / max( length( o ), 1e-6 );
			const vec3 l = normalize( T * dl.x + B * dl.y + n * dl.z );
			const float NoL = dot( N, l );
			if( NoL <= 0.0 )
				continue;
			const vec3 h = normalize( V + l );
			const float NoH = max( dot( N, h ), 0.0 );
			const float dd = NoH * NoH * ( a2 - 1.0 ) + 1.0;
			const float D = a2 / ( 3.14159265 * dd * dd );
			const float G2 = 2.0 * NoL * NoV /
							 ( NoV * sqrt( a2 + ( 1.0 - a2 ) * NoL * NoL ) + NoL * sqrt( a2 + ( 1.0 - a2 ) * NoV * NoV ) );
			const float w = D * G2 / ( 4.0 * NoV ) * jahOctSolidAngle( o, float( octRes ) );
			const vec3 L = texelFetch( prefilteredAtlas, ivec3( block + tex, int( layer ) ), 0 ).xyz;
			if( !( w > 0.0 ) || !finite3( L ) )
				continue;
			accT += L * w;
			wT += w;
		}
		if( !( wT > 0.0 ) )
			continue;
		acc += accT / wT * tapW[t];
		wacc += tapW[t];
	}
	gLobeFellBack = !( wacc > 0.0 );
	return wacc > 0.0 ? acc / wacc : diffuse;
}

/// THIS FRAME'S LOBE where it is read (the gate open, the diffuse not owning it), the diffuse E/pi elsewhere.
vec3 roughLobeNow( vec3 N, vec3 V, float roughness, uint tapIdx[5], float tapW[5], int nTap, float floorW, vec3 diffuse )
{
	gLobeFellBack = true;
	if( !( roughGate( roughness ) > 0.0 ) || roughToDiffuse( roughness ) >= 1.0 )
		return diffuse;
	const vec3 lobe = p.roughLevels.w > 1.5 ? probeLobeBrute( N, V, roughness, tapIdx, tapW, nTap, floorW, diffuse )
											: probeLobe( N, V, roughness, tapIdx, tapW, nTap, floorW, diffuse );
	return clamp( lobe, vec3( 0.0 ), vec3( kMaxRadiance ) );
}
/// THE ROUGH SPECULAR'S TEXEL: rgb the lobe (this frame's, or its mean) handed over to the diffuse, w the gate.
vec4 roughTexel( vec3 lobe, vec3 diffuse, float roughness )
{
	const float gate = roughGate( roughness );
	return gate > 0.0 ? vec4( mix( lobe, diffuse, roughToDiffuse( roughness ) ), gate ) : vec4( 0.0 );
}

void main()
{
	const ivec2 full = ivec2( p.resolution.zw );
	const ivec2 pix = ivec2( gl_GlobalInvocationID.xy );
	if( any( greaterThanEqual( pix, full ) ) )
		return;
	const ivec2 grid = ivec2( p.resolution.xy );
	const float stride = max( p.knobs.x, 1.0 );
	// THE PIXEL'S EYE (PHOTON-GA-VR). Under stereo the probe LIST is two grids:
	// everything below works in the eye's own cells (the right eye's numbered
	// after the left eye's, `cellOff`), so no pixel reads a probe of the other
	// eye. With one eye cellOff = 0 and gridEye = grid: the arithmetic is the
	// one-camera arithmetic exactly.
	// THE EYE IS THE LAYER (LAYERED-STEREO-1): every screen image here is an
	// array with one layer per eye and the dispatch's z walks them, so a pixel's
	// coordinate is its own eye's and the two eyes run the same arithmetic.
	const int eye = int( gl_GlobalInvocationID.z );
	const int eyeW = jahEyeWidth();
	const int lx = pix.x;
	const ivec3 at = ivec3( pix, eye );
	const ivec2 cellOff = ivec2( eye * jahEyeGridW(), 0 );
	const ivec2 gridEye = ivec2( jahEyeGridW(), grid.y );
	const ivec2 cell = clamp( ivec2( vec2( lx, pix.y ) / stride ), ivec2( 0 ), gridEye - 1 ) + cellOff;
	const uint index = uint( cell.y * grid.x + cell.x );
	const JahEye thisEye = jahEyeNow( eye );
	if( p.knobs4.w > 0.5 )
		imageStore( photonOverlay, at,
					photonDisc( pix, lx, cell, cellOff, gridEye, grid, thisEye, eyeW, full, stride ) );

	// The pixel's own surface, from the same prepass the probes were placed on:
	// `uv` over the target (the textures), `local` over the eye's own image (the
	// ray basis) — one number with one eye.
	const vec2 local = ( vec2( pix ) + 0.5 ) / vec2( full );
	const vec3 uv = vec3( local, float( eye ) );
	const float rawDepth = texture( sceneDepth, uv ).x;
	vec3 pixelNormal = vec3( 0.0 );
	vec3 pixelWorld = vec3( 0.0 );
	float pixelDist = 0.0;
	bool pixelValid = false;
	bool pixelFoliage = false;
	if( rawDepth > 0.0 && rawDepth < 1.0 )
	{
		const vec4 gN = texture( gBufNormals, uv );
		// THE SURFACE CLASS (PHOTON-2 stage 2d): the prepass writes 0 in the normals' alpha for foliage
		// (JahGBufClass_piece_ps.any), upstream's 1 elsewhere.
		pixelFoliage = gN.w < 0.5;
		vec3 normalVS = gN.xyz * 2.0 - 1.0;
		if( dot( normalVS, normalVS ) > 1e-6 )
		{
			normalVS = normalize( normalVS );
			pixelNormal = normalize( p.viewAxisX.xyz * normalVS.x + p.viewAxisY.xyz * normalVS.y +
									 p.viewAxisZ.xyz * normalVS.z );
			pixelDist = jahViewDistance( rawDepth );
			pixelWorld = jahWorldAt( thisEye, local, pixelDist );
			pixelValid = finite3( pixelWorld ) && finite3( pixelNormal ) && finite1( pixelDist );
		}
	}
	const bool temporal = p.knobs5.z > 0.5;
	if( !pixelValid )
	{
		// The sky, or a pixel the prepass never drew. No probe answers for it —
		// and nothing should: it has no hemisphere. Its history is "no surface"
		// (a zero word fails every distance test).
		imageStore( probeIrradiance, at, vec4( 0.0 ) );
		imageStore( roughSpec, at, vec4( 0.0 ) );
		if( temporal )
		{
			imageStore( historyCur, at, uvec4( 0u ) );
			imageStore( roughHistoryCur, at, uvec4( 0u ) );
			if( p.knobs6.x >= 1.0 )
			{
				imageStore( restMean, at, vec4( 0.0 ) );
				imageStore( roughRest, at, vec4( 0.0 ) );
			}
		}
		return;
	}

	// ---- THE PIXEL HISTORY (see the header) ---------------------------------
	vec4 prev = vec4( 0.0 );
	uint prevCount = 0u;
	ivec2 histAt = ivec2( 0 );   // the previous texel read (the rough specular's history half is read there too)
	if( temporal && p.knobs5.x >= 1.0 )
	{
		// THROUGH THIS EYE'S PREVIOUS CAMERA, onto this eye's own half of the
		// history, on THE SAME SURFACE only (jah_probe_history.glsl, the filter's
		// reader of the same history).
		uvec2 texel;
		uint wasCount;
		// Lumen's test (jah_probe_history.glsl): the jitter is the pixel's and the view's frame's (the rounding's
		// own PCG, its own salt), the facing the eye's.
		const vec3 toEye = thisEye.perspective < 0.5 ? -thisEye.fwd : normalize( thisEye.camPos - pixelWorld );
		const float NoV = dot( pixelNormal, toEye );
		if( jahHistoryAt( pixelWorld, pixelFoliage, NoV, roundingDither( ivec2( lx, pix.y ), 3u ), eye, texel,
						  wasCount, histAt ) )
		{
			if( gFoliageRuleOnly )
				atomicAdd( gatherCounter.words[1], 1u );
			const vec4 h = vec4( unpackRgbShared( texel.x ), float( texel.y >> 26u ) / 63.0 );
			if( finite3( h.xyz ) && finite1( h.w ) )
			{
				prev = clamp( h, vec4( 0.0 ), vec4( vec3( kMaxRadiance ), 1.0 ) );
				prevCount = wasCount;
			}
		}
	}
	// ---- THE YOUNG HISTORY'S REACH (GATHER-NOISE-1) ---------------------------
	// A pixel whose history is short — new to the screen at an edge the camera
	// turns toward, or uncovered behind a moving silhouette — has averaged only
	// that many frames, and its block of the picture is several times noisier
	// than an old pixel's (the lane's measurement: 2.1 against 0.6 codes on the
	// moving path). It reads the probes of a WIDER neighbourhood: a tent of
	// `young.y` cells at a history of 0, narrowing linearly to the bilinear four
	// (a tent of 1 cell IS the bilinear) at `young.x` frames — the
	// history-length-adaptive filter of SVGF / ReBLUR. Every probe is weighed by
	// the plane test exactly as the bilinear four are, so the wider read never
	// crosses onto another surface; what it trades is a transient spatial blur of
	// the irradiance along the surface, which the history's running mean dilutes
	// frame by frame as the pixel ages (the converged answer is the bilinear's).
	// NEVER AT REST: the rest mean is the shipped estimator's mean, exactly.
	float reach = 1.0;
	if( temporal && p.knobs6.x < 1.0 && float( prevCount ) < p.young.x )
		reach = mix( max( p.young.y, 1.0 ), 1.0, float( prevCount ) / max( p.young.x, 1.0 ) );

	// THE FOUR GRID PROBES AROUND THE PIXEL: the cells whose centres bracket
	// it, and the bilinear weights of that bracket. A cell off the grid clamps
	// onto the border cell (its weight joins the border's).
	// (THE GRID'S JITTER, plane.w 0: the probes sit at cell x stride + the frame's one offset, and the bracket
	// is taken on that shifted grid - rq_probe_place.comp's offset, the same hash; plane.w 1 = the centres)
	vec2 g = ( vec2( lx, pix.y ) + 0.5 ) / stride - 0.5;
	if( p.plane.w < 0.5 )
		g = ( vec2( lx, pix.y ) + 0.5 - ( floor( jahSample2( ivec2( 0 ), 0u, uint( p.knobs.z ) ) * stride ) + 0.5 ) ) / stride;
	const ivec2 c0 = ivec2( floor( g ) );
	const vec2 f = g - vec2( c0 );
	const int bands = p.knobs4.x > 5.0 ? 9 : 4;
	const float weightFloor = max( p.knobs4.y, 1e-6 );

	vec3 sum = vec3( 0.0 );
	float wsum = 0.0;
	// THE DEPTH WALK ON EVERY READ (PHOTON-2 stage 2's tail; 1.6 B4, DEEP_AUDIT photon-diffuse F13): no LIGHT THROUGH
	// A WALL on any read of a neighbouring probe - the bilinear four, the twin and both silhouette steps as the wide
	// young read always did (jah_probe_seen.glsl). A wall thinner than one probe stride on screen (0.1 m at 30 m is
	// ~2.6 px at 1080p) left the coplanar floors on its two sides one plane to the plane test alone.
	const vec2 eyeSize = vec2( float( eyeW ), float( full.y ) );
	// A PROBE WITH NO SAMPLE THIS FRAME (PHOTON-2 stage 2's tail, 1.6 A2): a ray of it was a record a full hit
	// list dropped (rq_probe_filter.comp's irradiance.w -1). It is no reading at all - neither an answer nor the absence
	// of one - so a pixel whose own probes are starved and that no other of them answers takes NO SAMPLE this frame
	// (below: it keeps its history, as a reflection texel with no sample keeps what it holds), never the fallback's
	// share a geometric "no answer" hands on.
	bool starved = false;
	// THE BILINEAR TAPS (bilinearTaps): the diffuse's own read when the history is old enough, and the rough specular's
	// lobe always (a young pixel's diffuse reads the wide neighbourhood below, its lobe these)
	uint tapIdx[5];
	float tapW[5];
	int nTap = 0;
	bool tapsRead = false;
	if( reach > 1.0 )
	{
		// THE WIDE READ: every cell whose centre lies within `reach` cells of the
		// pixel on both axes (cells off the eye's grid are skipped, not clamped),
		// its uniform probe and its adaptive twin, each at the cell's tent weight
		// times its plane weight.
		// PAST TWO CELLS THE READ STEPS BY TWO (the cost: a reach of 4 is 16 probe
		// pairs, not 64): the probes it skips are filtered with the ones it reads
		// (the filter's 3 x 3), so they add little that is independent. WHICH
		// half it reads ALTERNATES frame by frame on each axis, keyed on the
		// PIXEL'S OWN HISTORY COUNT (one more each frame it is read), so the
		// history averages both sets and no fixed tap set flips at a cell
		// boundary (an 8-px step pattern, the fix round's audit) — and a replay
		// of the same frames reads the same sets (keyed on the view's frame
		// counter, app.capture_steps' replay moved by 79 px at 1 code).
		const int stepC = reach > 2.0 ? 2 : 1;
		const uint parity = prevCount;
		const ivec2 own = ivec2( floor( g ) ) + ivec2( int( parity & 1u ), int( ( parity >> 1u ) & 1u ) );
		const int x0 = int( floor( g.x - reach ) ) + 1, x1 = int( floor( g.x + reach ) );
		const int y0 = int( floor( g.y - reach ) ) + 1, y1 = int( floor( g.y + reach ) );
		const int sx = x0 + ( ( ( own.x - x0 ) % stepC ) + stepC ) % stepC;
		const int sy = y0 + ( ( ( own.y - y0 ) % stepC ) + stepC ) % stepC;
		for( int cy = sy; cy <= y1; cy += stepC )
			for( int cx = sx; cx <= x1; cx += stepC )
			{
				if( cx < 0 || cy < 0 || cx >= gridEye.x || cy >= gridEye.y )
					continue;
				const float wt = max( 1.0 - abs( float( cx ) - g.x ) / reach, 0.0 ) *
								 max( 1.0 - abs( float( cy ) - g.y ) / reach, 0.0 );
				if( wt <= 0.0 )
					continue;
				const ivec2 c = ivec2( cx, cy ) + cellOff;
				const uint ui = uint( c.y * grid.x + c.x );
				const float link = records.r[ui].normalW.w;
				for( int k = 0; k < 2; ++k )
				{
					if( k == 1 && link < 0.5 )
						break;
					const uint pi = k == 0 ? ui : uint( link ) - 1u;
					const vec4 posW = records.r[pi].posW;
					starved = starved || ( posW.w > 0.5 && records.r[pi].irradiance.w < -0.5 );
					if( posW.w < 0.5 || records.r[pi].irradiance.w < 0.5 )
						continue;
					float w = wt * jahPlaneWeight( posW.xyz, records.r[pi].normalW.xyz, pixelWorld,
												   pixelNormal, pixelDist );
					// ...AND THE PROBE IS SEEN FROM THE PIXEL ALONG ITS SURFACE: no
					// LIGHT THROUGH A WALL. A floor that runs on under a thin
					// partition is one plane on both sides, so the plane test alone
					// would hand the lit side's probes to the dark side's pixels.
					if( w > 0.0 && !seenAlongSurface( pixelWorld, local, posW.xyz, thisEye, eye, eyeSize ) )
						w = 0.0;
					if( w <= 0.0 )
						continue;
					sum += shEvalAt( pi, pixelNormal, bands ) * w;
					wsum += w;
				}
			}
	}
	else
	{
		// THE BILINEAR FOUR, EACH CORNER ITS UNIFORM PROBE OR ITS TWIN (bilinearTaps), summed in its one fixed order
		nTap = bilinearTaps( c0, f, cell, index, cellOff, gridEye, grid, pixelWorld, pixelNormal, pixelDist, local,
							 thisEye, eye, eyeSize, tapIdx, tapW, starved );
		tapsRead = true;
		for( int t = 0; t < nTap; ++t )
		{
			sum += shEvalAt( tapIdx[t], pixelNormal, bands ) * tapW[t];
			wsum += tapW[t];
		}
	}
	// ---- THE SILHOUETTE RULE (GA-EDGE, the fix round) --------------------------
	// A pixel on a silhouette belongs to the surface it is on, and a thin
	// surface — a block's top seen almost edge-on, a strip a few pixels tall —
	// often has no probe in the four cells around it: every plane test fails and
	// the pixel used to fall to the field's cage, a different estimate (the 1-px
	// bright lines of the selftest's B1). Two widening steps, each only where the
	// last found nothing:
	//   1. a probe ON the pixel's plane in the 5 x 5 cells around it (uniform or
	//      adaptive), weighted by its plane weight over 1 + its cell distance^2 —
	//      the nearest same-surface answer;
	//   2. none on its plane at all: the NEAREST SURFACE — probes within two
	//      strides' world footprint of the pixel's point, the normal set aside
	//      and their SH read at the PIXEL's normal (the band-2 SH carries the
	//      irradiance's variation with the normal; a probe a few centimetres
	//      round the edge is a far closer estimate than the field's cage).
	// (a pixel whose own probes are starved this frame does not go looking further: it takes no sample, below - when it
	// HAS a history to keep; one with none takes the geometric no-answer path with its fallbacks: PHOTON-2 1b H2)
	const bool noSample = starved && wsum < weightFloor && prevCount > 0u;
	if( wsum < weightFloor && !noSample )
	{
		for( int dy = -2; dy <= 2; ++dy )
			for( int dx = -2; dx <= 2; ++dx )
			{
				const ivec2 c = cell + ivec2( dx, dy );
				if( any( lessThan( c, cellOff ) ) || any( greaterThanEqual( c, cellOff + gridEye ) ) )
					continue;
				const uint ui = uint( c.y * grid.x + c.x );
				const float link = records.r[ui].normalW.w;
				for( int k = 0; k < 2; ++k )
				{
					if( k == 1 && link < 0.5 )
						break;
					const uint pi = k == 0 ? ui : uint( link ) - 1u;
					const vec4 posW = records.r[pi].posW;
					if( posW.w < 0.5 || records.r[pi].irradiance.w < 0.5 )
						continue;
					const float w = jahPlaneWeight( posW.xyz, records.r[pi].normalW.xyz, pixelWorld,
													pixelNormal, pixelDist ) /
									( 1.0 + float( dx * dx + dy * dy ) );
					if( w <= 0.0 || !seenAlongSurface( pixelWorld, local, posW.xyz, thisEye, eye, eyeSize ) )
						continue;
					sum += shEvalAt( pi, pixelNormal, bands ) * w;
					wsum += w;
				}
			}
		if( wsum < weightFloor )
		{
			const float pixelWorldSize = length( thisEye.rayDown ) / float( max( full.y, 1 ) ) *
										 ( thisEye.perspective < 0.5 ? 1.0 : pixelDist );
			const float reach = max( 2.0 * stride * pixelWorldSize, 1e-4 );
			for( int dy = -2; dy <= 2; ++dy )
				for( int dx = -2; dx <= 2; ++dx )
				{
					const ivec2 c = cell + ivec2( dx, dy );
					if( any( lessThan( c, cellOff ) ) || any( greaterThanEqual( c, cellOff + gridEye ) ) )
						continue;
					const uint ui = uint( c.y * grid.x + c.x );
					const float link = records.r[ui].normalW.w;
					for( int k = 0; k < 2; ++k )
					{
						if( k == 1 && link < 0.5 )
							break;
						const uint pi = k == 0 ? ui : uint( link ) - 1u;
						const vec4 posW = records.r[pi].posW;
						if( posW.w < 0.5 || records.r[pi].irradiance.w < 0.5 )
							continue;
						// facing the same side: a probe on a surface's BACK is not near it
						if( dot( records.r[pi].normalW.xyz, pixelNormal ) < -0.05 )
							continue;
						const float d = length( posW.xyz - pixelWorld );
						const float w = clamp( 1.0 - d / reach, 0.0, 1.0 );
						if( w <= 0.0 || !seenAlongSurface( pixelWorld, local, posW.xyz, thisEye, eye, eyeSize ) )
							continue;
						sum += shEvalAt( pi, pixelNormal, bands ) * w;
						wsum += w;
					}
				}
		}
	}
	vec4 answer = vec4( 0.0 );
	if( wsum >= weightFloor )
		answer = vec4( clamp( sum / wsum, vec3( 0.0 ), vec3( kMaxRadiance ) ), 1.0 );
	// THE FIELD, COMPOSED (7-2): the eye's direction for its sample point's bias
	const bool composeField = p.fieldWin.w > 0.5;
	const vec3 toEyeField = thisEye.perspective < 0.5 ? -thisEye.fwd : normalize( thisEye.camPos - pixelWorld );
	// THE ROUGH SPECULAR (7-3): the pixel's perceptual roughness (the G-buffer's alpha, decoded as the reflection
	// decodes it); a young pixel's diffuse read the wide neighbourhood - its lobe reads the bilinear taps
	const float roughness =
		sqrt( max( texture( gBufShadowRoughness, uv ).y * 0.999 + 0.001, 1e-6 ) );
	const bool lobeRead = ( p.rough.x < 0.0 || roughness > p.rough.x - max( p.rough.y, 1e-4 ) ) && roughness < p.rough.w;
	if( lobeRead && !tapsRead )
	{
		bool tapStarved;
		nTap = bilinearTaps( c0, f, cell, index, cellOff, gridEye, grid, pixelWorld, pixelNormal, pixelDist, local,
							 thisEye, eye, eyeSize, tapIdx, tapW, tapStarved );
	}
	if( !temporal )
	{
		// THE MEASUREMENT LEVER (the arm "gather.temporal"): this frame's
		// estimate alone, and no history is read or written.
		if( composeField )
			answer = vec4( answer.xyz * answer.w +
							   ( answer.w < 1.0 ? fieldFallback( pixelWorld, pixelNormal, toEyeField ) * ( 1.0 - answer.w )
												: vec3( 0.0 ) ),
						   1.0 );
		imageStore( probeIrradiance, at, answer );
		const vec3 diffuseNow = answer.xyz * answer.w;
		imageStore( roughSpec, at,
					roughTexel( roughLobeNow( pixelNormal, toEyeField, roughness, tapIdx, tapW, nTap, weightFloor,
											  diffuseNow ),
								diffuseNow, roughness ) );
		return;
	}

	// THE COUNT-IN-HISTORY IDIOM (rq_reflect.comp): 1/n while the mean is young
	// — a true running mean, the fastest unbiased convergence — with a floor so
	// it keeps following a scene that changes. A pixel with no usable history
	// (count 0) takes this frame's estimate whole.
	const float floorBlend = clamp( p.knobs5.y, 1.0 / float( kHistoryCountMax ), 1.0 );
	// THE GI FREEZE (M1's measuring arm, stereo.w): a pixel with a history keeps it, no new sample enters.
	// ...and A PIXEL WITH NO SAMPLE THIS FRAME (its probes starved by a full hit list, above) keeps it too.
	const float blend = prevCount > 0u ? ( p.stereo.w > 0.5 || noSample ? 0.0 : max( 1.0 / ( float( prevCount ) + 1.0 ), floorBlend ) )
									   : 1.0;
	const vec4 sample1 = vec4( answer.xyz * answer.w, answer.w );
	vec4 mean = mix( prev, sample1, blend );
	// ---- AT REST, THE REST MEAN (PHOTON-GATHER-1d) ------------------------------
	// The history above is an EMA past its tenth frame, and an EMA never stops:
	// its state is a function of EVERY frame it has seen, so two pictures of one
	// still scene — a screenshot after a long settle and one after a short one —
	// differ, and a still view flickers by the floor's share of each frame's
	// noise forever. At rest the answer becomes a true mean of the rest frames
	// alone (restarted at the first, weight 1/k at the k-th: the sample sequence
	// is the rest frame's own index, so the mean is a function of the scene and
	// the camera and of nothing that happened before), handed over from the EMA
	// linearly over N frames (p.knobs6.y, the settle; no pop when a camera
	// stops), and at k = N the answer IS that mean — after which the host holds
	// the frame and dispatches nothing (OgreScreenProbeGather.cpp): a still view
	// costs the gather nothing. THE HISTORY IS WRITTEN WITH THE HANDED-OVER
	// VALUE, so when the camera moves again the EMA continues from the rest mean
	// and not from the older EMA state it would otherwise pop back to.
	// ...AND THE EMA FEEDS ON THE REST MEAN, NOT THIS FRAME'S SAMPLE (PHOTON-2 stage 2's round, H4 (a)): the
	// hand-over's per-frame change then FALLS as the rest mean converges (its step is 1/k of a sample's deviation),
	// where an EMA still taking each raw sample at its floor kept the settling phase's per-frame noise and added the
	// hand-over's own step on top - the change ROSE at the rest's start (photon-court: 0.12 -> 0.14 codes a frame,
	// Bistro 0.19 -> 0.23). The hand-over's weight starts at 0 on the first rest frame ((k - 1) / (N - 1): that frame
	// steps exactly as a settling one, Bistro's first rest frame jumped 0.18 -> 0.26 at k / N) and reaches 1 at k = N,
	// where the answer is still the rest mean exactly.
	const float restK = p.knobs6.x;
	// (the rest's law, held for the rough specular's rest below: whether this frame's sample enters, and the hand-over)
	bool restTakes = false;
	float restHandover = 0.0;
	// (and the diffuse's REST ANSWER itself, for the rough lobe's fallback during rest - carrier 3, below: w -1 = no
	// rest sample yet)
	vec4 diffuseRest = vec4( 0.0, 0.0, 0.0, -1.0 );
	if( restK >= 1.0 )
	{
		// NO SAMPLE THIS FRAME: the rest mean takes none, and is never SEEDED from the history (PHOTON-2 1b H2: the EMA is
		// path-dependent and the held answer would keep its share) - a starved first rest frame stores "no rest sample
		// yet" (w -1) and the rest mean starts at the pixel's first SAMPLED rest frame, whole. (Until then the answer is
		// the history; the later samples weigh 1 / k of the rest frame - a starved frame is a full list's, rare.)
		// ...and UNDER THE GI FREEZE (stereo.w, PHOTON-2 1b W4) a pixel with a history takes no rest sample either: it keeps
		// its history (the rest mean holds none yet) or its rest mean as it is - no new sample enters anywhere.
		restTakes = !noSample && !( p.stereo.w > 0.5 && prevCount > 0u );
		const vec4 stored = restK < 1.5 ? vec4( 0.0, 0.0, 0.0, -1.0 ) : imageLoad( restMean, at );
		const bool empty = stored.w < -0.5;
		vec4 rest = !restTakes ? stored : empty ? sample1 : mix( stored, sample1, 1.0 / restK );
		// (stored through the half's stochastic rounding: round to nearest drops the increment under half an ulp, and
		// drops it unevenly - the stage 7 read's F5; w, the count's sentinel, is exact)
		if( restTakes ) rest.xyz = jahRestStoreMean( rest.xyz, pix, eye, restK );
		imageStore( restMean, at, rest );
		// AT THE HOLD A PIXEL WITH NO REST SAMPLE IS NO SAMPLE (PHOTON-7 stage 10-3; L8 R2; L1): its pre-rest EMA is an
		// estimate of the PATH - which frames the view traced before its rest began, set by the scene's rest timing and so
		// by another view's state - and the hold froze it (the resize history's row: 14,961 px; a one-pixel sliver, the
		// self-test's fixture B's pillar top, 56 codes). Coverage 0: the field's fallback answers it, below. Before the
		// hold the hand-over still reads the history (its weight reaches the rest mean at k = N).
		const bool starved = rest.w < -0.5 && restK >= p.knobs6.y;
		if( starved )
			atomicAdd( gatherCounter.words[2], 1u );
		const vec4 restAnswer = starved ? vec4( 0.0 ) : rest.w < -0.5 ? prev : rest;
		diffuseRest = rest;
		restHandover = clamp( ( restK - 1.0 ) / max( p.knobs6.y - 1.0, 1.0 ), 0.0, 1.0 );
		mean = mix( mix( prev, restAnswer, blend ), restAnswer, restHandover );
	}
	imageStore( historyCur, at,
				uvec4( packRgbShared( mean.xyz, roundingDither( ivec2( lx, pix.y ), 1u ) ),
					   packGeom( pixelDist, pixelFoliage, noSample && prevCount > 0u ? prevCount : prevCount + 1u, mean.w,
								 roundingDither( ivec2( lx, pix.y ), 2u ) ),
					   0u, 0u ) );
	// The pixel's answer: the answered frames' mean irradiance at the fraction
	// of frames that answered (the piece and the field's cage are both linear in
	// the coverage, so a fraction hands that share to the fallback).
	vec4 outV = vec4( 0.0 );
	if( mean.w > 1e-3 )
		outV = vec4( clamp( mean.xyz / mean.w, vec3( 0.0 ), vec3( kMaxRadiance ) ), mean.w );
	// THE FIELD, COMPOSED AFTER THE MEAN (7-2): the answered frames' irradiance at their share (the premultiplied mean,
	// as the pass took it: rgb x w) plus the field's fallback for the rest; w 1
	if( composeField )
	{
		const float cover = clamp( outV.w, 0.0, 1.0 );
		outV = vec4( outV.xyz * cover +
						 ( cover < 1.0 ? fieldFallback( pixelWorld, pixelNormal, toEyeField ) * ( 1.0 - cover ) : vec3( 0.0 ) ),
					 1.0 );
	}
	// ---- THE ROUGH SPECULAR (7-3; the header's second output) -----------------
	// This frame's lobe (its fallback the pixel's diffuse E/pi as the shading pass takes it: the composed answer)
	// through the diffuse's own blend, and at
	// rest the diffuse's rest law word for word; then the hand-over to the diffuse and the gate.
	{
		const vec3 diffuseOut = outV.xyz * outV.w;
		// THE LOBE's FALLBACK DURING REST IS THE DIFFUSE's REST ANSWER (PHOTON-7 stage 10-3, carrier 3; L8 R2 at the seam,
		// the lead's ruling): where no probe answers the lobe it takes the pixel's diffuse - and during rest that is the
		// diffuse REST answer (its rest mean, composed with the field as the shading pass takes it), or NO SAMPLE where the
		// diffuse has none yet; never the hand-over's composition (diffuseOut before the hold), which carries the pre-rest
		// EMA - the path - into the rough rest mean, sample after sample.
		vec3 lobeFallback = diffuseOut;
		bool fallbackNone = false;
		if( restK >= 1.0 )
		{
			if( diffuseRest.w < -0.5 )
				fallbackNone = true;
			else
			{
				vec4 r = vec4( 0.0 );
				if( diffuseRest.w > 1e-3 )
					r = vec4( clamp( diffuseRest.xyz / diffuseRest.w, vec3( 0.0 ), vec3( kMaxRadiance ) ), diffuseRest.w );
				if( composeField )
				{
					const float cover = clamp( r.w, 0.0, 1.0 );
					r = vec4( r.xyz * cover +
								  ( cover < 1.0 ? fieldFallback( pixelWorld, pixelNormal, toEyeField ) * ( 1.0 - cover )
												: vec3( 0.0 ) ),
							  1.0 );
				}
				lobeFallback = r.xyz * r.w;
			}
		}
		const vec3 lobe = roughLobeNow( pixelNormal, toEyeField, roughness, tapIdx, tapW, nTap, weightFloor, lobeFallback );
		// (a lobe that fell back to a diffuse with no rest sample is no sample: the rough rest takes none this frame)
		const bool lobeTakes = restTakes && !( gLobeFellBack && fallbackNone );
		bool roughStarved = false;
		const vec3 prevLobe =
			prevCount > 0u ? unpackRgbShared( imageLoad( roughHistoryPrev, ivec3( histAt, eye ) ).x ) : vec3( 0.0 );
		vec3 meanLobe = mix( prevLobe, lobe, blend );
		if( restK >= 1.0 )
		{
			const vec4 stored = restK < 1.5 ? vec4( 0.0, 0.0, 0.0, -1.0 ) : imageLoad( roughRest, at );
			vec4 rest = !lobeTakes ? stored
							  : stored.w < -0.5 ? vec4( lobe, 1.0 )
												: mix( stored, vec4( lobe, 1.0 ), 1.0 / restK );
			// (the diffuse rest mean's stochastic store, its own draws: R1, F5)
			if( lobeTakes ) rest.xyz = jahRestStoreMean( rest.xyz, pix, eye + 2, restK );
			imageStore( roughRest, at, rest );
			// (the diffuse's law at the hold: no rest sample is NO SAMPLE - the rough specular's weight 0, below, so the
			// probe or the sky answers the lobe)
			roughStarved = rest.w < -0.5 && restK >= p.knobs6.y;
			if( roughStarved )
				atomicAdd( gatherCounter.words[3], 1u );
			const vec3 restAnswer = rest.w < -0.5 ? prevLobe : rest.xyz;
			meanLobe = mix( mix( prevLobe, restAnswer, blend ), restAnswer, restHandover );
		}
		meanLobe = finite3( meanLobe ) ? clamp( meanLobe, vec3( 0.0 ), vec3( kMaxRadiance ) ) : vec3( 0.0 );
		imageStore( roughHistoryCur, at,
					uvec4( packRgbShared( meanLobe, roundingDither( ivec2( lx, pix.y ), 4u ) ), 0u, 0u, 0u ) );
		imageStore( roughSpec, at, roughStarved ? vec4( 0.0 ) : roughTexel( meanLobe, diffuseOut, roughness ) );
	}
	// THE HISTORY-AGE VIEW (GatherTuning::ageView, an instrument; p.stereo.z):
	// magenta where the reprojected history held fewer than N frames.
	if( p.stereo.z > 0.5 )
		outV = float( prevCount ) < p.stereo.z ? vec4( 0.5, 0.0, 0.5, 1.0 ) : vec4( 0.0, 0.0, 0.0, 1.0 );
	imageStore( probeIrradiance, at, outV );
}
