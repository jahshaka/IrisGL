#define JAH_VOX_INVRES( c ) ( JAH_VOX_INVSIZE( c ).xyz * JAH_VOX_INVSIZE( c ).w )
// cascade c - 1's normalised space to cascade c's, from the two boxes (the chain's table, derived)
#define JAH_VOX_FROM_PREV_SCALE( c ) vec4( JAH_VOX_INVSIZE( c ).xyz / JAH_VOX_INVSIZE( (c) - 1 ).xyz, 0.0 )
