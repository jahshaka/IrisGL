#version 460
// PHOTON R1 — THE RAY BATCH. One inline hardware ray query per invocation
// against the scene's TLAS, answering the only question this tier exists to
// answer: what does this ray hit, and how far away is it.
//
// It is deliberately GEOMETRY ONLY — no material, no shading, no light. This
// is the record-driven form (the tool/test trace, OgreScene::traceRays); the
// frame's consumers each ask the same question in their own job:
// rq_sun_contact.comp (R3, one ray towards the sun per pixel), the gather's
// trace and rq_reflect.comp (R5). Radiance AT the hit is a separate question
// with its own answer (the cascade's lit voxels) and is not this shader's
// business.
//
// NOTE FOR ANY EDIT: this is compiled AT BUILD TIME by glslangValidator at
// --target-env spirv1.4 (SPV_KHR_ray_query's documented requirement) into a
// generated header. Ogre's own GLSL path never sets a target environment
// (OgreVulkanProgram.cpp: setEnvClient/setEnvTarget are commented out), which
// is why this does not go through Ogre's shader compiler at all.
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

layout( local_size_x = 64, local_size_y = 1, local_size_z = 1 ) in;

layout( set = 0, binding = 0 ) uniform accelerationStructureEXT tlas;

/// One ray. `origin.w` is tMin, `dir.w` is tMax, `mask.x` is the instance mask
/// the ray asks for (Types.h `kRayMask*`: bit 0 a shadow caster, bit 1 a mover,
/// bit 2 still world — audit C-15's per-consumer masks — bit 3 every NEAR copy,
/// bit 4 the FAR copies over each mesh's coarsest level, ATOM-FARBLAS-1).
struct Ray
{
    vec4  origin;
    vec4  dir;
    uvec4 mask;
};
layout( std430, set = 0, binding = 1 ) readonly buffer Rays { Ray r[]; } rays;

/// One answer: x = distance to the first hit (< 0 = miss), y = the hit
/// instance's customIndex (the node's slot in the scene's item index),
/// z = the hit primitive index inside its geometry, w = 1 on a hit, 0 on a miss.
layout( std430, set = 0, binding = 2 ) writeonly buffer Hits { vec4 h[]; } hits;

layout( set = 0, binding = 3 ) uniform Params
{
    uvec4 counts;   // x = how many rays are in the batch
    uvec4 alpha;    // xy = the alpha table's device address (REFLECT-MOVERS-2), 0 = none
} p;

#define JAH_ALPHA_TABLE p.alpha.xy
#include "jah_rq_alpha.glsl"

void main()
{
    const uint id = gl_GlobalInvocationID.x;
    if( id >= p.counts.x )
        return;

    const Ray ray = rays.r[id];

    // ONE FIELD PER RAY. Every object is in the TLAS twice (a near copy and a
    // far copy, A5b §4), so a mask naming both would let one object answer one
    // ray twice at two slightly different surfaces. A record asks for the FAR
    // copies by naming bit 4 and none of bits 0-3; anything else is a near ray
    // and keeps only its near bits (0xFF = the whole near field).
    const uint kNearField = 0x0Fu, kFar = 0x10u;
    const uint asked = ray.mask.x;
    const uint cull = ( asked & kNearField ) != 0u ? ( asked & kNearField ) : ( asked & kFar );

    rayQueryEXT rq;
    rayQueryInitializeEXT( rq, tlas, jahAlphaRayFlags( gl_RayFlagsNoneEXT ), cull, ray.origin.xyz,
                           ray.origin.w, ray.dir.xyz, ray.dir.w );
    // THE CANDIDATE LOOP (REFLECT-MOVERS-2): every BLAS is opaque, so an opaque
    // triangle commits inside the traversal; an alpha-tested item's instance is
    // FORCE_NO_OPAQUE and its candidates are confirmed where its mask is solid.
    JAH_RQ_PROCEED( rq )

    vec4 answer = vec4( -1.0, -1.0, -1.0, 0.0 );
    if( rayQueryGetIntersectionTypeEXT( rq, true ) ==
        gl_RayQueryCommittedIntersectionTriangleEXT )
    {
        answer.x = rayQueryGetIntersectionTEXT( rq, true );
        answer.y = float( rayQueryGetIntersectionInstanceCustomIndexEXT( rq, true ) );
        answer.z = float( rayQueryGetIntersectionPrimitiveIndexEXT( rq, true ) );
        answer.w = 1.0;
    }
    hits.h[id] = answer;
}
