#version 460
#extension GL_GOOGLE_include_directive : require
// THE HIT WRITE-BACK (PHOTON-HIT-SHADE-1; SPECS/atom/D2_HIT_SHADING_DESIGN.md
// section 2.3 with the lead's F3).
//
// The ray jobs appended every hit the caches could not shade to a compacted list
// (jah_rq_hit_record.glsl); HlmsAtom's decode in hit mode shaded each record into
// `jahHitRadiance` (one fragment per record, w = 1 where it shaded); this job
// scatters that radiance back to where each ray's answer lives, through the SAME
// arithmetic a card- or voxel-lit hit takes:
//
//   * THE REFLECTION: the texel's SAMPLE of this frame (PHOTON-2 1b; PHOTON-7 stage 6:
//     rgb = the radiance, w = the hit's distance). The trace left the sample empty;
//     here the decoded radiance becomes that sample - the resolve and the temporal
//     pass, after this, take it like a traced one.
//   * THE GATHER: the ray's atlas texel, radiance x the texel re-weight from the
//     record (rq_probe_gather.comp's `reweight`), its distance kept.
//
//   * THE REFLECTION'S RECORD RUNS (PHOTON-7 stage 6, the lead's ruling after the S
//     diagnostic): a resting texel's batch hands its records to the list as ONE
//     contiguous run in sample order (a negative weight, rq_reflect.comp: its magnitude
//     the ray's share, 1 unblended; a BLENDED record's screen share in its words 4-5,
//     and the fold takes the WHOLE sample, vouch x screen + ray share x ray); the run's
//     HEAD folds the whole run into the texel's rest mean, in that order, by the fold
//     the trace makes of the caches' answers (jah_reflect_rest.glsl jahRestFold), in
//     the denoiser space the trace ran at (the list's words 5 and 6).
//
// A record the decode could not shade (w = 0: a material HlmsAtom serves no twin
// for, a stale slot) takes the dropped record's answer: the reflection's sample
// stays empty (no sample: the resolve and the temporal pass keep the texel's
// history); the gather's ray stays at zero radiance; a run's record is skipped
// (counted, the list's word 7: its sample index is lost).
//
// ONE THREAD PER RECORD SLOT, records [0, min( count, capacity )). Every record owns
// its destination texel (a texel's frame sample, or its run's head), so nothing races.
//
// COMPILED AT BUILD TIME by glslangValidator at --target-env spirv1.4, like
// every ray job beside it.
layout( local_size_x = 64, local_size_y = 1, local_size_z = 1 ) in;

layout( set = 0, binding = 0 ) uniform Params
{
	/// x = the list's capacity, y = its grid width, z = 1 when the reflection's
	/// history is bound, w = 1 when the gather's atlas is bound.
	vec4 list;
	/// THE MEDIA ALONG A REFLECTION (PHOTON-I-1 fix 5): OgreScene::fogAlong's
	/// eight, the reflection's own (jah_fog_along.glsl).
	vec4 fog[8];
} p;
/// The list's buffer: [0] the records appended, then the records' words from
/// word 12, ten a record (jah_rq_hit_record.glsl kJahHitAuxBase, kJahHitAuxWords) —
/// this job reads the weight (the gather's re-weight; the reflection's records carry
/// their ray's share), the fog's two, a run record's screen share and the NEE delta (PHOTON-7 11-1b).
layout( std430, set = 0, binding = 1 ) buffer JahHitBuf { uint jahHitBuf[]; };
layout( set = 0, binding = 2 ) uniform usampler2D jahHitDest;
layout( set = 0, binding = 3 ) uniform sampler2D jahHitRadiance;
layout( rgba16f, set = 0, binding = 4 ) uniform image2D probeAtlas;
/// The list's records (the ray's direction, jah_rq_hit_record.glsl) and the air's
/// table — the reflection's fog along its ray (PHOTON-I-1 fix 5).
layout( rgba32ui, set = 0, binding = 5 ) uniform readonly uimage2D jahHitIds;
layout( set = 0, binding = 6 ) uniform sampler3D fogAerial;
/// THE REFLECTION'S SAMPLE (PHOTON-2 1b): what a shaded record writes (rq_reflect.comp's `reflectSample`).
/// A BLENDED sample's record (weight < 1, rq_reflect.comp's (1)): the trace wrote the screen's share, this job adds
/// the ray's - so the image is read here too.
layout( rgba16f, set = 0, binding = 7 ) uniform image2DArray reflectSample;
/// THE REST'S IN-PLACE HALVES a record run folds into (rq_reflect.comp's own bindings 6-9: the frozen half H with the
/// residual, the rest mean M, the state this frame and last).
layout( rgba16f, set = 0, binding = 8 ) uniform image2DArray historyCur;
layout( rgba16f, set = 0, binding = 9 ) uniform image2DArray historyPrev;
layout( rg32ui, set = 0, binding = 10 ) uniform uimage2DArray stateCur;
layout( rg32ui, set = 0, binding = 11 ) uniform readonly uimage2DArray statePrev;
#define JAH_FOG_P( k ) p.fog[k]
#define JAH_FOG_AERIAL( uvw ) textureLod( fogAerial, uvw, 0.0 )
#define JAH_FOG_HAS_AIR
#define JAH_FOG_HAS_HEIGHT_FOG
#include "jah_half_round.glsl"   // the fp16 store truncates on NVIDIA 595.x: every half-float store rounds first
#include "jah_atmosphere.glsl"
#include "jah_height_fog.glsl"
#include "jah_fog_along.glsl"
#include "jah_atlas_sample.glsl"

/// The record's direction (jahOctEncode, inverted): the one text.
#include "jah_oct_dir.glsl"

/// kMaxRadiance and finite3: the one copy (jah_rq_finite.glsl).
#include "jah_rq_finite.glsl"
/// THE REST'S FOLD (jah_reflect_rest.glsl) in the trace's denoiser space (its exposure: the list's word 5).
float gExposure = 1.0;
#define JAH_DENOISE_EXPOSURE gExposure
#include "jah_reflect_denoise.glsl"
#include "jah_reflect_rest.glsl"
#include "jah_reflect_state.glsl"
const uint kDestGather = 0x80000000u;
/// jah_rq_hit_record.glsl kJahHitAuxBase and kJahHitAuxWords.
const uint kAuxBase = 12u;
const uint kAuxWords = 10u;

void main()
{
	const uint capacity = uint( p.list.x );
	// THE RECORD INDEX over a 2D grid of groups: a list at 4K holds 4.7 M records,
	// past the 65,535 groups Vulkan guarantees on one axis.
	const uint i = ( gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x ) * 64u + gl_LocalInvocationID.x;
	if( i >= min( jahHitBuf[0], capacity ) )
		return;
	const uint w = max( uint( p.list.y ), 1u );
	const ivec2 at = ivec2( int( i % w ), int( i / w ) );
	const uint dest = texelFetch( jahHitDest, at, 0 ).x;
	// The record's words (jah_rq_hit_record.glsl: kJahHitAuxBase 12, ten a record).
	const uint aux = kAuxBase + kAuxWords * i;
	const float weight = uintBitsToFloat( jahHitBuf[aux + 1u] );
	const vec4 rad = texelFetch( jahHitRadiance, at, 0 );
	const bool shaded = rad.w > 0.5 && finite3( rad.xyz );
	const vec3 radiance = shaded ? clamp( rad.xyz, vec3( 0.0 ), vec3( kMaxRadiance ) ) : vec3( 0.0 );
	const ivec2 xy = ivec2( int( dest & 0x7FFFu ), int( ( dest >> 15u ) & 0x7FFFu ) );
	if( ( dest & kDestGather ) != 0u )
	{
		if( p.list.w < 0.5 || any( greaterThanEqual( xy, imageSize( probeAtlas ) ) ) )
			return;
		// AN UNSHADED RECORD IS NO SAMPLE (PHOTON-2 1b H3), never a black ray at its hit's distance: the texel's distance
		// becomes kAtlasNoSample, which keeps it out of the filter and the SH sums like a dropped record.
		const vec4 texel = imageLoad( probeAtlas, xy );
		// (ADDED to what the trace wrote: the crossed panes' own light, PHOTON-7 10-4 R7 - 0 where no pane was crossed)
		imageStore( probeAtlas, xy, jahRoundHalf( shaded ? vec4( min( texel.xyz + radiance * weight, vec3( kMaxRadiance ) ), texel.w )
										   : vec4( 0.0, 0.0, 0.0, kAtlasNoSample ) ) );
		return;
	}
	// A texel outside the image is never written (no robustness on this device:
	// an out-of-range store is undefined).
	// THE EYE'S LAYER (bit 30, LAYERED-STEREO-1): the reflection's history is an
	// array with one layer per eye.
	const ivec3 at3 = ivec3( xy, int( ( dest >> 30u ) & 1u ) );
	if( p.list.z < 0.5 || any( greaterThanEqual( at3, imageSize( reflectSample ) ) ) )
		return;
	// A RECORD RUN (weight < 0): its head folds it whole, the rest of the run return.
	if( weight < 0.0 )
	{
		if( i > 0u )
		{
			const uint ip = i - 1u;
			if( uintBitsToFloat( jahHitBuf[kAuxBase + kAuxWords * ip + 1u] ) < 0.0 &&
				texelFetch( jahHitDest, ivec2( int( ip % w ), int( ip / w ) ), 0 ).x == dest )
				return;
		}
		gExposure = uintBitsToFloat( jahHitBuf[5] );
		const float N = uintBitsToFloat( jahHitBuf[6] );
		JahReflectState st = jahStateUnpack( imageLoad( stateCur, at3 ).xy );
		// THE TEXEL'S REST MEAN AS THE TRACE LEFT IT (rq_reflect.comp's batch: the same three stores, the same rule)
		const vec4 Hr = imageLoad( historyPrev, at3 );
		const bool hasH = finite3( Hr.xyz ) && jahStateUnpack( imageLoad( statePrev, at3 ).xy ).N > 0.0;
		const vec4 Mt = imageLoad( historyCur, at3 );
		uint v = st.v;
		JahRestStats rs;
		rs.M = v > 0u && finite3( Mt.xyz ) ? Mt.xyz : ( hasH ? Hr.xyz : vec3( 0.0 ) );
		rs.m2 = v > 0u && finite1( Mt.w ) ? Mt.w : 0.0;
		rs.res = jahRestHasResidual( float( v ), hasH, N ) && finite3( Hr.xyz ) && finite1( Hr.w ) ? Hr : vec4( 0.0 );
		float restT = st.hitT;
		const uint last = min( jahHitBuf[0], capacity );
		uint lost = 0u;
		for( uint j = i; j < last; ++j )
		{
			const ivec2 atj = ivec2( int( j % w ), int( j / w ) );
			const uint auxj = kAuxBase + kAuxWords * j;
			const float wj = uintBitsToFloat( jahHitBuf[auxj + 1u] );
			if( j > i && ( texelFetch( jahHitDest, atj, 0 ).x != dest || !( wj < 0.0 ) ) )
				break;
			// THE SAMPLE WHOLE: the screen's share (words 4-5: vouch x its radiance, vouch x its distance; 0 unblended)
			// and the ray's, its share the weight's magnitude - or, unshaded, the screen's answer whole (the frame
			// sample's rule below); an unshaded record with no screen share is no sample (counted).
			const float rayShare = min( -wj, 1.0 );
			const vec2 s01 = unpackHalf2x16( jahHitBuf[auxj + 4u] );
			const vec2 s23 = unpackHalf2x16( jahHitBuf[auxj + 5u] );
			const vec4 screenShare = vec4( s01, s23 );
			const vec4 radj = texelFetch( jahHitRadiance, atj, 0 );
			vec3 sampleJ;
			float tj;
			if( radj.w > 0.5 && finite3( radj.xyz ) )
			{
				// (the media along the ray, as the frame sample's write-back below)
				const vec3 dirj = jahOctDecodeDir( unpackSnorm2x16( imageLoad( jahHitIds, atj ).w ) );
				const vec2 lengthsj = unpackHalf2x16( jahHitBuf[auxj + 3u] );
				const vec3 fogged = jahFogAlong( clamp( radj.xyz, vec3( 0.0 ), vec3( kMaxRadiance ) ),
												 uintBitsToFloat( jahHitBuf[auxj + 2u] ), dirj, lengthsj.x, lengthsj.y );
				// (+ the NEE delta, PHOTON-7 11-1b: the NEE part less the BRDF's share of the emission it found)
				// (and the ray share at the estimator's gain, PHOTON-7 11-2 (1): the screen share and the delta carry theirs)
				// (through the panes the ray crossed, words 8-9 - F6: their own light, in front, plus the throughput x what
				// originates beyond them - the hit's fogged radiance and the NEE delta, which lives at the hit)
				const vec2 dj01 = unpackHalf2x16( jahHitBuf[auxj + 6u] );
				const vec2 dj2g = unpackHalf2x16( jahHitBuf[auxj + 7u] );
				const vec3 deltaJ = vec3( dj01, dj2g.x );
				const float gainJ = finite1( dj2g.y ) ? dj2g.y : 0.0;
				const vec4 paneJ = vec4( unpackHalf2x16( jahHitBuf[auxj + 8u] ), unpackHalf2x16( jahHitBuf[auxj + 9u] ) );
				sampleJ = screenShare.xyz + rayShare * gainJ * ( paneJ.xyz + paneJ.w * fogged ) +
						  paneJ.w * ( finite3( deltaJ ) ? deltaJ : vec3( 0.0 ) );
				tj = max( screenShare.w + rayShare * max( lengthsj.x, 1e-3 ), 1e-3 );
			}
			else if( rayShare < 1.0 )
			{
				sampleJ = screenShare.xyz / max( 1.0 - rayShare, 1e-6 );
				tj = max( screenShare.w / max( 1.0 - rayShare, 1e-6 ), 1e-3 );
			}
			else
			{
				++lost;
				continue;
			}
			jahRestFold( rs, clamp( sampleJ, vec3( 0.0 ), vec3( kMaxRadiance ) ), float( v ) );
			++v;
			restT = v > 1u && restT > 0.0 ? max( restT + ( tj - restT ) / float( v ), 1e-3 ) : tj;
		}
		if( lost > 0u )
			atomicAdd( jahHitBuf[7], lost );
		if( v > st.v )
		{
			imageStore( historyCur, at3, jahRoundHalf( vec4( rs.M, rs.m2 ) ) );
			if( jahRestHasResidual( float( v ), hasH, N ) )
				imageStore( historyPrev, at3, jahRoundHalf( rs.res ) );
			st.v = v;
			st.hitT = restT;
			imageStore( stateCur, at3, uvec4( jahStatePack( st ), 0u, 0u ) );
		}
		return;
	}
	// THE BLEND (rq_reflect.comp's (1), every sample): a record of weight under 1 is the RAY'S SHARE of a sample the
	// screen half vouched for - the trace wrote the screen's share (1 - weight) of the radiance and the distance; this
	// adds the ray's, or, unshaded, leaves the screen's answer whole (its share renormalised), never a sample short of
	// one. A whole record (weight 1) is written as it always was.
	const bool share = weight < 1.0;
	if( shaded )
	{
		// THE MEDIA ALONG THE REFLECTION (PHOTON-I-1): the decoded light crossed the
		// ray's length before the surface reflected it — the RECORD carries the ray's
		// origin height and length — and rq_reflect.comp fogs a card's, a voxel's
		// and the sky's the same way.
		const vec3 dir = jahOctDecodeDir( unpackSnorm2x16( imageLoad( jahHitIds, at ).w ) );
		const float originY = uintBitsToFloat( jahHitBuf[aux + 2u] );
		const vec2 lengths = unpackHalf2x16( jahHitBuf[aux + 3u] );
		// (through the panes the ray crossed, words 8-9: their light plus the throughput x the hit's - the one read's F6)
		const vec4 pane = vec4( unpackHalf2x16( jahHitBuf[aux + 8u] ), unpackHalf2x16( jahHitBuf[aux + 9u] ) );
		const vec3 fogged = pane.xyz + pane.w * jahFogAlong( radiance, originY, dir, lengths.x, lengths.y );
		const vec4 was = share ? imageLoad( reflectSample, at3 ) : vec4( 0.0 );
		// THE NEE DELTA (PHOTON-7 11-1b, the preflight's gap G3): the NEE part less the BRDF's share ( 1 - v ) ( 1 - w_b )
		// E T of the emission this hit holds - added to the shaded sample (an unshaded one is the screen's whole or none)
		const vec2 d01 = unpackHalf2x16( jahHitBuf[aux + 6u] );
		const vec2 d2g = unpackHalf2x16( jahHitBuf[aux + 7u] );
		vec3 delta = vec3( d01, d2g.x );
		// (it lives at the hit, beyond the panes the ray crossed: their throughput attenuates it, as the run composite's)
		delta = pane.w * ( finite3( delta ) ? delta : vec3( 0.0 ) );
		// THE ESTIMATOR's GAIN (PHOTON-7 11-2 (1), the record's word): the decoded ray share at the draw's gain - the
		// screen's share the trace wrote and the delta carry theirs already
		const float gain = finite1( d2g.y ) ? d2g.y : 0.0;
		imageStore( reflectSample, at3,
					jahRoundHalf( share ? vec4( max( was.xyz + weight * gain * fogged + delta, vec3( 0.0 ) ),
								  was.w + weight * max( lengths.x, 1e-3 ) )
						  : vec4( max( gain * fogged + delta, vec3( 0.0 ) ), max( lengths.x, 1e-3 ) ) ) );
	}
	else if( share )
	{
		const vec4 was = imageLoad( reflectSample, at3 );
		imageStore( reflectSample, at3, jahRoundHalf( was / max( 1.0 - weight, 1e-6 ) ) );
	}
}
