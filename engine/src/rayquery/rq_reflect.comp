/// THE PHOTON VIEW'S OVERLAY (PHOTON-VIEW-1, binding 37): with p.stereo.z = 1 (the
/// scene's view is Hits) every traced texel writes, over its block of the full-
/// resolution overlay, the colour of what shaded its ray — or a dim veil where no
/// ray was traced. Written ONLY under the knob, and nothing else here reads it:
/// the reflection's own images and arithmetic are untouched by the view. With the
/// knob off the binding holds a stand-in (the reflection target's own view) that
/// is never written.
layout( rgba16f, set = 0, binding = 38 ) uniform writeonly image2DArray photonOverlay;
const vec4 kPhotonNoRay   = vec4( 0.0, 0.0, 0.0, 0.6 );
const vec4 kPhotonCard    = vec4( 0.1, 0.9, 0.2, 1.0 );
const vec4 kPhotonVoxel   = vec4( 0.15, 0.35, 1.0, 1.0 );
const vec4 kPhotonSky     = vec4( 0.2, 0.95, 1.0, 1.0 );
const vec4 kPhotonList    = vec4( 1.0, 0.2, 1.0, 1.0 );
const vec4 kPhotonDropped = vec4( 1.0, 0.1, 0.05, 1.0 );
const vec4 kPhotonRest    = vec4( 0.35, 0.35, 0.35, 1.0 );   // a texel that STOPPED at rest (R1): no ray
const vec4 kPhotonScreen  = vec4( 1.0, 0.85, 0.1, 1.0 );    // the screen trace answered (PHOTON-7 stage 6)
/// (Under the edge-class overlay the source colours give way to the class colour,
/// written with w = 2.5 so it passes here, and stored at 1.)
void photonHit( ivec2 tc, vec4 c )
{
	if( p.stereo.z < 0.5 || ( p.alpha.z > 0.5 && c.w >= 1.0 && c.w < 2.0 ) )
		return;
	c.w = min( c.w, 1.0 );
	const ivec2 full = ivec2( p.resolution.zw );
	const ivec2 traceRes = max( ivec2( p.resolution.xy ), ivec2( 1 ) );
	const ivec2 scale = max( full / traceRes, ivec2( 1 ) );
	// The LAST texel of a row or column covers the remainder too (a target that is
	// not a whole number of blocks): every pixel of the overlay is written.
	const ivec2 lo = tc * scale;
	const ivec2 hi = min( mix( lo + scale, full, greaterThanEqual( tc, traceRes - 1 ) ), full );
	for( int y = lo.y; y < hi.y; ++y )
		for( int x = lo.x; x < hi.x; ++x )
			imageStore( photonOverlay, ivec3( ivec2( x, y ), gEye ), jahRoundHalf( c ) );
}
