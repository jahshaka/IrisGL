/// THE CHANGED-REGION LIST (PHOTON-7 8B, B2: jah_rest_regions.glsl; OgreRayQuery.cpp kReflectRegionsBinding) and THE
/// BRICK MASKS, one binding a cascade in the hit set's order (stand-ins where none is this frame's: restBrickDims.w 0).
#define JAH_REST_REGIONS_BINDING 57
#include "jah_rest_regions.glsl"
layout( std430, set = 0, binding = 58 ) readonly buffer JahRestBricks0 { uint w[]; } restBricks0;
layout( std430, set = 0, binding = 59 ) readonly buffer JahRestBricks1 { uint w[]; } restBricks1;
layout( std430, set = 0, binding = 60 ) readonly buffer JahRestBricks2 { uint w[]; } restBricks2;
layout( std430, set = 0, binding = 61 ) readonly buffer JahRestBricks3 { uint w[]; } restBricks3;
/// THE REFINEMENT (binding 62, jah_reflect_rest.glsl kRefine*): the trace marks an estimate-only reach of any texel at rest
/// (kRefineReach, this frame's), and counts a stopped texel still refining as active.
layout( rgba32ui, set = 0, binding = 62 ) uniform uimage2DArray restRefine;
/// A BRICK's CHANGE this frame by its CAUSE (PHOTON-7 8B, the lead's ruling): 2 its DIRECT word moved (word 0: the most
/// a voxel's direct term changed in the frame's injections - the direct term moves only when a light, a shadow or the
/// geometry does: the world changing, over every frame its injection is spread across), 1 only its FEEDBACK word moved
/// (word 1: the store relighting toward its fixed point - an estimate converging), 0 none. A NaN word is a change.
uint restBrickChange( uint c, uint idx )
{
	uint a = 0u, b = 0u;
	if( c == 0u ) { a = restBricks0.w[2u * idx]; b = restBricks0.w[2u * idx + 1u]; }
	else if( c == 1u ) { a = restBricks1.w[2u * idx]; b = restBricks1.w[2u * idx + 1u]; }
	else if( c == 2u ) { a = restBricks2.w[2u * idx]; b = restBricks2.w[2u * idx + 1u]; }
	else { a = restBricks3.w[2u * idx]; b = restBricks3.w[2u * idx + 1u]; }
	if( jahBrickChangedWords( a, 0u ) )
		return 2u;
	return jahBrickChangedWords( 0u, b ) ? 1u : 0u;
}
/// A SEGMENT THE TRACED GEOMETRY CHANGED ACROSS THIS FRAME (G6; B2): origin o, unit direction d, length t, against the
/// list's MOVERS - a moved, staged or posed slot's swept box (its bounds this frame and last, joined: every transform
/// write, flags change and birth of a ray-tier slot is one, OgreEngine::listRayMovers). An EDIT is the STORE's geometry
/// (a region rebuild's voxel cells, up to a coarse cascade's whole box) or a material: what a HIT reads, never what a
/// ray meets (restHitKind). The list overflowed or restarted: every segment.
bool restSegmentMovedR( vec3 o, vec3 d, float t, float r )
{
	if( p.restLists.y > 0.5 )
		return true;
	const uint n = min( uint( p.restLists.x + 0.5 ), 128u );
	for( uint k = 0u; k < n; ++k )
	{
		const uint kind = regionKind( k );
		if( kind == kRegionMover && jahSegmentHitsBox( o, d, t, regionLo( k ).xyz - vec3( r ), regionHi( k ).xyz + vec3( r ) ) )
			return true;
	}
	return false;
}
bool restSegmentMoved( vec3 o, vec3 d, float t ) { return restSegmentMovedR( o, d, t, 0.0 ); }
/// THE LOBE's FOOTPRINT at distance t (B2, the (e) attribution: a stopped texel's test at the sample spacing
/// reflectFootprint - 2 t alpha / sqrt( MaxFrames ) - saw ~1/3.5 of what its samples read, and a change across the rest
/// of a glossy lobe never resumed it: eref's texel held 34 % under the converged light): the mean segment's and the mean
/// hit's tests take the whole lobe's, 2 t alpha (the box widened by it - conservative along the segment); each sample's
/// own hit keeps the sample's footprint (the samples spread over the lobe).
float restLobeFootprint( float lobeAlpha, float t ) { return 2.0 * t * lobeAlpha; }
/// WHAT CHANGED AT A HIT THIS FRAME (B2): the point x a ray found, its read's radius r (the lobe's footprint there).
/// 2 = A SCENE CHANGE - an edit (a material or the store's geometry the user changed), a lamp's parameters, a lamp's
/// shadow range (listed when a casting mover moves inside it: a mover's consequence, so a scene change), a changed brick
/// on a frame whose list carries a scene change (restLists.w: a mover, an edit, an overflow - the brick's change is then
/// that change's), or the list overflowed: the texel resumes at once. 1 = AN ESTIMATE CONVERGING - a relit, captured
/// or departed card's instance (Card), a scroll's re-injected slab (Slab), a changed brick on a frame whose list carries
/// no scene change (the store relighting toward its fixed point): the caches are the lighting's estimate, their
/// frame-to-frame steps are no event, so the readers follow at a code a frame (jah_reflect_rest.glsl's slew). 0 = none.
/// The finest cascade holding the point whose brick is at least the radius answers (the coarsest holding it for a wider
/// read), over the bricks within half a brick of it: the trilinear read's reach.
uint restHitKind( vec3 x, float r )
{
	if( p.restLists.y > 0.5 )
		return 2u;
	uint found = 0u;
	bool inSlab = false;
	const uint n = min( uint( p.restLists.x + 0.5 ), 128u );
	for( uint k = 0u; k < n; ++k )
	{
		const uint kind = regionKind( k );
		if( kind == kRegionMover || kind == kRegionMoverShadow )
			continue;   // (the traced geometry: the segments')
		const vec3 lo = regionLo( k ).xyz - vec3( r ), hi = regionHi( k ).xyz + vec3( r );
		if( !( all( greaterThanEqual( x, lo ) ) && all( lessThanEqual( x, hi ) ) ) )
			continue;
		if( kind == kRegionEdit || kind == kRegionLamp || kind == kRegionLampShadow || kind == kRegionCardScene )
			return 2u;   // (a scene change: CardScene is a relight a scene write caused - 8B (A))
		inSlab = inSlab || kind == kRegionSlab;
		found = 1u;   // (Card, Slab)
	}
	if( p.restLists.z < 0.5 )
		return found;
	int pick = -1;
	for( uint c = 0u; c < 4u; ++c )
	{
		const float brick = p.restBrickOrigin[c].w;
		const uvec3 dims = uvec3( p.restBrickDims[c].xyz );
		if( brick <= 0.0 || any( equal( dims, uvec3( 0u ) ) ) )
			continue;
		const vec3 g = ( x - p.restBrickOrigin[c].xyz ) / brick;
		if( any( lessThan( g, vec3( 0.0 ) ) ) || any( greaterThanEqual( g, vec3( dims ) ) ) )
			continue;
		pick = int( c );
		if( brick >= r )
			break;
	}
	if( pick < 0 || p.restBrickDims[pick].w < 0.5 )
		return found;   // (no cascade holds the point, or its mask is not this frame's: no change)
	const uint c = uint( pick );
	const float brick = p.restBrickOrigin[c].w;
	const ivec3 dims = ivec3( p.restBrickDims[c].xyz );
	const vec3 g = ( x - p.restBrickOrigin[c].xyz ) / brick;
	const ivec3 b0 = clamp( ivec3( floor( g - 0.5 ) ), ivec3( 0 ), dims - 1 );
	const ivec3 b1 = clamp( ivec3( floor( g + 0.5 ) ), ivec3( 0 ), dims - 1 );
	for( int z = b0.z; z <= b1.z; ++z )
		for( int y = b0.y; y <= b1.y; ++y )
			for( int xx = b0.x; xx <= b1.x; ++xx )
			{
				// (a brick's DIRECT change is the world changing - unless a Slab of this close re-injected it, a
				// cascade's commit: the store's own estimate; its FEEDBACK change is the store converging, a scene
				// change only on a close that listed one)
				const uint ch = restBrickChange( c, uint( ( z * dims.y + y ) * dims.x + xx ) );
				if( ch == 2u && !inSlab )
					return 2u;
				if( ch != 0u )
					found = max( found, p.restLists.w > 0.5 ? 2u : 1u );
			}
	return found;
}

/// THE VIEW'S ID IMAGE (REFLECT-MOVERS-1): x = the slot that drew the pixel
/// (jah_atom_id.glsl's encoding; 0xFFFFFFFF = nothing, or an item the id pass does
/// not draw). Read only under p.motion.x; a 1x1 stand-in is bound otherwise.
layout( set = 0, binding = 39 ) uniform usampler2D atomIds;
/// ...AND THE ID PASS'S OWN DEPTH (ID-DEPTH-1, PHOTON-II-1 item 11): the scene depth
/// copied right after the id pass, before any stock-drawn surface is added to it.
layout( set = 0, binding = 42 ) uniform sampler2D idDepth;
#include "jah_atom_id.glsl"
#define JAH_FOG_P( k ) p.fog[k]
#define JAH_FOG_AERIAL( uvw ) textureLod( fogAerial, uvw, 0.0 )
#define JAH_FOG_HAS_AIR
#define JAH_FOG_HAS_HEIGHT_FOG
#include "jah_atmosphere.glsl"
#include "jah_height_fog.glsl"
#include "jah_fog_along.glsl"

/// A SLOT THAT MOVED THIS FRAME, with its six rows (the instance table's lanes
/// 0-2 = world, 3-5 = prevWorld — GpuScene.h). False for a slot the table does
/// not hold, a still one and a mover at rest.
struct MovedSlot
{
	bool  moved;
	uvec4 w0, w1, w2, q0, q1, q2;
};
MovedSlot movedSlot( uint slot )
{
	MovedSlot m;
	m.moved = false;
	// THE FLAGS FIRST: a still slot (every pixel of a still world) costs one word.
	if( slot >= JAH_HIT_INSTANCES || ( jahHitFlags( slot ) & kJahReprojectMoverFlags ) == 0u )
		return m;
	m.w0 = JAH_HIT_INSTANCE( slot, 0u ); m.w1 = JAH_HIT_INSTANCE( slot, 1u ); m.w2 = JAH_HIT_INSTANCE( slot, 2u );
	m.q0 = JAH_HIT_INSTANCE( slot, 3u ); m.q1 = JAH_HIT_INSTANCE( slot, 4u ); m.q2 = JAH_HIT_INSTANCE( slot, 5u );
	m.moved = jahInstanceMoved( jahHitFlags( slot ), m.w0, m.w1, m.w2, m.q0, m.q1, m.q2 );
	return m;
}
vec3 movedPrevPosition( MovedSlot m, vec3 x )
{
	return jahInstancePrevPosition( m.w0, m.w1, m.w2, m.q0, m.q1, m.q2, x );
}

/// A HIT'S POINT, LAST FRAME (REFLECT-MOVERS-2). A rigid mover's through its two
/// poses (movedSlot). A POSED item's (kGpuSkinned) through its skin cache's
/// PREVIOUS-POSE SLICE (SkinCache.h: the row's first pad word is the slice's byte
/// offset from the vertex address): the hit triangle's three vertices as they
/// were last frame, at this hit's barycentrics, through the instance's previous
/// pose — the pose's motion and the node's together. Only the DIFFERENCE is
/// applied to the hit point (the interpolated point's own float error cancels),
/// so a triangle that did not move gives the hit back bit for bit. False when the
/// point did not move: a still slot, a mover at rest, a pose that did not change,
/// a slot whose cache is not ready (no row, or no slice).
bool hitPrevPoint( uint slot, uint geomIdx, uint prim, vec2 bary, vec3 hitNow, out vec3 was )
{
	was = hitNow;
	if( ( jahHitFlags( slot ) & kJahHitGpuSkinned ) == 0u )
	{
		const MovedSlot m = movedSlot( slot );
		if( !m.moved )
			return false;
		was = movedPrevPosition( m, hitNow );
		return true;
	}
	if( slot >= JAH_HIT_INSTANCES )
		return false;
	return jahSkinnedPrevPoint( slot, geomIdx, prim, bary, hitNow, was );
}

/// Metres along the camera's forward axis, with and without reverse Z — the
/// same line JahSsrRayMarch_ps.glsl uses, from Camera::getProjectionParamsAB().
float viewDistance( float rawDepth )
{
	if( p.camPos.w < 0.5 )				// orthographic: depth is linear in distance
		return abs( ( rawDepth - p.projParams.x ) / p.projParams.y );
	return p.projParams.y / ( rawDepth - p.projParams.x );
}

/// The surface this pixel shows, in world space.
/// THE SURFACE THIS PIXEL DREW, from its depth. `uv` is the coordinate in the
/// EYE'S OWN image (eyeLocalUv), so under stereo each half reconstructs through
/// the eye that rendered it and nothing here knows there are two.
vec3 worldAt( EyeImage e, vec2 uv, float dist )
{
	const vec3 plane = e.rayTL + e.rayRight * uv.x + e.rayDown * uv.y;
	if( e.perspective < 0.5 )
		return e.camPos + plane + e.fwd * dist;		// an offset, not a ray
	return e.camPos + plane * dist;
}

/// ---- THE SCREEN TRACE (PHOTON-7 stage 6, THE ONE ESTIMATOR's first source) ------------------------------------------
/// The march's core is the raster march's own text (jah_ssr_march.glsl): this file hosts it through the depth it reads
/// - this frame's, at the eye's own layer, point-sampled - and the view distance.
#define JAH_SSR_SCENE_DEPTH( uv ) textureLod( sceneDepth, vec3( ( uv ), float( gEye ) ), 0.0 ).x
#define JAH_SSR_VIEW_DISTANCE( d ) viewDistance( d )
#include "jah_ssr_march.glsl"
/// THE SAME SURFACE IN THE PREVIOUS PICTURE (the no-ray resolve's test, JahSsrResolve_ps.glsl "THE SAME SURFACE", in
/// view distance): a texel of the previous picture shows the hit only if the depth it was drawn at is the hit's, within
/// twice the hit's local depth slope plus 0.2 % of its distance, never more than 3 %.
const float kSsrSameSurfaceRel = 2e-3;
const float kSsrSameSurfaceCeil = 3e-2;
/// ...and the previous picture's frame edge, faded over 3 % of it (the resolve's kHistoryEdgeFade).
const float kSsrHistoryEdgeFade = 0.03;

/// THE SCREEN'S ANSWER FOR DIRECTION `L` from the surface `world` this pixel `px` shows: the march along L in the
/// eye's own frame (right / down / forward: z the view distance, the image coordinate h.xy / h.w through the eye's
/// basis - worldAt's inverse), then at a crossing the resolve's tests on the hit: its point last frame (the object
/// motion at the hit, a moving slot's previous pose), reprojected through the previous camera (jah_reproject.glsl),
/// the previous picture's texels around it that show the SAME SURFACE, bilinear over those, re-fogged for the
/// reflection's leg (jahSsrRefog). `coin` takes it with the probability the screen vouches for it - the envelope, the
/// arrival angle and the previous picture's edge (jah_ssr_march.glsl); false hands the sample to the ray. `travelled`
/// is the hit's distance along L; `moving` / `was` say whether the hit moved and where it was; `vouch` = how much the
/// screen vouches for an answer it gave (0 where it gave none: the mirror's blend weight, main's (1)).
bool screenAnswer( EyeImage e, EyeImage before, vec3 world, vec3 L, vec3 V, ivec2 px, ivec2 fullRes, float coin,
				   out vec3 radiance, out float travelled, out vec3 hitPos, out bool moving, out vec3 was,
				   out float vouchOut )
{
	vouchOut = 0.0;
	radiance = vec3( 0.0 );
	travelled = 0.0;
	hitPos = world;
	moving = false;
	was = world;
	// THE MARCH'S SPACE: the eye's right / down / forward axes; the image coordinate of a point (x, y, z) of it is
	// ((x / z - rTL) / |rayRight|, (y / z - dTL) / |rayDown|) through a perspective eye (rTL, dTL: the top-left ray's
	// components), ((x - rTL) / |rayRight|, ...) through an orthographic one - the matrix below, column by column.
	const float rR = length( e.rayRight ), rD = length( e.rayDown );
	const vec3 right = e.rayRight / max( rR, 1e-20 ), down = e.rayDown / max( rD, 1e-20 );
	const float rTL = dot( e.rayTL, right ), dTL = dot( e.rayTL, down );
	const mat4 viewToTex = e.perspective > 0.5
		? mat4( vec4( 1.0 / rR, 0.0, 0.0, 0.0 ), vec4( 0.0, 1.0 / rD, 0.0, 0.0 ),
				vec4( -rTL / rR, -dTL / rD, 1.0, 1.0 ), vec4( 0.0 ) )
		: mat4( vec4( 1.0 / rR, 0.0, 0.0, 0.0 ), vec4( 0.0, 1.0 / rD, 0.0, 0.0 ),
				vec4( 0.0, 0.0, 1.0, 0.0 ), vec4( -rTL / rR, -dTL / rD, 0.0, 1.0 ) );
	const vec3 rel = world - e.camPos;
	const vec3 o = vec3( dot( rel, right ), dot( rel, down ), dot( rel, e.fwd ) );
	const vec3 d = vec3( dot( L, right ), dot( L, down ), dot( L, e.fwd ) );
	const vec3 toSurface = -vec3( dot( V, right ), dot( V, down ), dot( V, e.fwd ) );
	const float maxDistance = p.screen2.x;
	const JahSsrMarch m = jahSsrMarch( viewToTex, o, d, maxDistance, p.screen2.y, p.screen.z,
									   jahSsrJitter( vec2( px ), p.screen.w ), p.screen.w );
	if( m.hit <= 0.0 )
		return false;
	// THE CROSSING ITSELF (jahSsrSecant): this trace answers the crossing's own point - one estimator, its hit is the
	// pixel's reflection - not the bisection's back end a fraction of a step past it (~10 px at 1 m on a face met steeply).
	float tCross;
	const vec2 hitUv = jahSsrSecant( viewToTex, o, d, m, tCross );
	// THE HIT: the depth of the texel the crossing landed in (the resolve's), its point and its normal.
	const ivec2 hitPx = clamp( ivec2( hitUv * vec2( fullRes ) ), ivec2( 0 ), fullRes - 1 );
	const float hitRaw = texelFetch( sceneDepth, ivec3( hitPx, gEye ), 0 ).x;
	if( hitRaw <= 0.0 || hitRaw >= 1.0 )
		return false;
	const float hitDist = viewDistance( hitRaw );
	hitPos = worldAt( e, hitUv, hitDist );
	// THE HIT'S LOCAL DEPTH SLOPE in this frame: per axis the smaller one-sided step to a neighbour (a silhouette's
	// texel keeps its own surface's), the two axes summed.
	float slope = 0.0;
	{
		const ivec2 dMax = fullRes - 1;
		float s[4];
		const ivec2 nb[4] = ivec2[4]( ivec2( -1, 0 ), ivec2( 1, 0 ), ivec2( 0, -1 ), ivec2( 0, 1 ) );
		for( int k = 0; k < 4; ++k )
		{
			const float r = texelFetch( sceneDepth, ivec3( clamp( hitPx + nb[k], ivec2( 0 ), dMax ), gEye ), 0 ).x;
			s[k] = r > 0.0 && r < 1.0 ? abs( viewDistance( r ) - hitDist ) : 3.0e38;
		}
		slope = min( min( s[0], s[1] ), 1.0e30 ) + min( min( s[2], s[3] ), 1.0e30 );
	}
	// THE CROSSING LIES ON THE SURFACE THE SCREEN SHOWS - or the screen does not answer. The march's own acceptance
	// is the raster march's (a crossing up to ssrThickness, 0.5 m, behind the depth: a screen-only estimator's hole
	// filler), so a ray that passed BEHIND an object - the wall beyond a pillar, hidden from the eye by it - "hit" the
	// object and took its colour. Here a miss costs nothing (the ray answers it, from the origin), so the screen
	// vouches only for a crossing whose own depth is the hit texel's within the depth buffer's resolution there: its
	// local slope (twice, the texel's centre against the crossing's point inside it) plus 0.2 % of the distance, never
	// more than 3 % - the same-surface tolerance below. A crossing at a depth discontinuity lies between the two
	// surfaces, on neither, and goes to the ray.
	if( !( abs( o.z + d.z * tCross - hitDist ) <=
		   min( 2.0 * slope + kSsrSameSurfaceRel * hitDist, kSsrSameSurfaceCeil * hitDist ) ) )
		return false;
	float arrival = 0.0;
	{
		vec3 hn = texelFetch( gBufNormals, ivec3( hitPx, gEye ), 0 ).xyz * 2.0 - 1.0;
		if( dot( hn, hn ) > 1e-6 )
		{
			hn = normalize( hn );
			arrival = -dot( L, normalize( p.viewAxisX.xyz * hn.x + p.viewAxisY.xyz * hn.y + p.viewAxisZ.xyz * hn.z ) );
		}
	}
	// THE VOUCH (jah_ssr_march.glsl jahSsrVouchRays): the frame's edge, the march's range end, the camera reversal and
	// the arrival - the terms with a measured reason; the raster envelope's distance and thickness fades are not the one
	// estimator's (the on-surface test above is its validity).
	float vouch = jahSsrVouchRays( m, d, toSurface, 0.0 ) * jahSsrFaceFade( arrival );
	if( !( vouch > coin ) )
		return false;
	// THE HIT LAST FRAME: a moving slot's previous pose (the object motion at the hit's texel, in this image), else
	// where it is.
	{
		const vec4 vel = texelFetch( ssrVelocity, min( hitPx, textureSize( ssrVelocity, 0 ) - 1 ), 0 );
		if( vel.w > 0.5 )
		{
			const float wasRaw = hitRaw + vel.z;
			if( wasRaw > 0.0 && wasRaw < 1.0 )
			{
				was = worldAt( e, hitUv + vel.xy, viewDistance( wasRaw ) );
				moving = true;
			}
		}
		if( !moving )
			was = hitPos;
	}
	vec2 puv;
	float pz;
	if( jahReproject( was, before.camPos, before.perspective, before.rayTL, before.rayRight, before.rayDown,
					  before.fwd, puv, pz ) != 0 )
		return false;
	const vec2 inside = min( puv, vec2( 1.0 ) - puv );
	vouch *= smoothstep( 0.0, kSsrHistoryEdgeFade, min( inside.x, inside.y ) );
	if( !( vouch > coin ) )
		return false;
	// THE SAME SURFACE, PER TAP of the bilinear footprint: the previous picture's depth at each against the hit's
	// distance there, the tolerance from the hit's local depth slope in THIS frame (above).
	const float tol = min( 2.0 * slope + kSsrSameSurfaceRel * pz, kSsrSameSurfaceCeil * pz );
	const ivec2 prevRes = textureSize( ssrPrevColour, 0 );
	const vec2 at = puv * vec2( prevRes ) - 0.5;
	const ivec2 base = ivec2( floor( at ) );
	const vec2 f = at - vec2( base );
	vec3 sum = vec3( 0.0 );
	float wSame = 0.0;
	for( int k = 0; k < 4; ++k )
	{
		const ivec2 o4 = ivec2( k & 1, k >> 1 );
		const ivec2 tc = clamp( base + o4, ivec2( 0 ), prevRes - 1 );
		const float w = ( o4.x == 1 ? f.x : 1.0 - f.x ) * ( o4.y == 1 ? f.y : 1.0 - f.y );
		if( w <= 0.0 )
			continue;
		const float wasRaw = texelFetch( ssrPrevDepth, tc, 0 ).x;
		if( !( wasRaw > 0.0 && wasRaw < 1.0 ) || abs( viewDistance( wasRaw ) - pz ) > tol )
			continue;
		const vec3 c = texelFetch( ssrPrevColour, tc, 0 ).xyz;
		if( !finite3( c ) )
			continue;
		sum += clamp( c, vec3( 0.0 ), vec3( kMaxRadiance ) ) * w;
		wSame += w;
	}
	if( !( wSame > 0.0 ) )
		return false;
	radiance = jahSsrRefog( sum / wSame, e.camPos, world, hitPos );
	travelled = tCross;
	vouchOut = clamp( vouch, 0.0, 1.0 );
	return finite3( radiance );
}

/// THE DRAW (the sequence, the VNDF sample, its density, the mirror ramp): jah_reflect_draw.glsl, the one text the
/// resolve re-derives a neighbour's direction from.
#include "jah_reflect_draw.glsl"

/// THE RADIANCE AT A HIT is `jahHitRadiance` (jah_rq_hit_radiance.glsl): the
/// CARD first, the VOXELS where no card answers — ONE function, read by this
/// trace and by the gather's hits (PHOTON-GATHER-1d, GA-1e), whose header says
/// what each read does. What this trace hands it is its FOOTPRINT, below.
// THE HIT'S OWN SURFACE (FAR-SUN-2, jah_rq_hit_direct.glsl): the hit table, the voxeliser's
// texture pool (binding 42) and the cloud layer's field (43).
layout( set = 0, binding = 43 ) uniform sampler2DArray jahHitPool;
layout( set = 0, binding = 44 ) uniform sampler2D jahHitCloud;
// C2's escape (jah_rq_hit_radiance.glsl jahHitSpecularLobeTraced): the sky this trace reads, at the secondary lobe's
vec3 skyRadiance( vec3 dir, float lobeAlpha, bool centreRay );
#define JAH_HIT_LOBE_SKY( d, alpha, centre ) skyRadiance( d, alpha, centre )
#include "jah_rq_hit_radiance.glsl"
#include "jah_rq_emitters.glsl"
#include "jah_rq_panes.glsl"
/// THE EMISSION OF THE HIT `jahHitSurf` describes (PHOTON-7 11-1b): the row's emissive and its map at the hit - the ONE
/// function both of the NEE's strategies take E from (the split between them is exact whatever answered the BRDF's hit).
/// 0 where the hit has no material (a far copy, an item the store has not converted).
vec3 jahNeeEmission( float footprint )
{
	vec3 albedo, emissive;
	float roughness;
	vec4 metal;
	if( !jahHitMaterial( footprint, albedo, emissive, roughness, metal ) || !finite3( emissive ) )
		return vec3( 0.0 );
	return clamp( emissive, vec3( 0.0 ), vec3( kMaxRadiance ) );
}
// THE CARD READ'S LOBE INTEGRALS (jah_rq_card.glsl, ENGINE-POLISH-PHOTON-1): the store's table, through the hit table.
void jahCardLobeHemi( float r, out float a, out float b )
{
	a = 0.0;
	b = 0.0;
	const uvec2 t = JAH_HIT_TABLE;
	if( ( t.x | t.y ) != 0u )
		jahSpecularAlbedoHemi( r, a, b );
}

/// THE ESTIMATOR's GAIN of a direction L for this texel (PHOTON-7 11-2 (1), jah_reflect_draw.glsl's jahReflectGain): the
/// VNDF draw's missing G2/G1 over the F-free A + B the pixel's split DFG takes, at the texel's N.V and the perceptual
/// roughness sqrt( alpha ) (the G-buffer's alpha). Without the hit table (no ray tier's tables yet) the old weight, 1.
float reflectGainAt( vec3 N, vec3 g, vec3 V, vec3 L, float alpha )
{
	const uvec2 t = JAH_HIT_TABLE;
	if( ( t.x | t.y ) == 0u )
		return 1.0;
	float a, b;
	jahSpecularAlbedo( clamp( dot( N, V ), 0.0, 1.0 ), sqrt( clamp( alpha, 0.0, 1.0 ) ), a, b );
	return jahReflectGain( N, g, V, L, alpha, a + b );
}

/// What is read as a MIRROR at the hit — the card texel-exact, the containing cascade whole at LOD 0 and no crossfade,
/// the sky's finest mip — is the lobe's CENTRE RAY (the mirror ramp's draw, jah_reflect_draw.glsl), never an alpha.

/// THIS TRACE'S SAMPLE FOOTPRINT at a hit `t` away along a lobe of GGX alpha
/// `lobeAlpha` — the currency both reads select on. Not the WHOLE lobe: the
/// temporal mean already averages up to N samples of the lobe (N = 1/knobs2.w,
/// Lumen's MaxFrames 12 since PHOTON-7 stage 6 - re-derived with it, or every hit read blurs by sqrt(32/12) = 1.63x),
/// so pre-filtering the whole lobe on top of that
/// would blur it twice. The honest footprint for ONE stochastic sample is the
/// spacing BETWEEN the samples the mean holds, which for N samples spread over
/// the lobe goes as 1/sqrt(N). (`textureLod(..., 0.0)` once made every ray read
/// the finest directional mip, so a rough reflection paid for the anisotropic
/// chain and never read it — DRAG-1.)
float reflectFootprint( float lobeAlpha, float t )
{
	const float meanSamples = 1.0 / max( p.knobs2.w, 1e-3 );
	return 2.0 * t * lobeAlpha / sqrt( max( meanSamples, 1.0 ) );
}

/// An escaping sample, read at the SAME honest footprint as a hit (GA-SKY): the
/// spacing between the samples the temporal mean holds, as a half-angle —
/// lobeAlpha / sqrt(N), N = the MaxFrames 12 — and the lobe's centre ray (the mirror ramp's draw)
/// reads the environment's finest mip.
vec3 skyRadiance( vec3 dir, float lobeAlpha, bool centreRay )
{
	const float meanSamples = 1.0 / max( p.knobs2.w, 1e-3 );
	const float tanHalf = centreRay ? 0.0 : lobeAlpha / sqrt( max( meanSamples, 1.0 ) );
	return jahSkyRadiance( dir, tanHalf );
}

/// THE GEOMETRIC NORMAL AT A PIXEL (the ray origin's direction, READ_A finding 1): jah_geometric_normal.glsl, the one
/// text the sun contact reads too - this eye's own layer and basis.
EyeImage gNormalEye;
#define JAH_GN_RAW( q ) texelFetch( sceneDepth, ivec3( ( q ), gEye ), 0 ).x
#define JAH_GN_WORLD( q, raw ) worldAt( gNormalEye, ( vec2( q ) + 0.5 ) / vec2( fullRes ), viewDistance( raw ) )
#include "jah_geometric_normal.glsl"
#include "jah_ray_origin.glsl"

// ---- ONE SAMPLE OF THE ONE ESTIMATOR (the screen, the TLAS near ray, the far copies, the sky) for a texel ---------------
// THE TEXEL A SAMPLE IS TRACED FOR: everything of it a sample reads - the rest's spread lanes (main) trace a sample for
// ANOTHER lane's texel from these, shuffled; the texel's own lane from its own (the same values, the same answer).
struct JahReflectTexel
{
	vec3 world, worldN, V, geomN, origin;
	float alpha, centreChance, meanT;   // meanT: the lobe's mean segment the resume test reads (the rest's, else the throw)
	ivec2 seedPix, px;
};
// ONE SAMPLE'S ANSWER: what main's frame-sample logic reads, and the resume test's verdict (in: the texel's own).
struct JahReflectSample
{
	vec3 L, traced, recN, screenRadiance;
	vec3 nee;        // the sample's NEE part (PHOTON-7 11-1b; inside `traced`, and the write-back's for a record)
	vec3 recDelta;   // a RECORD's addend at the write-back: the NEE part less the BRDF's share of the emission it found
	vec2 recBary;
	float hitT, sampleT, screenT, blendVouch;
	float sunVis;   // a record's: the sun's visibility at its hit (the list's word; one call site, here)
	uint areaVis;   // ...and its area lights' (L9 (b1): jahHitAreaVisWord, the list's word 10)
	float recGain;  // a RECORD's estimator gain (PHOTON-7 11-2 (1)): the write-back's factor on the decoded ray share
	bool recTraced; // a RECORD whose lobe the trace traced (C2, 11-2 (3)): its environment specular rides the delta
	vec4 recPane;   // ...and the panes it was seen through: their own light, their throughput ((0, 1) none; the one read's F6)
	vec3 c2;        // THE PICK's (the reds' instrument): the hit's traced lobe (C2) inside `traced` / a record's lobe
	uint c2Slot;    // ...its secondary ray's hit slot (0xFFFFFFFF an exit), distance, BRDF part and portal part
	float c2T;
	vec3 c2Brdf, c2Portal, c2Spec, c2Mirror, cut;
	uint c2MirrorSlot;
	uint recSlot, recPrim, recGeom, photonSource;
	bool ok, record, recFar, slotHit, screenHit, noSample, blend, centre, vndf, folded, resume;
	bool card;   // (B2: this sample's resume is an ESTIMATE CONVERGING's alone - the caches: restHitKind 1)
};
JahReflectSample jahReflectSampleNone( JahReflectTexel x )
{
	JahReflectSample o;
	o.L = x.worldN;
	o.traced = vec3( 0.0 );
	o.recN = -x.worldN;
	o.screenRadiance = vec3( 0.0 );
	o.nee = vec3( 0.0 );
	o.recDelta = vec3( 0.0 );
	o.recBary = vec2( 0.0 );
	o.hitT = p.knobs.y * 2.0;
	o.sampleT = o.hitT;
	o.screenT = 0.0;
	o.blendVouch = 1.0;
	o.sunVis = 1.0;
	o.areaVis = 0u;
	o.recGain = 1.0;
	o.recTraced = false;
	o.recPane = vec4( 0.0, 0.0, 0.0, 1.0 );
	o.c2 = vec3( 0.0 );
	o.c2Slot = 0xFFFFFFFFu;
	o.c2T = 0.0;
	o.c2Brdf = vec3( 0.0 );
	o.c2Portal = vec3( 0.0 );
	o.c2Spec = vec3( 0.0 );
	o.c2Mirror = vec3( 0.0 );
	o.cut = vec3( 0.0 );
	o.c2MirrorSlot = 0xFFFFFFFFu;
	o.recSlot = 0u; o.recPrim = 0u; o.recGeom = 0u; o.photonSource = 0u;
	o.ok = false; o.record = false; o.recFar = false; o.slotHit = false; o.screenHit = false; o.noSample = false;
	o.blend = false; o.centre = false; o.vndf = false; o.folded = false; o.resume = false; o.card = false;
	return o;
}
// THE SAMPLE at index `frame` (every random input of it is keyed on it: the draw, the screen's coin, the mover gate's turn).
void reflectSampleAt( JahReflectTexel x, EyeImage thisEye, EyeImage before, ivec2 fullRes, bool atRest, uint frame,
					  inout JahReflectSample o )
{
	const vec3 world = x.world;
	const vec3 worldN = x.worldN;
	const vec3 V = x.V;
	const vec3 geomN = x.geomN;
	const vec3 origin = x.origin;
	const float alpha = x.alpha;
	const float centreChance = x.centreChance;
	const ivec2 seedPix = x.seedPix;
	const ivec2 px = x.px;
	const float maxT = p.knobs.y;
	const float lobeAlpha = max( alpha, 1e-4 );
	bool resume = o.resume;
	bool centre = false, vndf = false, folded = false;
	vec3 L = worldN;
	vec3 traced = vec3( 0.0 );
	bool ok = false;
	float hitT = maxT * 2.0;
	bool record = false;
	bool recFar = false;
	vec3 recLobe = vec3( 0.0 );   // a record's traced environment specular (C2), fogged by transmittance
	bool recTraced = false;
	bool slotHit = false;
	uint recSlot = 0u, recPrim = 0u, recGeom = 0u;
	vec2 recBary = vec2( 0.0 );
	vec3 recN = -L;
	uint photonSource = 0u;
	bool screenHit = false, screenMoving = false;
	vec3 screenWas = world, screenPos = world;
	jahC2Seg[0] = jahC2Seg[1] = jahC2Seg[2] = vec4( 0.0 );   // (C2's segments: this sample's alone - B2's resume test)
	jahC2HitR = 0.0;
	vec3 screenRadiance = vec3( 0.0 );
	float screenT = 0.0;
	float blendVouch = 1.0;
	bool noSample = false, blend = false;
	float sampleT = hitT;
	L = jahReflectDraw( worldN, V, alpha, seedPix, frame + uint( p.denoiser.z ), centreChance, centre, vndf );
	// ...AND THE GEOMETRIC PLANE (READ_A W4): a normal-mapped lobe seen at grazing can point below the surface the ray
	// actually leaves (L above the shaded plane, under the geometric one), and from an origin lifted along the geometric
	// normal with tMin 0 it would hit its own surface at lift / |L . geomN|. Such a direction is REFLECTED about the
	// geometric plane - deterministic (no rejection loop), the lobe's mass kept on the side the surface reflects into
	// (Lumen clamps its rays to the geometric hemisphere the same way). The fold makes the draw's density
	// p( L ) + p( R L ) (R the reflection about the plane, |det| 1) - for every draw of a lobe that straddles the plane,
	// folded or not; the resolve evaluates it (READ_B Q2), the state's folded bit says this draw was one.
	folded = false;
	if( dot( L, geomN ) < 0.0 )
	{
		L -= 2.0 * dot( L, geomN ) * geomN;
		folded = true;
	}
	// THE ESTIMATOR's GAIN (PHOTON-7 11-2 (1); the reference arm, ledger 3388): the VNDF draw's sample is weighed by its
	// missing G2/G1 over the F-free A + B (jahReflectGain: the folded target over the folded density), so the samples
	// average to the lobe's normalised mean under HlmsPbs's own D G2 - the split DFG then applies F. Before it the pass
	// averaged under D G1: a rough lobe at grazing read ~13 % (linear) dark against its reference. The centre ray is the
	// lobe whole (1); a draw that left the surface is a sample of no light (0: G2 is 0 there).
	const float gainB = vndf ? reflectGainAt( worldN, geomN, V, L, lobeAlpha ) : centre ? 1.0 : 0.0;
	// ---- NEXT-EVENT ESTIMATION TOWARD THE EMITTERS (PHOTON-7 stage 11, 11-1b; jah_rq_emitters.glsl) ----------------------
	// On a VNDF draw (never the centre ray nor a mirror fallback: a delta has no density to weigh) of a texel some target
	// reaches, ONE more direction L_l is drawn in a target's cone, and the two are combined by the BALANCE HEURISTIC:
	//   the BRDF's sample:  its answer less ( 1 - w_b ) E( L ),  w_b = q( L ) / ( q( L ) + p_l( L ) )
	//   the NEE's sample:   E( L_l ) q( L_l ) / ( q( L_l ) + p_l( L_l ) )
	// q the folded draw's density (the VNDF branch's: the centre ray's chance is the mixture's, unchanged), p_l the table's
	// (jahNeePick), E the emission of the FIRST surface along the direction (jahNeeEmission - one function on both
	// strategies, so the split is exact whatever answered the BRDF's hit: the card, the voxels or the decode), each times
	// the fog's transmittance along its own leg and - in Both - its RAY SHARE 1 - v: the screen vouches along the NEE's
	// direction too (the preflight's gap G1; its one call site is the loop of two below). The analytic lights are not
	// geometry (no ray meets one): their light stays the hit's and the pixel's, never counted twice; the sky is never E.
	// Every random input is keyed on the sample index `frame` (jahNeeSample3): the rest stays deterministic.
	const bool neeArm = p.knobs.w > 0.5 && !( p.screen.x > 0.5 && p.screen.y > 0.5 ) && p.denoiser.w < 0.5;
	JahNeePick nee;
	nee.ok = false; nee.W = 0.0; nee.pdfB = 0.0; nee.L = geomN; nee.pdfL = 0.0; nee.slot = 0xFFFFFFFFu;
	float neeQB = 0.0;
	if( neeArm && vndf )
	{
		nee = jahNeePick( world, geomN, reflect( -V, worldN ), lobeAlpha, L, true,
						  jahNeeSample3( seedPix, frame + uint( p.denoiser.z ) ), kJahNeeKindEmitters );
		if( nee.W > 0.0 )
			neeQB = jahReflectFoldedPdf( worldN, geomN, V, L, lobeAlpha );
	}
	const bool neeActive = nee.W > 0.0 && neeQB > 0.0;          // this sample is an NEE + MIS pair
	const float neeWb = neeActive ? neeQB / ( neeQB + nee.pdfB ) : 1.0;
	const float neeQL = nee.ok ? jahReflectFoldedPdf( worldN, geomN, V, nee.L, lobeAlpha ) : 0.0;
	const bool neeTrace = neeActive && nee.ok && neeQL > 0.0;    // (a draw under the surface is a sample of 0: no ray)
	float neeVouch = 0.0;   // the screen's vouch along L_l (Both)
	vec3 neeEb = vec3( 0.0 );   // E at the BRDF's hit (only where p_l( L ) > 0)
	traced = vec3( 0.0 );
	ok = false;
	// How far this ray went: the hit's distance, or — for a ray that
	// left the scene — a length no hit can have.
	hitT = maxT * 2.0;
	// A HIT THE CACHES CANNOT SHADE IS A PIXEL OF A SECOND VISIBILITY BUFFER
	// (PHOTON-HIT-SHADE-1). A mover or a rigged item always, and a static hit
	// neither its card nor a cascade answers: the hit is written to the list and
	// HlmsAtom's decode shades it — the same lighting text as a screen pixel,
	// with the sun from a shadow ray — and rq_hit_composite.comp completes the
	// temporal mean below with that radiance. There is no hand-back to the
	// probe: a hit is always shaded (a card, a voxel, or the decode).
	record = false;
	recFar = false;      // the hit is a FAR copy's (each mesh's coarsest level: no card, no near row)
	slotHit = false;     // a TLAS triangle answered: recSlot / recPrim / recGeom / recBary name it
	recSlot = 0u; recPrim = 0u; recGeom = 0u;
	recBary = vec2( 0.0 );
	recN = -L;
	photonSource = 0u;   // 1 card, 2 voxels (jahHitRadianceStore); 3 the sky; 4 the screen
	// (1) THE SCREEN TRACE, where the chain runs one, and THE COIN'S EXPECTATION for EVERY sample (READ_B F2; the lead's
	// round-3 ruling (i), built after the rest's tail diagnostic): a random choice between the screen's answer and the
	// ray's, on the screen's vouch, is replaced by its MEAN - where the screen vouches fully (vouch 1) its answer alone,
	// where it gives none the ray's alone, and in between (the fade band) BOTH, blended vouch x screen + (1 - vouch) x ray.
	// Rao-Blackwell: an expectation never raises the variance, and where the two disagree it removes v (1 - v) (S - R)^2
	// from every sample (a fixed coin of one half made every fade a hard seam that moved with the camera; a per-sample
	// coin left that variance in every rest at a reflected edge - the hold's tail). ONE rule for the mirror's centre ray
	// and the lobe's draw alike. Screen mode (p.screen.y, the screen-alone measuring arm) keeps its coin: a draw on the
	// vouch, the centre ray's fixed one half.
	screenHit = false; screenMoving = false;
	screenWas = world; screenPos = world;
	screenRadiance = vec3( 0.0 );
	screenT = 0.0;
	blendVouch = 1.0;   // the screen's share of a centre ray's sample; 1 = the screen's alone
	if( p.screen.x > 0.5 )
	{
		// (Screen mode keeps its coin: the screen-alone arm is unchanged)
		const bool screenAlone = p.screen.y > 0.5;
		const float coin = !screenAlone ? 0.0 : centre ? 0.5
			: float( jahReflectPcg( uint( seedPix.x ) * 7919u + uint( seedPix.y ) * 104729u + frame * 15485863u +
									0x9E3779B9u ) & 0xFFFFFFu ) * ( 1.0 / 16777216.0 );
		// (a loop of two, ONE call site of the march - ENGINE.md's inlining trap: the draw's direction, then the NEE's,
		// whose vouch alone is read)
		for( int k = 0; k < 2; ++k )
		{
			if( k == 1 && !( neeTrace && !screenAlone ) )
				break;
			vec3 kRadiance, kPos, kWas;
			float kT, kVouch;
			bool kMoving;
			const bool kHit = screenAnswer( thisEye, before, world, k == 0 ? L : nee.L, V, px, fullRes,
											k == 0 ? coin : 0.0, kRadiance, kT, kPos, kMoving, kWas, kVouch );
			if( k == 1 )
			{
				neeVouch = kHit ? clamp( kVouch, 0.0, 1.0 ) : 0.0;
				continue;
			}
			screenHit = kHit;
			screenRadiance = kRadiance;
			screenT = kT;
			screenPos = kPos;
			screenMoving = kMoving;
			screenWas = kWas;
			if( screenHit )
			{
				ok = true;
				hitT = screenT;
				traced = screenRadiance;
				photonSource = 4u;
				if( !screenAlone )
					blendVouch = kVouch;
			}
		}
	}
	// THE SCREEN ALONE (PostFxDesc::reflectSources Screen): a sample the screen does not answer is NO SAMPLE - no ray
	// follows it (biased by construction: the measuring arm the agreement row reads Both against Rays beside).
	noSample = !screenHit && p.screen.y > 0.5;
	// THE BLEND: the screen answered with partial trust, so the ray answers the rest.
	blend = screenHit && blendVouch < 1.0;
	if( ( !screenHit || blend ) && !noSample )
	{
		// (2) THE TLAS NEAR RAY from the origin above (lifted along the geometric normal by the float error and the
		// drawn cut's error; tMin 0) - NEAR COPIES ONLY (0x0F, Types.h kRayMaskNearField): the meshes' level 0.
		rayQueryEXT rq;
		rayQueryInitializeEXT( rq, tlas, jahAlphaRayFlags( gl_RayFlagsNoneEXT ), 0x0Fu, origin, 0.0, L, maxT );
		JahPanes panes = jahPanesNone();
		JahPanes panesFar = jahPanesNone();
		JAH_RQ_PROCEED_PANES( rq, panes )
		float t = 0.0;
		vec3 hitN = -L;
		bool hitNormalKnown = false;
		mat4x3 hitToWorld = mat4x3( 1.0 );
		if( rayQueryGetIntersectionTypeEXT( rq, true ) == gl_RayQueryCommittedIntersectionTriangleEXT )
		{
			slotHit = true;
			t = rayQueryGetIntersectionTEXT( rq, true );
			recSlot = uint( rayQueryGetIntersectionInstanceCustomIndexEXT( rq, true ) );
			recPrim = uint( rayQueryGetIntersectionPrimitiveIndexEXT( rq, true ) );
			recGeom = uint( rayQueryGetIntersectionGeometryIndexEXT( rq, true ) );
			recBary = rayQueryGetIntersectionBarycentricsEXT( rq, true );
			hitToWorld = rayQueryGetIntersectionObjectToWorldEXT( rq, true );
			hitNormalKnown = jahHitGeometricNormal( recSlot, recGeom, recPrim, hitToWorld, L, hitN );
		}
		jahPanesInFront( panes, slotHit ? t : maxT );
		if( !slotHit && p.screen2.w > maxT )
		{
			// (3) THE FAR COPIES for an escape (kRayMaskFar, each mesh's coarsest level), from the near length less
			// the widest coarse-vs-fine hand-over gap to the far plane - the gather's continuation (rq_probe_gather.comp):
			// a coarse surface just inside the near length whose fine one lies just outside is not passed by both
			// queries, and a coarse hit in that overlap is honest (the near query proved no fine surface lies there).
			// A far hit names no near row and no card: the cascades answer it, else the decode.
			rayQueryEXT rqFar;
			rayQueryInitializeEXT( rqFar, tlas, jahAlphaRayFlags( gl_RayFlagsNoneEXT ), 0x10u, origin, p.screen2.z, L,
								   p.screen2.w );
			JAH_RQ_PROCEED_PANES( rqFar, panesFar )
			if( rayQueryGetIntersectionTypeEXT( rqFar, true ) == gl_RayQueryCommittedIntersectionTriangleEXT )
			{
				slotHit = true;
				recFar = true;
				t = rayQueryGetIntersectionTEXT( rqFar, true );
				recSlot = uint( rayQueryGetIntersectionInstanceCustomIndexEXT( rqFar, true ) );
				recPrim = uint( rayQueryGetIntersectionPrimitiveIndexEXT( rqFar, true ) );
				recBary = rayQueryGetIntersectionBarycentricsEXT( rqFar, true );
			}
			// (a pane the near query already crossed is not crossed twice: the far copies' past its end)
			jahPanesBetween( panesFar, maxT, slotHit ? t : p.screen2.w );
		}
		// THE PANES IN FRONT (PHOTON-7 10-4 R7): their own light and the throughput past them (jah_rq_panes.glsl)
		float through = 1.0;
		vec3 paneLight = vec3( 0.0 );
		const bool crossedPanes = panes.n + panesFar.n > 0;
		if( crossedPanes )
		{
			// the near list, then the far one, through ONE call of the fold (its shading inlined once)
			[[dont_unroll]] for( int list = 0; list < 2; ++list )
			{
				float th = 1.0;
				const vec3 own = jahPanesOwnLight( list == 0 ? panes : panesFar, origin, L, th );
				paneLight += through * own;
				through *= th;
			}
		}
		if( slotHit )
		{
			hitT = t;
			// THE HIT, for its direct light at the hit (FAR-SUN-2, jah_rq_hit_direct.glsl).
			jahHitSurf = JahHitSurface( recSlot, recGeom, recPrim, recBary, hitToWorld, t, recFar,
										!recFar && hitNormalKnown );
			// ...and the sample's draw for an area light's stratum there (jah_rq_hit_direct.glsl, 7-H)
			jahHitAreaSeq = jahAreaPcg( frame + uint( p.denoiser.z ) ) ^ seedPix.x * 73856093u ^ seedPix.y * 19349663u;
			// ...and AT REST its time-stratified cycle: the rest sequence index (frame = the sequence's base + v), the
			// texel's offset keyed on its seed pixel (11-2 (2))
			jahHitAreaCycle = atRest ? int( frame - uint( p.knobs.z ) ) : -1;
			jahHitAreaCycleKey = uint( seedPix.x ) * 2654435761u ^ uint( seedPix.y ) * 40503u;
			// ONE RULE FOR EVERY HIT (BUGS-1 item 2): the card, else the store with the direct light at the hit
			// (jahHitRadianceStore), AND THE HIT's OWN SPECULAR TRACED (C2, PHOTON-7 11-2 (3)): one secondary ray of the
			// hit's lobe in place of the store's integral of it - every material alike (the metal switch, a sharp
			// reflector's metal hit sent to the decode from metalness 0.5, is deleted: a step on the alpha -> F0 continuum).
			// Only a hit the caches cannot hold decodes: a mover, a rigged item.
			const bool decodeAlways = jahHitAlwaysDecodes( recSlot );
			const bool c2 = p.denoiser.w < 0.5;   // (the flat-hits arm answers the hit by a constant: no lobe)
			// (the C2 draw's two uniforms: this sample's)
			const uint c2h0 = jahReflectPcg( uint( seedPix.x ) * 2246822519u ^ uint( seedPix.y ) * 3266489917u ^
											 ( frame + uint( p.denoiser.z ) ) * 668265263u ^ 0xC2C2C2C2u );
			const vec2 c2u = vec2( c2h0, jahReflectPcg( c2h0 ^ 0x9E3779B9u ) ) * ( 1.0 / 4294967296.0 );
			if( !decodeAlways )
			{
				jahHitTracedLobe = c2;
				jahCardPickCut = vec3( 0.0 );
				traced = jahHitRadianceStore( recFar ? 0xFFFFFFFFu : recSlot, origin + L * t, hitN, L,
												reflectFootprint( lobeAlpha, t ), centre, ok, photonSource );
				o.cut = jahCardPickCut;   // (THE PICK: the store's lobe share C2 replaces, left out of `traced`)
				jahHitTracedLobe = false;
				vec3 hAlbedo, hEmissive;
				float hRough;
				vec4 hMetal;
				if( c2 && ok && finite3( traced ) &&
					jahHitMaterial( reflectFootprint( lobeAlpha, t ), hAlbedo, hEmissive, hRough, hMetal ) )
				{
					const vec3 c2part = jahHitSpecularLobeTraced( origin + L * t, normalize( hitN ), -L, t, hRough, hMetal, c2u );
					traced += c2part;
					o.c2 = c2part;
					o.c2Slot = jahC2PickSlot;
					o.c2T = jahC2PickT;
					o.c2Brdf = jahC2PickBrdf;
					o.c2Portal = jahC2PickPortal;
					o.c2Spec = jahC2PickSpec;
					o.c2Mirror = jahC2PickMirror;
					o.c2MirrorSlot = jahC2PickMirrorSlot;
				}
			}
			record = decodeAlways || !ok || !finite3( traced );
			// ...AND A RECORD's (the lead's ruling on D5): the decode keeps the lights' lobe, its ENVIRONMENT specular is
			// this traced ray's - fogged along the leg by its transmittance alone (the decoded part takes the leg's
			// in-scatter at the write-back), riding the record's delta; the record's bit tells the decode to drop its own
			if( record && c2 )
			{
				vec3 rAlbedo, rEmissive;
				float rRough;
				vec4 rMetal;
				if( jahHitMaterial( reflectFootprint( lobeAlpha, t ), rAlbedo, rEmissive, rRough, rMetal ) )
				{
					const vec3 lobeR = jahHitSpecularLobeTraced( origin + L * t, normalize( hitN ), -L, t, rRough, rMetal,
																 c2u );
					const float lenR = length( origin + L * t - world ), eyeR = length( world - thisEye.camPos );
					recLobe = max( jahFogAlong( lobeR, world.y, L, lenR, eyeR ) - jahFogAlong( vec3( 0.0 ), world.y, L, lenR, eyeR ),
								   vec3( 0.0 ) );
					recTraced = true;
				}
			}
			// THE EMISSION THE BRDF's HIT FOUND (11-1b), where the NEE covers its direction (p_l( L ) > 0): read from
			// the hit as the NEE reads its own (jahHitSurf is this hit's).
			if( neeActive && nee.pdfB > 0.0 && !recFar && p.denoiser.w < 0.5 )
				neeEb = jahNeeEmission( reflectFootprint( lobeAlpha, t ) );
			// THE MEDIA ALONG THE REFLECTION (PHOTON-I-1, the one law jah_fog_along.glsl):
			// the hit's light crossed the leg from the hit to the REFLECTING SURFACE — not
			// to the ray's lifted origin — and the colour pass fogs the eye's leg, which the
			// height fog's start already spent. A record is fogged at its write-back, which has
			// the decoded radiance (rq_hit_composite.comp; the record carries the same three numbers).
			if( !record )
				traced = jahFogAlong( traced, world.y, L, length( origin + L * t - world ),
									  length( world - thisEye.camPos ) );
			// ...THROUGH THE PANES IN FRONT (PHOTON-7 10-4 R7; the one read's F6): a hit the decode must shade behind
			// panes keeps its record, the panes' light and throughput in it (words 6-7: the write-back's ray share is
			// the panes' light plus the throughput x the decoded light - the gather's rule, its weight x through)
			if( crossedPanes )
			{
				if( record )
					o.recPane = vec4( paneLight, through );
				else
					traced = paneLight + through * traced;
			}
			// THE MEASURING ARM reflect.flatHits (denoiser.w): the hit answered by a constant of its instance - no cache,
			// no footprint, no fog, no record (the estimator and the denoiser measured alone).
			if( p.denoiser.w > 0.5 )
			{
				traced = vec3( 0.2 + 0.6 * fract( float( recSlot ) * 0.6180339 ) );
				ok = true;
				record = false;
				photonSource = 2u;
			}
			recN = hitN;
		}
		else
		{
			// (4) THE SKY: nothing near, nothing far.
			traced = paneLight + through * jahFogAlongSky( skyRadiance( L, lobeAlpha, centre ), world.y, L,
														   length( world - thisEye.camPos ) );
			ok = true;
			photonSource = 3u;
		}
	}
	// THE BLEND (1): the screen's share and the ray's, one sample - its distance the shares' mean, so the hit history's
	// virtual point moves continuously across the fade. A ray whose answer is no evidence leaves the screen's whole; a
	// ray that needs a RECORD leaves its share to the write-back (below).
	sampleT = hitT;
	if( blend && !record )
	{
		if( finite3( traced ) )
		{
			traced = blendVouch * screenRadiance + ( 1.0 - blendVouch ) * traced;
			sampleT = blendVouch * screenT + ( 1.0 - blendVouch ) * hitT;
		}
		else
		{
			traced = screenRadiance;
			sampleT = screenT;
		}
	}
	// THE BRDF's SAMPLE AT ITS GAIN (11-2 (1)): every radiance of the draw - the ray's, the screen's, their blend; a record's
	// ray share takes it at the write-back (the record's gain word)
	if( !record && finite3( traced ) )
		traced *= gainB;
	screenRadiance *= gainB;
	// ---- THE NEE's SAMPLE AND THE PAIR COMBINED (11-1b) -------------------------------------------------------------------
	// ONE CLOSEST-HIT RAY along L_l (the near copies, then the far ones for an escape - the BRDF ray's own route, so E( L )
	// is one function of the direction), where the screen does not vouch for it whole.
	vec3 neePart = vec3( 0.0 ), recDelta = vec3( 0.0 );
	float neeT = 0.0;
	bool neeHitMoving = false;
	if( neeTrace && !noSample && neeVouch < 1.0 )
	{
		rayQueryEXT nq;
		rayQueryInitializeEXT( nq, tlas, jahAlphaRayFlags( gl_RayFlagsNoneEXT ), 0x0Fu, origin, 0.0, nee.L, maxT );
		JAH_RQ_PROCEED( nq )
		vec3 El = vec3( 0.0 );
		bool neeHit = false, neeFar = false;
		uint nSlot = 0u, nPrim = 0u, nGeom = 0u;
		vec2 nBary = vec2( 0.0 );
		if( rayQueryGetIntersectionTypeEXT( nq, true ) == gl_RayQueryCommittedIntersectionTriangleEXT )
		{
			neeHit = true;
			neeT = rayQueryGetIntersectionTEXT( nq, true );
			nSlot = uint( rayQueryGetIntersectionInstanceCustomIndexEXT( nq, true ) );
			nPrim = uint( rayQueryGetIntersectionPrimitiveIndexEXT( nq, true ) );
			nGeom = uint( rayQueryGetIntersectionGeometryIndexEXT( nq, true ) );
			nBary = rayQueryGetIntersectionBarycentricsEXT( nq, true );
			const mat4x3 nToWorld = rayQueryGetIntersectionObjectToWorldEXT( nq, true );
			vec3 nN = -nee.L;
			const bool nKnown = jahHitGeometricNormal( nSlot, nGeom, nPrim, nToWorld, nee.L, nN );
			jahHitSurf = JahHitSurface( nSlot, nGeom, nPrim, nBary, nToWorld, neeT, false, nKnown );
			El = jahNeeEmission( reflectFootprint( lobeAlpha, neeT ) );
		}
		else if( p.screen2.w > maxT )
		{
			// (a far copy's hit has no material row at the hit: E 0 - and the BRDF's far hit reads none either)
			rayQueryEXT nqFar;
			rayQueryInitializeEXT( nqFar, tlas, jahAlphaRayFlags( gl_RayFlagsNoneEXT ), 0x10u, origin, p.screen2.z, nee.L,
								   p.screen2.w );
			JAH_RQ_PROCEED( nqFar )
			if( rayQueryGetIntersectionTypeEXT( nqFar, true ) == gl_RayQueryCommittedIntersectionTriangleEXT )
			{
				neeHit = true;
				neeFar = true;
				neeT = rayQueryGetIntersectionTEXT( nqFar, true );
				nSlot = uint( rayQueryGetIntersectionInstanceCustomIndexEXT( nqFar, true ) );
			}
		}
		if( any( greaterThan( El, vec3( 0.0 ) ) ) )
		{
			const float lenL = length( origin + nee.L * neeT - world );
			const float eyeD = length( world - thisEye.camPos );
			const vec3 ElT = max( jahFogAlong( El, world.y, nee.L, lenL, eyeD ) -
									  jahFogAlong( vec3( 0.0 ), world.y, nee.L, lenL, eyeD ),
								  vec3( 0.0 ) );
			// (at the NEE direction's own gain: the target t( L_l ) = q( L_l ) gain( L_l ), 11-2 (1))
			neePart = ( 1.0 - neeVouch ) * ElT * ( neeQL / ( neeQL + nee.pdfL ) ) *
					  reflectGainAt( worldN, geomN, V, nee.L, lobeAlpha );
		}
		// THE CONE'S HIT RATE (the lead's condition): the NEE rays, and those whose first hit is the target drawn
		if( JAH_HIT_ON )
		{
			const uint nRays = subgroupAdd( 1u );
			const uint nHits = subgroupAdd( neeHit && !neeFar && nSlot == nee.slot ? 1u : 0u );
			if( subgroupElect() )
			{
				atomicAdd( jahHitBuf[10], nRays );
				atomicAdd( jahHitBuf[11], nHits );
			}
		}
		if( atRest && neeHit && !neeFar && p.motion.w > 0.5 )
		{
			vec3 was;
			neeHitMoving = hitPrevPoint( nSlot, nGeom, nPrim, nBary, origin + nee.L * neeT, was );
		}
		if( !neeHit )
			neeT = maxT;
	}
	if( neeActive && !noSample )
	{
		// THE BRDF's SHARE OF THE EMISSION IT FOUND taken out where the NEE covers it: ( 1 - v ) ( 1 - w_b ) E T
		vec3 corrB = vec3( 0.0 );
		if( slotHit && any( greaterThan( neeEb, vec3( 0.0 ) ) ) )
		{
			const float vb = screenHit ? blendVouch : 0.0;
			const float lenB = length( origin + L * hitT - world );
			const float eyeD = length( world - thisEye.camPos );
			corrB = -gainB * ( 1.0 - vb ) * ( 1.0 - neeWb ) *
					max( jahFogAlong( neeEb, world.y, L, lenB, eyeD ) - jahFogAlong( vec3( 0.0 ), world.y, L, lenB, eyeD ),
						 vec3( 0.0 ) );
		}
		if( record )
			recDelta = corrB + neePart;
		else if( finite3( traced ) )
			traced = max( traced + corrB + neePart, vec3( 0.0 ) );
	}
	// THE RECORD's TRACED LOBE (C2) at the sample's gain and its ray share (the screen's share is the trace's own)
	if( record && recTraced )
		recDelta += gainB * ( blend ? 1.0 - blendVouch : 1.0 ) * recLobe;
	// THE REST'S RESUME TEST (G6; PHOTON-7 8B, B2: against the changed-region list), the ray just traced: a GEOMETRY
	// region across its segment, the lobe's mean segment (the throw), the hit's sun leg, the NEE's segment (11-1b) or
	// C2's secondary rays (its BRDF draw's, its portals' and its image draw's), or the hit itself on a moving slot; or
	// a LIGHT region or a changed brick at its hit, the mean segment's end or C2's hit - resumes the texel.
	if( atRest && !resume && ( p.restLists.x > 0.5 || p.restLists.y > 0.5 || p.restLists.z > 0.5 || p.motion.w > 0.5 ) )
	{
		bool hitMoving = screenHit && screenMoving && p.motion.w > 0.5;
		if( !hitMoving && slotHit && !recFar && p.motion.w > 0.5 )
		{
			vec3 was;
			hitMoving = hitPrevPoint( recSlot, recGeom, recPrim, recBary, origin + L * hitT, was );
		}
		const float t = min( hitT, maxT );
		const float meanT = x.meanT;
		const vec3 meanL = reflect( -V, worldN );
		resume = hitMoving || restSegmentMoved( origin, L, t ) ||
				 ( meanT > 0.0 && restSegmentMovedR( origin, meanL, meanT, restLobeFootprint( lobeAlpha, meanT ) ) ) ||
				 ( hitT < maxT && p.hit.hitSun.w > 0.5 && restSegmentMoved( origin + L * hitT, p.hit.hitSun.xyz, p.hit.hitSun2.z ) ) ||
				 neeHitMoving || ( neeT > 0.0 && restSegmentMoved( origin, nee.L, min( neeT, maxT ) ) );
		for( int k = 0; k < 3 && !resume; ++k )
			resume = jahC2Seg[k].w > 0.0 && restSegmentMoved( jahC2SegO, jahC2Seg[k].xyz, jahC2Seg[k].w );
		// ...AND WHAT ITS HITS READ (B2): a scene change there resumes it at once; an estimate converging there (the
		// caches) resumes it marked, and the readers follow at a code a frame
		if( !resume )
		{
			const uint k0 = hitT < maxT ? restHitKind( origin + L * hitT, reflectFootprint( lobeAlpha, hitT ) ) : 0u;
			const uint k1 = meanT > 0.0 ? restHitKind( origin + meanL * meanT, restLobeFootprint( lobeAlpha, meanT ) ) : 0u;
			const uint k2 = jahC2HitR > 0.0 ? restHitKind( jahC2SegO + jahC2Seg[0].xyz * jahC2Seg[0].w, jahC2HitR ) : 0u;
			const uint most = max( k0, max( k1, k2 ) );
			resume = most > 0u;
			o.card = most == 1u;
		}
	}
	o.L = L; o.traced = traced; o.recN = recN; o.screenRadiance = screenRadiance; o.recBary = recBary;
	o.nee = neePart; o.recDelta = recDelta;
	o.hitT = hitT; o.sampleT = sampleT; o.screenT = screenT; o.blendVouch = blendVouch;
	o.recSlot = recSlot; o.recPrim = recPrim; o.recGeom = recGeom; o.photonSource = photonSource;
	o.ok = ok; o.record = record; o.recFar = recFar; o.slotHit = slotHit; o.screenHit = screenHit;
	o.noSample = noSample; o.blend = blend; o.centre = centre; o.vndf = vndf; o.folded = folded; o.resume = resume;
	// A RECORD'S SUN (the list's word, the write-back's direct light at the hit): a FAR copy's hit is recorded as one
	// (READ_B finding 1, the gather's rule) and its sun leg lifts by the far copy's hand-over.
	o.recGain = gainB;
	o.recTraced = record && recTraced;
	if( record && recTraced )
		o.c2 = recLobe;
	o.sunVis = record ? jahHitSunVisibility( origin + L * hitT, recN, hitT, recFar ) : 1.0;
	if( record )
	{
		// (the area strata's draw: this sample's sequence, as a store hit's - jahHitAreaSeq above)
		jahHitAreaSeq = jahAreaPcg( frame + uint( p.denoiser.z ) ) ^ seedPix.x * 73856093u ^ seedPix.y * 19349663u;
		o.areaVis = jahHitAreaVisWord( origin + L * hitT, recN, hitT, recFar );
	}
}

// THE PICK (binding 56, the reds' instrument: jahlab pick; OgreRayQuery.cpp kReflectPickBinding): while alpha.y's bits
// name a full-resolution pixel (x | y << 12 | the ring's slot << 24 | 1 << 30), the trace texel holding it writes its
// frame's sample into its slot's words 0-31 and the temporal pass its rest terms into 32-47.
layout( std430, set = 0, binding = 56 ) buffer JahPick { uint jahPick[]; };
int jahPickSlot( ivec2 tc )
{
	const uint w = floatBitsToUint( p.alpha.y );
	if( ( w & ( 1u << 30u ) ) == 0u || gEye != 0 )
		return -1;
	const ivec2 full = ivec2( p.resolution.zw );
	const ivec2 traceRes = max( ivec2( p.resolution.xy ), ivec2( 1 ) );
	const ivec2 scale = max( full / traceRes, ivec2( 1 ) );
	const ivec2 px = ivec2( int( w & 4095u ), int( ( w >> 12u ) & 4095u ) );
	return all( equal( px / scale, tc ) ) ? int( ( w >> 24u ) & 63u ) : -1;
}
void jahPickSample( ivec2 tc, JahReflectSample s, uint vNow, uint restStop, bool atRest )
{
	const int slot = jahPickSlot( tc );
	if( slot < 0 )
		return;
	const uint b = uint( slot ) * 64u;
	jahPick[b + 0u] = 1u;   // written
	jahPick[b + 1u] = ( s.ok ? 1u : 0u ) | ( s.record ? 2u : 0u ) | ( s.recFar ? 4u : 0u ) | ( s.slotHit ? 8u : 0u ) |
					  ( s.screenHit ? 16u : 0u ) | ( s.noSample ? 32u : 0u ) | ( s.centre ? 64u : 0u ) |
					  ( s.vndf ? 128u : 0u ) | ( s.resume ? 256u : 0u ) | ( s.recTraced ? 512u : 0u ) |
					  ( atRest ? 1024u : 0u ) | ( s.blend ? 2048u : 0u );
	jahPick[b + 2u] = s.recSlot;
	jahPick[b + 3u] = s.photonSource;
	jahPick[b + 4u] = floatBitsToUint( s.hitT );
	jahPick[b + 5u] = floatBitsToUint( s.L.x );
	jahPick[b + 6u] = floatBitsToUint( s.L.y );
	jahPick[b + 7u] = floatBitsToUint( s.L.z );
	jahPick[b + 8u] = floatBitsToUint( s.traced.x );
	jahPick[b + 9u] = floatBitsToUint( s.traced.y );
	jahPick[b + 10u] = floatBitsToUint( s.traced.z );
	jahPick[b + 11u] = floatBitsToUint( s.c2.x );
	jahPick[b + 12u] = floatBitsToUint( s.c2.y );
	jahPick[b + 13u] = floatBitsToUint( s.c2.z );
	jahPick[b + 14u] = floatBitsToUint( s.nee.x );
	jahPick[b + 15u] = floatBitsToUint( s.nee.y );
	jahPick[b + 16u] = floatBitsToUint( s.nee.z );
	jahPick[b + 17u] = floatBitsToUint( s.screenRadiance.x );
	jahPick[b + 18u] = floatBitsToUint( s.blendVouch );
	jahPick[b + 19u] = floatBitsToUint( s.recGain );
	jahPick[b + 20u] = floatBitsToUint( s.recDelta.x );
	jahPick[b + 21u] = vNow;
	jahPick[b + 22u] = restStop;
	jahPick[b + 23u] = s.recPrim;
	jahPick[b + 24u] = s.c2Slot;
	jahPick[b + 25u] = floatBitsToUint( s.c2T );
	jahPick[b + 26u] = floatBitsToUint( s.c2Brdf.x );
	jahPick[b + 27u] = floatBitsToUint( s.c2Portal.x );
	jahPick[b + 28u] = floatBitsToUint( s.c2Spec.x );
	jahPick[b + 29u] = floatBitsToUint( s.c2Mirror.x );
	jahPick[b + 30u] = s.c2MirrorSlot;
	jahPick[b + 31u] = floatBitsToUint( s.cut.x );
}

// THE TEXEL'S FRAME, FINISHED (main, once per live texel, inside the rest's deal): the batch's folds stored, the state,
// and the frame's sample `s` - a record, no sample, the sample - or, for a batch that folded its whole count, none.
void reflectFinish( ivec2 tc, float dist, vec3 world, vec3 origin, vec3 prevSurf, bool ownMoving, float lobeAlpha,
					EyeImage thisEye, bool atRest, bool restInPlace, bool restBatch, uint batchRays,
					JahReflectState inPlace, uint restStop, float throwT, JahRestStats rs, bool restHasH, float restN,
					uint vNow, uint folds, uint consumed, float restT, bool stoppedCard, bool centreOnly, JahReflectSample s )
{
	jahPickSample( tc, s, vNow, restStop, atRest );   // THE PICK (the reds' instrument; nothing unless the arm names tc)
	bool resume;
	resume = s.resume;
	const bool centre = s.centre, vndf = s.vndf, folded = s.folded;
	const vec3 L = s.L;
	const vec3 traced = s.traced;
	const float hitT = s.hitT;
	const bool record = s.record;
	const bool recFar = s.recFar;
	const uint recSlot = s.recSlot, recPrim = s.recPrim;
	const vec2 recBary = s.recBary;
	const vec3 recN = s.recN;
	const uint photonSource = s.photonSource;
	const vec3 screenRadiance = s.screenRadiance;
	const float screenT = s.screenT;
	const float blendVouch = s.blendVouch;
	const bool noSample = s.noSample, blend = s.blend;
	const float sampleT = s.sampleT;
	// THE BATCH'S FOLDS STORED (the rest half in place, and the residual where the frozen half is free for it - else, for
	// a centre texel, its plain mean there: every reader composes M, the temporal pass's rule for its own fold).
	if( folds > 0u )
	{
		imageStore( historyCur, ivec3( tc, gEye ), jahRoundHalf( vec4( rs.M, rs.m2 ) ) );
		if( jahRestHasResidual( float( vNow ), restHasH, restN ) )
			imageStore( historyPrev, ivec3( tc, gEye ), jahRoundHalf( rs.res ) );
		else if( centreOnly )
			imageStore( historyPrev, ivec3( tc, gEye ), jahRoundHalf( vec4( rs.M, 0.0 ) ) );
	}
	// THE STATE THIS FRAME STORES (jah_reflect_state.glsl): the surface's distance (the texel is live: the temporal pass
	// decides whether it holds an answer), the throw this draw used (the resolve re-derives a neighbour's chance from it;
	// the temporal pass writes the new mean over it), this frame's draw, and - at rest in place - the counts, the stop and
	// the rest's mean length the temporal pass keeps (a resuming texel's stop restarts).
	JahReflectState st = jahStateNone();
	st.surfDist = dist;
	st.hitT = restInPlace ? restT : throwT;
	st.N = restInPlace ? inPlace.N : 0.0;
	st.v = restInPlace ? vNow : 0u;
	st.stop = restInPlace && !resume ? restStop : 0u;
	st.resume = atRest && resume;
	// THE REFINEMENT's MARK (B2): a resume by an ESTIMATE CONVERGING alone (restHitKind 1: the cards, a slab, the store's
	// bricks relighting) - on a stopped texel (its mean hit's test, main) or one still converging - re-rests with its
	// shown answer slewed at a code a frame (the temporal pass). A converging texel too, unlike the gather's active cell:
	// its resume restarts its rest mid-batch, and the eased hand-over of 2N samples at k samples a frame lands the new
	// read in 2N / k frames (measured: rtreflect.lamp_step_held's eref bursts, unchanged when only stopped texels were
	// marked). A scene change resumes at once. The mark is this frame's.
	if( atRest )
	{
		uvec4 rw = imageLoad( restRefine, ivec3( tc, gEye ) );
		const bool reach = resume && ( stoppedCard || s.card );
		const uint w = ( rw.w & ~kRefineReach ) | ( reach ? kRefineReach : 0u );
		if( w != rw.w )
			imageStore( restRefine, ivec3( tc, gEye ), uvec4( rw.xyz, w ) );
	}
	st.centre = centre;
	st.folded = folded;
	st.delta = !centre && !vndf;
	// THE REFLECTOR'S OWN MOTION, for the temporal pass' reprojection (the histories are read there now, Lumen's order):
	// the surface's world-space step since last frame, w = 1 on a moving slot - in the half this frame's mean is written
	// to, at this texel only (the temporal pass reads it, then writes the mean over it). Not at rest: that half holds
	// the rest mean, and nothing moves under a resting texel (a crossing resumes it).
	if( !atRest )
		imageStore( historyCur, ivec3( tc, gEye ), jahRoundHalf( vec4( prevSurf - world, ownMoving ? 1.0 : 0.0 ) ) );
	// THE REST'S ACTIVE TEXELS, counted into the hit list's third counter word (read back several frames late): the
	// view holds once a rest frame counted none (OgreRayQuery.cpp).
	if( atRest && JAH_HIT_ON )
		atomicAdd( jahHitBuf[2], 1u );
	// A BATCH THAT RAN ITS COUNT (every ray folded above): no sample for the temporal pass, which makes the frame's stop
	// test on the rest mean as it now stands.
	if( restBatch && !resume && !record && consumed == batchRays )
	{
		imageStore( reflectSample, ivec3( tc, gEye ), jahRoundHalf( vec4( 0.0 ) ) );
		imageStore( reflectNee, ivec3( tc, gEye ), jahRoundHalf( vec4( 0.0 ) ) );
		imageStore( stateCur, ivec3( tc, gEye ), uvec4( jahStatePack( st ), 0u, 0u ) );
		photonHit( tc, photonSource == 1u ? kPhotonCard : photonSource == 2u ? kPhotonVoxel :
					   photonSource == 4u ? kPhotonScreen : kPhotonSky );
		return;
	}
	if( noSample || ( !record && !finite3( traced ) ) )
	{
		// NO SAMPLE THIS FRAME - a non-finite answer is no evidence about this pixel, nor is a sample the screen alone
		// left unanswered (noSample): the resolve reconstructs the texel from its neighbours' samples, else the temporal
		// pass carries its history (or finds it holds no answer).
		imageStore( reflectSample, ivec3( tc, gEye ), jahRoundHalf( vec4( 0.0 ) ) );
		imageStore( reflectNee, ivec3( tc, gEye ), jahRoundHalf( vec4( 0.0 ) ) );
		imageStore( stateCur, ivec3( tc, gEye ), uvec4( jahStatePack( st ), 0u, 0u ) );
		photonHit( tc, kPhotonDropped );
		return;
	}
	if( record )
	{
		// THE RECORD: the write-back (rq_hit_composite) writes the decoded radiance and its distance as this frame's
		// SAMPLE - the radiance arriving one pass later, before the resolve reads it. A record the decode leaves
		// unshaded, or one a full list dropped (counted), is no sample.
		// (A BLENDED sample's record: the screen's share is written here, the write-back adds the ray's - the record's
		// weight - or, unshaded, takes the screen's answer whole.)
		imageStore( reflectSample, ivec3( tc, gEye ),
					jahRoundHalf( blend ? vec4( blendVouch * screenRadiance, blendVouch * screenT ) : vec4( 0.0 ) ) );
		const vec3 hitPos = origin + L * hitT;
		// A FAR COPY'S HIT IS RECORDED AS ONE (READ_B finding 1, the gather's rule): the decode reads the coarsest
		// level's triangle `prim` (bit 27) and the sun leg lifts by the far copy's hand-over - a near-flagged record
		// shaded triangle `prim` of level 0, another place of the mesh.
		const float sunVis = s.sunVis;   // (reflectSampleAt's: the sun leg at the hit)
		const bool appended = jahHitAppend( recSlot, recFar, recPrim, recBary, L, sunVis, reflectFootprint( lobeAlpha, hitT ),
											blend ? 1.0 - blendVouch : 1.0, jahHitDestPack( tc, false, gEye ), world.y,
											length( hitPos - world ), length( world - thisEye.camPos ), s.recDelta, s.recGain,
											s.recPane, s.recTraced, s.areaVis );
		if( blend && !appended )   // a full list: the screen's answer whole, never its share alone
			imageStore( reflectSample, ivec3( tc, gEye ), jahRoundHalf( vec4( screenRadiance, screenT ) ) );
		// (the NEE part rides the record's delta into the sample; here it is the resolve's - none for a sample short of it)
		imageStore( reflectNee, ivec3( tc, gEye ), jahRoundHalf( vec4( appended ? s.nee : vec3( 0.0 ), 0.0 ) ) );
		imageStore( stateCur, ivec3( tc, gEye ), uvec4( jahStatePack( st ), 0u, 0u ) );
		photonHit( tc, appended ? kPhotonList : kPhotonDropped );
		return;
	}
	// THE SAMPLE: the radiance and the hit's distance (an escape's is a length no hit has, so its virtual point lies
	// beyond every surface: the sky's history moves with the camera's turn alone).
	imageStore( reflectSample, ivec3( tc, gEye ), jahRoundHalf( vec4( clamp( traced, vec3( 0.0 ), vec3( kMaxRadiance ) ), sampleT ) ) );
	imageStore( reflectNee, ivec3( tc, gEye ), jahRoundHalf( vec4( clamp( s.nee, vec3( 0.0 ), vec3( kMaxRadiance ) ), 0.0 ) ) );
	imageStore( stateCur, ivec3( tc, gEye ), uvec4( jahStatePack( st ), 0u, 0u ) );
	photonHit( tc, photonSource == 1u ? kPhotonCard : photonSource == 2u ? kPhotonVoxel :
				   photonSource == 4u ? kPhotonScreen : kPhotonSky );
}

void main()
{
	const ivec2 traceRes = ivec2( p.resolution.xy );
	// A LANE WHOSE TEXEL TRACES NOTHING STAYS TO THE REST'S DEAL (below) as a worker - one past the image's edge too
	// (its reads clamped inside): its outcome stored, `live` false, and every later side effect guarded by it - the
	// values computed past this point on its texel are never used.
	// THE REST'S COMPACT PATH: the list this frame's tile pass fills (its half), and whether last frame's count was within
	// the path's bound L (p.compact.z) - then every texel it lists this frame is the compact pass's. The converging set
	// does NOT only shrink at rest: resumes (a crossing, a card-only reach) and late first samples re-list texels, and it
	// was measured to swing 8,827 -> 83,695 between two frames (DETERMINISM-1, rf 141-142) - so a half holds the whole
	// trace grid (compactCap: the buffer's own length) and a listing never overflows: no texel is traced by neither pass,
	// and which texels the compact pass takes never depends on the order of the listing's atomics.
	const uint compactL = uint( p.compact.z );
	const uint compactCap = ( uint( compactWords.length() ) - kCompactHeaderWords ) / 2u;
	const uint compactHalf = uint( p.compact.x ) & 1u;
	const uint compactBase = kCompactHeaderWords + compactHalf * compactCap;
	const uint compactPrev = compactWords[compactHalf ^ 1u];
	const bool compactOn = p.compact.w > 0.5 && compactPrev > 0u && compactPrev <= compactL;
	ivec2 gid = ivec2( gl_GlobalInvocationID.xy );
	bool compactOwner = true;
	uint compactN = 0u;
	bool compactDense = false;
	if( kCompactPass )
	{
		// THE MODE BY THIS FRAME'S COUNT (final once the tile pass has listed: the barrier in front of this pass), never by
		// last frame's: up to L a subgroup a listed texel (the slot uniform in the subgroup: the whole subgroup leaves
		// together); past L, DENSE - a lane a listed texel, as the tile pass would have traced it (its k, its deal, its
		// allowance below: each texel's result is the one the tile pass computes - the deal is per texel, in sample
		// order). One dispatch, the larger of the two modes' groups (the tile pass's atomicMax); the groups past this
		// mode's need leave at once.
		compactN = min( compactWords[compactHalf], compactCap );
		compactDense = compactN > compactL;
		if( !compactOn )
			return;
		uint slot;
		if( compactDense )
		{
			slot = gl_WorkGroupID.x * ( gl_WorkGroupSize.x * gl_WorkGroupSize.y ) + gl_LocalInvocationIndex;
			if( subgroupAll( slot >= compactN ) )
				return;
			compactOwner = slot < compactN;   // a lane past the count stays a worker in its subgroup's deal
		}
		else
		{
			slot = gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID;
			if( slot >= compactN )
				return;
			compactOwner = gl_SubgroupInvocationID == 0u;
		}
		const uint packed = compactWords[compactBase + min( slot, compactN - 1u )];
		gid = ivec2( int( packed & 0xFFFFu ), int( packed >> 16u ) );
	}
	bool live = all( lessThan( gid, traceRes ) ) && compactOwner;
	const ivec2 tc = min( gid, traceRes - 1 );

	// The pixel this ray is traced FOR is its block's centre pixel at full resolution (jahTexelPixel: read exactly, so
	// the point reconstructed is on that pixel's drawn surface - the ray origin's law, below).
	const ivec2 fullRes = ivec2( p.resolution.zw );
	const ivec2 scale = max( fullRes / max( traceRes, ivec2( 1 ) ), ivec2( 1 ) );
	const ivec2 px = jahTexelPixel( tc, scale, fullRes );
	const vec2 uv = jahTexelUv( tc, scale, fullRes );
	// WHICH EYE THIS PIXEL BELONGS TO (lane REFLECT-VR-1, LAYERED-STEREO-1): the
	// dispatch's z, the layer of every screen image; `uv` is that eye's own
	// image coordinate, and every RAY below is built through that eye's basis.
	gEye = int( gl_GlobalInvocationID.z );
	const int eye = gEye;
	const vec2 localUv = uv;
	const EyeImage thisEye = eyeNow( eye );
	// THE SAMPLE SEQUENCE IS KEYED ON THE EYE'S OWN PIXEL (VR-MONO-PARITY-1): the
	// ray NOISE of the two eyes is the same at one pose, and that is correct —
	// it is averaged into a temporal mean, and an eye's mean must not depend on
	// which eye it is. With layers the pixel IS the eye's own.
	const ivec2 seedPix = tc;

	const float rawDepth = texelFetch( sceneDepth, ivec3( px, gEye ), 0 ).x;
	// Cleared depth at EITHER extreme is "nothing was drawn here" — correct with
	// and without reverse Z, the same test the march makes.
	if( live && ( rawDepth <= 0.0 || rawDepth >= 1.0 ) )
	{
		imageStore( stateCur, ivec3( tc, gEye ), uvec4( 0u ) );
		photonHit( tc, kPhotonNoRay );
		live = false;
	}
	const float roughGate = p.knobs.x;
	const float feather = p.projParams.w;
	// WHAT THE G-BUFFER'S .y ACTUALLY IS, and getting this wrong is a factor of
	// ten in the lobe (second reader, C1). It is the GGX ALPHA — HlmsPbs runs
	// with `mPerceptualRoughness` true, so `pixelData.roughness` in the piece
	// that writes this channel is the perceptual value SQUARED (CLAUDE.md) —
	// packed by fork 16d8e29d4 (was 0043) over [0.001, 1] and NOT over upstream's old
	// [0.02, 1]. Decoding it with the old range and then squaring it again ran
	// the lobe at perceptual to the FOURTH power: a surface authored at 0.3 was
	// traced as though it were 0.095, about ten times too sharp.
	//
	// The gate and the feather below are compared in PERCEPTUAL roughness,
	// because that is the number the World row shows and the owner states the
	// dial in. alpha 0.4 would be perceptual 0.63 — a different surface.
	const float alpha = max( texelFetch( gBufShadowRoughness, ivec3( px, gEye ), 0 ).y * 0.999 + 0.001, 1e-6 );
	const float roughness = sqrt( alpha );
	// TRACED UP TO THE FEATHER'S FAR EDGE, not to the cutoff: the band above the
	// cutoff is exactly where the two answers are being crossfaded, and a pixel
	// in it with no ray would make the crossfade a step again.
	if( live && roughness > roughGate + feather )
	{
		imageStore( stateCur, ivec3( tc, gEye ), uvec4( 0u ) );
		photonHit( tc, kPhotonNoRay );
		live = false;
	}
	vec3 normalVS = texelFetch( gBufNormals, ivec3( px, gEye ), 0 ).xyz * 2.0 - 1.0;
	if( live && dot( normalVS, normalVS ) < 1e-6 )
	{
		imageStore( stateCur, ivec3( tc, gEye ), uvec4( 0u ) );
		photonHit( tc, kPhotonNoRay );
		live = false;
	}
	normalVS = normalize( normalVS );

	const float dist = viewDistance( rawDepth );
	const vec3 world = worldAt( thisEye, localUv, dist );
	// The G-buffer normal is in Ogre's RIGHT-HANDED view space (HlmsPbs writes
	// `pixelData.normal` straight out — JahSsrRayMarch_ps.glsl's own note, which
	// is why the march negates z to march in a left-handed one). viewAxis* are
	// that space's three axes expressed in world space, so this is the plain
	// rotation back and nothing here has to know the handedness at all.
	const vec3 worldN = normalize( p.viewAxisX.xyz * normalVS.x +
								   p.viewAxisY.xyz * normalVS.y +
								   p.viewAxisZ.xyz * normalVS.z );

	const vec3 V = thisEye.perspective < 0.5 ? -thisEye.fwd
												: normalize( thisEye.camPos - world );
	if( live && dot( worldN, V ) <= 0.0 )
	{
		imageStore( stateCur, ivec3( tc, gEye ), uvec4( 0u ) );
		photonHit( tc, kPhotonNoRay );
		live = false;
	}
	// ---- THE RAY ORIGIN (PHOTON-7 stage 6, AB E15, READ_B F3; the one law of every ray job, jah_ray_origin.glsl) -----
	// The ray starts on the pixel's DRAWN surface - Atom's cut or a stock item's LOD - and traces the meshes' LEVEL 0
	// (ONE RAY LEVEL PER MESH): it is lifted along the GEOMETRIC normal (the G-buffer's is the shaded one, normal maps
	// included) by the reconstructed point's float bound plus the drawn surface's bound against level 0 at the point's
	// EUCLIDEAN distance from THIS eye (knobs2.y: Types.h rayOriginDrawnFootprints - the tolerance x the LOD bias over
	// the view's band, x the bake's drift ratio), tMin 0. The 1/2-cell bias it replaces (3.9 cm at Epic, also as tMin)
	// lifted the ray over a post's foot: the contact's reflection was missing for 99 rows at 1 m.
	// THE POINT'S OWN ERROR beyond the float bound (READ_B F5 (b)): the depth's quantum and the sub-pixel snap
	// (jahDepthPointError; alpha.z = the snap in pixels, 0 = the term off: rays.originPoint).
	gNormalEye = thisEye;
	const vec3 geomN = jahGeometricNormal( px, fullRes, rawDepth, world, worldN, V );
	const bool perspective = thisEye.perspective > 0.5;
	const float pixelSize = length( thisEye.rayDown ) / float( fullRes.y ) * ( perspective ? dist : 1.0 );
	const float pointError = jahDepthPointError( rawDepth, dist, p.projParams.y, perspective,
												 perspective ? ( world - thisEye.camPos ) / dist : thisEye.fwd,
												 thisEye.fwd, geomN, pixelSize, p.alpha.z );
	const vec3 origin = jahRayOrigin( world, geomN, dist,
									  pointError + jahViewDrawnBound( p.knobs2.y, world, thisEye.camPos, thisEye.rayDown,
																	  float( fullRes.y ), perspective ) );

	// ---- AT REST, PER TEXEL (PHOTON-2 round 2: R1, G6; jah_reflect_rest.glsl) ----------------------------------
	// knobs2.x = the rest frame k (1, 2, ...), 0 while moving, -1 on the frame that BREAKS a rest (the compose
	// pass ran first: G2). From k = 2 the ping-pong does not flip: the frozen history H is the half this pass reads, the
	// rest mean M the half it writes - in place: this pass folds its batch into it (below), the temporal pass a frame's
	// sample. A texel whose rest has
	// STOPPED (its rest mean's standard error under a code for kReflectStopFrames frames: its state's stop count)
	// traces nothing - unless a moved instance crossed its lobe's mean segment this frame (G6): then it RESUMES.
	const float restK = p.knobs2.x;
	const bool atRest = restK >= 0.5;
	const bool restInPlace = restK >= 1.5;
	// THE TEXEL'S STATE IN PLACE at rest (its rest half: the counts, the stop, the mean length so far).
	const JahReflectState inPlace = restInPlace ? jahStateUnpack( imageLoad( stateCur, ivec3( tc, gEye ) ).xy )
												: jahStateNone();
	const uint restStop = restInPlace ? inPlace.stop : 0u;
	// THE TILE PASS LISTS each texel still converging (the stop's own state, as the trace reads it) into this frame's
	// half, and leaves it to the compact pass when last frame's count was within L. The slot is always inside the half
	// (it holds the grid; `stored` is the invariant, kept), and only a STORED texel leaves the tile pass. On a compact
	// frame the texel opening a group raises the indirect dispatch to cover it - a group of gl_NumSubgroups slots below
	// L (the warp mode's), a group of the workgroup's lanes at any slot (the dense mode's): the groups end at the larger,
	// max( ceil( min( count, L ) / gl_NumSubgroups ), ceil( count / 64 ) ), whatever order the atomics took (atomicMax).
	if( !kCompactPass && live && p.compact.w > 0.5 && restInPlace && inPlace.v >= 1u && restStop < kReflectStopFrames )
	{
		const uint at = atomicAdd( compactWords[compactHalf], 1u );
		const bool stored = at < compactCap;
		if( stored )
			compactWords[compactBase + at] = uint( tc.x ) | ( uint( tc.y ) << 16u );
		if( compactOn && stored )
		{
			const uint lanes = gl_WorkGroupSize.x * gl_WorkGroupSize.y;
			if( at < compactL && at % gl_NumSubgroups == 0u )
				atomicMax( compactWords[kCompactDispatchWord], at / gl_NumSubgroups + 1u );
			if( at % lanes == 0u )
				atomicMax( compactWords[kCompactDispatchWord], at / lanes + 1u );
			live = false;   // the compact pass's (this lane works in the tile's deal)
		}
	}
	bool resume = false, stoppedCard = false;
	if( live && restStop >= kReflectStopFrames )
	{
		const float meanT = inPlace.hitT;
		const vec3 meanL = reflect( -V, worldN );
		const float meanR = restLobeFootprint( max( alpha, 1e-4 ), meanT );   // (the whole lobe's: B2's (e))
		const uint meanKind = meanT > 0.0 ? restHitKind( origin + meanL * meanT, meanR ) : 0u;
		const bool real = meanT > 0.0 && ( restSegmentMovedR( origin, meanL, meanT, meanR ) || meanKind == 2u );
		stoppedCard = !real && meanKind == 1u;
		if( !real && !stoppedCard )
		{
			// (a stopped texel still REFINING - B2's code-a-frame slew - is still active: the view holds once each arrived)
			if( JAH_HIT_ON && ( imageLoad( restRefine, ivec3( tc, gEye ) ).w & kRefineRefining ) != 0u )
				atomicAdd( jahHitBuf[2], 1u );
			// No sample - and the texel's state is left as it is. A CAPPED texel (its count at the field's ceiling: it
			// stopped by the cap, not by its standard error) is counted every frame into the hit list's fourth word -
			// RayQueryStatus::reflectRestCapped, the defect reading (commit 8).
			if( inPlace.v >= kReflectRestVCap && JAH_HIT_ON )
				atomicAdd( jahHitBuf[3], 1u );
			imageStore( reflectSample, ivec3( tc, gEye ), jahRoundHalf( vec4( 0.0 ) ) );
			photonHit( tc, kPhotonRest );
			live = false;
		}
		else
			resume = true;
	}

	// ---- THE DRAW (jah_reflect_draw.glsl: the mirror ramp, PHOTON-7 stage 6 commit 6) --------------------------------
	// The lobe is the alpha decoded above — NOT squared again; see the note there. THE CENTRE RAY'S CHANCE is the lobe's
	// footprint at its hit in trace texels - its THROW, the state's temporal mean of the resolved hit distance (the
	// texel's own last frame: the half the ping-pong hands this frame; at rest the frozen half, constant through the
	// rest) - against one trace texel's width at the reflected image: p( f ) = 1 - smoothstep( 0.8, 1.25, f ). A lobe
	// under one texel takes the centre ray (it IS the integral: no variance, the mirror's speckle never shows), a wide one
	// the GGX sample (the temporal mean averages it), between a continuous mixture - no flag, no hysteresis, no restart
	// (the fixed estimator's switch, AB E6, deleted). A centre draw fixes every random input (the screen's coin, the hit's
	// mover-visibility rays turn per texel, never per frame).
	const float lobeAlpha = max( alpha, 1e-4 );
	const JahReflectState ownState = jahStateUnpack( imageLoad( statePrev, ivec3( tc, gEye ) ).xy );
	const float throwT = ownState.surfDist > 0.0 ? ownState.hitT : 0.0;
	const float centreChance = jahReflectCentreChance( alpha, throwT, length( world - thisEye.camPos ),
													   length( thisEye.rayDown ) / float( traceRes.y ),
													   thisEye.perspective > 0.5 );

	// THIS SURFACE, LAST FRAME (REFLECT-MOVERS-1) - Lumen's velocity term, handed to the temporal pass' reprojection
	// (below). A pixel the id pass drew for a slot that MOVED this frame was at that slot's previous pose: its point is
	// carried back through the slot's two transforms. Every other pixel — a still surface, a mover at rest, an item the
	// id pass does not draw, a chain with no id pass — is where it is, and takes the camera path.
	vec3 prevSurf = world;
	bool ownMoving = false;
	if( live && p.motion.x > 0.5 )
	{
		const ivec2 idPx = clamp( ivec2( uv * p.motion.yz ), ivec2( 0 ), ivec2( p.motion.yz ) - 1 );
		// NOT THE ID'S SURFACE (ID-DEPTH-1, rq_motion.comp's test): a stock-drawn surface
		// (a character, a front-culled twin) nearer than the id pass's own depth was drawn
		// after it, and the id names the mover BEHIND it. Such a pixel is not that
		// mover's: it takes the posed identification below, else the camera path.
		const bool idSurface = !jahNotIdSurface( dist, viewDistance( texelFetch( idDepth, idPx, 0 ).x ) );
		const uint idX = idSurface ? texelFetch( atomIds, idPx, 0 ).x : JAH_ATOM_ID_EMPTY;
		if( idX != JAH_ATOM_ID_EMPTY )
		{
			const MovedSlot own = movedSlot( idX & JAH_ATOM_ID_SLOT_MASK );
			if( own.moved )
			{
				ownMoving = true;
				prevSurf = movedPrevPosition( own, world );
			}
		}
		if( !ownMoving && p.motion.w > 2.5 && thisEye.perspective > 0.5 )
		{
			// A PIXEL NO MOVING ATOM ITEM DREW, WHILE A POSE MOVES (SKINNED-VELOCITY-1):
			// a character is stock-drawn (atomRouteFor keeps a skinned item on PBS), so
			// the id image cannot say it moved — and it is not EMPTY there either: the
			// id pass has its own depth and holds whatever Atom surface lies BEHIND the
			// character (the floor), measured on gi.reflect_mover. One ray along this pixel's own view
			// ray over a 1 % window around its depth asks the TLAS — built over this
			// frame's pose — which surface it is; a posed hit's previous point comes
			// from the skin cache's previous-pose slice (jah_skin_prev.glsl, the
			// march's velocity job's own text). The normal is taken as it is now:
			// one frame of a limb's turn moves the virtual-image construction by far
			// less than the lobe it averages.
			const vec3 ray = thisEye.rayTL + thisEye.rayRight * localUv.x + thisEye.rayDown * localUv.y;
			rayQueryEXT idq;
			rayQueryInitializeEXT( idq, tlas, gl_RayFlagsOpaqueEXT, 0x0Fu, thisEye.camPos, dist * 0.99, ray,
								   dist * 1.01 );
			while( rayQueryProceedEXT( idq ) )
			{
			}
			if( rayQueryGetIntersectionTypeEXT( idq, true ) == gl_RayQueryCommittedIntersectionTriangleEXT )
			{
				const uint idSlot = uint( rayQueryGetIntersectionInstanceCustomIndexEXT( idq, true ) );
				vec3 was;
				if( idSlot < JAH_HIT_INSTANCES && ( jahHitFlags( idSlot ) & kJahHitGpuSkinned ) != 0u &&
					jahSkinnedPrevPoint( idSlot, uint( rayQueryGetIntersectionGeometryIndexEXT( idq, true ) ),
										 uint( rayQueryGetIntersectionPrimitiveIndexEXT( idq, true ) ),
										 rayQueryGetIntersectionBarycentricsEXT( idq, true ), world, was ) )
				{
					ownMoving = true;
					prevSurf = was;
				}
			}
		}
	}

	// ---- THE ONE ESTIMATOR (PHOTON-7 stage 6): the screen, the TLAS near ray, the far copies, the sky ----------------
	const float maxT = p.knobs.y;
	const EyeImage before = eyeBefore( eye );
	gExposure = exposureOf();
	// THE REST'S BATCH (commit 8, PREFLIGHT_R section 3): at rest IN PLACE a texel still converging traces the tier's
	// rest count of rays a frame (p.rest.z), each the rest sequence's NEXT sample (v + i: the sample index, never the
	// frame's), and FOLDS each answer the caches give into its rest mean HERE - the rest owns its texel (the in-place
	// halves), so no other invocation reads or writes it this pass. THE FIRST RAY THAT NEEDS A RECORD ENDS THE BATCH:
	// one record per texel per frame is a hard limit (one decode a frame; the write-back writes the sample at the
	// record's texel), and the record's sample folds in the temporal pass as the sequence's next - so the batch is the
	// sequence's order, unbiased and deterministic; a dropped record is no sample and the same index is retried next
	// frame. A ray that crosses a moved instance (G6) ends it too: the texel resumes on that sample. One ray a frame
	// otherwise - moving, the first rest frame, a DETERMINISTIC sample (below), the reference arm, the freeze.
	// The batch's rays are DEALT across the subgroup's lanes (below), its folds made in this order all the same.
	// A DETERMINISTIC SAMPLE (DETERMINISM-1, the R13 tail): a lobe under a texel draws its centre ray every time
	// (centreChance 1: no lobe draw, the screen's coin fixed, no NEE - the NEE pairs only a VNDF draw), but its SAMPLE is
	// still stochastic wherever the HIT's shading is: C2's traced lobe at the hit (its own VNDF draw, keyed on the sample
	// index) and the hit's area-light stratum (jahHitAreaSeq / the rest's cycle) - known only once the hit is. Measured on
	// photon-glass: the far wall's mirror texels reflecting the r0.3 floor pane read a card (~0.0107, constant) and ALL
	// their noise is C2's lobe there (0.010-0.060, CV ~1); at one sample a frame their stop needed ~1,400-1,700 rest frames
	// (116-285 texels; the walk's hold refused at 1,200). So a centre texel is excluded from the batch only where no hit
	// can be stochastic: C2 off - the flat-hits arm (p.denoiser.w: every hit a constant of its instance) - and otherwise
	// batched like every texel (the price: its rays at rest until it stops).
	const bool centreOnly = centreChance >= 1.0;
	const bool centreFixed = centreOnly && p.denoiser.w > 0.5;
	const bool restBatch = live && restInPlace && !resume && p.rest.x < 0.5 && p.rest.y < 0.5 && !centreFixed &&
						   p.rest.z > 1.5;
	// THE BATCH: the tile pass's k (the rest's first frame's), the compact pass's the tail's rays a frame shared by the
	// listed texels, k = min( 64, ( count / 8 ) / listed ) - each texel's samples over its own warp's lanes.
	// (the DENSE mode takes the tile pass's k: its texels are the tile pass's own, handed over)
	const bool compactWarp = kCompactPass && !compactDense;
	const uint compactK = compactWarp ? clamp( uint( p.compact.y ) / max( compactN, 1u ), 1u, 64u ) : 0u;
	const uint batchRays = restBatch ? ( compactWarp ? compactK : uint( p.rest.z ) ) : 1u;
	uint vNow = restInPlace ? inPlace.v : 0u;   // the samples the rest mean holds
	float restT = restInPlace ? inPlace.hitT : throwT;   // the rest's mean length
	uint folds = 0u;
	JahRestStats rs;
	bool restHasH = false;
	const float restN = max( p.stereo.w, 1.0 );
	// (the space the rest folds in, for the write-back's fold of the record runs: one invocation writes it)
	if( JAH_HIT_ON && all( equal( gl_GlobalInvocationID, uvec3( 0u ) ) ) )
	{
		jahHitBuf[5] = floatBitsToUint( gExposure );
		jahHitBuf[6] = floatBitsToUint( restN );
		// THE REST'S BOUND's two words (PHOTON-7 11-1c): zeroed on every frame up to the rest's 2N, where the temporal
		// pass fills them; past it they hold that frame's (the host's copy of every later frame reads them)
		if( restK <= 2.0 * restN + 0.5 )
		{
			jahHitBuf[8] = 0u;
			jahHitBuf[9] = 0u;
		}
	}
	vec4 restHr = vec4( 0.0 );
	if( restBatch )
	{
		restHr = imageLoad( historyPrev, ivec3( tc, gEye ) );
		restHasH = finite3( restHr.xyz ) && ownState.N > 0.0;
		const vec4 Mt = imageLoad( historyCur, ivec3( tc, gEye ) );
		rs.M = vNow > 0u && finite3( Mt.xyz ) ? Mt.xyz : ( restHasH ? restHr.xyz : vec3( 0.0 ) );
		rs.m2 = vNow > 0u && finite1( Mt.w ) ? Mt.w : 0.0;
		rs.res = jahRestHasResidual( float( vNow ), restHasH, restN ) && finite3( restHr.xyz ) &&
						 finite1( restHr.w )
					 ? restHr
					 : vec4( 0.0 );
	}
	// ---- THE REST'S RAYS SPREAD ACROSS THE SUBGROUP'S LANES (L7; the lead's ruling after the hold's tail) ------------
	// A batching texel traces k_active samples (p.rest.z: the view's rest count shared by the texels still converging,
	// OgreRayQuery.cpp kReflectRestRaysCap's note). As a loop in its own thread a few scattered converging texels made
	// every warp run k_active SERIAL rays for a few lanes (measured: 1.9 ms against the rest's first frame's 1.03 while
	// ~16,000 converged; two texels' 32 serial rays a millisecond of latency). So the subgroup DEALS its texels' samples
	// one per LANE - the texels in lane order, each its samples in sequence order: a fixed order, deterministic, no
	// atomics, no memory; every lane is a worker, a stopped texel's, a gated one's and one past the edge too (they stay
	// to here) - a lane traces the sample it is dealt from its owner's inputs (shuffled), and the answers go back to
	// their texel IN ORDER, which folds them into its rest mean exactly as one thread would, ENDED at the first sample
	// that is no fold (a record - one per texel per frame, unchanged -, a resume, no evidence, the count's ceiling):
	// that sample's index is then the frame's sample, traced again by the texel itself (the same inputs, the same
	// answer) and handled as without a batch; the dealt samples behind it are dropped. A subgroup whose texels still
	// need m samples costs ceil( m / lanes ) rounds, not its largest batch. ONE LOOP, ONE CALL OF EACH: a lane traces
	// its own frame's sample, and finishes its texel, in a round where it is dealt nothing - the estimator's text is
	// one inlined copy (measured: a second call site of reflectSampleAt made the whole trace 3x slower, the deal
	// unused included).
	JahReflectTexel self;
	self.world = world;
	self.worldN = worldN;
	self.V = V;
	self.geomN = geomN;
	self.origin = origin;
	self.alpha = alpha;
	self.centreChance = centreChance;
	self.meanT = restInPlace ? inPlace.hitT : throwT;
	self.seedPix = seedPix;
	self.px = px;
	bool batchEnded = false, batchFull = false;
	uint lastBits = 0u;   // the last folded sample's draw and source (a full batch's state and photon class)
	// THE TEXEL'S PHASE: 0 its batch is being dealt, 1 its own sample (or a full batch's finish) is due, 2 done
	uint phase = !live ? 2u : restBatch ? 0u : 1u;
	const uvec4 lanes = subgroupBallot( true );
	const uint laneCount = subgroupBallotBitCount( lanes );
	const uint rank = subgroupBallotExclusiveBitCount( lanes );
	// A WHOLE SUBGROUP (every lane here: a lane's rank is its id) deals by binary search; a partial one (a device whose
	// subgroups the workgroup does not fill) by walking its lanes - the same deal, the same order.
	const bool whole = laneCount == gl_SubgroupSize;
	const uint vStart = vNow;
	// THE RECORD RUN (the lead's ruling after the S diagnostic): a batching texel may hand up to `allowance` of its
	// records a frame to the list as ONE contiguous run, in sample order - the write-back folds them into its
	// rest mean (rq_hit_composite.comp). A BLENDED record rides it too (the lead's ruling after the Both-at-S probe: on a
	// silhouette in the screen's fade the batch ended at the first one, ~4 folds of 64 a frame): the record carries the
	// screen's share and the write-back folds the WHOLE sample, vouch x screen + ( 1 - vouch ) x ray, as one (the mean is
	// linear in its parts, the moments the stop reads are not); the trace writes nothing of it into the texel's sample.
	// A record past the allowance, or one the list cannot hold, ends the batch as
	// before. allowance = min( k_active, capacity / batching ) (the host's, p.rest.w): the list's existing capacity is
	// the count. A texel's run is the records of ONE round of the deal (one reservation): the rounds after it end at a
	// record. THE COMPACT PASS's share is of what the list has LEFT after the records in it before this pass (the host's
	// copy of the count, one value for every texel - never the live counter, which this pass's own runs raise), less the
	// one record a texel's own sample may still append: compactN ( allowance + 1 ) <= left, so its runs never reach
	// the drop.
	// (the DENSE mode's is the tile pass's, p.rest.w: its texels' runs are what the tile pass would have reserved)
	const uint compactLeft = compactWarp ? JAH_HIT_CAPACITY - min( compactWords[kCompactRecordsWord], JAH_HIT_CAPACITY )
										 : 0u;
	const uint compactShare = compactLeft / max( compactN, 1u );
	// A CENTRE TEXEL hands NO run: its frozen half holds its plain mean while it hands over (the temporal pass writes M
	// there - a centre texel composes M, never lerp( H, M ) - and so does its batch's store, reflectFinish), which the
	// write-back's run fold (rq_hit_composite.comp) cannot keep (it knows no texel's chance); its record ends its batch
	// and is the frame's sample, folded by the temporal pass, which keeps the frozen half its mean.
	const uint allowance = centreOnly ? 0u
						 : compactWarp ? min( batchRays, compactShare > 0u ? compactShare - 1u : 0u )
									   : min( uint( p.rest.w ), batchRays );
	uint runUsed = 0u;                               // this texel's records in its run this frame
	uint dealt = 0u;                                 // this texel's samples dealt so far
	uint remaining = restBatch ? batchRays : 0u;     // ...and still to deal
	while( subgroupAny( remaining > 0u || phase == 1u ) )
	{
		// THE DEAL: slot `rank` of this round is the sample `index` of the texel whose run of slots holds it.
		const uint ahead = subgroupExclusiveAdd( remaining );
		const uint total = subgroupAdd( remaining );
		uint owner = gl_SubgroupInvocationID, index = 0u;
		const bool job = rank < total;
		JahReflectTexel x = self;
		if( total > 0u )
		{
			if( whole )
			{
				// the owner: the first lane whose run ends past this slot (the ends rise with the lane id)
				const uint runEnd = ahead + remaining;
				uint i = 0u;
				for( uint step = gl_SubgroupSize >> 1u; step > 0u; step >>= 1u )
					if( subgroupShuffle( runEnd, i + step - 1u ) <= rank )
						i += step;
				if( job )
					owner = i;
			}
			else
			{
				uvec4 left = lanes;
				for( uint r = 0u; r < laneCount; ++r )
				{
					const uint q = subgroupBallotFindLSB( left );
					left[q >> 5u] &= ~( 1u << ( q & 31u ) );
					const uint qAhead = subgroupShuffle( ahead, q );
					const uint qLeft = subgroupShuffle( remaining, q );
					if( job && rank >= qAhead && rank < qAhead + qLeft )
						owner = q;
				}
			}
			index = rank - subgroupShuffle( ahead, owner );
			x.world = subgroupShuffle( self.world, owner );
			x.worldN = subgroupShuffle( self.worldN, owner );
			x.V = subgroupShuffle( self.V, owner );
			x.geomN = subgroupShuffle( self.geomN, owner );
			x.origin = subgroupShuffle( self.origin, owner );
			x.alpha = subgroupShuffle( self.alpha, owner );
			x.centreChance = subgroupShuffle( self.centreChance, owner );
			x.meanT = subgroupShuffle( self.meanT, owner );
			x.seedPix = subgroupShuffle( self.seedPix, owner );
			x.px = subgroupShuffle( self.px, owner );
		}
		const uint first = subgroupShuffle( vStart + dealt, owner );
		// THIS LANE'S WORK this round: a dealt sample, else its own frame's (its index the frame's while moving, at rest
		// the rest sequence's next: vNow), else nothing
		const bool mine = !job && phase == 1u;
		JahReflectSample s = jahReflectSampleNone( x );
		s.resume = mine && resume;
		if( job || ( mine && !batchFull ) )
			reflectSampleAt( x, thisEye, before, fullRes, atRest,
							 job ? uint( p.knobs.z ) + first + index
								 : atRest ? uint( p.knobs.z ) + vNow + runUsed : uint( p.knobs.z ),
							 s );

		// THE ANSWERS BACK, in the deal's order (each texel's run of slots: its sequence order).
		if( total > 0u )
		{
			const uint bits = ( job ? 1u : 0u ) |
							  ( s.resume || s.record || s.noSample || !finite3( s.traced ) ? 2u : 0u ) |
							  ( s.centre ? 4u : 0u ) | ( s.vndf ? 8u : 0u ) | ( s.folded ? 16u : 0u ) |
							  ( s.photonSource << 5u ) |
							  ( s.record && !s.resume && !s.noSample ? 256u : 0u );   // a run's candidate
			const uint mySlots = ahead >= laneCount ? 0u : min( remaining, laneCount - ahead );
			if( whole )
			{
				const uint most = subgroupMax( mySlots );
				// (1) THE CLASSES, in order (no fold yet: a run record that does not fit must end the batch before the
				// samples behind it): a fold, a RUN record (within the allowance, in the texel's first round with
				// records), or the batch's END
				uint runMask = 0u, endAt = mySlots;
				{
					uint consumedHere = vNow + runUsed;
					uint runHere = 0u;
					const bool window = runUsed == 0u;
					for( uint i = 0u; i < most; ++i )
					{
						const uint qBits = subgroupShuffle( bits, min( ahead + i, gl_SubgroupSize - 1u ) );
						if( i < mySlots && i < endAt && !batchEnded )
						{
							if( consumedHere >= kReflectRestVCap )
								endAt = i;
							else if( ( qBits & 2u ) == 0u )
								++consumedHere;
							else if( ( qBits & 256u ) != 0u && window && runHere < allowance )
							{
								runMask |= 1u << i;
								++runHere;
								++consumedHere;
							}
							else
								endAt = i;
						}
					}
				}
				// (2) THE RUN RESERVED, one atomic a subgroup: lane order is each texel's sample order, so a texel's run
				// is contiguous; a record past the capacity is not written (and ends its texel's batch below).
				const ivec2 ownerTc = ivec2( subgroupShuffle( uvec2( tc ), owner ) );
				const bool runRec = job && ( ( subgroupShuffle( runMask, owner ) >> index ) & 1u ) != 0u;
				const uvec4 runBallot = subgroupBallot( runRec );
				const uint runCount = subgroupBallotBitCount( runBallot );
				uint fit = 0u;   // 1 written, 2 not
				if( runCount > 0u )
				{
					uint runBase = 0u;
					if( subgroupElect() )
						runBase = atomicAdd( jahHitBuf[0], runCount );
					runBase = subgroupBroadcastFirst( runBase );
					if( runRec )
					{
						const uint li = runBase + subgroupBallotExclusiveBitCount( runBallot );
						if( li < JAH_HIT_CAPACITY )
						{
							const vec3 hitPos = x.origin + s.L * s.hitT;
							jahHitWrite( li, s.recSlot, s.recFar, s.recPrim, s.recBary, s.L,
										 s.sunVis,
										 reflectFootprint( max( x.alpha, 1e-4 ), s.hitT ),
										 s.blend ? -( 1.0 - s.blendVouch ) : -1.0,
										 jahHitDestPack( ownerTc, false, gEye ), x.world.y, length( hitPos - x.world ),
										 length( x.world - thisEye.camPos ),
										 s.blend ? s.blendVouch * vec4( s.screenRadiance, s.screenT ) : vec4( 0.0 ), s.recDelta,
										 s.recGain, s.recPane, s.recTraced, s.areaVis );
							fit = 1u;
						}
						else
						{
							atomicAdd( jahHitBuf[1], 1u );
							fit = 2u;
						}
					}
				}
				// (3) THE FOLDS, in order: the caches' answers here; a written run record counted (its fold is the
				// write-back's); the END - a record past the run, one not written, or no evidence.
				for( uint i = 0u; i < most; ++i )
				{
					const uint from = min( ahead + i, gl_SubgroupSize - 1u );
					const uint qBits = subgroupShuffle( bits, from );
					const vec3 qTraced = subgroupShuffle( s.traced, from );
					const float qT = subgroupShuffle( s.sampleT, from );
					const uint qFit = subgroupShuffle( fit, from );
					if( i < mySlots && !batchEnded )
					{
						if( i >= endAt )
							batchEnded = true;
						else if( ( runMask & ( 1u << i ) ) != 0u )
						{
							if( qFit == 1u )
								++runUsed;
							else
								batchEnded = true;
						}
						else
						{
							jahRestFold( rs, qTraced, float( vNow ) );
							++vNow;
							++folds;
							restT = vNow > 1u && restT > 0.0 ? max( restT + ( qT - restT ) / float( vNow ), 1e-3 ) : qT;
							lastBits = qBits;
						}
					}
				}
			}
			else
			{
				uvec4 from = lanes;
				for( uint r = 0u; r < laneCount; ++r )
				{
					const uint q = subgroupBallotFindLSB( from );
					from[q >> 5u] &= ~( 1u << ( q & 31u ) );
					const uint qOwner = subgroupShuffle( owner, q );
					const uint qBits = subgroupShuffle( bits, q );
					const vec3 qTraced = subgroupShuffle( s.traced, q );
					const float qT = subgroupShuffle( s.sampleT, q );
					if( ( qBits & 1u ) != 0u && qOwner == gl_SubgroupInvocationID && !batchEnded )
					{
						if( ( qBits & 2u ) != 0u || vNow >= kReflectRestVCap )
							batchEnded = true;
						else
						{
							jahRestFold( rs, qTraced, float( vNow ) );
							++vNow;
							++folds;
							restT = vNow > 1u && restT > 0.0 ? max( restT + ( qT - restT ) / float( vNow ), 1e-3 ) : qT;
							lastBits = qBits;
						}
					}
				}
			}
			dealt += mySlots;
			remaining = batchEnded ? 0u : remaining - mySlots;
			if( phase == 0u && remaining == 0u )
			{
				phase = 1u;   // the batch is done: its ending sample re-traced, or (folded whole) its finish, next
				batchFull = !batchEnded;
			}
		}
		if( mine )
		{
			if( batchFull )
			{
				s.centre = ( lastBits & 4u ) != 0u;
				s.vndf = ( lastBits & 8u ) != 0u;
				s.folded = ( lastBits & 16u ) != 0u;
				s.photonSource = lastBits >> 5u;
			}
			reflectFinish( tc, dist, world, origin, prevSurf, ownMoving, lobeAlpha, thisEye, atRest, restInPlace,
						   restBatch, batchRays, inPlace, restStop, throwT, rs, restHasH, restN, vNow, folds,
						   folds + runUsed, restT, stoppedCard, centreOnly, s );
			phase = 2u;
		}
	}
	// THE REST'S BATCHING TEXELS THIS FRAME (the tail budget's reading, OgreRayQuery.cpp kReflectRestRaysCap's note;
	// read back with the active count): the subgroup's sum, one atomic.
	if( JAH_HIT_ON && subgroupAny( restBatch ) )
	{
		const uint b = subgroupAdd( restBatch ? 1u : 0u );
		if( subgroupElect() )
			atomicAdd( jahHitBuf[4], b );
	}
}
